# Valeurs de production par défaut (chargées seulement quand APP_ENV=prod). Aucun secret ici : fichier versionné.
# Les secrets (base, clé, emails) vont sur le serveur dans .env.prod.local (modèle : bin/ops/env.prod.local.exemple).

# Hébergement mutualisé (Hostinger) : pas de processus permanent possible,
# les emails partent donc immédiatement, pendant la requête.
MESSENGER_TRANSPORT_DSN=sync://

# HTTPS est terminé par le serveur web lui-même.
TRUSTED_PROXIES=127.0.0.1

# Noms de domaine acceptés en production (expression régulière) : le site seulement, ni localhost ni adresse IP.
# Un autre nom d'accès (domaine de test, aperçu de l'hébergeur) doit être ajouté ici ou dans .env.prod.local.
TRUSTED_HOSTS='^(www\.)?kiinisawa\.com$'
