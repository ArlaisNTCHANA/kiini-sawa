# Valeurs de production par défaut (chargées seulement quand APP_ENV=prod).
# Les variables définies chez l'hébergeur ont toujours la priorité.
# Aucun secret ici : ce fichier est versionné.

# Clever Cloud : la base est construite à partir des variables de l'add-on MySQL lié à l'application.
# Ailleurs : définir directement DATABASE_URL chez l'hébergeur.
DATABASE_URL="mysql://${MYSQL_ADDON_USER}:${MYSQL_ADDON_PASSWORD}@${MYSQL_ADDON_HOST}:${MYSQL_ADDON_PORT}/${MYSQL_ADDON_DB}?serverVersion=8.4.0&charset=utf8mb4"

# Clever Cloud fournit l'adresse de ses proxys dans CC_REVERSE_PROXY_IPS.
TRUSTED_PROXIES="${CC_REVERSE_PROXY_IPS:-127.0.0.1}"

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
