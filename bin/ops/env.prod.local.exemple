# Modèle du fichier de secrets de production. Sur le serveur, copiez-le à la racine du projet sous le nom
# .env.prod.local, remplissez-le, puis lancez bin/ops/mise-a-jour.sh. Ne le versionnez jamais.

APP_ENV=prod
APP_DEBUG=0

# 64 caractères aléatoires : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Adresse publique du site (liens des emails)
DEFAULT_URI=https://app.kiinisawa.com

# hPanel › Bases de données › MySQL : nom de la base, utilisateur, mot de passe ; hôte « localhost ».
# Version : phpMyAdmin › onglet « Serveur » (ex. 11.8.2-MariaDB -> serverVersion=11.8.2-MariaDB).
DATABASE_URL="mysql://UTILISATEUR:MOTDEPASSE@localhost:3306/BASE?serverVersion=VERSION&charset=utf8mb4"

# Fournisseur d'emails (ex. Brevo : smtp://IDENTIFIANT:CLE@smtp-relay.brevo.com:587)
MAILER_DSN=
MAILER_FROM="KIINI SAWA <bonjour@kiinisawa.com>"
