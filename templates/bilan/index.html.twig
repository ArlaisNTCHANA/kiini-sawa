</div>

<!-- Script de gestion interactive -->
<script>
function bilanData() {
    return {
        // State
        activeTab: 'COMPETENCE',
        guideOpen: false,
        goals: {{ goalsJson|json_encode|raw }},
        challenges: {{ challengesJson|json_encode|raw }},
        
        // Wizard state
        wizardOpen: false,
        wizardStep: 'INTRO',
        wizardGoals: [],
        currentGoalIdx: 0,
        activeReviewGoal: null,
        
        wizardState: {
            scores: {},
            progressValues: {},
            notes: {}
        },

        initBilan() {
            // Initialize showHabits dynamically on goals
            this.goals = this.goals.map(g => ({ ...g, showHabits: false }));

            // Hotkeys listening for review step
            window.addEventListener('keydown', (e) => {
                if (!this.wizardOpen || this.wizardStep !== 'REVIEW' || !this.activeReviewGoal) return;
                
                // Ignore hotkeys if focused on input fields
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
                    return;
                }

                // 1 to 9 key presses -> score
                if (e.key >= '1' && e.key <= '9') {
                    this.wizardState.scores[this.activeReviewGoal.id] = parseInt(e.key);
                } else if (e.key === '0') {
                    this.wizardState.scores[this.activeReviewGoal.id] = 10;
                }
                
                // Enter -> next step
                if (e.key === 'Enter' && this.wizardState.scores[this.activeReviewGoal.id]) {
                    this.nextReviewGoal();
                }
            });
        },

        filteredGoals() {
            return this.goals.filter(g => g.axis === this.activeTab);
        },

        // Category KPI Averages
        averageHabitRate() {
            const active = this.filteredGoals();
            if (active.length === 0) return 0;
            let total = 0;
            active.forEach(g => {
                total += this.calculateHabitRate(g);
            });
            return Math.round(total / active.length);
        },

        averageProgress() {
            const active = this.filteredGoals();
            if (active.length === 0) return 0;
            let total = 0;
            active.forEach(g => {
                total += g.progress;
            });
            return Math.round(total / active.length);
        },

        averageSentiment() {
            const active = this.filteredGoals();
            let total = 0;
            let count = 0;
            active.forEach(g => {
                if (g.scores && g.scores.length > 0) {
                    total += g.scores[g.scores.length - 1].score;
                    count++;
                }
            });
            return count > 0 ? (total / count).toFixed(1) : '-';
        },

        // 7-day tracker helpers
        getRecentDays() {
            const days = [];
            const dayLabels = ['D', 'L', 'M', 'M', 'J', 'V', 'S'];
            const today = new Date();
            today.setHours(0,0,0,0);
            for (let i = 6; i >= 0; i--) {
                const d = new Date();
                d.setDate(today.getDate() - i);
                d.setHours(0,0,0,0);
                days.push({
                    dateStr: d.toISOString().split('T')[0],
                    label: dayLabels[d.getDay()],
                    isToday: i === 0
                });
            }
            return days;
        },

        isHabitLogged(habit, dateStr) {
            if (!habit.logs) return false;
            const log = habit.logs.find(l => l.date === dateStr);
            return log ? log.status : false;
        },

        isHabitScheduled(habit, dateStr) {
            const d = new Date(dateStr);
            if (habit.endDate && new Date(habit.endDate) < d) return false;
            
            if (habit.frequency === 'DAILY') return true;
            if (habit.frequency === 'WEEKLY') {
                const targetDay = habit.recurrenceDay ?? 1;
                return d.getDay() === targetDay;
            }
            if (habit.frequency === 'MONTHLY') {
                return d.getDate() === (habit.recurrenceDay ?? 1);
            }
            return false;
        },

        // Helper calculations
        calculateHabitRate(goal) {
            let total = 0;
            let completed = 0;
            
            goal.habits.forEach(h => {
                h.logs.forEach(l => {
                    total++;
                    if (l.status) completed++;
                });
            });
            
            return total > 0 ? Math.round((completed / total) * 100) : 0;
        },

        getHabitRateColor(goal) {
            const r = this.calculateHabitRate(goal);
            return r >= 80 ? 'text-emerald-600' : r >= 50 ? 'text-amber-600' : 'text-rose-600';
        },

        getHabitRateBg(goal) {
            const r = this.calculateHabitRate(goal);
            return r >= 80 ? 'bg-emerald-500' : r >= 50 ? 'bg-amber-500' : 'bg-rose-500';
        },

        getSignalColorClass(goal) {
            const r = this.calculateHabitRate(goal);
            const p = goal.progress;
            
            if (r < 40) return 'bg-rose-50 text-rose-700 border border-rose-100';
            if (r >= 80 && p < 20) return 'bg-emerald-50 text-emerald-700 border border-emerald-100';
            if (p >= 90) return 'bg-teal-50 text-teal-700 border border-teal-100';
            return 'bg-slate-50 text-slate-600 border border-slate-100';
        },

        getGoalSignal(goal) {
            const r = this.calculateHabitRate(goal);
            const p = goal.progress;
            
            if (r < 40) return '<span>🏗️ Discipline à bâtir</span>';
            if (r >= 80 && p < 20) return '<span>🌱 Semis (Patience)</span>';
            if (p >= 90) return '<span>🏆 Victoire proche</span>';
            return '<span>⚡ En action</span>';
        },

        // SVG graphing helpers
        getX(idx, total) {
            if (total <= 1) return 250;
            return (idx / (total - 1)) * 480 + 10;
        },

        getY(score) {
            // score 1-10 -> height range 90 (at bottom) to 10 (at top)
            return 90 - (score / 10) * 80;
        },

        getStrokePath(scores) {
            return this.getBezierPath(scores, false);
        },

        getAreaPath(scores) {
            return this.getBezierPath(scores, true);
        },

        getBezierPath(scores, isClosed = false) {
            if (!scores || scores.length === 0) return '';
            
            const points = scores.map((s, idx) => ({
                x: this.getX(idx, scores.length),
                y: this.getY(s.score)
            }));
            
            if (points.length === 1) {
                if (isClosed) {
                    return `M ${points[0].x - 10},90 L ${points[0].x - 10},${points[0].y} L ${points[0].x + 10},${points[0].y} L ${points[0].x + 10},90 Z`;
                }
                return `M ${points[0].x - 10},${points[0].y} L ${points[0].x + 10},${points[0].y}`;
            }

            const line = (pointA, pointB) => {
                const lengthX = pointB.x - pointA.x;
                const lengthY = pointB.y - pointA.y;
                return {
                    length: Math.sqrt(Math.pow(lengthX, 2) + Math.pow(lengthY, 2)),
                    angle: Math.atan2(lengthY, lengthX)
                };
            };

            const controlPoint = (current, previous, next, reverse) => {
                const p = previous || current;
                const n = next || current;
                const smoothing = 0.2;
                const o = line(p, n);
                const angle = o.angle + (reverse ? Math.PI : 0);
                const length = o.length * smoothing;
                const x = current.x + Math.cos(angle) * length;
                const y = current.y + Math.sin(angle) * length;
                return { x, y };
            };

            let d = `M ${points[0].x},${points[0].y}`;
            
            for (let i = 1; i < points.length; i++) {
                const cpStart = controlPoint(points[i - 1], points[i - 2], points[i], false);
                const cpEnd = controlPoint(points[i], points[i - 1], points[i + 1], true);
                
                const constrain = (val) => Math.max(10, Math.min(90, val));
                cpStart.y = constrain(cpStart.y);
                cpEnd.y = constrain(cpEnd.y);
                
                d += ` C ${cpStart.x},${cpStart.y} ${cpEnd.x},${cpEnd.y} ${points[i].x},${points[i].y}`;
            }

            if (isClosed) {
                d += ` L ${points[points.length - 1].x},90 L ${points[0].x},90 Z`;
            }
            return d;
        },

        formatDateShort(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        },

        // Wizard management
        openWizard() {
            this.wizardGoals = this.goals;
            if (this.wizardGoals.length === 0) {
                alert("Vous devez avoir des objectifs actifs pour faire un bilan.");
                return;
            }

            // Reset wizard state
            this.wizardStep = 'INTRO';
            this.currentGoalIdx = 0;
            this.wizardState.scores = {};
            this.wizardState.progressValues = {};
            this.wizardState.notes = {};

            // Prefill current progress values
            this.wizardGoals.forEach(g => {
                this.wizardState.progressValues[g.id] = g.progress;
                this.wizardState.notes[g.id] = '';
            });

            this.wizardOpen = true;
        },

        startReviews() {
            this.wizardStep = 'REVIEW';
            this.currentGoalIdx = 0;
            this.activeReviewGoal = this.wizardGoals[0];
        },

        prevReviewGoal() {
            if (this.currentGoalIdx > 0) {
                this.currentGoalIdx--;
                this.activeReviewGoal = this.wizardGoals[this.currentGoalIdx];
            }
        },

        nextReviewGoal() {
            // Save score via API
            const goalId = this.activeReviewGoal.id;
            const score = this.wizardState.scores[goalId];
            const progressValue = this.wizardState.progressValues[goalId];
            const note = this.wizardState.notes[goalId];

            fetch('/api/bilan/save-score', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ goalId, score, progressValue, note })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    // Update local model
                    this.activeReviewGoal.progress = progressValue;
                    this.activeReviewGoal.scores.push({
                        id: Date.now(), // dummy temporary id
                        date: new Date().toISOString().split('T')[0],
                        score,
                        progressValue,
                        note
                    });

                    // Proceed
                    if (this.currentGoalIdx < this.wizardGoals.length - 1) {
                        this.currentGoalIdx++;
                        this.activeReviewGoal = this.wizardGoals[this.currentGoalIdx];
                    } else {
                        this.wizardStep = 'OUTRO';
                    }
                } else {
                    alert("Erreur lors de la sauvegarde.");
                }
            });
        },

        closeWizard() {
            this.wizardOpen = false;
            this.activeReviewGoal = null;
        },

        // Missed Habits Catch-up
        getMissedHabits(goal) {
            let missed = [];
            let today = new Date();
            today.setHours(0,0,0,0);
            
            const dayNames = ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"];

            for (let i = 6; i >= 0; i--) {
                let checkDate = new Date();
                checkDate.setDate(today.getDate() - i);
                checkDate.setHours(0,0,0,0);
                
                let checkDateStr = checkDate.toISOString().split('T')[0];
                let dayOfWeek = checkDate.getDay(); // 0 (Sun) - 6 (Sat)
                
                goal.habits.forEach(h => {
                    if (h.endDate && new Date(h.endDate) < checkDate) return;
                    
                    let matchesRecurrence = false;
                    if (h.frequency === 'DAILY') {
                        matchesRecurrence = true;
                    } else if (h.frequency === 'WEEKLY') {
                        let targetDay = h.recurrenceDay ?? 1;
                        if (dayOfWeek === targetDay) matchesRecurrence = true;
                    } else if (h.frequency === 'MONTHLY') {
                        if (checkDate.getDate() === (h.recurrenceDay ?? 1)) matchesRecurrence = true;
                    }
                    
                    if (matchesRecurrence) {
                        let log = h.logs.find(l => l.date === checkDateStr && l.status);
                        if (!log) {
                            missed.push({
                                habitId: h.id,
                                title: h.title,
                                date: checkDate,
                                dateStr: checkDateStr,
                                dayLabel: dayNames[dayOfWeek]
                            });
                        }
                    }
                });
            }
            return missed;
        },

        catchUpHabit(item) {
            fetch(`/api/planner/toggle/HABIT/${item.habitId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ date: item.dateStr })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success && data.isCompleted) {
                    // Update local logs
                    const goal = this.goals.find(g => g.id === this.activeReviewGoal.id);
                    const habit = goal.habits.find(h => h.id === item.habitId);
                    habit.logs.push({
                        date: item.dateStr,
                        status: true
                    });
                }
            });
        }
    }
}
</script>
{% endblock %}
