                 <button class="px-5 py-2 text-sm font-bold text-slate-500 hover:text-slate-700 transition-colors"
                         :disabled="currentGoalIdx === 0"
                         :class="currentGoalIdx === 0 ? 'opacity-30 cursor-not-allowed' : ''"
