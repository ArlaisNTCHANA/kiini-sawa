                 <button class="bg-teal-700 hover:bg-teal-800 text-white font-semibold py-2.5 px-6 rounded-xl shadow-md transition-colors flex items-center gap-1.5"
                         :disabled="!wizardState.scores[activeReviewGoal?.id]"
                         :class="!wizardState.scores[activeReviewGoal?.id] ? 'opacity-50 cursor-not-allowed' : ''"
                         @click="nextReviewGoal()">
                     <span x-text="currentGoalIdx < wizardGoals.length - 1 ? 'Suivant' : 'Terminer'"></span>
