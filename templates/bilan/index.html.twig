{% extends 'base.html.twig' %}

{% block title %}Mon Bilan & Progression{% endblock %}

{% block body %}
<style>
    .bilan-wrap {
        max-width: 900px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 8rem;
    }
    @media (min-width: 1024px) {
        .bilan-wrap {
            padding: 3.5rem 2rem 5rem;
        }
    }

    /* Section Cards — aligned with ritual-section */
    .bilan-section {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(15, 118, 110, 0.06);
        border-radius: 2rem;
        padding: 2.25rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
    }

    /* Tab buttons — aligned with tab-btn */
    .bilan-tab {
        padding: 0.75rem 1.5rem;
        border-radius: var(--r-md);
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.25s var(--ease);
        cursor: pointer;
        border: 1px solid transparent;
        background: transparent;
        color: var(--fg-muted);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .bilan-tab.active {
        background: var(--primary-glow);
        color: var(--primary);
        border-color: rgba(15, 118, 110, 0.15);
    }
    .bilan-tab:hover:not(.active) {
        background: var(--bg-alt);
        color: var(--fg-light);
    }

    /* Stat KPI Cards */
    .bilan-stat-card {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(15, 118, 110, 0.06);
        border-radius: 1.25rem;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.25s var(--ease);
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.02);
    }
    .bilan-stat-card:hover {
        box-shadow: 0 8px 20px rgba(15, 118, 110, 0.06);
        transform: translateY(-1px);
    }

    /* Metric sub-cards inside goal cards */
    .bilan-metric {
        padding: 1.25rem;
        border-radius: 1.25rem;
        border: 1px solid rgba(15, 118, 110, 0.06);
        background: rgba(248, 250, 252, 0.6);
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition: all 0.25s var(--ease);
    }
    .bilan-metric:hover {
        background: rgba(248, 250, 252, 0.9);
    }

    /* Labels */
    .bilan-label {
        font-size: 0.675rem;
        font-weight: 800;
        color: var(--fg-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .bilan-sublabel {
        font-size: 0.7rem;
        color: #94A3B8;
        line-height: 1.4;
    }

    /* Inputs — aligned with ritual-input */
    .bilan-input {
        width: 100%;
        padding: 0.85rem 1.1rem;
        background-color: #ffffff;
        border: 1.5px solid rgba(15, 118, 110, 0.08);
        border-radius: 12px;
        color: var(--fg);
        font-family: inherit;
        font-size: 0.95rem;
        outline: none;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
        transition: all 0.25s;
    }
    .bilan-input:focus {
        border-color: var(--primary-light);
        box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.12), inset 0 2px 4px rgba(0,0,0,0.01);
    }

    /* Buttons — aligned with btn-submit */
    .bilan-btn {
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%);
        border: none;
        border-radius: 12px;
        color: #ffffff;
        font-family: inherit;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .bilan-btn:hover:not(:disabled) {
        opacity: 0.95;
        box-shadow: 0 6px 20px rgba(15, 118, 110, 0.45);
        transform: translateY(-1px);
    }
    .bilan-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .bilan-btn-ghost {
        padding: 0.65rem 1.25rem;
        background: transparent;
        border: none;
        color: var(--fg-muted);
        font-family: inherit;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: color 0.2s;
    }
    .bilan-btn-ghost:hover { color: var(--fg); }
    .bilan-btn-ghost:disabled { opacity: 0.3; cursor: not-allowed; }

    /* Habit accordion items */
    .bilan-habit-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-radius: 1rem;
        background: #ffffff;
        border: 1px solid rgba(15, 118, 110, 0.05);
        box-shadow: 0 4px 12px rgba(15, 118, 110, 0.02);
        transition: all 0.2s var(--ease);
    }

    /* Custom range slider */
    .ks-slider {
        -webkit-appearance: none;
        width: 100%;
        background: transparent;
    }
    .ks-slider:focus { outline: none; }
    .ks-slider::-webkit-slider-runnable-track {
        width: 100%;
        height: 6px;
        cursor: pointer;
        background: #e2e8f0;
        border-radius: 9999px;
    }
    .ks-slider::-webkit-slider-thumb {
        height: 18px;
        width: 18px;
        border-radius: 50%;
        background: var(--primary);
        border: 2px solid white;
        cursor: pointer;
        -webkit-appearance: none;
        margin-top: -6px;
        box-shadow: 0 2px 6px rgba(15, 118, 110, 0.3);
        transition: transform 0.1s var(--ease);
    }
    .ks-slider::-webkit-slider-thumb:hover { transform: scale(1.15); }
    .ks-slider::-moz-range-track {
        width: 100%;
        height: 6px;
        cursor: pointer;
        background: #e2e8f0;
        border-radius: 9999px;
    }
    .ks-slider::-moz-range-thumb {
        height: 18px;
        width: 18px;
        border-radius: 50%;
        background: var(--primary);
        border: 2px solid white;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(15, 118, 110, 0.3);
    }

    /* Progress bars */
    .bilan-progress-track {
        width: 100%;
        height: 5px;
        background: rgba(226, 232, 240, 0.7);
        border-radius: 9999px;
        overflow: hidden;
    }
    .bilan-progress-fill {
        height: 100%;
        border-radius: 9999px;
        transition: width 0.5s var(--ease);
    }
</style>

<div class="bilan-wrap"
     x-data="bilanData()"
     x-init="initBilan()">
     
    <!-- Header -->
    <header class="text-center" style="margin-bottom: 2rem;">
        <h1 style="font-size: 1.75rem; font-weight: 700; line-height: 1.2;">Mon Bilan & Progression</h1>
        <p style="color: var(--fg-muted); font-size: 0.875rem; margin-top: 0.5rem;">Évaluez vos progrès, suivez votre discipline et observez votre évolution.</p>
        <a href="{{ path('app_weekly_review') }}" class="bilan-btn" style="margin-top: 1.25rem; display: inline-flex; align-items: center; gap: .5rem; text-decoration: none;">
            <i data-lucide="calendar-check" class="w-4 h-4"></i> Faire ma revue de la semaine
        </a>
    </header>
    <div style="max-width: 760px; margin: 0 auto 1.5rem;">{{ book_panel('bilan') }}</div>

    <!-- Tabs Navigation -->
    <nav style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 2.5rem;">
        <button @click="activeTab = 'COMPETENCE'"
                class="bilan-tab"
                :class="activeTab === 'COMPETENCE' ? 'active' : ''">
            <i data-lucide="book-open" class="w-4 h-4"></i>
            <span>Compétences</span>
        </button>
        <button @click="activeTab = 'CHARACTER'"
                class="bilan-tab"
                :class="activeTab === 'CHARACTER' ? 'active' : ''">
            <i data-lucide="shield" class="w-4 h-4"></i>
            <span>Caractère</span>
        </button>
        <button @click="activeTab = 'RELATION'"
                class="bilan-tab"
                :class="activeTab === 'RELATION' ? 'active' : ''">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>Relations</span>
        </button>
    </nav>

    <!-- Global Category Stats (KPIs) -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.5rem;" class="sm:!grid-cols-4" x-show="filteredGoals().length > 0">
        <div class="bilan-stat-card">
            <div style="padding: 0.6rem; background: rgba(13,148,136,0.06); border-radius: 0.75rem; color: var(--primary);">
                <i data-lucide="target" class="w-4 h-4"></i>
            </div>
            <div>
                <span class="bilan-label" style="display: block;">Objectifs Actifs</span>
                <span style="font-size: 1.1rem; font-weight: 800; color: var(--fg);" x-text="filteredGoals().length"></span>
            </div>
        </div>
        <div class="bilan-stat-card">
            <div style="padding: 0.6rem; background: rgba(16,185,129,0.08); border-radius: 0.75rem; color: #059669;">
                <i data-lucide="activity" class="w-4 h-4"></i>
            </div>
            <div>
                <span class="bilan-label" style="display: block;">Discipline Moyenne</span>
                <span style="font-size: 1.1rem; font-weight: 800; color: var(--fg);" x-text="averageHabitRate() + '%'"></span>
            </div>
        </div>
        <div class="bilan-stat-card">
            <div style="padding: 0.6rem; background: rgba(99,102,241,0.08); border-radius: 0.75rem; color: #4F46E5;">
                <i data-lucide="trending-up" class="w-4 h-4"></i>
            </div>
            <div>
                <span class="bilan-label" style="display: block;">Atteinte Moyenne</span>
                <span style="font-size: 1.1rem; font-weight: 800; color: var(--fg);" x-text="averageProgress() + '%'"></span>
            </div>
        </div>
        <div class="bilan-stat-card">
            <div style="padding: 0.6rem; background: rgba(245,158,11,0.08); border-radius: 0.75rem; color: #D97706;">
                <i data-lucide="smile" class="w-4 h-4"></i>
            </div>
            <div>
                <span class="bilan-label" style="display: block;">Sentiment Moyen</span>
                <span style="font-size: 1.1rem; font-weight: 800; color: var(--fg);" x-text="averageSentiment() === '-' ? '-' : averageSentiment() + '/10'"></span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div style="display: flex; flex-direction: column; gap: 1.75rem;">
        
        <!-- Empty State -->
        <div x-show="filteredGoals().length === 0" class="bilan-section" style="text-align: center; padding: 3rem 2rem; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; border-style: dashed;">
            <div style="padding: 1rem; background: var(--bg-alt); border-radius: 9999px; color: var(--fg-muted);">
                <i data-lucide="target" class="w-10 h-10"></i>
            </div>
            <div>
                <p style="color: var(--fg-light); font-weight: 600; margin-bottom: 0.25rem;">Aucun objectif actif dans cette catégorie.</p>
                <p class="bilan-sublabel" style="max-width: 24rem; margin: 0 auto;">
                    Ajoutez des objectifs de croissance ou liez des habitudes dans votre plan pour commencer le suivi de votre progression.
                </p>
            </div>
            <a href="{{ path('app_strategies') }}" class="bilan-btn">
                Gérer mes Stratégies
            </a>
        </div>

        <!-- Goals Cards Loop -->
        <template x-for="goal in filteredGoals()" :key="goal.id">
            <div class="bilan-section" style="display: flex; flex-direction: column; gap: 1.75rem;">
                
                <!-- Card Header -->
                <div class="flex justify-between items-start">
                    <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                        <span class="bilan-label" x-text="goal.sourceTitle || 'OBJECTIF DE CROISSANCE'"></span>
                        <h3 style="font-size: 1.1rem; font-weight: 700; line-height: 1.3;" x-text="goal.title"></h3>
                    </div>
                    
                    <!-- Dynamic Signal Badge -->
                    <div style="display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.85rem; border-radius: 9999px; font-size: 0.7rem; font-weight: 700; white-space: nowrap;"
                         :class="getSignalColorClass(goal)" 
                         x-html="getGoalSignal(goal)">
                    </div>
                </div>

                <!-- Metrics Grid -->
                <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" class="md:!grid-cols-2">
                    <!-- Regularity -->
                    <div class="bilan-metric">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                <div style="display: flex; align-items: center; gap: 0.4rem;">
                                    <i data-lucide="repeat" class="w-3.5 h-3.5" style="color: var(--fg-muted);"></i>
                                    <span class="bilan-label">Régularité</span>
                                </div>
                                <span class="bilan-sublabel">Complétion des habitudes liées</span>
                            </div>
                            <span style="font-size: 1.25rem; font-weight: 800; line-height: 1;" 
                                  :class="getHabitRateColor(goal)" 
                                  x-text="calculateHabitRate(goal) + '%'"></span>
                        </div>
                        <div class="bilan-progress-track">
                            <div class="bilan-progress-fill" 
                                 :class="getHabitRateBg(goal)" 
                                 :style="'width: ' + calculateHabitRate(goal) + '%'"></div>
                        </div>
                    </div>

                    <!-- Progress level -->
                    <div class="bilan-metric" style="background: rgba(13,148,136,0.03);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                                <div style="display: flex; align-items: center; gap: 0.4rem;">
                                    <i data-lucide="trending-up" class="w-3.5 h-3.5" style="color: var(--primary);"></i>
                                    <span class="bilan-label" style="color: var(--primary);">Niveau d'atteinte</span>
                                </div>
                                <span class="bilan-sublabel">Progrès vers le résultat final</span>
                            </div>
                            <span style="font-size: 1.25rem; font-weight: 800; color: var(--primary); line-height: 1;" x-text="goal.progress + '%'"></span>
                        </div>
                        <div class="bilan-progress-track" style="background: rgba(13,148,136,0.1);">
                            <div class="bilan-progress-fill" style="background: var(--primary);" :style="'width: ' + goal.progress + '%'"></div>
                        </div>
                    </div>
                </div>

                <!-- Sentiment Graph -->
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                        <i data-lucide="history" class="w-4 h-4" style="color: var(--fg-muted);"></i>
                        <span class="bilan-label">Sentiment de progression</span>
                    </div>
                    
                    <div class="bilan-metric" style="display: flex; align-items: center; justify-content: center; min-height: 100px; position: relative;"
                         x-data="{ activeTooltip: null }">
                        <template x-if="goal.scores.length === 0">
                            <span class="text-slate-400 text-xs italic">Aucun score enregistré. Complétez votre premier bilan.</span>
                        </template>
                        <template x-if="goal.scores.length > 0">
                            <div class="w-full relative">
                                <svg viewBox="0 0 500 100" class="w-full h-20 overflow-visible text-teal-700/80">
                                    <defs>
                                        <linearGradient :id="'gradient-' + goal.id" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0%" stop-color="rgb(15, 118, 110)" stop-opacity="0.22" />
                                            <stop offset="100%" stop-color="rgb(15, 118, 110)" stop-opacity="0.0" />
                                        </linearGradient>
                                    </defs>
                                    <!-- Background Grid Lines -->
                                    <line x1="10" y1="10" x2="490" y2="10" stroke="rgba(15, 118, 110, 0.08)" stroke-width="1" stroke-dasharray="2,2" />
                                    <line x1="10" y1="50" x2="490" y2="50" stroke="rgba(15, 118, 110, 0.08)" stroke-width="1" stroke-dasharray="2,2" />
                                    <line x1="10" y1="90" x2="490" y2="90" stroke="rgba(15, 118, 110, 0.08)" stroke-width="1" stroke-dasharray="2,2" />
                                    <!-- Area Path -->
                                    <path :d="getAreaPath(goal.scores)" :fill="'url(#gradient-' + goal.id + ')'" stroke="none" />
                                    <!-- Stroke Path -->
                                    <path :d="getStrokePath(goal.scores)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                                </svg>

                                <!-- Interactive Dots Layer (HTML overlay to bypass browser SVG template parsing bugs) -->
                                <div class="absolute inset-0 pointer-events-none">
                                    <template x-for="(s, idx) in goal.scores" :key="s.id">
                                        <div class="absolute pointer-events-auto group/dot cursor-pointer"
                                             :style="`left: ${getX(idx, goal.scores.length) / 500 * 100}%; top: ${getY(s.score)}%; transform: translate(-50%, -50%); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center;`"
                                             @mouseenter="activeTooltip = { index: idx, score: s.score, date: formatDateShort(s.date), x: getX(idx, goal.scores.length), y: getY(s.score) }"
                                             @mouseleave="activeTooltip = null">
                                            <!-- Visible inner dot -->
                                            <div class="w-1.5 h-1.5 rounded-full bg-teal-700 transition-transform duration-200 group-hover/dot:scale-125"></div>
                                            <!-- Glowing pulse ring on hover -->
                                            <div class="absolute w-5 h-5 rounded-full bg-teal-700/15 opacity-0 group-hover/dot:opacity-100 transition-opacity duration-200"></div>
                                        </div>
                                    </template>
                                </div>

                                <!-- Tooltip Bubble (Positioned relative to the SVG container) -->
                                <div x-show="activeTooltip" 
                                     x-transition:enter="transition ease-out duration-200"
                                     x-transition:enter-start="opacity-0 translate-y-1"
                                     x-transition:enter-end="opacity-100 translate-y-0"
                                     x-transition:leave="transition ease-in duration-150"
                                     x-transition:leave-start="opacity-100 translate-y-0"
                                     x-transition:leave-end="opacity-0 translate-y-1"
                                     class="absolute bg-slate-800 text-white text-[10px] font-bold px-2.5 py-1 rounded-lg shadow-md pointer-events-none -translate-x-1/2 -translate-y-full z-10"
                                     :style="`left: ${activeTooltip ? (activeTooltip.x / 500 * 100) : 0}%; top: ${activeTooltip ? (activeTooltip.y - 6) : 0}%;`"
                                     x-cloak>
                                    <span x-text="activeTooltip ? `${activeTooltip.score}/10 (${activeTooltip.date})` : ''"></span>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Associated Habits Accordion -->
                <div style="border-top: 1px solid rgba(15,118,110,0.06); padding-top: 1.25rem; margin-top: 0.5rem;">
                    <button @click="goal.showHabits = !goal.showHabits" 
                            class="w-full flex items-center justify-between text-xs font-semibold text-slate-500 hover:text-teal-700 transition-colors cursor-pointer">
                        <span class="flex items-center gap-2">
                            <i data-lucide="activity" class="w-3.5 h-3.5 text-slate-400"></i>
                            <span x-text="goal.showHabits ? 'Masquer les rituels associés' : 'Voir les rituels associés (' + goal.habits.length + ')'"></span>
                        </span>
                        <i data-lucide="chevron-down" class="w-4 h-4 transition-transform duration-300" :class="goal.showHabits ? 'rotate-180 text-teal-755' : ''"></i>
                    </button>
                    
                    <div x-show="goal.showHabits"
                         x-transition:enter="transition ease-out duration-200"
                         x-transition:enter-start="opacity-0 -translate-y-2"
                         x-transition:enter-end="opacity-100 translate-y-0"
                         style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem; background: rgba(248,250,252,0.5); border-radius: 1.25rem; border: 1px solid rgba(15,118,110,0.05); padding: 1.25rem;">
                        
                        <template x-if="goal.habits.length === 0">
                            <p class="text-xs text-slate-400 italic text-center py-2">Aucune habitude liée à cet objectif.</p>
                        </template>
                        
                        <template x-for="h in goal.habits" :key="h.id">  
                            <div class="bilan-habit-item" style="flex-direction: column; gap: 0.75rem;" class="sm:!flex-row sm:!items-center">
                                <div style="display: flex; align-items: center; gap: 0.75rem; min-width: 0; flex: 1;">
                                    <span style="width: 4px; height: 1.5rem; border-radius: 9999px; background: var(--primary); flex-shrink: 0;"></span>
                                    <div style="min-width: 0;">
                                        <span style="font-size: 0.85rem; font-weight: 700; color: var(--fg-light); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" x-text="h.title"></span>
                                        <span class="bilan-label" x-text="h.frequency === 'DAILY' ? 'Tous les jours' : (h.frequency === 'WEEKLY' ? 'Chaque semaine' : 'Chaque mois')"></span>
                                    </div>
                                </div>
                                
                                <!-- 7-day mini calendar tracker -->
                                <div class="flex items-center gap-1.5 self-end sm:self-center">
                                    <template x-for="day in getRecentDays()" :key="day.dateStr">
                                        <div class="flex flex-col items-center gap-0.5">
                                            <span class="text-[8px] font-bold text-slate-400" x-text="day.label"></span>
                                            
                                            <div class="w-5 h-5 rounded-full flex items-center justify-center text-[9px] font-extrabold transition-all"
                                                 :class="
                                                    isHabitLogged(h, day.dateStr) 
                                                        ? 'bg-emerald-500 text-white shadow-sm shadow-emerald-500/10' 
                                                        : (isHabitScheduled(h, day.dateStr) 
                                                            ? (new Date(day.dateStr) < new Date(new Date().setHours(0,0,0,0)) 
                                                                ? 'bg-rose-50 text-rose-500 border border-rose-100' 
                                                                : 'bg-teal-50 text-teal-600 border border-teal-150') 
                                                            : 'bg-slate-100/60 text-slate-350 border border-transparent')
                                                 "
                                                 :title="day.dateStr + ' : ' + (isHabitLogged(h, day.dateStr) ? 'Complété' : (isHabitScheduled(h, day.dateStr) ? 'Manqué' : 'Non requis'))">
                                                <span x-show="isHabitLogged(h, day.dateStr)">✓</span>
                                                <span x-show="!isHabitLogged(h, day.dateStr) && isHabitScheduled(h, day.dateStr)" x-text="day.isToday ? '•' : '×'"></span>
                                                <span x-show="!isHabitLogged(h, day.dateStr) && !isHabitScheduled(h, day.dateStr)" class="text-[7px] text-slate-350">—</span>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>

            </div>
        </template>
    </div>

    <!-- Coach's Guide -->
    <div class="max-w-[800px] mx-auto mt-10 bg-slate-50 rounded-3xl p-2">
        <button @click="guideOpen = !guideOpen"
