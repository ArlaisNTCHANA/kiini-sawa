{% extends 'base.html.twig' %}

{% block title %}Revue de la semaine{% endblock %}

{% block body %}
<style>
    .wr-wrap { max-width: var(--page-standard); margin: 0 auto; padding: 2.5rem 1.25rem 8rem; }
    .wr-intro { color: var(--fg-muted); margin: .25rem 0 2rem; }
    .wr-card { background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem; margin-bottom: 1.25rem; }
    .wr-card h2 { font-family: var(--font-serif); font-size: 1.25rem; display: flex; align-items: center; gap: .5rem; margin-bottom: .25rem; }
    .wr-sub { color: var(--fg-muted); font-size: .85rem; margin-bottom: 1rem; }
    .wr-field { display: flex; flex-direction: column; gap: .35rem; margin-bottom: 1rem; }
    .wr-field label, .wr-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--fg-muted); }
    .wr-field textarea, .wr-field input[type=text] { padding: .65rem .85rem; border: 1.5px solid var(--border); border-radius: var(--r-md); font: inherit; font-size: .95rem; background: #fff; }
    .wr-field textarea:focus, .wr-field input:focus { outline: none; border-color: var(--primary-light); box-shadow: 0 0 0 3px var(--primary-glow); }
    .wr-item { border-top: 1px solid var(--bg-alt); padding: 1rem 0; }
    .wr-item:first-of-type { border-top: none; }
    .wr-item-title { font-weight: 700; margin-bottom: .6rem; }
    .wr-scores { display: flex; gap: .3rem; flex-wrap: wrap; margin-bottom: .6rem; }
    .wr-scores input { position: absolute; opacity: 0; pointer-events: none; }
    .wr-scores label { width: 2.2rem; height: 2.2rem; display: flex; align-items: center; justify-content: center; border: 1.5px solid var(--border); border-radius: .6rem; font-weight: 700; font-size: .85rem; cursor: pointer; color: var(--fg-light); }
    .wr-scores label:has(input:checked) { background: var(--primary); border-color: var(--primary); color: #fff; }
    .wr-row { display: grid; grid-template-columns: 1fr; gap: .6rem; }
    @media (min-width: 640px) { .wr-row { grid-template-columns: 220px 1fr; align-items: center; } }
    .wr-row input[type=range] { width: 100%; accent-color: var(--primary); }
    .wr-row input[type=text] { padding: .5rem .75rem; border: 1.5px solid var(--border); border-radius: var(--r-md); font: inherit; font-size: .9rem; }
    .wr-habit { display: flex; justify-content: space-between; gap: 1rem; padding: .4rem 0; font-size: .9rem; border-top: 1px solid var(--bg); }
    .wr-bar { height: 6px; background: var(--bg-alt); border-radius: 6px; overflow: hidden; width: 120px; flex-shrink: 0; align-self: center; }
    .wr-bar span { display: block; height: 100%; background: var(--primary-light); }
    .wr-submit { display: flex; justify-content: flex-end; gap: .75rem; margin-top: 1.5rem; }
    .wr-btn { padding: .85rem 1.5rem; border-radius: var(--r-md); border: none; background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .wr-btn:hover { background: var(--primary-dark); }
    .wr-history { display: flex; flex-direction: column; gap: .4rem; font-size: .9rem; }
    .wr-history div { display: flex; justify-content: space-between; padding: .4rem 0; border-top: 1px solid var(--bg-alt); }
</style>

<div class="wr-wrap">
    <a href="{{ path('app_bilan') }}" class="ks-header__back">← Mon bilan</a>
    <h1 class="ks-header__title">Revue de la semaine</h1>
    <p class="wr-intro ks-header__lead">
        Semaine du {{ week|format_date(pattern: 'd MMMM y', locale: 'fr') }}.
        Quinze minutes pour regarder en arrière, ajuster, et choisir ce qui compte vraiment la semaine prochaine.
        {% if review %}<br><strong>Revue déjà faite le {{ review.completedAt|format_date(pattern: 'EEEE d MMMM', locale: 'fr') }}</strong> : vous pouvez la compléter.{% endif %}
    </p>

    {{ book_panel('revue') }}

    <form method="post">
        {# 1. Rétrospective #}
        <section class="wr-card">
            <h2><i data-lucide="rewind" style="width: 20px; height: 20px;"></i> 1. Regarder en arrière</h2>
            <p class="wr-sub">Avec gratitude et honnêteté.</p>
            <div class="wr-field"><label for="wins">Mes victoires de la semaine</label><textarea id="wins" name="wins" rows="2">{{ review.wins ?? '' }}</textarea></div>
            <div class="wr-field"><label for="struggles">Ce qui a été difficile</label><textarea id="struggles" name="struggles" rows="2">{{ review.struggles ?? '' }}</textarea></div>
            <div class="wr-field"><label for="lesson">La leçon que je retiens</label><textarea id="lesson" name="lesson" rows="2">{{ review.lesson ?? '' }}</textarea></div>
        </section>

        {# 2. Les plans #}
        {% set hasItems = false %}
        {% for key, plan in plans %}
            {% if items[key]|length > 0 %}
                {% set hasItems = true %}
                <section class="wr-card" style="border-top: 4px solid {{ plan.color }};">
                    <h2 style="color: {{ plan.color }};"><i data-lucide="{{ plan.icon }}" style="width: 20px; height: 20px;"></i> {{ plan.label }}</h2>
                    <p class="wr-sub">Notez de 1 à 10 votre engagement de la semaine sur chaque point.</p>
                    {% for item in items[key] %}
                        {% set k = item.type ~ '_' ~ item.id %}
                        <div class="wr-item">
                            <div class="wr-item-title">{{ item.title }}</div>
                            <div class="wr-scores" role="radiogroup" aria-label="Évaluation de {{ item.title }}">
                                {% for n in 1..10 %}
                                    <label><input type="radio" name="score[{{ k }}]" value="{{ n }}" {{ (previous[k].score ?? null) == n ? 'checked' }}>{{ n }}</label>
                                {% endfor %}
                            </div>
                            <div class="wr-row">
                                {% if item.progress is not null %}
                                    <label class="wr-label" x-data="{ v: {{ previous[k].progress ?? item.progress }} }">Avancement : <span x-text="v + ' %'"></span>
                                        <input type="range" name="progress[{{ k }}]" min="0" max="100" step="5" x-model="v">
                                    </label>
                                {% else %}
                                    <span></span>
                                {% endif %}
                                <input type="text" name="note[{{ k }}]" value="{{ previous[k].note ?? '' }}" placeholder="Une note, un ajustement…" maxlength="500" aria-label="Note sur {{ item.title }}">
                            </div>
                        </div>
                    {% endfor %}
                </section>
            {% endif %}
        {% endfor %}
        {% if not hasItems %}
            <section class="wr-card">
                <h2>2. Mes plans</h2>
                <p class="wr-sub">Vos plans sont encore vides. <a href="{{ path('app_plans') }}" style="color: var(--primary); font-weight: 600;">Définir mes axes →</a></p>
            </section>
        {% endif %}

        {# 3. Rituels et journal #}
        <section class="wr-card">
            <h2><i data-lucide="repeat" style="width: 20px; height: 20px;"></i> Mes rituels et mon journal</h2>
            <p class="wr-sub">Les 7 derniers jours · {{ journalCount }} note{{ journalCount > 1 ? 's' }} dans le journal.</p>
            {% for h in habits %}
                <div class="wr-habit">
                    <span>{{ h.title }}</span>
                    <span style="display: flex; gap: .6rem; align-items: center; color: var(--fg-muted);">{{ h.done }}/{{ h.expected }}
                        <span class="wr-bar"><span style="width: {{ h.expected > 0 ? (h.done / h.expected * 100)|round : 0 }}%;"></span></span>
                    </span>
                </div>
            {% else %}
                <p style="color: var(--fg-muted); font-size: .9rem;">Aucun rituel pour l'instant. <a href="{{ path('app_user_habits') }}" style="color: var(--primary); font-weight: 600;">Créer un rituel →</a></p>
            {% endfor %}
        </section>

        {# Redevabilité : ce que les partenaires ont fait cette semaine #}
        {% if accountability %}
            <section class="wr-card" id="redevabilite">
                <h2><i data-lucide="shield-check" style="width: 20px; height: 20px;"></i> Mes engagements cette semaine</h2>
                <p class="wr-sub">
                    {{ accountability.totals.messages }} message{{ accountability.totals.messages > 1 ? 's' }} à vos partenaires ·
                    {{ accountability.totals.responses }} réponse{{ accountability.totals.responses > 1 ? 's' }} ·
                    {{ accountability.totals.resumed }} reprise{{ accountability.totals.resumed > 1 ? 's' }} dans les 72 h
                </p>
                {% for a in accountability.items %}
                    <div class="wr-habit" style="flex-wrap: wrap;">
                        <span><strong>{{ a.label }}</strong> · avec {{ a.partner }}</span>
                        <span style="color: var(--fg-muted); font-size: .85rem;">
                            {% if a.alerts + a.helps == 0 %}Aucun message cette semaine{% else %}{{ a.alerts ? a.alerts ~ ' alerte' ~ (a.alerts > 1 ? 's') }}{{ a.alerts and a.helps ? ', ' }}{{ a.helps ? a.helps ~ ' coup' ~ (a.helps > 1 ? 's') ~ ' de main' }}{% endif %}
                            {% if a.responses is not empty %} · {{ a.responses|join(', ') }}{% endif %}
                        </span>
                        {% for n in a.notes %}<span style="flex-basis: 100%; font-size: .85rem; font-style: italic; color: var(--fg-muted);">« {{ n }} »</span>{% endfor %}
                    </div>
                {% endfor %}
                <p style="margin-top: .8rem; font-size: .9rem;"><strong>Question pour votre revue :</strong> qu'est-ce que vos partenaires ont changé pour vous cette semaine, et de quoi aurez-vous besoin la semaine prochaine ?
                    Vous pouvez y répondre dans « Regarder en arrière ». <a href="{{ path('app_social') }}" style="color: var(--primary); font-weight: 600;">Mes Partenaires de Redevabilité →</a></p>
            </section>
        {% endif %}

        {# 4. Priorités #}
        <section class="wr-card">
            <h2><i data-lucide="target" style="width: 20px; height: 20px;"></i> Mes 3 priorités pour la semaine prochaine</h2>
            <p class="wr-sub">Peu de choses, mais faites profondément.</p>
            {% for i in 0..2 %}
                <div class="wr-field" style="margin-bottom: .6rem;"><input type="text" name="priorities[]" value="{{ review.priorities[i] ?? '' }}" maxlength="255" placeholder="Priorité {{ i + 1 }}" aria-label="Priorité {{ i + 1 }}"></div>
            {% endfor %}
        </section>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('weekly_review') }}">
        <div class="wr-submit"><button type="submit" class="wr-btn">Enregistrer ma revue</button></div>
    </form>

    {% if history|length > 0 %}
        <section class="wr-card" style="margin-top: 2rem;">
            <h2><i data-lucide="history" style="width: 20px; height: 20px;"></i> Mes revues précédentes</h2>
            <div class="wr-history">
                {% for r in history %}
                    <div>
                        <span>Semaine du {{ r.weekStart|format_date(pattern: 'd MMMM y', locale: 'fr') }}</span>
                        <span style="color: var(--fg-muted);">{{ r.averageScore is not null ? (r.averageScore|number_format(1, ',') ~ '/10') : '—' }} · {{ r.items|length }} point{{ r.items|length > 1 ? 's' }} évalué{{ r.items|length > 1 ? 's' }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
