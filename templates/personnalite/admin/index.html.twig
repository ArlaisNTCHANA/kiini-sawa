{% extends 'admin/layout.html.twig' %}

{% block title %}Tests : questions et profils{% endblock %}
{% block page_title %}Tests : questions et profils{% endblock %}
{% block page_lead %}Choisissez un test pour gérer ses questions ou les fiches qui expliquent chaque résultat.{% endblock %}

{% block content %}
<div class="ks-stack">
    <div class="ks-grid">
        {% for type, test in tests %}
            <article class="ks-card">
                <h2 class="ks-card__title"><i data-lucide="sparkles"></i> {{ test.name }}</h2>
                <p class="ks-muted">{{ test.subtitle }}</p>
                <div class="ks-stat-grid" style="grid-template-columns: 1fr 1fr; margin: 1rem 0;">
                    <div class="ks-stat"><div class="ks-stat__value">{{ test.questions }}</div><div class="ks-stat__label">questions</div></div>
                    <div class="ks-stat"><div class="ks-stat__value">{{ test.profiles }}</div><div class="ks-stat__label">profils</div></div>
                </div>
                <div class="ks-toolbar">
                    <a href="{{ path('admin_personality_questions', {type: type|lower}) }}" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="help-circle"></i> Questions</a>
                    <a href="{{ path('admin_personality_profiles', {type: type|lower}) }}" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="file-text"></i> Profils</a>
                </div>
            </article>
        {% endfor %}
    </div>
    <p class="ks-alert ks-alert--info">Les autres tests (personnalité, dons, ennéagramme…) se modifient dans <a href="{{ path('admin_content_index') }}" style="font-weight: 700; color: inherit;">Textes des tests</a>.</p>
</div>
{% endblock %}
