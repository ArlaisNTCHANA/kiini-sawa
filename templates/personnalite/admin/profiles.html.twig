{% extends 'admin/layout.html.twig' %}

{% block title %}Profils de résultat · {{ testMeta.name }}{% endblock %}
{% block page_title %}Profils de résultat · {{ testMeta.name }}{% endblock %}
{% block page_lead %}Les fiches qui expliquent chaque résultat de ce test.{% endblock %}

{% block crumbs %}<span aria-hidden="true">›</span><span aria-current="page">{{ testMeta.name }}</span>{% endblock %}
{% block page_actions %}<button type="button" class="ks-btn ks-btn--primary" onclick="openModal('add-modal')"><i data-lucide="plus"></i> Ajouter un profil de résultat</button>{% endblock %}

{% block stylesheets %}{% include 'personnalite/admin/_editor_styles.html.twig' %}{% endblock %}

{% block content %}

    <div class="profiles-grid">
        {% for p in profiles %}
            <article class="profile-card">
                <div>
                    <div class="profile-card__header">
                        <span class="profile-card__code">{{ p.code }}</span>
                        <span style="font-size: 11px; color: var(--fg-subtle);">N° {{ p.id }}</span>
                    </div>
                    <h2 class="profile-card__title">{{ p.title }}</h2>
                    <div class="profile-card__body">
                        {{ p.description|slice(0, 160) }}{{ p.description|length > 160 ? '...' : '' }}
                    </div>
                    
                    <div class="profile-card__details-indicator">
                        <span class="detail-pill {% if p.strengths %}detail-pill--filled{% endif %}">Forces</span>
                        <span class="detail-pill {% if p.weaknesses %}detail-pill--filled{% endif %}">Faiblesses</span>
                        <span class="detail-pill {% if p.essence %}detail-pill--filled{% endif %}">Essence</span>
                        <span class="detail-pill {% if p.relationships %}detail-pill--filled{% endif %}">Relations</span>
                        <span class="detail-pill {% if p.career %}detail-pill--filled{% endif %}">Carrière</span>
                        <span class="detail-pill {% if p.emotionalDynamics %}detail-pill--filled{% endif %}">Émotions</span>
                        <span class="detail-pill {% if p.growthAxes %}detail-pill--filled{% endif %}">Croissance</span>
                    </div>
                </div>

                <div class="profile-card__actions">
                    <button class="btn btn--secondary" style="padding: 6px 12px; font-size: 12px;"
                        data-id="{{ p.id }}"
                        data-code="{{ p.code }}"
                        data-title="{{ p.title }}"
                        data-description="{{ p.description }}"
                        data-strengths="{{ p.strengths }}"
                        data-weaknesses="{{ p.weaknesses }}"
                        data-essence="{{ p.essence }}"
                        data-relationships="{{ p.relationships }}"
                        data-career="{{ p.career }}"
                        data-emotional-dynamics="{{ p.emotionalDynamics }}"
                        data-growth-axes="{{ p.growthAxes }}"
                        onclick="setupAndOpenEditModal(this)">
                        <i data-lucide="edit-2" style="width: 12px; height: 12px;"></i>
                        Modifier
                    </button>
                    <form action="{{ path('admin_personality_profile_delete', {id: p.id}) }}" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce profil de résultat ?');">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_profile_' ~ p.id) }}">
                        <button type="submit" class="btn btn--danger" style="padding: 6px 12px; font-size: 12px;">
                            <i data-lucide="trash-2" style="width: 12px; height: 12px;"></i>
                            Supprimer
                        </button>
                    </form>
                </div>
            </article>
        {% else %}
            <div style="grid-column: 1 / -1; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 60px; text-align: center; color: var(--fg-subtle); font-style: italic;">
                Aucun profil de résultat n'a été créé pour ce test.
            </div>
        {% endfor %}
    </div>

    {# MODAL AJOUT #}
    <div class="ks-modal" id="add-modal">
        <div class="ks-modal__overlay" onclick="closeModal('add-modal')"></div>
        <div class="ks-modal__container">
            <div class="ks-modal__header">
                <h3 class="ks-modal__title">Ajouter un profil de résultat</h3>
                <button class="ks-modal__close" onclick="closeModal('add-modal')">
                    <i data-lucide="x" style="width: 20px; height: 20px;"></i>
                </button>
            </div>
            <form action="{{ path('admin_personality_profiles', {type: type|lower}) }}" method="POST">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_profile') }}">
                <div class="ks-modal__body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="add-code">Code du profil (ex: INTJ, 5, D, FORCE_1)</label>
                            <input type="text" name="code" id="add-code" class="form-control" placeholder="Entrez le code" required>
                        </div>
                        <div class="form-group">
                            <label for="add-title">Titre du profil (ex. : L'Équilibré, Le Bâtisseur)</label>
                            <input type="text" name="title" id="add-title" class="form-control" placeholder="Entrez le titre" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="add-description">Description globale (explication détaillée)</label>
                        <textarea name="description" id="add-description" rows="4" class="form-control" placeholder="Entrez la description générale du profil..." required></textarea>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="add-strengths">Forces principales</label>
                            <textarea name="strengths" id="add-strengths" rows="3" class="form-control" placeholder="Forces..."></textarea>
                        </div>
                        <div class="form-group">
                            <label for="add-weaknesses">Faiblesses / Pièges</label>
                            <textarea name="weaknesses" id="add-weaknesses" rows="3" class="form-control" placeholder="Faiblesses..."></textarea>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="add-essence">Essence / Motivation profonde</label>
                            <textarea name="essence" id="add-essence" rows="3" class="form-control" placeholder="Essence..."></textarea>
                        </div>
                        <div class="form-group">
                            <label for="add-relationships">Relations / Mode de communication</label>
                            <textarea name="relationships" id="add-relationships" rows="3" class="form-control" placeholder="Relations..."></textarea>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="add-career">Carrière / Style professionnel</label>
                            <textarea name="career" id="add-career" rows="3" class="form-control" placeholder="Carrière..."></textarea>
                        </div>
                        <div class="form-group">
                            <label for="add-emotionalDynamics">Dynamiques émotionnelles</label>
                            <textarea name="emotionalDynamics" id="add-emotionalDynamics" rows="3" class="form-control" placeholder="Dynamiques émotionnelles..."></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="add-growthAxes">Axes de croissance et de développement</label>
                        <textarea name="growthAxes" id="add-growthAxes" rows="3" class="form-control" placeholder="Conseils d'évolution..."></textarea>
                    </div>
                </div>
                <div class="ks-modal__footer">
                    <button type="button" class="btn btn--secondary" onclick="closeModal('add-modal')">Annuler</button>
                    <button type="submit" class="btn btn--primary">Créer le profil</button>
                </div>
            </form>
        </div>
    </div>

    {# MODAL EDITION #}
    <div class="ks-modal" id="edit-modal">
        <div class="ks-modal__overlay" onclick="closeModal('edit-modal')"></div>
        <div class="ks-modal__container">
            <div class="ks-modal__header">
                <h3 class="ks-modal__title">Modifier le profil de résultat</h3>
                <button class="ks-modal__close" onclick="closeModal('edit-modal')">
                    <i data-lucide="x" style="width: 20px; height: 20px;"></i>
                </button>
            </div>
            <form id="edit-form" method="POST">
                <input type="hidden" name="_csrf_token" id="edit-csrf-token">
                <div class="ks-modal__body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="edit-code">Code du profil</label>
                            <input type="text" name="code" id="edit-code" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label for="edit-title">Titre du profil</label>
                            <input type="text" name="title" id="edit-title" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-description">Description globale (explication détaillée)</label>
                        <textarea name="description" id="edit-description" rows="4" class="form-control" required></textarea>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="edit-strengths">Forces principales</label>
                            <textarea name="strengths" id="edit-strengths" rows="3" class="form-control"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="edit-weaknesses">Faiblesses / Pièges</label>
                            <textarea name="weaknesses" id="edit-weaknesses" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="edit-essence">Essence / Motivation profonde</label>
                            <textarea name="essence" id="edit-essence" rows="3" class="form-control"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="edit-relationships">Relations / Mode de communication</label>
                            <textarea name="relationships" id="edit-relationships" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="edit-career">Carrière / Style professionnel</label>
                            <textarea name="career" id="edit-career" rows="3" class="form-control"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="edit-emotionalDynamics">Dynamiques émotionnelles</label>
                            <textarea name="emotionalDynamics" id="edit-emotionalDynamics" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-growthAxes">Axes de croissance et de développement</label>
                        <textarea name="growthAxes" id="edit-growthAxes" rows="3" class="form-control"></textarea>
                    </div>
                </div>
                <div class="ks-modal__footer">
                    <button type="button" class="btn btn--secondary" onclick="closeModal('edit-modal')">Annuler</button>
                    <button type="submit" class="btn btn--primary">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        // Add scroll to top on modal close so body doesn't jump
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function setupAndOpenEditModal(btn) {
            const id = btn.getAttribute('data-id');
            const code = btn.getAttribute('data-code');
            const title = btn.getAttribute('data-title');
            const description = btn.getAttribute('data-description');
            const strengths = btn.getAttribute('data-strengths');
            const weaknesses = btn.getAttribute('data-weaknesses');
            const essence = btn.getAttribute('data-essence');
            const relationships = btn.getAttribute('data-relationships');
            const career = btn.getAttribute('data-career');
            const emotionalDynamics = btn.getAttribute('data-emotional-dynamics');
            const growthAxes = btn.getAttribute('data-growth-axes');

            const form = document.getElementById('edit-form');
            form.action = `/admin/tests/profile/${id}/edit`;

            document.getElementById('edit-code').value = code || '';
            document.getElementById('edit-title').value = title || '';
            document.getElementById('edit-description').value = description || '';
            document.getElementById('edit-strengths').value = strengths || '';
            document.getElementById('edit-weaknesses').value = weaknesses || '';
            document.getElementById('edit-essence').value = essence || '';
            document.getElementById('edit-relationships').value = relationships || '';
            document.getElementById('edit-career').value = career || '';
            document.getElementById('edit-emotionalDynamics').value = emotionalDynamics || '';
            document.getElementById('edit-growthAxes').value = growthAxes || '';

            const token = csrfTokens[id] || '';
            document.getElementById('edit-csrf-token').value = token;

            openModal('edit-modal');
        }

        var csrfTokens = {
            {% for p in profiles %}
                "{{ p.id }}": "{{ csrf_token('edit_profile_' ~ p.id) }}",
            {% endfor %}
        };
    </script>
{% endblock %}
