{% extends 'admin/layout.html.twig' %}

{% block title %}Questions · {{ testMeta.name }}{% endblock %}
{% block page_title %}Questions · {{ testMeta.name }}{% endblock %}
{% block page_lead %}Les questions posées dans ce test et leurs réponses possibles.{% endblock %}

{% block crumbs %}<span aria-hidden="true">›</span><span aria-current="page">{{ testMeta.name }}</span>{% endblock %}
{% block page_actions %}<button type="button" class="ks-btn ks-btn--primary" onclick="openModal('add-modal')"><i data-lucide="plus"></i> Ajouter une question</button>{% endblock %}

{% block stylesheets %}{% include 'personnalite/admin/_editor_styles.html.twig' %}{% endblock %}

{% block content %}

    <div class="questions-card">
        <table class="q-table" id="questions-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Ordre</th>
                    <th style="width: 150px;">Catégorie</th>
                    <th>Question & Réponses</th>
                    <th style="width: 180px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for q in questions %}
                    {% set answers_raw = "" %}
                    {% for ans in q.answers %}
                        {% set answers_raw = answers_raw ~ ans.value ~ "|" ~ ans.text ~ (not loop.last ? "\n" : "") %}
                    {% endfor %}
                    <tr id="question-row-{{ q.id }}">
                        <td>
                            <span class="q-order">{{ q.sortOrder }}</span>
                        </td>
                        <td>
                            {% if q.category %}
                                <span class="q-category">{{ q.category }}</span>
                            {% else %}
                                <span style="color: var(--fg-subtle); font-style: italic; font-size: 12px;">Aucune</span>
                            {% endif %}
                        </td>
                        <td>
                            <div style="font-weight: 600; color: var(--fg); margin-bottom: 8px;">
                                {{ q.question }}
                            </div>
                            <div class="answer-badge-list">
                                {% for ans in q.answers %}
                                    <span class="answer-badge">
                                        <strong>{{ ans.value }}</strong> {{ ans.text }}
                                    </span>
                                {% else %}
                                    <span style="color: var(--fg-subtle); font-size: 12px; font-style: italic;">Aucune réponse configurée</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td>
                            <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                <button class="btn btn--secondary" style="padding: 6px 10px; font-size: 12px;" 
                                    onclick="openEditModal({{ q.id }}, '{{ q.question|escape('js') }}', '{{ q.category|escape('js') }}', {{ q.sortOrder }}, '{{ answers_raw|escape('js') }}')">
                                    <i data-lucide="edit-2" style="width: 12px; height: 12px;"></i>
                                    Modifier
                                </button>
                                <form action="{{ path('admin_personality_question_delete', {id: q.id}) }}" method="POST" style="display: inline-block;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette question ? Cette action est irréversible.');">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_question_' ~ q.id) }}">
                                    <button type="submit" class="btn btn--danger" style="padding: 6px 10px; font-size: 12px;">
                                        <i data-lucide="trash-2" style="width: 12px; height: 12px;"></i>
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" style="text-align: center; padding: 40px; color: var(--fg-subtle); font-style: italic;">
                            Aucune question n'a été ajoutée pour ce test.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# MODAL AJOUT #}
    <div class="ks-modal" id="add-modal">
        <div class="ks-modal__overlay" onclick="closeModal('add-modal')"></div>
        <div class="ks-modal__container">
            <div class="ks-modal__header">
                <h3 class="ks-modal__title">Ajouter une question</h3>
                <button class="ks-modal__close" onclick="closeModal('add-modal')">
                    <i data-lucide="x" style="width: 20px; height: 20px;"></i>
                </button>
            </div>
            <form action="{{ path('admin_personality_questions', {type: type|lower}) }}" method="POST">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('add_question') }}">
                <div class="ks-modal__body">
                    <div class="form-group">
                        <label for="add-question">Texte de la question</label>
                        <textarea name="question" id="add-question" rows="3" class="form-control" placeholder="Entrez la question..." required></textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label for="add-category">Catégorie / Dimension</label>
                            <input type="text" name="category" id="add-category" class="form-control" placeholder="Ex: E/I ou Force">
                        </div>
                        <div class="form-group">
                            <label for="add-sortOrder">Ordre d'affichage</label>
                            <input type="number" name="sortOrder" id="add-sortOrder" class="form-control" value="1" min="1" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="add-answers">Choix de réponses</label>
                        <textarea name="answers" id="add-answers" rows="6" class="form-control" placeholder="valeur|Libellé de la réponse" style="font-family: monospace; font-size: 13px;"></textarea>
                        <p class="form-help">
                            Saisissez un choix de réponse par ligne au format <code>valeur|Libellé de la réponse</code>.<br>
                            Exemple pour un test MBTI :<br>
                            <code>E|Je préfère être en groupe et interagir</code><br>
                            <code>I|Je préfère réfléchir seul dans le calme</code>
                        </p>
                    </div>
                </div>
                <div class="ks-modal__footer">
                    <button type="button" class="btn btn--secondary" onclick="closeModal('add-modal')">Annuler</button>
                    <button type="submit" class="btn btn--primary">Créer la question</button>
                </div>
            </form>
        </div>
    </div>

    {# MODAL EDITION #}
    <div class="ks-modal" id="edit-modal">
        <div class="ks-modal__overlay" onclick="closeModal('edit-modal')"></div>
        <div class="ks-modal__container">
            <div class="ks-modal__header">
                <h3 class="ks-modal__title">Modifier la question</h3>
                <button class="ks-modal__close" onclick="closeModal('edit-modal')">
                    <i data-lucide="x" style="width: 20px; height: 20px;"></i>
                </button>
            </div>
            <form id="edit-form" method="POST">
                <input type="hidden" name="_csrf_token" id="edit-csrf-token">
                <div class="ks-modal__body">
                    <div class="form-group">
                        <label for="edit-question">Texte de la question</label>
                        <textarea name="question" id="edit-question" rows="3" class="form-control" placeholder="Entrez la question..." required></textarea>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label for="edit-category">Catégorie / Dimension</label>
                            <input type="text" name="category" id="edit-category" class="form-control" placeholder="Ex: E/I ou Force">
                        </div>
                        <div class="form-group">
                            <label for="edit-sortOrder">Ordre d'affichage</label>
                            <input type="number" name="sortOrder" id="edit-sortOrder" class="form-control" min="1" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="edit-answers">Choix de réponses</label>
                        <textarea name="answers" id="edit-answers" rows="6" class="form-control" placeholder="valeur|Libellé de la réponse" style="font-family: monospace; font-size: 13px;"></textarea>
                        <p class="form-help">
                            Saisissez un choix de réponse par ligne au format <code>valeur|Libellé de la réponse</code>.
                        </p>
                    </div>
                </div>
                <div class="ks-modal__footer">
                    <button type="button" class="btn btn--secondary" onclick="closeModal('edit-modal')">Annuler</button>
                    <button type="submit" class="btn btn--primary">Enregistrer les modifications</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function openEditModal(id, question, category, sortOrder, answers) {
            const form = document.getElementById('edit-form');
            form.action = `/admin/tests/question/${id}/edit`;
            
            document.getElementById('edit-question').value = question;
            document.getElementById('edit-category').value = category;
            document.getElementById('edit-sortOrder').value = sortOrder;
            document.getElementById('edit-answers').value = answers;
            
            // Build the CSRF token name for editing this specific question
            const csrfTokenElement = document.getElementById('edit-csrf-token');
            // We can retrieve the token from the delete form for safety, or generate it, 
            // but Symfony's isCsrfTokenValid expects 'edit_question_' . $id. We can render the CSRF token dynamically 
            // by passing it or retrieving it using a JS mapper. To make it completely reliable, we will inject 
            // it using Twig in each row's edit button, or render them ahead.
            // Let's pass the token value as well.
            // Let's fetch the edit CSRF token.
            const token = csrfTokens[id] || '';
            csrfTokenElement.value = token;

            openModal('edit-modal');
        }

        // Object containing edit tokens for each question to be accessible by JS
        var csrfTokens = {
            {% for q in questions %}
                "{{ q.id }}": "{{ csrf_token('edit_question_' ~ q.id) }}",
            {% endfor %}
        };
    </script>
{% endblock %}
