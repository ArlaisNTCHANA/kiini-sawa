{% extends 'admin/layout.html.twig' %}

{% block title %}Qualité des tests{% endblock %}
{% block page_title %}Qualité scientifique des tests{% endblock %}
{% block page_lead %}Combien de personnes ont passé chaque test, et si les questions mesurent bien ce qu'elles doivent mesurer.{% endblock %}

{% block content %}
<div class="ks-stack">
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="users"></i> Passations</h2>
        {% if counts is empty %}
            <p class="ks-muted">Aucune passation pour l'instant.</p>
        {% else %}
            <div class="ks-stat-grid" style="margin-top: .75rem;">
                {% for instrument, n in counts %}<div class="ks-stat"><div class="ks-stat__value">{{ n }}</div><div class="ks-stat__label">{{ instrument }}</div></div>{% endfor %}
            </div>
        {% endif %}
        <p class="ks-muted" style="margin-top: 1rem;">
            Percentiles : affichés aux utilisateurs dès {{ minSample }} profils fiables par échelle.
            {% for d, label in domains %}{{ label }} : {{ norms[d].n ?? 0 }}{{ not loop.last ? ' · ' }}{% endfor %}.
        </p>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="gauge"></i> Fidélité (alpha de Cronbach)</h2>
        <p class="ks-muted" style="margin-bottom: 1rem;">Calculée dès 30 réponses complètes par échelle. Repères : ≥ 0,70 bon, 0,60 à 0,70 acceptable pour 4 items, &lt; 0,60 à revoir (traduction ou formulation). Pour l'IPIP, la colonne « Origine » donne l'alpha de l'échantillon anglophone de Johnson (N = 619 150).</p>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Échelle</th><th class="is-num">Réponses</th><th class="is-num">Alpha KIINI SAWA</th><th class="is-num">Origine</th></tr></thead>
                <tbody>
                {% for code, r in reliability %}
                    {% set facet = code starts with 'ipip:' ? code|slice(5) : null %}
                    <tr>
                        <td>{{ facet ? facet ~ ' · ' }}{{ r.label }}</td>
                        <td data-label="Réponses" class="is-num">{{ r.n }}</td>
                        <td data-label="Alpha KIINI SAWA" class="is-num"><strong class="{{ r.alpha is null ? '' : (r.alpha >= 0.7 ? 'ks-text-success' : (r.alpha >= 0.6 ? 'ks-text-warning' : 'ks-text-danger')) }}">{{ r.alpha is null ? '—' : r.alpha|number_format(2, ',') }}</strong></td>
                        <td data-label="Origine" class="is-num ks-small">{{ facet and originalAlpha[facet] is defined ? originalAlpha[facet]|number_format(2, ',') : '—' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Pas encore assez de réponses.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
