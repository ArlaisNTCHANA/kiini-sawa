<style>
    .ct-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px 22px; margin-bottom: 18px; }
    .ct-card h2 { font-size: 15px; margin: 0 0 12px; color: var(--text-primary); }
    .ct-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px 12px; border-radius: var(--radius-sm); text-decoration: none; color: var(--text-primary); border: 1px solid transparent; }
    .ct-row:hover { background: var(--bg-card-hover); border-color: var(--border-active); }
    .ct-meta { font-size: 12px; color: var(--text-secondary); white-space: nowrap; }
    .ct-badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px; background: rgba(245, 158, 11, .15); color: #fbbf24; margin-left: 8px; }
    .ct-note { font-size: 13px; color: var(--text-secondary); line-height: 1.6; }
    .ct-btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: var(--radius-sm); background: var(--accent); color: #fff; border: 0; font: inherit; font-weight: 600; font-size: 13px; cursor: pointer; text-decoration: none; }
    .ct-btn.sec { background: transparent; border: 1px solid var(--border-active); color: var(--text-primary); }
    .ct-field { padding: 16px 0; border-top: 1px solid var(--border); }
    .ct-field label.ct-l { display: block; font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 6px; }
    .ct-field textarea, .ct-field input[type=text], .ct-search { width: 100%; background: var(--bg-input); color: var(--text-primary); border: 1px solid var(--border-active); border-radius: var(--radius-sm); padding: 10px 12px; font: inherit; font-size: 14px; line-height: 1.5; }
    .ct-orig { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
    .ct-orig summary { cursor: pointer; color: var(--text-secondary); }
    .ct-reset { font-size: 12px; color: var(--text-secondary); display: inline-flex; gap: 6px; align-items: center; margin-top: 6px; }
    .ct-sticky { position: sticky; bottom: 0; background: var(--bg-body); padding: 14px 0; border-top: 1px solid var(--border); display: flex; gap: 10px; }
    .ct-crumb { font-size: 13px; color: var(--text-secondary); margin-bottom: 14px; }
    .ct-crumb a { color: var(--accent-light); text-decoration: none; }
</style>
