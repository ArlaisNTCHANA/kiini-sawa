{# Styles communs des pages Questions et Profils (administration des tests) : palette et composants de docs/design.md. #}
<style>
    .btn { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1rem; border-radius: var(--r-md); font: inherit; font-size: .85rem; font-weight: 700; cursor: pointer; border: 1.5px solid transparent; text-decoration: none; white-space: nowrap; }
    .btn svg { width: 15px; height: 15px; }
    .btn--primary { background: var(--primary); color: #fff; }
    .btn--primary:hover { background: var(--primary-dark); }
    .btn--secondary { background: var(--card-bg); color: var(--fg); border-color: var(--border); }
    .btn--secondary:hover { border-color: var(--primary); color: var(--primary); }
    .btn--danger { background: var(--card-bg); color: var(--danger); border-color: var(--danger-soft); }
    .btn--danger:hover { background: var(--danger-soft); }

    .questions-card { background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: .5rem 1rem; overflow-x: auto; }
    .q-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .q-table th { text-align: left; font-size: .72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-muted); padding: .7rem .6rem; border-bottom: 1px solid var(--border); }
    .q-table td { padding: .9rem .6rem; border-top: 1px solid var(--border); vertical-align: top; }
    .q-order { display: inline-flex; width: 2rem; height: 2rem; align-items: center; justify-content: center; border-radius: 50%; background: var(--primary-soft); color: var(--primary-dark); font-weight: 800; font-size: .85rem; }
    .q-category { display: inline-block; font-size: .75rem; font-weight: 700; padding: .2rem .6rem; border-radius: var(--r-full); background: var(--bg-alt); color: var(--fg-light); }
    .answer-badge-list { display: flex; flex-wrap: wrap; gap: .35rem; }
    .answer-badge { font-size: .78rem; padding: .2rem .55rem; border-radius: var(--r-sm); background: var(--bg); border: 1px solid var(--border); color: var(--fg-light); }
    .answer-badge strong { color: var(--primary); margin-right: .2rem; }

    .profiles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
    .profile-card { background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; }
    .profile-card__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
    .profile-card__code { font-size: .72rem; font-weight: 800; letter-spacing: .05em; padding: .2rem .6rem; border-radius: var(--r-full); background: var(--primary-tint); color: var(--primary-dark); }
    .profile-card__title { font-family: var(--font-serif); font-size: 1.15rem; color: var(--fg); margin-bottom: .4rem; }
    .profile-card__body { font-size: .88rem; color: var(--fg-muted); line-height: 1.55; }
    .profile-card__details-indicator { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .8rem; }
    .detail-pill { font-size: .7rem; font-weight: 700; padding: .15rem .5rem; border-radius: var(--r-full); background: var(--bg-alt); color: var(--fg-subtle); }
    .detail-pill--filled { background: var(--success-soft); color: var(--success); }
    .profile-card__actions { display: flex; gap: .5rem; flex-wrap: wrap; }

    .ks-modal { display: none; position: fixed; inset: 0; z-index: 100; align-items: center; justify-content: center; padding: 1rem; }
    .ks-modal.active { display: flex; }
    .ks-modal__overlay { position: absolute; inset: 0; background: rgba(27, 27, 27, .4); }
    .ks-modal__container { position: relative; background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow-hover); width: min(720px, 100%); max-height: calc(100vh - 2rem); display: flex; flex-direction: column; }
    .ks-modal__container form { display: flex; flex-direction: column; min-height: 0; }
    .ks-modal__header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); }
    .ks-modal__title { font-family: var(--font-serif); font-size: 1.2rem; color: var(--primary); }
    .ks-modal__close { border: 0; background: none; color: var(--fg-muted); cursor: pointer; padding: .25rem; }
    .ks-modal__body { padding: 1.25rem; overflow-y: auto; display: flex; flex-direction: column; gap: 1rem; }
    .ks-modal__footer { display: flex; justify-content: flex-end; gap: .5rem; padding: .9rem 1.25rem; border-top: 1px solid var(--border); }
    .form-group label { display: block; font-size: .75rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--fg-muted); margin-bottom: .35rem; }
    .form-control { width: 100%; padding: .65rem .85rem; border: 1.5px solid var(--border); border-radius: var(--r-md); background: var(--card-bg); font: inherit; font-size: .92rem; color: var(--fg); }
    .form-control:focus { outline: none; border-color: var(--primary-light); box-shadow: 0 0 0 3px var(--primary-glow); }
    .form-help { font-size: .78rem; color: var(--fg-muted); margin-top: .35rem; line-height: 1.5; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }

    @media (max-width: 720px) {
        .q-table thead { display: none; }
        .q-table, .q-table tbody, .q-table tr, .q-table td { display: block; width: 100%; }
        .q-table tr { border-top: 1px solid var(--border); padding: .6rem 0; }
        .q-table td { border: 0; padding: .3rem 0; }
        .q-table td > div[style*="justify-content: flex-end"] { justify-content: flex-start !important; }
        .ks-modal { padding: 0; align-items: flex-end; }
        .ks-modal__container { border-radius: var(--r-lg) var(--r-lg) 0 0; max-height: 92vh; }
    }
</style>
