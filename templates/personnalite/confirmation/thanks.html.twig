{% extends 'base.html.twig' %}
{% block title %}{{ t('confirmation.merci.onglet', 'Merci') }}{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' with {minimal: true} %}{% endif %}
{% include 'feedback/_styles.html.twig' %}
<div class="ks-page ks-page--narrow">
    <div class="ks-card ks-empty">
        <div class="ks-empty__icon"><i data-lucide="heart" style="width: 26px; height: 26px;"></i></div>
        <h1 class="ks-empty__title">{{ t('confirmation.merci.titre', 'Merci pour votre regard') }}</h1>
        <p class="ks-empty__text">{{ t('confirmation.merci.texte', 'Votre réponse est bien arrivée. {prenom} la découvrira avec celles des autres proches. Merci pour ce cadeau.', 'text', {prenom: firstName}) }}</p>
    </div>
    {% include 'feedback/_discover.html.twig' with {source: 'confirmation', campaign: 'confirmation-test', content: 'merci'} %}
</div>
{% endblock %}
