{% extends 'base.html.twig' %}

{% block title %}Mon évolution · {{ name }}{% endblock %}

{% block body %}
<div style="max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 8rem; line-height: 1.6;">
    <a href="{{ path('app_test_evolution') }}" style="font-size: .8rem; font-weight: 700; color: var(--fg-muted); text-transform: uppercase; letter-spacing: .05em; text-decoration: none;">← Mon évolution</a>
    <h1 style="font-family: var(--font-serif); color: var(--primary); font-size: 2rem; margin: .4rem 0 .25rem;">{{ name }} : mon évolution</h1>
    <p style="color: var(--fg-muted); margin-bottom: 1.25rem;">{{ entries|length }} passation{{ entries|length > 1 ? 's' }}{% if entries|length %}, de {{ (entries|first).date|format_date(pattern: 'MMMM y', locale: 'fr') }} à {{ (entries|last).date|format_date(pattern: 'MMMM y', locale: 'fr') }}{% endif %}</p>

    {% set card = 'background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem; margin-bottom: 1.25rem;' %}
    {% if not enough %}
        <section style="{{ card }}">
            <h2 style="font-family: var(--font-serif); font-size: 1.3rem;">Une seule passation pour l'instant</h2>
            <p style="color: var(--fg-light);">Repassez ce test dans quelques mois (ou quand votre situation change) pour voir votre évolution ici.</p>
        </section>
    {% else %}
        <section style="{{ card }}">
            <h2 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: .5rem;">Ce qui a changé</h2>
            {% for r in reading %}<p style="margin-bottom: .4rem;">{{ r }}</p>{% endfor %}
        </section>

        {% for c in charts %}
            <section style="{{ card }}">
                <h2 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: .5rem;">{{ c.title }}</h2>
                <img src="{{ c.img }}" alt="{{ c.title }} au fil du temps" style="width: 100%; height: auto;">
            </section>
        {% endfor %}

        {% if rows is defined %}
            <section style="{{ card }}">
                <h2 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: .5rem;">Avant et aujourd'hui</h2>
                <table style="width: 100%; border-collapse: collapse; font-size: .92rem;">
                    <tr style="color: var(--fg-muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em;"><th style="text-align: left; padding: .4rem 0;">Domaine</th><th>Première</th><th>Dernière</th><th>Évolution</th></tr>
                    {% for r in rows %}
                        <tr style="border-top: 1px solid var(--border);">
                            <td style="padding: .5rem 0;"><strong style="color: {{ r.color }};">{{ r.label }}</strong></td>
                            <td style="text-align: center;">{{ r.before|number_format(1, ',', ' ') }}</td>
                            <td style="text-align: center;">{{ r.after|number_format(1, ',', ' ') }}</td>
                            <td style="text-align: center; font-weight: 700; color: {{ r.delta > 0 ? '#16A34A' : (r.delta < 0 ? '#DC2626' : 'var(--fg-muted)') }};">{{ r.delta > 0 ? '+' }}{{ r.delta|number_format(1, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </table>
            </section>
        {% endif %}

        {% if timeline is defined %}
            <section style="{{ card }}">
                <h2 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: .5rem;">Votre parcours</h2>
                {% for t in timeline %}
                    <div style="display: flex; gap: .8rem; align-items: baseline; padding: .5rem 0; border-top: {{ loop.first ? 'none' : '1px solid var(--border)' }};">
                        <span style="min-width: 7rem; color: var(--fg-muted); font-size: .85rem;">{{ t.date|format_date(pattern: 'd MMM y', locale: 'fr') }}</span>
                        <a href="{{ t.url }}" style="color: var(--fg); font-weight: 600; text-decoration: none;">{{ t.label }}</a>
                        {% if t.changed %}<span class="ks-badge" style="font-size: .7rem;">changement</span>{% endif %}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
    {% endif %}

    <section style="{{ card }}">
        <h2 style="font-family: var(--font-serif); font-size: 1.2rem; margin-bottom: .5rem;">Toutes vos passations</h2>
        {% for e in entries|reverse %}
            <a href="{{ e.url }}" style="display: flex; justify-content: space-between; gap: 1rem; padding: .55rem 0; border-top: {{ loop.first ? 'none' : '1px solid var(--border)' }}; color: var(--fg); text-decoration: none;">
                <span><strong>{{ e.date|format_date(pattern: 'd MMMM y', locale: 'fr') }}</strong> · {{ e.label }}</span><span style="color: var(--fg-muted);">→</span>
            </a>
        {% endfor %}
        <p style="font-size: .8rem; color: var(--fg-muted); margin-top: .75rem;">Les résultats de chaque passation sont conservés tels quels ; les textes des rapports, eux, suivent les dernières mises à jour. Les variations peuvent tenir à votre contexte ou à votre état du jour : lisez-les avec recul.</p>
    </section>
</div>
{% endblock %}
