{% extends 'base.html.twig' %}

{% block title %}{{ testMeta.name }} : mes résultats{% endblock %}

{% block body %}
<div style="max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 8rem; line-height: 1.6;">
    <a href="{{ path('app_personality_index') }}" style="font-size: .8rem; font-weight: 700; color: var(--fg-muted); text-transform: uppercase; letter-spacing: .05em; text-decoration: none;">← Mes tests</a>
    <h1 style="font-family: var(--font-serif); color: {{ testMeta.color }}; font-size: 2rem; margin: .4rem 0 .25rem;">{{ testMeta.name }}</h1>
    <p style="color: var(--fg-muted); margin-bottom: 1.25rem;">Passé le {{ test.date|format_date(pattern: 'd MMMM y', locale: 'fr') }} · {{ testMeta.level }}</p>
    <div style="display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        {% if is_pro() %}
            <a href="{{ path('app_personality_result_pdf', {type: type|lower, id: test.id}) }}" data-turbo="false" class="ks-btn ks-btn--primary">Télécharger le rapport PDF</a>
        {% else %}
            <a href="{{ path('app_subscription', {fonction: 'test_pdf'}) }}" class="ks-btn ks-btn--secondary">Rapport PDF · PRO</a>
        {% endif %}
        <a href="{{ path('app_personality_take', {type: type|lower}) }}" class="ks-btn ks-btn--secondary">Refaire l'évaluation</a>
    </div>
    {% include template with {pdf: false, name: app.user.displayName} %}
    {% include 'personnalite/_history.html.twig' with {currentUrl: '/mes-tests/' ~ type|lower ~ '/resultats/' ~ test.id} %}
</div>
{% endblock %}
