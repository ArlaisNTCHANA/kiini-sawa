{% extends 'base.html.twig' %}

{% block title %}{{ instrument.name }} : mes résultats{% endblock %}

{% block body %}
<style>
    .r-wrap { max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 8rem; line-height: 1.6; }
    .r-section { background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem; margin-bottom: 1.25rem; }
    .r-section h2 { font-family: var(--font-serif); color: var(--fg); font-size: 1.3rem; margin-bottom: .6rem; }
    .r-section p { margin-bottom: .5rem; }
    .r-section ul { padding-left: 1.2rem; }
</style>
<div class="r-wrap">
    <a href="{{ path('app_personality_index') }}" style="font-size: .8rem; font-weight: 700; color: var(--fg-muted); text-transform: uppercase; letter-spacing: .05em; text-decoration: none;">← Mes tests</a>
    <h1 style="font-family: var(--font-serif); color: {{ instrument.color }}; font-size: 2rem; margin: .4rem 0 .25rem;">{{ instrument.name }}</h1>
    <p style="color: var(--fg-muted); margin-bottom: 1.25rem;">Passé le {{ assessment.takenAt|format_date(pattern: 'd MMMM y', locale: 'fr') }} · {{ instrument.level }}</p>
    <div style="display: flex; gap: .6rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
        <a href="{{ path('app_assessment_report_pdf', {id: assessment.id}) }}" data-turbo="false" style="padding: .65rem 1.1rem; border-radius: var(--r-md); background: var(--primary); color: #fff; font-weight: 700; text-decoration: none;">Télécharger le rapport PDF</a>
        <a href="{{ path('app_assessment_take', {slug: slug}) }}" style="padding: .65rem 1.1rem; border-radius: var(--r-md); background: var(--bg-alt); color: var(--fg); font-weight: 600; text-decoration: none;">Repasser le test</a>
    </div>
    {{ book_panel('personnalite') }}
    {% if slug == 'disc' %}
        {% include 'personnalite/assessment/disc/_report.html.twig' with {pdf: false, name: app.user.displayName} %}
    {% else %}
        {% include 'personnalite/assessment/_report_body.html.twig' %}
    {% endif %}

    {# Partage : décidé par l'utilisateur ; seule la carte (prénom + résultat principal) devient publique #}
    {% set shareUrl = assessment.shareToken ? url('app_shared_result', {token: assessment.shareToken}) ~ '?utm_source=partage-test&utm_medium=partage&utm_campaign=test-' ~ slug : null %}
    <section class="r-section" id="partage" x-data="shareCard()" data-kicker="{{ shareCard.kicker }}" data-title="{{ shareCard.title }}" data-desc="{{ shareCard.desc }}" data-name="{{ app.user.displayName }}">
        <h2>Partager mon résultat</h2>
        {% if not assessment.shareToken %}
            <p>Montrez votre résultat à vos proches et invitez-les à découvrir le leur. Seuls votre <strong>prénom</strong> et votre <strong>résultat principal</strong> ({{ shareCard.title }}) seront visibles ; votre rapport détaillé reste privé.</p>
            <form method="post" action="{{ path('app_assessment_report_share', {id: assessment.id}) }}" style="margin-top: .75rem;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('assessment_share') }}">
                <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="share-2"></i> Partager mon résultat</button>
            </form>
        {% else %}
            <canvas x-ref="canvas" width="1080" height="1350" style="width: 100%; max-width: 320px; border-radius: 16px; display: block; margin: .5rem 0 1rem; box-shadow: var(--card-shadow);"></canvas>
            <div style="display: flex; gap: .6rem; flex-wrap: wrap;">
                <button type="button" class="ks-btn ks-btn--primary" @click="shareImage('{{ shareUrl|e('js') }}')"><i data-lucide="image"></i> Partager l'image</button>
                <a class="ks-btn ks-btn--secondary" style="color: #128C7E;" target="_blank" rel="noopener" href="https://wa.me/?text={{ ('Mon résultat KIINI SAWA : ' ~ shareCard.title ~ '. Et toi, quel est le tien ? ' ~ shareUrl)|url_encode }}"><i data-lucide="message-circle"></i> WhatsApp</a>
                <button type="button" class="ks-btn ks-btn--secondary" @click="navigator.clipboard.writeText('{{ shareUrl|e('js') }}'); copied = true; setTimeout(() => copied = false, 2000)"><i data-lucide="link"></i> <span x-text="copied ? 'Lien copié ✓' : 'Copier le lien'">Copier le lien</span></button>
            </div>
            <form method="post" action="{{ path('app_assessment_report_share', {id: assessment.id}) }}" style="margin-top: .75rem;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('assessment_share') }}">
                <input type="hidden" name="action" value="stop">
                <button type="submit" class="ks-btn ks-btn--ghost" style="padding-left: 0;">Arrêter le partage</button>
            </form>
        {% endif %}
    </section>
    <script>
    function shareCard() {
        return {
            copied: false,
            init() { if (this.$refs.canvas) { document.fonts.ready.then(() => this.draw()); } },
            draw() {
                const c = this.$refs.canvas, x = c.getContext('2d'), d = this.$root.dataset, W = c.width, H = c.height;
                const g = x.createLinearGradient(0, 0, W, H); g.addColorStop(0, '#134E4A'); g.addColorStop(1, '#0F766E');
                x.fillStyle = g; x.fillRect(0, 0, W, H);
                x.fillStyle = 'rgba(255,255,255,.9)'; x.font = '600 44px "Playfair Display", Georgia, serif'; x.fillText('KIINI SAWA', 90, 140);
                x.fillStyle = '#F59E0B'; x.fillRect(90, 170, 120, 8);
                x.fillStyle = '#CCFBF1'; x.font = '700 40px Inter, sans-serif'; x.fillText(d.kicker.toUpperCase(), 90, 420);
                x.fillStyle = '#FFFFFF'; x.font = '600 96px "Playfair Display", Georgia, serif';
                let y = this.wrap(x, d.title, 90, 540, W - 180, 110);
                x.fillStyle = 'rgba(255,255,255,.85)'; x.font = '400 40px Inter, sans-serif';
                y = this.wrap(x, d.desc, 90, y + 70, W - 180, 58, 6);
                x.fillStyle = 'rgba(255,255,255,.95)'; x.font = '600 42px Inter, sans-serif'; x.fillText(d.name, 90, H - 230);
                x.fillStyle = '#CCFBF1'; x.font = '400 36px Inter, sans-serif'; x.fillText('Et toi ? Fais le test sur app.kiinisawa.com', 90, H - 160);
            },
            wrap(x, text, left, top, maxW, lh, maxLines = 4) {
                const words = (text || '').split(' '); let line = '', y = top, n = 0;
                for (const w of words) {
                    const t = line ? line + ' ' + w : w;
                    if (x.measureText(t).width > maxW && line) { x.fillText(line, left, y); y += lh; line = w; if (++n >= maxLines - 1) { line += '…'; break; } }
                    else line = t;
                }
                if (line) x.fillText(line, left, y);
                return y;
            },
            async shareImage(url) {
                const blob = await new Promise(r => this.$refs.canvas.toBlob(r, 'image/png'));
                const file = new File([blob], 'mon-resultat-kiini-sawa.png', { type: 'image/png' });
                if (navigator.canShare && navigator.canShare({ files: [file] })) {
                    try { await navigator.share({ files: [file], text: 'Et toi, quel est ton résultat ? ' + url }); } catch (e) {}
                } else {
                    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = file.name; a.click();
                }
            },
        };
    }
    </script>
    <p style="font-size: .78rem; color: var(--fg-muted);">Ce rapport est un outil de connaissance de soi, pas un diagnostic. {% if slug in ['profil-complet', 'big-five', 'type', 'style'] %}Questions : International Personality Item Pool (IPIP-NEO, Johnson 2014, domaine public). Le type de fonctionnement s'inspire de la typologie de Carl Jung (popularisée par le MBTI®) et le style du modèle DISC de William Marston ; KIINI SAWA n'est affilié à aucune de ces marques.{% endif %}</p>
</div>
{% endblock %}
