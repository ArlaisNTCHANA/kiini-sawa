{# Corps du rapport, commun à l'écran et au PDF (styles simples, compatibles Dompdf). #}
{% macro bar(score, color) %}
    <div style="background: #E2E8F0; border-radius: 4px; height: 8px; width: 100%;"><div style="background: {{ color }}; height: 8px; border-radius: 4px; width: {{ max(2, score) }}%;"></div></div>
{% endmacro %}
{% set color = instrument.color %}

{% if quality.warnings is defined and quality.warnings|length %}
    <div style="background: #FEF3C7; border: 1px solid #FDE68A; color: #92400E; border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px;">
        {% for w in quality.warnings %}<div>⚠ {{ w }}</div>{% endfor %}
    </div>
{% endif %}

{# ── DISC (questionnaire à choix forcé) ─────────────────── #}
{% if disc is defined %}
    {% set p = disc.profile %}
    {% set th = 'padding: 6px 8px; text-align: left; font-size: 12px; color: #64748B; border-bottom: 1px solid #E2E8F0;' %}
    {% set td = 'padding: 7px 8px; font-size: 13px; vertical-align: top; border-bottom: 1px solid #F1F5F9;' %}
    <div class="r-section">
        <h2>Votre profil : {{ p.name }}{% if disc.secondaryProfile %} – {{ disc.secondaryProfile.name }}{% endif %}{% if disc.combo %} · {{ disc.combo.name }}{% endif %}</h2>
        <p style="font-size: 15px;">{{ disc.combo ? disc.combo.desc : p.essence }}</p>
        <p style="font-size: 13px; color: #475569;">Votre question réflexe : <strong>« {{ p.question }} »</strong> · {{ p.axis }}.</p>
    </div>

    <div class="r-section">
        <h2>Profil naturel et profil adapté</h2>
        <p style="font-size: 13px; color: #475569;">Le <strong>profil naturel</strong> est votre façon spontanée d'agir, quand rien ne vous contraint. Le <strong>profil adapté</strong> est celle que vous adoptez en ce moment pour répondre à votre contexte (travail, famille, Église).</p>
        <table style="width: 100%; border-collapse: collapse; margin: 8px 0;">
            <tr><th style="{{ th }} width: 26%;">Dimension</th><th style="{{ th }}">Naturel</th><th style="{{ th }}">Adapté</th></tr>
            {% for l, prof in disc.profiles %}
                <tr>
                    <td style="{{ td }}"><strong style="color: {{ prof.color }};">{{ l }}</strong> · {{ prof.name }}</td>
                    <td style="{{ td }}">{{ _self.bar(min(100, disc.natural[l] * 2), prof.color) }}<span style="font-size: 11px; color: #64748B;">{{ disc.natural[l] }} %</span></td>
                    <td style="{{ td }}">{{ _self.bar(min(100, disc.adapted[l] * 2), '#94A3B8') }}<span style="font-size: 11px; color: #64748B;">{{ disc.adapted[l] }} %</span></td>
                </tr>
            {% endfor %}
        </table>
        <div style="background: #F8FAFC; border-radius: 10px; padding: 10px 14px; margin-top: 8px;">
            <p style="margin: 0 0 4px;"><strong>{{ disc.gapReading[0] }}</strong> (écart de {{ disc.gap }} points)</p>
            <p style="margin: 0; font-size: 13px;">{{ disc.gapReading[1] }}</p>
            {% if disc.more|length %}<p style="margin: 6px 0 0; font-size: 13px;">Votre contexte vous demande de {{ disc.more|join(', ') }}.</p>{% endif %}
            {% if disc.less|length %}<p style="margin: 4px 0 0; font-size: 13px;">Vous mettez en retrait une partie de votre côté {{ disc.less|join(', ')|lower }}.</p>{% endif %}
            {% if disc.adaptedPrimary != disc.primary %}<p style="margin: 4px 0 0; font-size: 13px;">En contexte, on vous voit surtout <strong>{{ disc.adaptedProfile.name }}</strong> : les autres ne connaissent peut-être pas votre nature {{ p.name|lower }}.</p>{% endif %}
        </div>
    </div>

    <div class="r-section" style="page-break-inside: avoid;">
        <h2>La fiche du profil {{ p.name }} <span style="font-weight: normal; font-size: 14px; color: #64748B;">({{ p.colorName }})</span></h2>
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="{{ td }} width: 50%;"><strong>Vos forces</strong><br>{{ p.strengths|join(' · ') }}</td>
                <td style="{{ td }}"><strong>Vos points de vigilance</strong><br>{{ p.watch|join(' · ') }}</td>
            </tr>
            <tr>
                <td style="{{ td }}"><strong>Votre crainte principale</strong><br>{{ p.fear }}</td>
                <td style="{{ td }}"><strong>Vos besoins</strong><br>{{ p.needs|join(' · ') }}</td>
            </tr>
        </table>
        {% if disc.secondaryProfile %}
            <p style="font-size: 13px; color: #475569; margin-top: 8px;">Votre dimension secondaire, <strong>{{ disc.secondaryProfile.name }}</strong>, ajoute : {{ disc.secondaryProfile.strengths|join(', ')|lower }}.</p>
        {% endif %}
    </div>

    <div class="r-section" style="page-break-inside: avoid;">
        <h2>Sous pression</h2>
        <table style="width: 100%; border-collapse: collapse;">
            <tr><td style="{{ td }} width: 34%;"><strong>Quand vous vous adaptez</strong></td><td style="{{ td }}">{{ p.pressure.adapted }}</td></tr>
            <tr><td style="{{ td }}"><strong>Votre réflexe naturel</strong></td><td style="{{ td }}">{{ p.pressure.natural }}</td></tr>
            <tr><td style="{{ td }}"><strong>Sous tension durable</strong></td><td style="{{ td }}">{{ p.pressure.tension }}</td></tr>
            <tr><td style="{{ td }}"><strong>Dans un désaccord</strong></td><td style="{{ td }}">{{ p.disagree }}</td></tr>
            <tr><td style="{{ td }}"><strong>Pour grandir</strong></td><td style="{{ td }}">{{ p.grow }}</td></tr>
        </table>
    </div>

    <div class="r-section">
        <h2>Comment les autres vous perçoivent</h2>
        <p style="font-size: 13px; color: #475569;">Chaque profil voit le monde depuis sa propre question. Voici ce que vous percevez chez les autres, et ce qu'ils perçoivent de vous.</p>
        <table style="width: 100%; border-collapse: collapse;">
            <tr><th style="{{ th }} width: 18%;">Avec un…</th><th style="{{ th }}">Vous percevez</th><th style="{{ th }}">Il vous perçoit</th><th style="{{ th }}">Point de friction</th></tr>
            {% for l, o in disc.others %}
                <tr>
                    <td style="{{ td }}"><strong style="color: {{ o.profile.color }};">{{ l }}</strong> · {{ o.profile.name }}</td>
                    <td style="{{ td }}">{{ o.perception[0] }}</td>
                    <td style="{{ td }}">{{ o.perception[1] }}</td>
                    <td style="{{ td }} color: #64748B;">{{ o.perception[2] }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>

    <div class="r-section">
        <h2>Interagir avec chaque profil</h2>
        <table style="width: 100%; border-collapse: collapse;">
            <tr><th style="{{ th }} width: 18%;">Avec un…</th><th style="{{ th }}">De votre côté</th><th style="{{ th }}">Ce que vous pouvez lui demander</th></tr>
            {% for l, o in disc.others %}
                <tr>
                    <td style="{{ td }}"><strong style="color: {{ o.profile.color }};">{{ l }}</strong> · {{ o.profile.name }}</td>
                    <td style="{{ td }}">{{ o.interaction[0] }}</td>
                    <td style="{{ td }}">{{ o.interaction[1] }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>

    <div class="r-section" style="page-break-inside: avoid;">
        <h2>Reconnaître le profil des autres</h2>
        <p style="font-size: 13px; color: #475569;">Quelques indices observables. Un indice seul ne suffit pas : cherchez-en plusieurs, et vérifiez en écoutant.</p>
        <table style="width: 100%; border-collapse: collapse;">
            <tr><th style="{{ th }}">Indice</th>{% for l, prof in disc.profiles %}<th style="{{ th }} color: {{ prof.color }};">{{ l }} · {{ prof.name }}</th>{% endfor %}</tr>
            {% for key, label in {question: 'Sa question', speech: 'Débit', gesture: 'Gestuelle', mail: 'Ses mails', stress: 'Sous pression'} %}
                <tr><td style="{{ td }}"><strong>{{ label }}</strong></td>
                    {% for l, prof in disc.profiles %}<td style="{{ td }}">{{ key == 'question' ? prof.question : prof.cues[key] }}</td>{% endfor %}
                </tr>
            {% endfor %}
        </table>
    </div>

    <div class="r-section">
        <p style="font-size: 13px;">« Nous avons plusieurs membres dans un seul corps, et tous les membres n'ont pas la même fonction » (Romains 12.4). Aucun profil n'est meilleur qu'un autre : chacun est une manière d'agir, que l'on peut ajuster par amour pour les autres.</p>
        <p style="font-size: 12px; color: #64748B;">Le DISC décrit des comportements observables, pas la valeur d'une personne ni ses compétences. Outil de connaissance de soi issu du modèle de William Marston (1928) ; questionnaire et textes propres à KIINI SAWA. Le profil adapté change avec votre contexte : refaites le test quand votre situation évolue.</p>
    </div>
{% endif %}

{# ── Type de fonctionnement ─────────────────────────────── #}
{% if type is defined and type %}
    <div class="r-section">
        <h2>Votre type de fonctionnement : {{ type.code }} · {{ type.name }}</h2>
        <p style="font-size: 15px;">{{ type.desc }}</p>
        <table style="width: 100%; border-collapse: collapse; margin-top: 8px;">
            {% for axis in type.axes %}
                <tr><td style="padding: 6px 0; width: 46%; font-size: 13px;">{{ axis.text }}</td>
                    <td style="padding: 6px 8px;">{{ _self.bar(axis.clarity, '#6366F1') }}</td>
                    <td style="padding: 6px 0; width: 90px; font-size: 12px; color: #64748B;">netteté {{ axis.clarity }}/100</td></tr>
            {% endfor %}
        </table>
        <p style="font-size: 12px; color: #64748B;">Une préférence peu nette (moins de 20) signifie que vous êtes à l'aise des deux côtés : c'est une richesse, pas une indécision.</p>
    </div>
{% endif %}

{# ── Style comportemental ───────────────────────────────── #}
{% if style is defined and style %}
    <div class="r-section">
        <h2>Votre style comportemental : {{ style.profile.name }}{% if style.secondaryProfile %} et {{ style.secondaryProfile.name }}{% endif %}</h2>
        <p>{{ style.profile.essence }}</p>
        <table style="width: 100%; border-collapse: collapse; margin: 8px 0;">
            {% for key, s in style.scores %}
                <tr><td style="padding: 5px 0; width: 30%; font-size: 13px;"><strong>{{ key }}</strong> · {{ constant('App\\Personnalite\\Psychometrie\\Interpretations::STYLES')[key].name }}</td>
                    <td style="padding: 5px 8px;">{{ _self.bar(s, '#F43F5E') }}</td><td style="width: 40px; font-size: 12px; color: #64748B;">{{ s|round }}</td></tr>
            {% endfor %}
        </table>
        <p><strong>Vos forces :</strong> {{ style.profile.strengths }}</p>
        <p><strong>Points de vigilance :</strong> {{ style.profile.watch }}</p>
        <p><strong>Pour bien communiquer avec vous :</strong> {{ style.profile.communicate }}</p>
    </div>
{% endif %}

{# ── Big Five ───────────────────────────────────────────── #}
{% if domains is defined and domains|length %}
    <div class="r-section">
        <h2>Vos cinq grandes dimensions</h2>
        <p style="font-size: 12px; color: #64748B;">{% if normsAvailable %}Le percentile indique votre position par rapport aux utilisateurs de KIINI SAWA (50 = la moyenne).{% else %}Scores de 0 à 100. La comparaison avec la population (percentiles) apparaîtra dès que suffisamment de personnes auront répondu.{% endif %}</p>
        {% for d, dom in domains %}
            <div style="margin: 14px 0 6px; page-break-inside: avoid;">
                <table style="width: 100%; border-collapse: collapse;"><tr>
                    <td style="width: 34%; font-weight: bold; font-size: 15px;">{{ dom.label }}</td>
                    <td style="padding: 0 8px;">{{ _self.bar(dom.percentile ?? dom.score, color) }}</td>
                    <td style="width: 90px; font-size: 12px; color: #64748B;">{{ dom.percentile is not null ? dom.percentile ~ 'e percentile' : dom.score|round ~ '/100' }}</td>
                </tr></table>
                <p style="font-size: 12px; color: #64748B; margin: 4px 0;">{{ dom.what }}</p>
                <p style="margin: 4px 0 8px;">{{ dom.text }}</p>
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    {% for f in dom.facets %}
                        <tr><td style="padding: 3px 0; width: 30%;">{{ f.label }}</td>
                            <td style="padding: 3px 8px; width: 30%;">{{ _self.bar(f.percentile ?? f.score, color) }}</td>
                            <td style="padding: 3px 0; color: #475569;">{{ f.text ?? '' }}</td></tr>
                    {% endfor %}
                </table>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% if strengths is defined and strengths|length %}
    <div class="r-section">
        <h2>Vos points d'appui</h2>
        <ul>{% for f in strengths %}<li><strong>{{ f.label }}</strong> : {{ f.text }}</li>{% endfor %}</ul>
    </div>
{% endif %}
{% if vigilance is defined and vigilance|length %}
    <div class="r-section">
        <h2>Vos terrains de croissance</h2>
        <ul>{% for f in vigilance %}<li><strong>{{ f.label }}</strong> : {{ f.text }}</li>{% endfor %}</ul>
        <p style="font-size: 12px; color: #64748B;">Ces pistes peuvent nourrir votre Plan de Croissance (axe Caractère & Conviction) et votre Plan d'Hygiène de Vie.</p>
    </div>
{% endif %}

{# ── Ennéagramme ────────────────────────────────────────── #}
{% if enneagram is defined %}
    {% set p = enneagram.profile %}
    <div class="r-section">
        <h2>Type {{ enneagram.type }} · {{ p.name }} <span style="font-weight: normal; font-size: 14px; color: #64748B;">(aile {{ enneagram.wing }} · {{ enneagram.wingProfile.name }})</span></h2>
        <p><strong>Ce qui vous motive :</strong> {{ p.motivation }}</p>
        <p><strong>Ce que vous craignez :</strong> {{ p.fear }}</p>
        <p><strong>Votre don :</strong> {{ p.gift }}</p>
        <p><strong>Votre vigilance :</strong> {{ p.watch }}</p>
        <p><strong>Votre chemin de croissance :</strong> {{ p.growth }}</p>
        {% if enneagram.clarity < 8 %}<p style="font-size: 12px; color: #92400E;">Plusieurs types sont proches dans vos réponses : lisez aussi les profils suivants et retenez celui dont la peur profonde vous parle le plus.</p>{% endif %}
        <table style="width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px;">
            {% for t, b in enneagram.bars %}
                <tr><td style="padding: 3px 0; width: 38%;">{{ t }} · {{ b.name }}</td><td style="padding: 3px 8px;">{{ _self.bar(b.score, '#F59E0B') }}</td><td style="width: 40px; color: #64748B;">{{ b.score|round }}</td></tr>
            {% endfor %}
        </table>
    </div>
{% endif %}

{# ── Dons spirituels ────────────────────────────────────── #}
{% if gifts is defined %}
    <div class="r-section">
        <h2>Vos dons les plus marqués</h2>
        {% for g in gifts.top %}
            <div style="margin-bottom: 10px; page-break-inside: avoid;">
                <p style="margin: 0;"><strong>{{ g.name }}</strong> <span style="color: #64748B; font-size: 12px;">({{ g.ref }})</span></p>
                <p style="margin: 2px 0;">{{ g.desc }}</p>
                <p style="margin: 2px 0; font-size: 13px; color: #475569;">Pistes de service : {{ g.serve }}</p>
            </div>
        {% endfor %}
        <p style="font-size: 12px; color: #64748B;">Un don se confirme dans l'expérience et par la communauté : servez, demandez un retour à vos responsables, et reprenez ce test dans quelques mois.</p>
        <table style="width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 13px;">
            {% for code, b in gifts.bars %}
                <tr><td style="padding: 3px 0; width: 30%;">{{ b.name }}</td><td style="padding: 3px 8px;">{{ _self.bar(b.score, '#B45309') }}</td><td style="width: 40px; color: #64748B;">{{ b.score|round }}</td></tr>
            {% endfor %}
        </table>
    </div>
{% endif %}
