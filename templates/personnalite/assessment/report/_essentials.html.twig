{#
  « L'essentiel en une page » + sommaire, juste après la page de garde.
  Variables : pdf, pc, pcLight, pcDark, kicker, headline, tagline, chart (data URI), chartAlt, strengths (liste), watch (liste),
  action (texte), toc (liste de titres de sections).
#}
<div class="dr-page">
    {# Avertissement de qualité (réponses trop rapides…) : une seule fois, ici, pour ne pas créer de page presque vide dans le PDF #}
    {% if quality.warnings is defined and quality.warnings|length %}
        <div style="background: #FEF3C7; border: 1px solid #FDE68A; color: #92400E; border-radius: 12px; padding: 10px 14px; margin: {{ pdf ? '0 0 4mm' : '0 0 18px' }}; font-size: 13px;" data-quality-warning>
            {% for w in quality.warnings %}<div>{{ report_icon('alert', '#B45309') }}{{ w }}</div>{% endfor %}
        </div>
    {% endif %}
    <div class="dr-kicker">L'essentiel en une page</div>
    <h2>{{ headline }}</h2>
    <p class="dr-lead">{{ tagline }}</p>
    <table class="dr-grid"><tr>
        <td style="width: 46%;">
            {% if chart %}<img class="dr-img" src="{{ chart }}" alt="{{ chartAlt|default('Schéma') }}">{% endif %}
        </td>
        <td>
            <div class="dr-tile" style="background: #F0FDF4; border-color: #BBF7D0; margin-bottom: 10px;">
                <div class="dr-label" style="color: #166534;">{{ report_icon('check', '#16A34A') }}Vos atouts</div>
                <ul>{% for x in strengths %}<li>{{ x }}</li>{% endfor %}</ul>
            </div>
            <div class="dr-tile" style="background: #FFF7ED; border-color: #FED7AA; margin-bottom: 10px;">
                <div class="dr-label" style="color: #9A3412;">{{ report_icon('alert', '#EA580C') }}À surveiller</div>
                <ul>{% for x in watch %}<li>{{ x }}</li>{% endfor %}</ul>
            </div>
            <div class="dr-tile" style="background: {{ pcLight }}; border-color: {{ pcLight }};">
                <div class="dr-label" style="color: {{ pcDark }};">{{ report_icon('target', pcDark) }}Votre premier pas</div>
                <p style="margin: 0; color: {{ pcDark }};">{{ action }}</p>
            </div>
        </td>
    </tr></table>
    <div style="margin-top: 14px; border-top: 1px solid #E2E8F0; padding-top: 12px;">
        <div class="dr-label">{{ report_icon('book', '#64748B') }}Dans ce rapport</div>
        <table style="width: 100%; border-collapse: collapse;">
            {% for row in toc|batch(2) %}
                <tr>{% for t in row %}<td style="width: 50%; padding: 4px 0; font-size: {{ pdf ? '9pt' : '.88rem' }}; color: #334155;"><strong style="color: {{ pc }};">{{ '%02d'|format(loop.parent.loop.index0 * 2 + loop.index) }}</strong>&nbsp;&nbsp;{{ t }}</td>{% endfor %}</tr>
            {% endfor %}
        </table>
    </div>
</div>
