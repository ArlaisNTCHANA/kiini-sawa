{# Fiche d'un personnage biblique (BiblicalFigures). Variables : fig, why, pdf, pc. Écran : portrait complet repliable ; PDF : déplié. #}
{% set serif = pdf ? "'Playfair Display', serif" : 'var(--font-serif)' %}
{% macro body(fig, pdf, pc, serif) %}
    <p style="margin: 8px 0;">{{ fig.who }}</p>

    <div class="dr-label" style="margin-top: 12px; color: {{ pc }};">Dans le texte</div>
    {% for e in fig.episodes %}
        <div style="margin: 0 0 8px; page-break-inside: avoid;">
            <div><strong>{{ e.title }}</strong> <span class="dr-small">· {{ e.ref }}</span></div>
            <p style="margin: 2px 0 4px;">{{ e.text }}</p>
            {% if e.quote is defined %}
                <div class="dr-quote" style="padding: 8px 14px; margin: 0 0 4px; font-size: {{ pdf ? '9.5pt' : '.95rem' }};">« {{ e.quote.text }} »<div style="font-style: normal; font-weight: bold; font-size: {{ pdf ? '8pt' : '.8rem' }}; margin-top: 2px;">{{ e.quote.ref }} (LSG)</div></div>
            {% endif %}
        </div>
    {% endfor %}

    <div class="dr-tile" style="margin-top: 10px; background: #F1F5F9; border-color: #E2E8F0; page-break-inside: avoid;">
        <div class="dr-label">Notre lecture : ce n'est pas celle du texte</div>
        <p style="margin: 0 0 6px;">{{ fig.reading.temperament }}</p>
        <table class="dr-table">
            <tr><th>Ce que nous y lisons</th><th>Où le texte le montre</th></tr>
            {% for t in fig.reading.traits %}<tr><td>{{ t[0] }}</td><td class="dr-small">{{ t[1] }}</td></tr>{% endfor %}
        </table>
    </div>

    <div class="dr-tile" style="margin-top: 8px; background: #FFF7ED; border-color: #FED7AA; page-break-inside: avoid;">
        <div class="dr-label" style="color: #9A3412;">Là où il est fragile</div>
        <p style="margin: 0;">{{ fig.weakness }}</p>
    </div>

    <div class="dr-tile" style="margin-top: 8px; background: #F0FDF4; border-color: #BBF7D0; page-break-inside: avoid;">
        <div class="dr-label" style="color: #166534;">Comment Dieu le relève</div>
        <p style="margin: 0;">{{ fig.grace }}</p>
    </div>

    <div class="dr-tile" style="margin-top: 8px; background: #DCE7DF; border-color: #DCE7DF; page-break-inside: avoid;">
        <div class="dr-label" style="color: #173D2E;">Le Christ au centre</div>
        <p style="margin: 0 0 6px; color: #173D2E;">{{ fig.christ }}</p>
        {% for q in fig.quotes %}<div class="dr-small" style="color: #173D2E;">« {{ q.text }} » <strong>{{ q.ref }} (LSG)</strong></div>{% endfor %}
    </div>

    <div class="dr-tile" style="margin-top: 8px; background: #fff; page-break-inside: avoid;">
        <div class="dr-label">Pour vous</div>
        <p style="margin: 0 0 4px; font-family: {{ serif }}; font-size: {{ pdf ? '11pt' : '1.05rem' }};">{{ fig.question }}</p>
        <p class="dr-small" style="margin: 0; color: #334155;"><strong>Un pas :</strong> {{ fig.step }}</p>
    </div>
    {% if not fig.reviewed %}<p class="dr-small" style="margin: 6px 0 0;">Fiche en cours de relecture.</p>{% endif %}
{% endmacro %}

<div style="margin-bottom: 14px; border-left: 6px solid {{ pc }}; border-radius: 0 14px 14px 0; background: #fff; padding: {{ pdf ? '10px 14px' : '16px 18px' }}; border-top: 1px solid #E2E8F0; border-right: 1px solid #E2E8F0; border-bottom: 1px solid #E2E8F0;">
    <div style="font-family: {{ serif }}; font-size: {{ pdf ? '15pt' : '1.35rem' }}; font-weight: bold; color: #0F172A;">{{ fig.name }}</div>
    <div style="font-family: {{ serif }}; font-style: italic; color: #475569; margin-bottom: 2px;">{{ fig.title }}</div>
    <div class="dr-small" style="margin-bottom: 6px;">{{ fig.refs }}</div>
    <p style="margin: 0; color: #1E293B;"><strong>Pourquoi lui, pour vous ?</strong> {{ why }}</p>
    {% if pdf %}
        {{ _self.body(fig, pdf, pc, serif) }}
    {% else %}
        <details style="margin-top: 10px;">
            <summary style="cursor: pointer; font-weight: 700; color: {{ pc }};">Lire le portrait complet</summary>
            {{ _self.body(fig, pdf, pc, serif) }}
        </details>
    {% endif %}
</div>
