{% extends 'base.html.twig' %}

{% block title %}Mes tests{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
:root {
    --page-bg: #f8f7f4;
}
.tests-hero {
    padding: 2.25rem 0 1rem;
}
.progress-bar-wrap {
    max-width: 300px;
    margin: 1.25rem 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.progress-bar-track {
    max-width: 300px;
    height: 6px;
    background: var(--border);
    border-radius: 99px;
    overflow: hidden;
    max-width: 300px;
    margin: 0 auto 2rem;
}
.progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
    border-radius: 99px;
    transition: width 0.8s ease;
}
.tests-disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-alt);
    border-radius: 99px;
    font-size: 0.7rem;
    color: var(--fg-subtle);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 3rem;
}
.tests-section-title {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg-subtle);
    margin: 2.5rem 0 1.25rem;
}
.tests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}
.test-card {
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    display: flex;
    flex-direction: column;
}
.test-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
}
.test-card-header {
    padding: 1.5rem 1.5rem 1rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
}
.test-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.test-card-icon svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
}
.test-card-meta h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--fg-light);
    margin: 0 0 0.2rem;
}
.test-card-meta .subtitle {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
}
.test-card-body {
    padding: 0 1.5rem 0;
    flex: 1;
}
.test-card-body p {
    font-size: 0.85rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0 0 1rem;
}
.test-card-footer {
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
}
.test-card-done-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.6rem;
    border-radius: 99px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #dcfce7;
    color: #16a34a;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}
.btn-take {
    flex: 1;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: #fff;
    transition: opacity 0.2s, transform 0.1s;
}
.btn-take:hover { opacity: 0.88; transform: scale(1.02); }
.btn-result {
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    border: 1.5px solid var(--border);
    background: transparent;
    color: var(--fg-light);
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s, border-color 0.2s;
}
.btn-result:hover { background: var(--bg); border-color: var(--border-strong); }
.questions-count {
    font-size: 0.7rem;
    color: var(--fg-subtle);
    margin-top: auto;
    padding: 0 1.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}
.icon-svg { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
</style>
{% endblock %}

{% block body %}
<div style="min-height: 100vh; background: var(--page-bg, #f8f7f4);">
<div style="max-width: 960px; margin: 0 auto; padding: 0 1.5rem 4rem;">

    {# ── Hero ── #}
    <div class="tests-hero">
        <span class="ks-header__eyebrow"><i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>Se connaître pour mieux servir</span>
        <h1 class="ks-header__title">Mes tests</h1>
        <p class="ks-header__lead">Discernez ce que Dieu a mis en vous : votre personnalité, vos motivations, vos dons, et où vous en êtes aujourd'hui.</p>
        <div style="max-width: 680px; margin: 1rem 0 0;">{{ book_panel('personnalite') }}</div>

        {% set completed = assessments|length + latestTests|filter((v, k) => k in tests|keys)|length %}
        {% set total = tests|length + instruments|length %}
        <div class="progress-bar-wrap">
            <span style="font-size:0.65rem;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:var(--fg-subtle);">Progression</span>
            <span style="font-size:0.65rem;font-weight:800;color:var(--fg-light);">{{ completed }}/{{ total }} tests</span>
        </div>
        <div class="progress-bar-track">
            <div class="progress-bar-fill" style="width:{{ total > 0 ? ((completed / total) * 100)|round : 0 }}%;"></div>
        </div>
    </div>

    {# ── Synthèse croisée ── #}
    <a href="{{ path('app_synthesis') }}" style="display:flex;align-items:center;gap:1rem;background:#0F172A;color:#fff;border-radius:18px;padding:1.1rem 1.25rem;margin-bottom:1.25rem;text-decoration:none;">
        <span style="flex:none;width:44px;height:44px;border-radius:12px;background:#0F766E;display:flex;align-items:center;justify-content:center;"><i data-lucide="sparkles" style="width:22px;height:22px;color:#fff;"></i></span>
        <span style="flex:1;">
            <span style="display:block;font-family:var(--font-serif);font-size:1.15rem;font-weight:700;">Mon profil KIINI SAWA</span>
            <span style="display:block;font-size:.85rem;color:#CBD5E1;">La synthèse de tous vos tests : qui vous êtes, ce qui vous pousse, votre zone de vocation.</span>
        </span>
        <span style="font-size:1.2rem;color:#5EEAD4;">→</span>
    </a>
    <p style="margin:-.5rem 0 1.25rem;text-align:right;font-size:.85rem;"><a href="{{ path('app_test_evolution') }}" style="color:var(--primary);font-weight:600;text-decoration:none;"><i data-lucide="trending-up" style="width:15px;height:15px;vertical-align:-3px;"></i> Mon évolution et l'historique de mes tests</a></p>

    {# ── Légende des niveaux de fiabilité ── #}
    <details style="background:#fff;border:1px solid var(--border);border-radius:14px;padding:.9rem 1.1rem;margin-bottom:2rem;">
        <summary style="cursor:pointer;font-weight:700;color:var(--fg-light);font-size:.9rem;">Que valent ces tests ? Chaque test indique son niveau de fiabilité</summary>
        <dl style="margin-top:.75rem;display:grid;gap:.55rem;font-size:.85rem;">
            {% for label, hint in levels %}
                <div><dt style="font-weight:700;color:var(--fg);display:inline;">{{ label }}</dt><dd style="display:inline;color:var(--fg-muted);margin:0;"> : {{ hint }}</dd></div>
            {% endfor %}
        </dl>
        <p style="font-size:.8rem;color:var(--fg-subtle);margin-top:.75rem;">Dans tous les cas, un résultat décrit des tendances, pas une étiquette : c'est un point de départ pour la réflexion, la prière et le dialogue.</p>
    </details>

    {# ── Questionnaires (personnalité, motivations et dons) ── #}
    {% for groupName, slugs in groups %}
        <p class="tests-section-title" style="{{ not loop.first ? 'margin-top:3rem;' }}">{{ groupName }}</p>
        {% if loop.first %}<p style="color:var(--fg-muted);font-size:.85rem;margin:-0.5rem 0 1rem;">Le <strong>profil complet</strong> remplit d'un coup le Big Five, le type et le style. Vous pouvez aussi passer chaque test séparément : vos réponses se cumulent.</p>{% endif %}
        <div class="tests-grid">
            {% for slug in slugs %}
                {% set def = instruments[slug] %}
                {% set done = assessments[slug] ?? null %}
                <div class="test-card" style="{{ slug == 'profil-complet' ? 'border: 2px solid ' ~ def.color ~ ';' }}">
                    {% if done %}<div class="test-card-done-badge">✓ Complété</div>{% endif %}
                    <div class="test-card-header">
                        <div class="test-card-icon" style="background:{{ def.bg }};color:{{ def.color }};"><i data-lucide="{{ def.icon }}" style="width:22px;height:22px;"></i></div>
                        <div class="test-card-meta">
                            <div class="subtitle">{{ def.subtitle }}</div>
                            <h3>{{ def.name }}</h3>
                        </div>
                    </div>
                    <div class="test-card-body"><p>{{ def.description }}</p></div>
                    <div class="questions-count" style="color:{{ def.color }};" title="{{ levels[def.level] ?? '' }}">⏱ {{ def.minutes }} min · {{ def.level }}</div>
                    <div class="test-card-footer">
                        <a href="{{ path('app_assessment_take', {slug: slug}) }}" class="btn-take" style="background:{{ def.color }};">{{ done ? 'Refaire' : 'Faire le test' }}</a>
                        {% if done %}<a href="{{ path('app_assessment_report', {id: done.id}) }}" class="btn-result">Résultats</a>{% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
    <p style="font-size:.72rem;color:var(--fg-subtle);margin-top:.75rem;">Questions de personnalité : International Personality Item Pool (IPIP-NEO, domaine public). Type inspiré de Carl Jung (popularisé par le MBTI®), style inspiré du modèle DISC de W. Marston ; KIINI SAWA n'est affilié à aucune de ces marques.</p>

    {# ── Faire le point : auto-évaluations ── #}
    <p class="tests-section-title" style="margin-top:3rem;">Faire le point</p>
    <p style="color:var(--fg-muted);font-size:.85rem;margin:-0.5rem 0 1rem;">Deux auto-évaluations à refaire régulièrement : elles nourrissent votre Plan d'Hygiène de Vie et vos revues.</p>
    <div class="tests-grid">
        {% for typeKey, meta in tests %}
            {% include 'personnalite/_card.html.twig' with {typeKey: typeKey, meta: meta, done: latestTests[typeKey] is defined} %}
        {% endfor %}
        <div class="test-card">
            <div class="test-card-header">
                <div class="test-card-icon" style="background:var(--couple-soft);color:var(--couple);"><i data-lucide="users" style="width:22px;height:22px;"></i></div>
                <div class="test-card-meta"><div class="subtitle">Le regard des autres</div><h3>Feedback nourricier</h3></div>
            </div>
            <div class="test-card-body"><p>Demandez à vos proches les qualités qu'ils voient en vous, ce que vous faites de mieux et où vous pourriez grandir. Anonyme si vous le souhaitez.</p></div>
            <div class="questions-count" style="color:var(--couple);">⏱ 3 min pour chaque proche · Regard extérieur</div>
            <div class="test-card-footer"><a href="{{ path('app_feedback') }}" class="btn-take" style="background:var(--couple);">Demander un feedback</a></div>
        </div>
    </div>

</div>
</div>
{% endblock %}
