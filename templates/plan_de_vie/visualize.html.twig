            Retour
        </a>
        <a href="{{ path('app_plan_de_vie_pdf') }}" class="btn-toolbar btn-toolbar-primary" style="text-decoration: none;" data-turbo="false">
            <i data-lucide="file-down" style="width: 16px; height: 16px;"></i>
            Télécharger le PDF
        </a>
