            <i data-lucide="printer" style="width: 16px; height: 16px;"></i>
            Imprimer
        </button>
        <button id="visualize-send-email" class="btn-toolbar btn-toolbar-secondary">
            <i data-lucide="mail" style="width: 16px; height: 16px;"></i>
            M'envoyer par email
        </button>
    </div>
    {% endif %}

    {# Toast Notification #}
    <div id="toast" class="toast-notify">Plan de Vie envoyé avec succès à votre adresse email !</div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof lucide !== 'undefined') lucide.createIcons();

            // Email handler
            const emailBtn = document.getElementById('visualize-send-email');
            const toast = document.getElementById('toast');

            if (emailBtn) {
                emailBtn.addEventListener('click', async () => {
                    emailBtn.disabled = true;
                    emailBtn.style.opacity = '0.7';
                    const originalText = emailBtn.innerHTML;
                    emailBtn.innerHTML = 'Envoi en cours...';

                    try {
                        const response = await fetch("{{ path('app_plan_de_vie_email') }}", {
                            method: "POST"
                        });
                        const result = await response.json();
                        if (result.success) {
                            // Show toast
                            toast.innerText = `Plan de Vie envoyé avec succès à ${result.emailSentTo} !`;
                            toast.classList.add('show');
                            setTimeout(() => {
                                toast.classList.remove('show');
                            }, 4000);
                        } else {
                            alert("Erreur lors de l'envoi : " + result.error);
                        }
                    } catch (err) {
                        alert("Erreur réseau ou serveur lors de l'envoi.");
                    } finally {
                        emailBtn.disabled = false;
                        emailBtn.style.opacity = '1';
                        emailBtn.innerHTML = originalText;
                    }
                });
            }
        });
    </script>
