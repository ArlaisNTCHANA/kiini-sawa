                                <option value="INTP" {% if mbtiVal == 'INTP' %}selected{% endif %}>INTP (Logicien)</option>
                                <option value="ENTJ" {% if mbtiVal == 'ENTJ' %}selected{% endif %}>ENTJ (Commandant)</option>
                                <option value="ENTP" {% if mbtiVal == 'ENTP' %}selected{% endif %}>ENTP (Innovateur)</option>
                                <option value="INFJ" {% if mbtiVal == 'INFJ' %}selected{% endif %}>INFJ (Avocat)</option>
