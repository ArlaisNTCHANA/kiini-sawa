                                <option value="">Je ne sais pas...</option>
                                <option value="O" {% if big5Val == 'O' %}selected{% endif %}>O — Ouverture (Curiosité, Créativité)</option>
                                <option value="C" {% if big5Val == 'C' %}selected{% endif %}>C — Conscienciosité (Organisation, Fiabilité)</option>
