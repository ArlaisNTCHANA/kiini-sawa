                                <option value="ISTJ" {% if mbtiVal == 'ISTJ' %}selected{% endif %}>ISTJ (Logisticien)</option>
                                <option value="ISFJ" {% if mbtiVal == 'ISFJ' %}selected{% endif %}>ISFJ (Défenseur)</option>
                                <option value="ESTJ" {% if mbtiVal == 'ESTJ' %}selected{% endif %}>ESTJ (Directeur)</option>
                                <option value="ESFJ" {% if mbtiVal == 'ESFJ' %}selected{% endif %}>ESFJ (Consul)</option>
                                <option value="ISTP" {% if mbtiVal == 'ISTP' %}selected{% endif %}>ISTP (Virtuose)</option>
                                <option value="ISFP" {% if mbtiVal == 'ISFP' %}selected{% endif %}>ISFP (Aventurier)</option>
                                <option value="ESTP" {% if mbtiVal == 'ESTP' %}selected{% endif %}>ESTP (Entrepreneur)</option>
