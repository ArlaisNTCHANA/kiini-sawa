{% extends 'base.html.twig' %}

{% block title %}Strategic Hub - Life Plan - KIINI SAWA{% endblock %}

{% block stylesheets %}
    <style>
        .animate-fade-in { animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Custom scrollbar for inner container */
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .wizard-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: calc(100vh - 72px);
            position: relative;
            background: linear-gradient(135deg, #022c22 0%, #0f766e 50%, #014751 100%);
            padding: 2.5rem 1.5rem;
        }

        /* Ambient glows for onboarding/wizard vibe */
        .glow-1 {
            position: absolute;
            top: -10%; left: -10%;
            width: 45vw; height: 45vh;
            background: radial-gradient(circle, rgba(45, 212, 191, 0.15) 0%, transparent 70%);
            filter: blur(60px);
            pointer-events: none;
        }
        .glow-2 {
            position: absolute;
            bottom: -10%; right: -10%;
            width: 55vw; height: 55vh;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.12) 0%, transparent 70%);
            filter: blur(80px);
            pointer-events: none;
        }
        .dots {
            position: absolute;
            inset: 0;
            opacity: 0.12;
            background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        /* Input fields in wizard */
        .wiz-input, .wiz-select, .wiz-textarea {
            width: 100%;
            padding: 0.85rem 1.1rem;
            background-color: #F8FAFC;
            border: 1.5px solid rgba(15, 118, 110, 0.08);
            border-radius: 12px;
            color: var(--fg);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
            transition: all 0.25s;
        }
        .wiz-input:focus, .wiz-select:focus, .wiz-textarea:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.12), inset 0 2px 4px rgba(0,0,0,0.01);
            background-color: #ffffff;
        }

        .dynamic-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: #F8FAFC;
            border: 1px solid rgba(15, 118, 110, 0.06);
            border-radius: 1rem;
            animation: fadeIn 0.3s ease-out;
            margin-bottom: 0.5rem;
        }

        .btn-add {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.5rem 1.1rem;
            border-radius: 9999px;
            background: rgba(13, 148, 136, 0.08);
            color: var(--primary);
            font-weight: 750;
            font-size: 0.75rem;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            outline: none;
        }
        .btn-add:hover {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 10px rgba(15, 118, 110, 0.15);
        }

        .btn-remove {
            background: transparent;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 0.375rem;
            border-radius: 0.5rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-remove:hover {
            color: #EF4444;
            background: #FEF2F2;
        }

        /* Stepper progress */
        .progress-line {
            height: 5px;
            width: 100%;
            background: #E2E8F0;
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #0D9488 0%, #2dd4bf 100%);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>
{% endblock %}

{% block body %}
{% if single %}
    <div style="max-width: 800px; margin: 3rem auto; padding: 0 1.5rem;" class="animate-fade-in">
        <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <a href="{{ path(planRoute) }}" style="font-size: 0.875rem; color: var(--fg-muted); display: inline-flex; align-items: center; gap: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--fg-muted)'">
                    <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
                    Retour au {{ planLabel }}
                </a>
                <h1 style="font-family: var(--font-serif); font-size: 2.25rem; color: var(--primary); margin-top: 0.5rem; font-weight: 700; letter-spacing: -0.02em;">
                    {% if step == 1 %}Modifier mon But de Dieu
                    {% elseif step == 2 %}Modifier ma Balance Interne
                    {% elseif step == 3 %}Modifier mes Passions & Intérêts
                    {% elseif step == 4 %}Modifier mes Dons & Talents
                    {% elseif step == 5 %}Modifier mon Profil de Personnalité
                    {% elseif step == 6 %}Modifier ma Vision Personnelle
                    {% elseif step == 7 %}Modifier mes Objectifs Spécifiques
                    {% elseif step == 8 %}Modifier Compétence & Connaissance
                    {% elseif step == 9 %}Modifier Caractère & Conviction
                    {% elseif step == 10 %}Modifier Relation & Réseau
                    {% elseif step == 11 %}Modifier Héritage & Transmission
                    {% elseif step == 12 %}Modifier mon Hygiène de Vie
                    {% elseif step == 13 %}Modifier mon Échéancier
                    {% endif %}
                </h1>
            </div>
        </div>

        <div style="background: white; border-radius: 1.5rem; border: 1px solid rgba(15, 118, 110, 0.08); box-shadow: var(--card-shadow); overflow: hidden; display: flex; flex-direction: column;">
            <form action="{{ path('app_plan_wizard', { step: step, single: 1, plan: plan }) }}" method="POST" style="flex: 1; display: flex; flex-direction: column; padding: 2.5rem; width: 100%;">
                <input type="hidden" name="plan" value="{{ plan }}">
                <div style="flex: 1;">
{% else %}
<div class="wizard-body">
    <div class="glow-1"></div>
    <div class="glow-2"></div>
    <div class="dots"></div>

    <!-- Top Bar / Navigation header -->
    <div style="width: 100%; max-width: 900px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 10;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4px 12px rgba(15, 118, 110, 0.25);">
                <i data-lucide="compass" style="width: 18px; height: 18px; stroke-width: 2.5px;"></i>
            </div>
            <h1 style="font-family: 'Playfair Display', serif; font-size: 1.35rem; font-weight: 700; color: white; letter-spacing: -0.01em;">
                {% if plan == 'CROISSANCE' %}Plan de Croissance
                {% elseif plan == 'DEVELOPPEMENT' %}Plan de Développement
                {% elseif plan == 'TRANSMISSION' %}Plan de Transmission
                {% elseif plan == 'HYGIENE' %}Plan d'Hygiène de Vie
                {% else %}Plan de Vie{% endif %}
            </h1>
        </div>
        <a href="{{ path(planRoute) }}" 
           style="width: 2.25rem; height: 2.25rem; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s; cursor: pointer;"
           onmouseover="this.style.background='rgba(255,255,255,0.25)'"
           onmouseout="this.style.background='rgba(255,255,255,0.15)'"
           title="Fermer et retour">
            <i data-lucide="x" style="width: 16px; height: 16px; stroke-width: 2.5px;"></i>
        </a>
    </div>

    <!-- Main Wizard Card -->
    <div style="width: 100%; max-width: 900px; background: rgba(255, 255, 255, 0.98); border-radius: 2rem; 
                box-shadow: 0 30px 70px rgba(0, 0, 0, 0.2); border: 1px solid rgba(15, 118, 110, 0.06);
                display: flex; flex-direction: column; overflow: hidden; position: relative; z-index: 10; min-height: 520px;"
          data-controller="wizard" 
          data-wizard-current-step-value="{{ currentWizardStep }}"
          data-wizard-total-steps-value="{{ allowedSteps|length }}">
        
        <!-- Stepper Header -->
        <div style="position: relative; z-index: 10;">
            <div class="progress-line">
                <div class="progress-fill" data-wizard-target="progress" style="width: 0%;"></div>
            </div>
            <div style="padding: 1.25rem 2rem; border-bottom: 1px solid rgba(15, 118, 110, 0.05); display: flex; justify-content: space-between; align-items: center; background: white;">
                <div style="display: flex; flex-direction: column;">
                    <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; tracking: 0.1em; color: var(--primary);" data-wizard-target="progressText">
                        Étape {{ currentWizardStep }} sur {{ allowedSteps|length }}
                    </span>
                    <h3 style="font-size: 0.95rem; font-weight: 700; color: #334155; display: flex; align-items: center; gap: 0.5rem; margin-top: 2px;" id="step-title">But de Dieu</h3>
                </div>
            </div>
        </div>

        <!-- Form content -->
        <form action="{{ path('app_plan_wizard', { step: step, single: 0, plan: plan }) }}" method="POST" style="flex: 1; display: flex; flex-direction: column; padding: 2rem 2.5rem 2.5rem; width: 100%;">
            <input type="hidden" name="plan" value="{{ plan }}">
            <div style="flex: 1; overflow-y: auto; max-height: 420px; padding-right: 0.5rem;" class="custom-scrollbar">
{% endif %}
                
                {# ETAPE 1: BOUSSOLE (PURPOSE) #}
                {% if (not single and 1 in allowedSteps) or (single and step == 1) %}
                <div data-wizard-target="step" data-step-number="1" class="{% if step != 1 %}hidden{% endif %} animate-fade-in" data-step-title="But de Dieu">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="compass" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 500;">But de Dieu pour ma vie</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Définissez votre mission de vie principale. Quelle est la phrase ou le paragraphe qui résume le sens que vous donnez à votre existence ?
                    </p>
                    
                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Énoncé de mission</label>
                        <textarea name="purpose_statement" class="wiz-textarea" rows="5" placeholder="Ex: Guider et inspirer les autres à réaliser leur plein potentiel par l'éducation, le partage et l'engagement continu.">{% if planDeVie and planDeVie.purpose and planDeVie.purpose.statement %}{{ planDeVie.purpose.statement }}{% else %}{{ defaultPurposeStatement }}{% endif %}</textarea>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 2: BALANCE INTERNE (VALUES, CONVICTIONS, LIMITING BELIEFS) #}
                {% if (not single and 2 in allowedSteps) or (single and step == 2) %}
                <div data-wizard-target="step" data-step-number="2" class="{% if step != 2 %}hidden{% endif %} animate-fade-in" data-step-title="Balance Interne">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="activity" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: 'Playfair Display', serif; font-size: 1.75rem; font-weight: 500;">Balance Interne</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Vos fondations psychologiques : vos valeurs cardinales, convictions profondes et croyances limitantes à surmonter.
                    </p>

                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        {# Values Real #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Valeurs Réelles & Vécues</label>
                                <button type="button" class="btn-add" onclick="addValueReal()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-real-container">
                                {% if valuesReal|length > 0 %}
                                    {% for val in valuesReal %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_real_ids[]" value="{{ val.id }}"><input type="text" name="values_real[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_real_ids[]" value=""><input type="text" name="values_real[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Excellence" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Values Declared #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Valeurs Déclarées & Admirées (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addValueDeclared()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-declared-container">
                                {% if valuesDeclared|length > 0 %}
                                    {% for val in valuesDeclared %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_declared_ids[]" value="{{ val.id }}"><input type="text" name="values_declared[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_declared_ids[]" value=""><input type="text" name="values_declared[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Impact" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Values Counter #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Contre-valeurs observées (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addValueCounter()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-counter-container">
                                {% if valuesCounter|length > 0 %}
                                    {% for val in valuesCounter %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_counter_ids[]" value="{{ val.id }}"><input type="text" name="values_counter[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_counter_ids[]" value=""><input type="text" name="values_counter[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Validation Externe" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Deep #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions profondes ou dogmatiques</label>
                                <button type="button" class="btn-add" onclick="addConvictionDeep()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-deep-container">
                                {% if convictionsDeep|length > 0 %}
                                    {% for c in convictionsDeep %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_deep_ids[]" value="{{ c.id }}"><input type="text" name="convictions_deep[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_deep_ids[]" value=""><input type="text" name="convictions_deep[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: L'éducation doit être accessible à tous">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Medium #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions médianes ou raisonnées</label>
                                <button type="button" class="btn-add" onclick="addConvictionMedium()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-medium-container">
                                {% if convictionsMedium|length > 0 %}
                                    {% for c in convictionsMedium %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_medium_ids[]" value="{{ c.id }}"><input type="text" name="convictions_medium[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_medium_ids[]" value=""><input type="text" name="convictions_medium[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: La discipline bat le talent sur le long terme">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Light #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions légères ou circonstancielles</label>
                                <button type="button" class="btn-add" onclick="addConvictionLight()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-light-container">
                                {% if convictionsLight|length > 0 %}
                                    {% for c in convictionsLight %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_light_ids[]" value="{{ c.id }}"><input type="text" name="convictions_light[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_light_ids[]" value=""><input type="text" name="convictions_light[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Le travail à distance est plus productif">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Limiting beliefs #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Croyances Limitantes (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addLimitingBelief()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="limiting-beliefs-container">
                                {% if limitingBeliefs|length > 0 %}
