                                <option value="A" {% if big5Val == 'A' %}selected{% endif %}>A — Agréabilité (Coopération, Bienveillance)</option>
                                <option value="N" {% if big5Val == 'N' %}selected{% endif %}>N — Névrosisme (Sensibilité émotionnelle)</option>
