                                    <input type="hidden" name="talents_ids[]" value=""><input type="text" name="talents[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Vulgarisation de concepts complexes" required>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 5: PERSONNALITÉ #}
                {% if (not single and 5 in allowedSteps) or (single and step == 5) %}
