                {# ETAPE 3: PASSIONS #}
                {% if (not single and 3 in allowedSteps) or (single and step == 3) %}
                <div data-wizard-target="step" data-step-number="3" class="{% if step != 3 %}hidden{% endif %} animate-fade-in" data-step-title="Passions & Intérêts">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
