        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    // Monitor step change to update step title
    document.addEventListener('turbo:load', () => {
        setupObserver();
    });
    
    // In case of non-turbo reload fallback
    document.addEventListener('DOMContentLoaded', () => {
        setupObserver();
    });

    function setupObserver() {
        const stepHeader = document.getElementById('step-title');
        if (!stepHeader) return;

        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    const target = mutation.target;
                    if (!target.classList.contains('hidden')) {
                        const stepTitle = target.getAttribute('data-step-title');
                        if (stepTitle) {
                            stepHeader.textContent = stepTitle;
                        }
                    }
                }
            });
        });

        document.querySelectorAll('[data-wizard-target="step"]').forEach(step => {
            observer.observe(step, { attributes: true });
        });

        // Initialize header with the first visible step's title
        const firstStep = document.querySelector('[data-wizard-target="step"]:not(.hidden)');
        if (firstStep) {
            const title = firstStep.getAttribute('data-step-title');
            if (title) stepHeader.textContent = title;
        }
        
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }
</script>
