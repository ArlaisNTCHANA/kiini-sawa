                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Type Ennéagramme</label>
                            <select name="profile_enneagram" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                <option value="1" {% if enneagramVal == '1' %}selected{% endif %}>Type 1 (Perfectionniste / Réformateur)</option>
                                <option value="2" {% if enneagramVal == '2' %}selected{% endif %}>Type 2 (Altruiste / Aidant)</option>
                                <option value="3" {% if enneagramVal == '3' %}selected{% endif %}>Type 3 (Battant / Réalisateur)</option>
                                <option value="4" {% if enneagramVal == '4' %}selected{% endif %}>Type 4 (Individualiste / Romantique)</option>
                                <option value="5" {% if enneagramVal == '5' %}selected{% endif %}>Type 5 (Investigateur / Observateur)</option>
                                <option value="6" {% if enneagramVal == '6' %}selected{% endif %}>Type 6 (Loyaliste / Sceptique)</option>
                                <option value="7" {% if enneagramVal == '7' %}selected{% endif %}>Type 7 (Enthousiaste / Épicurien)</option>
