                        {# DISC #}
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Profil DISC</label>
                            <select name="profile_disc" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                <option value="D" {% if discVal == 'D' %}selected{% endif %}>D — Dominant (Direct, Décidé)</option>
                                <option value="I" {% if discVal == 'I' %}selected{% endif %}>I — Influent (Enthousiaste, Sociable)</option>
                                <option value="S" {% if discVal == 'S' %}selected{% endif %}>S — Stable (Patient, Fiable)</option>
                                <option value="C" {% if discVal == 'C' %}selected{% endif %}>C — Consciencieux (Analytique, Précis)</option>
                                <option value="DI" {% if discVal == 'DI' %}selected{% endif %}>DI — Dominant / Influent</option>
