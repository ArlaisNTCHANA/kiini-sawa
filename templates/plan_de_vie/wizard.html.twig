{% extends 'base.html.twig' %}

{% block title %}Assistant · {{ planLabel }}{% endblock %}

{% block stylesheets %}
    <style>
        .animate-fade-in { animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Custom scrollbar for inner container */
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: var(--fg-subtle); }
        
        .wizard-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            min-height: calc(100vh - 72px);
            position: relative;
            background: linear-gradient(135deg, #022c22 0%, var(--primary) 50%, #014751 100%);
            padding: 2.5rem 1.5rem;
        }

        /* Ambient glows for onboarding/wizard vibe */
        .glow-1 {
            position: absolute;
            top: -10%; left: -10%;
            width: 45vw; height: 45vh;
            background: radial-gradient(circle, rgba(45, 212, 191, 0.15) 0%, transparent 70%);
            filter: blur(60px);
            pointer-events: none;
        }
        .glow-2 {
            position: absolute;
            bottom: -10%; right: -10%;
            width: 55vw; height: 55vh;
            background: radial-gradient(circle, rgba(200, 150, 46, 0.12) 0%, transparent 70%);
            filter: blur(80px);
            pointer-events: none;
        }
        .dots {
            position: absolute;
            inset: 0;
            opacity: 0.12;
            background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        /* Input fields in wizard */
        .wiz-input, .wiz-select, .wiz-textarea {
            width: 100%;
            padding: 0.85rem 1.1rem;
            background-color: var(--bg);
            border: 1.5px solid rgba(46, 107, 83, 0.08);
            border-radius: 12px;
            color: var(--fg);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.01);
            transition: all 0.25s;
        }
        .wiz-input:focus, .wiz-select:focus, .wiz-textarea:focus {
            border-color: var(--primary-light);
            box-shadow: 0 0 0 4px rgba(61, 122, 95, 0.12), inset 0 2px 4px rgba(0,0,0,0.01);
            background-color: #ffffff;
        }

        .dynamic-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: var(--bg);
            border: 1px solid rgba(46, 107, 83, 0.06);
            border-radius: 1rem;
            animation: fadeIn 0.3s ease-out;
            margin-bottom: 0.5rem;
        }

        .wiz-test-hint { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--fg-muted); }
        .wiz-test-hint strong { color: var(--fg-light); }
        .wiz-test-hint a, .wiz-suggestions a, .wiz-links a { color: var(--primary); font-weight: 600; text-decoration: underline; }
        .wiz-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-bottom: 1.5rem; font-size: 0.88rem; }
        .wiz-links a { display: inline-flex; align-items: center; gap: 0.35rem; }
        .wiz-suggestions { padding: 0.9rem 1.1rem; border: 1px dashed var(--border-strong); border-radius: 1rem; background: var(--bg-alt); margin-bottom: 1.25rem; }
        .wiz-suggestions p { margin: 0 0 0.6rem; font-size: 0.85rem; color: var(--fg-light); line-height: 1.5; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
        .wiz-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
        .wiz-equation { background: var(--primary-soft); border-radius: var(--r-md); padding: 1rem 1.1rem; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: .7rem; }
    .wiz-equation__formula { font-family: var(--font-serif); font-size: 1.05rem; margin: 0; }
    .wiz-equation__fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .6rem; }
    .wiz-equation__fields label { display: flex; flex-direction: column; gap: .25rem; font-size: .8rem; font-weight: 600; color: var(--fg-muted); }
    .wiz-equation__example { font-size: .82rem; color: var(--fg-muted); font-style: italic; margin: 0; }
    .wiz-chip { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.85rem; border-radius: 9999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--primary); font-size: 0.82rem; font-weight: 650; cursor: pointer; }
        .wiz-chip:hover { border-color: var(--primary); }
        .wiz-chip.is-added { opacity: 0.55; cursor: default; }
        .wiz-chip-note { font-size: 0.7rem; font-weight: 600; color: var(--fg-muted); }
        .btn-add {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.5rem 1.1rem;
            border-radius: 9999px;
            background: rgba(61, 122, 95, 0.08);
            color: var(--primary);
            font-weight: 750;
            font-size: 0.75rem;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            outline: none;
        }
        .btn-add:hover {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 10px rgba(46, 107, 83, 0.15);
        }

        .btn-remove {
            background: transparent;
            border: none;
            color: var(--fg-subtle);
            cursor: pointer;
            padding: 0.375rem;
            border-radius: 0.5rem;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-remove:hover {
            color: var(--danger);
            background: var(--danger-soft);
        }

        /* Stepper progress */
        .progress-line {
            height: 5px;
            width: 100%;
            background: var(--border);
            overflow: hidden;
        }
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary-light) 0%, #7A9E7E 100%);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>
{% endblock %}

{% block body %}
{% if single %}
    <div style="max-width: 800px; margin: 3rem auto; padding: 0 1.5rem;" class="animate-fade-in">
        <div style="margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <a href="{{ path(planRoute) }}" style="font-size: 0.875rem; color: var(--fg-muted); display: inline-flex; align-items: center; gap: 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--fg-muted)'">
                    <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
                    Retour au {{ planLabel }}
                </a>
                <h1 style="font-family: var(--font-serif); font-size: 2.25rem; color: var(--primary); margin-top: 0.5rem; font-weight: 700; letter-spacing: -0.02em;">
                    {% if step == 1 %}Modifier mon But de Dieu
                    {% elseif step == 2 %}Modifier ma Balance interne
                    {% elseif step == 3 %}Modifier mes Passions & Intérêts
                    {% elseif step == 4 %}Modifier mes Dons & Talents
                    {% elseif step == 5 %}Modifier mon Profil de personnalité
                    {% elseif step == 6 %}Modifier ma Vision Personnelle
                    {% elseif step == 7 %}Modifier mes Objectifs spécifiques
                    {% elseif step == 8 %}Modifier Compétence & Connaissance
                    {% elseif step == 9 %}Modifier Caractère & Conviction
                    {% elseif step == 10 %}Modifier Relation & Réseau
                    {% elseif step == 11 %}Modifier Héritage & Transmission
                    {% elseif step == 12 %}Modifier mon Hygiène de vie
                    {% elseif step == 13 %}Modifier mon Échéancier
                    {% endif %}
                </h1>
            </div>
        </div>

        <div style="background: white; border-radius: 1.5rem; border: 1px solid rgba(46, 107, 83, 0.08); box-shadow: var(--card-shadow); overflow: hidden; display: flex; flex-direction: column;">
            <form action="{{ path('app_plan_wizard', { step: step, single: 1, plan: plan }) }}" method="POST" style="flex: 1; display: flex; flex-direction: column; padding: 2.5rem; width: 100%;">
                <input type="hidden" name="plan" value="{{ plan }}">
                <div style="flex: 1;">
{% else %}
<div class="wizard-body">
    <div class="glow-1"></div>
    <div class="glow-2"></div>
    <div class="dots"></div>

    <!-- Top Bar / Navigation header -->
    <div style="width: 100%; max-width: 900px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 10;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 2.25rem; height: 2.25rem; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; color: white; box-shadow: 0 4px 12px rgba(46, 107, 83, 0.25);">
                <i data-lucide="compass" style="width: 18px; height: 18px; stroke-width: 2.5px;"></i>
            </div>
            <h1 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 700; color: white; letter-spacing: -0.01em;">
                {% if plan == 'CROISSANCE' %}Plan de Croissance
                {% elseif plan == 'DEVELOPPEMENT' %}Plan de Développement personnel
                {% elseif plan == 'TRANSMISSION' %}Plan de Transmission
                {% elseif plan == 'HYGIENE' %}Plan d'Hygiène de vie
                {% else %}Plan de Vie{% endif %}
            </h1>
        </div>
        <a href="{{ path(planRoute) }}" 
           style="width: 2.25rem; height: 2.25rem; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.2); color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%; transition: all 0.2s; cursor: pointer;"
           onmouseover="this.style.background='rgba(255,255,255,0.25)'"
           onmouseout="this.style.background='rgba(255,255,255,0.15)'"
           title="Fermer et retour">
            <i data-lucide="x" style="width: 16px; height: 16px; stroke-width: 2.5px;"></i>
        </a>
    </div>

    <!-- Main Wizard Card -->
    <div style="width: 100%; max-width: 900px; background: rgba(255, 255, 255, 0.98); border-radius: 2rem; 
                box-shadow: 0 30px 70px rgba(0, 0, 0, 0.2); border: 1px solid rgba(46, 107, 83, 0.06);
                display: flex; flex-direction: column; overflow: hidden; position: relative; z-index: 10; min-height: 520px;"
          data-controller="wizard" 
          data-wizard-current-step-value="{{ currentWizardStep }}"
          data-wizard-total-steps-value="{{ allowedSteps|length }}">
        
        <!-- Stepper Header -->
        <div style="position: relative; z-index: 10;">
            <div class="progress-line">
                <div class="progress-fill" data-wizard-target="progress" style="width: 0%;"></div>
            </div>
            <div style="padding: 1.25rem 2rem; border-bottom: 1px solid rgba(46, 107, 83, 0.05); display: flex; justify-content: space-between; align-items: center; background: white;">
                <div style="display: flex; flex-direction: column;">
                    <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; tracking: 0.1em; color: var(--primary);" data-wizard-target="progressText">
                        Étape {{ currentWizardStep }} sur {{ allowedSteps|length }}
                    </span>
                    <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--fg-light); display: flex; align-items: center; gap: 0.5rem; margin-top: 2px;" id="step-title">But de Dieu</h3>
                </div>
            </div>
        </div>

        <!-- Form content -->
        <form action="{{ path('app_plan_wizard', { step: step, single: 0, plan: plan }) }}" method="POST" style="flex: 1; display: flex; flex-direction: column; padding: 2rem 2.5rem 2.5rem; width: 100%;">
            <input type="hidden" name="plan" value="{{ plan }}">
            <div style="flex: 1; overflow-y: auto; max-height: 420px; padding-right: 0.5rem;" class="custom-scrollbar">
{% endif %}
                
                {# ETAPE 1: BOUSSOLE (PURPOSE) #}
                {% if (not single and 1 in allowedSteps) or (single and step == 1) %}
                <div data-wizard-target="step" data-step-number="1" class="{% if step != 1 %}hidden{% endif %} animate-fade-in" data-step-title="But de Dieu">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="compass" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">But de Dieu pour ma vie</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.25rem; line-height: 1.6;">
                        Le But de Dieu pour votre vie est une fonction, une nature, pas un projet : ce que vous êtes fait pour accomplir, quel que soit le lieu. Formulez-le avec l'Équation du But.
                    </p>
                    {{ book_panel('wizard.1') }}
                    {% include 'methode/_figure.html.twig' with {name: 'fig_equation', alt: 'L\'Équation du But : je suis créé pour un verbe, afin d\'apporter un impact, chez une cible', caption: 'l\'Équation du But', collapsed: true, max: '560px'} only %}

                    <div class="wiz-equation" data-purpose-equation>
                        <p class="wiz-equation__formula">Je suis créé pour <em>[verbe]</em> afin d'apporter <em>[impact]</em> chez <em>[cible]</em>.</p>
                        <div class="wiz-equation__fields">
                            <label>Je suis créé pour<input type="text" class="wiz-input" data-eq="verb" placeholder="administrer, structurer, enseigner…"></label>
                            <label>afin d'apporter<input type="text" class="wiz-input" data-eq="impact" placeholder="la sécurité, la restauration…"></label>
                            <label>chez<input type="text" class="wiz-input" data-eq="target" placeholder="ceux que je sers, mon peuple…"></label>
                        </div>
                        <button type="button" class="wiz-chip" onclick="composePurposeEquation(this)">Écrire mon But avec cette équation</button>
                        <p class="wiz-equation__example">Joseph : « Je suis créé pour administrer les ressources et optimiser les systèmes afin d'apporter la préservation de la vie et l'abondance chez ceux que je sers. »</p>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                        <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Mon But de Dieu</label>
                        <textarea name="purpose_statement" class="wiz-textarea" rows="5" placeholder="Je suis créé pour … afin d'apporter … chez …">{% if planDeVie and planDeVie.purpose and planDeVie.purpose.statement %}{{ planDeVie.purpose.statement }}{% else %}{{ defaultPurposeStatement }}{% endif %}</textarea>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 2: BALANCE INTERNE (VALUES, CONVICTIONS, LIMITING BELIEFS) #}
                {% if (not single and 2 in allowedSteps) or (single and step == 2) %}
                <div data-wizard-target="step" data-step-number="2" class="{% if step != 2 %}hidden{% endif %} animate-fade-in" data-step-title="Balance interne">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="activity" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Balance interne</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Vos fondations psychologiques : vos valeurs cardinales, convictions profondes et croyances limitantes à surmonter.
                    </p>
                    {{ book_panel('wizard.2') }}
                    {% include 'methode/_figure.html.twig' with {name: 'fig_convictions', alt: 'Les convictions : profonde, raisonnée, circonstancielle', caption: 'les convictions', collapsed: true, max: '560px'} only %}
                    {% if plan == 'CROISSANCE' %}
                        <div class="wiz-suggestions" data-croissance-balance>
                            <p style="margin: 0;"><i data-lucide="scale" style="width: 14px; height: 14px;"></i> Votre Balance interne vient de votre Plan de Vie ; elle sert ici à choisir les convictions à renforcer et les croyances à transformer.</p>
                        </div>
                    {% endif %}

                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        {# Values Real #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Valeurs Réelles & Vécues</label>
                                <button type="button" class="btn-add" onclick="addValueReal()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-real-container">
                                {% if valuesReal|length > 0 %}
                                    {% for val in valuesReal %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_real_ids[]" value="{{ val.id }}"><input type="text" name="values_real[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_real_ids[]" value=""><input type="text" name="values_real[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Excellence" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Values Declared #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Valeurs Déclarées & Admirées (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addValueDeclared()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-declared-container">
                                {% if valuesDeclared|length > 0 %}
                                    {% for val in valuesDeclared %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_declared_ids[]" value="{{ val.id }}"><input type="text" name="values_declared[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_declared_ids[]" value=""><input type="text" name="values_declared[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Impact" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Values Counter #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Contre-valeurs observées (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addValueCounter()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="values-counter-container">
                                {% if valuesCounter|length > 0 %}
                                    {% for val in valuesCounter %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="values_counter_ids[]" value="{{ val.id }}"><input type="text" name="values_counter[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ val.name }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="values_counter_ids[]" value=""><input type="text" name="values_counter[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Validation Externe" required>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Deep #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions profondes ou dogmatiques</label>
                                <button type="button" class="btn-add" onclick="addConvictionDeep()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-deep-container">
                                {% if convictionsDeep|length > 0 %}
                                    {% for c in convictionsDeep %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_deep_ids[]" value="{{ c.id }}"><input type="text" name="convictions_deep[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_deep_ids[]" value=""><input type="text" name="convictions_deep[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: L'éducation doit être accessible à tous">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Medium #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions médianes ou raisonnées</label>
                                <button type="button" class="btn-add" onclick="addConvictionMedium()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-medium-container">
                                {% if convictionsMedium|length > 0 %}
                                    {% for c in convictionsMedium %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_medium_ids[]" value="{{ c.id }}"><input type="text" name="convictions_medium[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_medium_ids[]" value=""><input type="text" name="convictions_medium[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: La discipline bat le talent sur le long terme">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Convictions Light #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Convictions légères ou circonstancielles</label>
                                <button type="button" class="btn-add" onclick="addConvictionLight()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="convictions-light-container">
                                {% if convictionsLight|length > 0 %}
                                    {% for c in convictionsLight %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="convictions_light_ids[]" value="{{ c.id }}"><input type="text" name="convictions_light[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ c.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="convictions_light_ids[]" value=""><input type="text" name="convictions_light[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Le travail à distance est plus productif">
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# Limiting beliefs #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Croyances Limitantes (alimente la croissance)</label>
                                <button type="button" class="btn-add" onclick="addLimitingBelief()">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="limiting-beliefs-container">
                                {% if limitingBeliefs|length > 0 %}
                                    {% for lb in limitingBeliefs %}
                                        <div class="dynamic-row">
                                            <input type="hidden" name="limiting_beliefs_ids[]" value="{{ lb.id }}"><input type="text" name="limiting_beliefs[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ lb.text }}" required>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="limiting_beliefs_ids[]" value=""><input type="text" name="limiting_beliefs[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Je ne suis pas assez expérimenté pour diriger">
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 3: PASSIONS #}
                {% if (not single and 3 in allowedSteps) or (single and step == 3) %}
                <div data-wizard-target="step" data-step-number="3" class="{% if step != 3 %}hidden{% endif %} animate-fade-in" data-step-title="Passions & Intérêts">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="heart" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Passions & Intérêts</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Qu'est-ce qui vous anime, vous passionne, vous fait oublier le temps et vous redonne de l'énergie ?
                    </p>
                    {{ book_panel('wizard.3') }}

                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Vos Passions</label>
                            <button type="button" class="btn-add" onclick="addPassion()">
                                <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                            </button>
                        </div>
                        <div id="passions-container" style="display: flex; flex-direction: column; gap: 0.5rem;">
                            {% if planDeVie and planDeVie.passions|length > 0 %}
                                {% for p in planDeVie.passions %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="passions_ids[]" value="{{ p.id }}"><input type="text" name="passions[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ p.name }}" required>
                                        {% if not loop.first %}
                                            <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="dynamic-row">
                                    <input type="hidden" name="passions_ids[]" value=""><input type="text" name="passions[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Écriture & création de contenu" required>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 4: TALENTS #}
                {% if (not single and 4 in allowedSteps) or (single and step == 4) %}
                <div data-wizard-target="step" data-step-number="4" class="{% if step != 4 %}hidden{% endif %} animate-fade-in" data-step-title="Dons & Talents">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="sparkles" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Dons & Talents Naturels</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Quelles sont vos facilités innées ? Ce que vous effectuez avec aisance et plaisir là où d'autres doivent faire de gros efforts.
                    </p>
                    {{ book_panel('wizard.4') }}
                    {% include 'plan_de_vie/wizard/_gift_suggestions.html.twig' with {gifts: testResults.gifts} only %}

                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Vos Talents</label>
                            <button type="button" class="btn-add" onclick="addTalent()">
                                <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                            </button>
                        </div>
                        <div id="talents-container" style="display: flex; flex-direction: column; gap: 0.5rem;">
                            {% if talents|length > 0 %}
                                {% for t in talents %}
                                    <div class="dynamic-row">
                                        <input type="hidden" name="talents_ids[]" value="{{ t.id }}"><input type="text" name="talents[]" class="wiz-input" style="border:none; background:transparent; padding:0;" value="{{ t.text }}" required>
                                        {% if not loop.first %}
                                            <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                            </button>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="dynamic-row">
                                    <input type="hidden" name="talents_ids[]" value=""><input type="text" name="talents[]" class="wiz-input" style="border:none; background:transparent; padding:0;" placeholder="Ex: Vulgarisation de concepts complexes" required>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 5: PERSONNALITÉ #}
                {% if (not single and 5 in allowedSteps) or (single and step == 5) %}
                <div data-wizard-target="step" data-step-number="5" class="{% if step != 5 %}hidden{% endif %} animate-fade-in" data-step-title="Profil de personnalité">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="user" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Profil de personnalité</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1rem; line-height: 1.6;">
                        Vos résultats aux tests de personnalité enrichissent votre plan. Ceux que vous avez passés dans KIINI SAWA sont repris automatiquement ; vous pouvez toujours les modifier.
                    </p>
                    <div class="wiz-links">
                        <a href="{{ path('app_synthesis') }}" target="_blank" rel="noopener"><i data-lucide="user-round-search" style="width: 14px; height: 14px;"></i> Voir mon profil KIINI SAWA</a>
                        <a href="{{ path('app_personality_index') }}" target="_blank" rel="noopener"><i data-lucide="flask-conical" style="width: 14px; height: 14px;"></i> Passer les tests</a>
                    </div>
                    {{ book_panel('wizard.5') }}

                    {% set selType = mbtiVal ?: (testResults.type.value ?? null) %}
                    {% set selDisc = discVal ?: (testResults.disc.value ?? null) %}
                    {% set selEnn = enneagramVal ?: (testResults.enneagram.value ?? null) %}
                    {% set selBig5 = big5Val ?: (testResults.big5.value ?? null) %}
                    <div style="display: flex; flex-direction: column; gap: 1.25rem;">

                        {# Type de fonctionnement #}
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Type de fonctionnement (4 lettres)</label>
                            <select name="profile_mbti" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                {% for code, t in constant('App\\Personnalite\\Psychometrie\\Interpretations::TYPES') %}
                                <option value="{{ code }}" {% if selType == code %}selected{% endif %}>{{ code }} ({{ t[0] }})</option>
                                {% endfor %}
                            </select>
                            {% include 'plan_de_vie/wizard/_test_hint.html.twig' with {current: mbtiVal, test: testResults.type} only %}
                        </div>

                        {# DISC #}
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Profil DISC</label>
                            <select name="profile_disc" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                {% for code, name in discOptions %}
                                <option value="{{ code }}" {% if selDisc == code %}selected{% endif %}>{{ code }} · {{ name }}</option>
                                {% endfor %}
                            </select>
                            {% include 'plan_de_vie/wizard/_test_hint.html.twig' with {current: discVal, test: testResults.disc} only %}
                        </div>

                        {# ENNÉAGRAMME #}
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Type Ennéagramme</label>
                            <select name="profile_enneagram" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                {% for n, t in constant('App\\Personnalite\\Psychometrie\\EnneagramBank::TYPES') %}
                                <option value="{{ n }}" {% if selEnn == n ~ '' %}selected{% endif %}>Type {{ n }} ({{ t.name }})</option>
                                {% endfor %}
                            </select>
                            {% include 'plan_de_vie/wizard/_test_hint.html.twig' with {current: enneagramVal, test: testResults.enneagram} only %}
                        </div>

                        {# BIG FIVE #}
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Big Five : profil dominant</label>
                            <select name="profile_big5" class="wiz-select">
                                <option value="">Je ne sais pas...</option>
                                {% for code, label in {
                                    'O': 'O — Ouverture (Curiosité, Créativité)',
                                    'C': 'C — Conscienciosité (Organisation, Fiabilité)',
                                    'E': 'E — Extraversion (Sociabilité, Énergie)',
                                    'A': 'A — Agréabilité (Coopération, Bienveillance)',
                                    'N': 'N — Névrosisme (Sensibilité émotionnelle)',
                                    'OC': 'OC — Ouverture + Conscienciosité',
                                    'OE': 'OE — Ouverture + Extraversion',
                                    'CE': 'CE — Conscienciosité + Extraversion',
                                    'CA': 'CA — Conscienciosité + Agréabilité',
                                    'AE': 'AE — Agréabilité + Extraversion',
                                } %}
                                <option value="{{ code }}" {% if selBig5 == code %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                            {% include 'plan_de_vie/wizard/_test_hint.html.twig' with {current: big5Val, test: testResults.big5} only %}
                        </div>

                    </div>
                </div>
                {% endif %}


                {# ETAPE 6: VISION #}
                {% if (not single and 6 in allowedSteps) or (single and step == 6) %}
                <div data-wizard-target="step" data-step-number="6" class="{% if step != 6 %}hidden{% endif %} animate-fade-in" data-step-title="Ma Vision">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="eye" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Ma Vision</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Projetez-vous à moyen/long terme. À quoi ressemblerait votre vie idéale ? Que voulez-vous avoir accompli ?
                    </p>
                    {{ book_panel('wizard.6') }}

                    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Description de votre Vision</label>
                            <textarea name="vision_content" class="wiz-textarea" rows="4" placeholder="Ex: Devenir un consultant indépendant épanoui, travaillant depuis n'importe où dans le monde, tout en maintenant une santé robuste et un équilibre familial parfait...">{% if planDeVie and planDeVie.vision %}{{ planDeVie.vision.content }}{% endif %}</textarea>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 0.375rem;">
                            <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Horizon temporel</label>
                            <input type="text" name="vision_horizon" class="wiz-input" placeholder="Ex: 5 ans, 10 ans..." value="{% if planDeVie and planDeVie.vision %}{{ planDeVie.vision.horizon }}{% endif %}">
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ETAPE 7: OBJECTIFS SPÉCIFIQUES (BE, DO, HAVE, GIVE) #}
                {% if (not single and 7 in allowedSteps) or (single and step == 7) %}
                <div data-wizard-target="step" data-step-number="7" class="{% if step != 7 %}hidden{% endif %} animate-fade-in" data-step-title="Objectifs spécifiques">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; color: var(--primary);">
                        <i data-lucide="target" style="width: 24px; height: 24px;"></i>
                        <h2 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 500;">Objectifs spécifiques (BE, DO, HAVE, GIVE)</h2>
                    </div>
                    <p style="color: var(--fg-muted); font-size: 0.95rem; margin-bottom: 1.75rem; line-height: 1.6;">
                        Déclinez votre vision générale en objectifs catégorisés selon 4 angles fondamentaux.
                    </p>
                    {{ book_panel('wizard.7') }}

                    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                        {# BE #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Être (Qui je veux être)</label>
                                <button type="button" class="btn-add" onclick="addLifeGoal('be')">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="life-goals-be-container">
                                {% if lifeGoals.BE|length > 0 %}
                                    {% for goal in lifeGoals.BE %}
                                        <div class="dynamic-row" style="flex-wrap: wrap;">
                                            <input type="hidden" name="life_goals_be_ids[]" value="{{ goal.id }}"><input type="text" name="life_goals_be[]" class="wiz-input" style="border:none; background:transparent; padding:0; flex: 1; min-width: 200px;" value="{{ goal.title }}" required>
                                            <div style="display: flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid rgba(46, 107, 83, 0.12); border-radius: 0.5rem; padding: 0.25rem 0.5rem; margin-left: auto;">
                                                <span style="font-size: 0.75rem; color: var(--fg-muted);">Échéance :</span>
                                                <input type="date" name="life_goals_be_deadlines[]" class="wiz-input" style="border:none; background:transparent; padding:0; font-size: 0.8rem; width: 125px; color: var(--fg-light); outline: none;" value="{{ goal.deadline ? goal.deadline|date('Y-m-d') : '' }}">
                                            </div>
                                            {% if not loop.first %}
                                                <button type="button" onclick="this.parentElement.remove()" class="btn-remove" title="Supprimer">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                                </button>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="dynamic-row" style="flex-wrap: wrap;">
                                        <input type="hidden" name="life_goals_be_ids[]" value=""><input type="text" name="life_goals_be[]" class="wiz-input" style="border:none; background:transparent; padding:0; flex: 1; min-width: 200px;" placeholder="Ex: Un leader calme et à l'écoute">
                                        <div style="display: flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid rgba(46, 107, 83, 0.12); border-radius: 0.5rem; padding: 0.25rem 0.5rem; margin-left: auto;">
                                            <span style="font-size: 0.75rem; color: var(--fg-muted);">Échéance :</span>
                                            <input type="date" name="life_goals_be_deadlines[]" class="wiz-input" style="border:none; background:transparent; padding:0; font-size: 0.8rem; width: 125px; color: var(--fg-light); outline: none;">
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# DO #}
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <label style="font-size: 0.75rem; font-weight: 700; color: var(--fg-light); letter-spacing: 0.05em; text-transform: uppercase;">Faire (Ce que je veux accomplir)</label>
                                <button type="button" class="btn-add" onclick="addLifeGoal('do')">
                                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> Ajouter
                                </button>
                            </div>
                            <div id="life-goals-do-container">
                                {% if lifeGoals.DO|length > 0 %}
                                    {% for goal in lifeGoals.DO %}
                                        <div class="dynamic-row" style="flex-wrap: wrap;">
                                            <input type="hidden" name="life_goals_do_ids[]" value="{{ goal.id }}"><input type="text" name="life_goals_do[]" class="wiz-input" style="border:none; background:transparent; padding:0; flex: 1; min-width: 200px;" value="{{ goal.title }}" required>
                                            <div style="display: flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid rgba(46, 107, 83, 0.12); border-radius: 0.5rem; padding: 0.25rem 0.5rem; margin-left: auto;">
                                                <span style="font-size: 0.75rem; color: var(--fg-muted);">Échéance :</span>
