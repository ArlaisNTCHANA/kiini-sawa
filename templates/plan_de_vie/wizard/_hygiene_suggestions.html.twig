{# Axes prioritaires du test Hygiène de Vie, ajoutés en un clic comme domaines (étape 12). Variable : hygiene #}
{% if hygiene %}
    <div class="wiz-suggestions">
        <p>
            <i data-lucide="flask-conical" style="width: 14px; height: 14px;"></i>
            Vos axes prioritaires selon votre test du {{ hygiene.date|date('d/m/Y') }} : commencez par l'un d'eux.
            <a href="{{ path('app_personality_result', {type: 'hygiene', id: hygiene.testId}) }}" target="_blank" rel="noopener">voir le rapport</a>
        </p>
        <div class="wiz-chips">
            {% for p in hygiene.priorities %}
                <button type="button" class="wiz-chip" data-value="{{ p.label }}" onclick="addSuggestedHygieneDomain(this)">
                    <i data-lucide="plus" style="width: 12px; height: 12px;"></i> {{ p.label }}
                    <span class="wiz-chip-note">{{ p.value|number_format(1, ',') }}/10</span>
                </button>
            {% endfor %}
        </div>
    </div>
{% endif %}
