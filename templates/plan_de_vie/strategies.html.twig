                                                                    {% for lg in hd.supportedLifeGoals %}
                                                                        <span style="background: rgba(59, 130, 246, 0.06); color: #1e3a8a; border: 1px solid rgba(59, 130, 246, 0.15); padding: 0.15rem 0.45rem; border-radius: 5px; font-size: 0.72rem; font-weight: 500;">
                                                                            [{{ lg.category|upper }}] {{ lg.title }}
                                                                        </span>
                                                                    {% endfor %}
                                                                </div>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}

                                {% if not hasAnyHygiene %}
                                    <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic;">Aucun domaine d'hygiène configuré.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
