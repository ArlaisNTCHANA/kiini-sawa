                                {% else %}
                                    <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic;">Aucun projet de transmission défini.</p>
                                {% endfor %}
                            </div>

                            <!-- Hygiene Domains -->
                            <div x-show="activePlan === 'HYGIENE'" style="display: flex; flex-direction: column; gap: 1.5rem; margin-top: 0.5rem;">
                                {% set hasAnyHygiene = false %}
                                {% for category, hds in groupedHygieneDomains %}
                                    {% if hds|length > 0 %}
                                        {% set hasAnyHygiene = true %}
                                        <div style="border: 1px solid rgba(15, 118, 110, 0.08); border-radius: 1.25rem; padding: 1.25rem; background: #ffffff;">
                                            <h3 style="font-size: 1rem; font-weight: 750; color: var(--primary); margin: 0 0 1rem 0; display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px dashed rgba(15, 118, 110, 0.12); padding-bottom: 0.5rem; font-family: 'Playfair Display', serif;">
                                                <i data-lucide="shield" style="width: 16px; height: 16px; color: var(--primary);"></i>
                                                Axe {{ category }}
                                            </h3>
                                            <div style="display: flex; flex-direction: column; gap: 1rem;">
                                                {% for hd in hds %}
                                                    <div style="padding: 1rem; background: #F8FAFC; border-radius: 0.85rem; border: 1px solid rgba(0, 0, 0, 0.03); border-left: 3px solid #059669; display: flex; flex-direction: column; gap: 0.75rem;">
                                                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; flex-wrap: wrap; gap: 0.5rem;">
                                                            <h4 style="font-weight: 700; font-size: 0.95rem; color: var(--fg); margin: 0;">{{ hd.name }}</h4>
                                                            <span style="font-size: 0.72rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 0.35rem; text-transform: uppercase; background: {% if hd.subtype == 'leverage' %}#D1F2EB; color: #0E6251;{% elseif hd.subtype == 'consolidate' %}#D5F5E3; color: #196F3D;{% else %}#FCF3CF; color: #7E5109;{% endif %}">
                                                                {{ hd.subtype == 'leverage' ? 'À mettre à profit' : (hd.subtype == 'consolidate' ? 'À consolider' : 'À construire') }}
                                                            </span>
                                                        </div>

                                                        {% if hygieneTestScores is not null and hygieneTestScores.details is defined %}
                                                            {% set categoryKey = category|lower %}
                                                            {% set score = hygieneTestScores.details[categoryKey][hd.name] ?? null %}
                                                            {% if score is not null %}
                                                                <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--fg-muted);">
                                                                    <i data-lucide="bar-chart-2" style="width: 14px; height: 14px; color: var(--primary);"></i>
                                                                    <span>Score d'auto-évaluation au test :</span>
                                                                    <strong style="color: {% if score >= 7.0 %}#059669{% elseif score >= 4.0 %}#D97706{% else %}#EF4444{% endif %};">{{ score }}/10</strong>
                                                                </div>
                                                            {% endif %}
                                                        {% endif %}

                                                        {% if hd.supportedLifeGoals|length > 0 %}
                                                            <div style="font-size: 0.78rem; color: var(--fg-muted); display: flex; flex-direction: column; gap: 0.25rem;">
                                                                <span style="font-weight: 700; color: var(--fg-light); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em;">Soutient les objectifs de vie :</span>
