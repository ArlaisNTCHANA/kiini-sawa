                                        <h3 style="font-weight: 700; font-size: 1rem; color: var(--fg); margin-bottom: 0.25rem;">{{ gg.title }}</h3>
                                        {% if gg.strategy %}<p style="font-size: 0.85rem; color: var(--fg-muted); line-height: 1.4; margin: 0;">{{ gg.strategy }}</p>{% endif %}
                                    </div>
                                {% else %}
