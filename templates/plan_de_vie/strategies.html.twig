                        {% set transmissionIssues = transmissionIssues|merge([issue]) %}
                    {% else %}
                        {% set transmissionScoreCurrent = transmissionScoreCurrent + 5 %}
                    {% endif %}
                {% endfor %}
                {% set transmissionHealthScore = transmissionScoreTotal == 0 ? 0 : ((transmissionScoreCurrent / transmissionScoreTotal) * 100)|round %}
