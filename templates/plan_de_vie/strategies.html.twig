                                {% endif %}
                            </div>

                            <!-- Hygiène - no deadlines -->
                            <div x-show="activePlan === 'HYGIENE'">
                                <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic; text-align: center; margin: 2rem 0;">Aucune échéance temporelle spécifique (les routines d'hygiène s'appliquent de manière permanente).</p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            {# ════════════════ 6. ANALYSIS TAB ════════════════ #}
            <div x-show="activeTab === 'ANALYSIS'">
                {# Compute alignment analysis in Twig for each plan separately #}
                
                {# 1. CROISSANCE Calculations #}
                {% set croissanceIssues = [] %}
                {% set croissanceScoreTotal = 10 %}
                {% set croissanceScoreCurrent = 0 %}
                {% if not planDeVie or not planDeVie.vision or planDeVie.vision.content|length < 20 %}
                    {% set issue = {'type': 'CRITICAL', 'message': "Rédigez votre vision pour orienter vos choix stratégiques.", 'icon': 'alert-circle', 'link': path('app_plan_wizard', {step: 6, single: 1}) ~ '&plan=CROISSANCE'} %}
                    {% set croissanceIssues = croissanceIssues|merge([issue]) %}
                {% else %}
                    {% set croissanceScoreCurrent = 10 %}
                {% endif %}

                {% set supportedIds = [] %}
                {% for gg in growthGoals.CHARACTER|merge(growthGoals.RELATION) %}
                    {% for sg in gg.supportedLifeGoals %}
                        {% set supportedIds = supportedIds|merge([sg.id]) %}
                    {% endfor %}
                {% endfor %}

                {% for sg in lifeGoals.BE %}
                    {% set croissanceScoreTotal = croissanceScoreTotal + 10 %}
                    {% if sg.id not in supportedIds %}
                        {% set issue = {'type': 'WARNING', 'message': "L'objectif '" ~ sg.title ~ "' n'est soutenu par aucun axe de croissance.", 'icon': 'target', 'link': path('app_plan_wizard', {step: 7, single: 1}) ~ '&plan=CROISSANCE'} %}
                        {% set croissanceIssues = croissanceIssues|merge([issue]) %}
                    {% else %}
                        {% set croissanceScoreCurrent = croissanceScoreCurrent + 10 %}
                    {% endif %}
                {% endfor %}

                {% for gg in growthGoals.CHARACTER|merge(growthGoals.RELATION) %}
                    {% set ggStep = gg.axis.value == 'RELATION' ? 10 : 9 %}
                    {% set croissanceScoreTotal = croissanceScoreTotal + 10 %}
                    {% if gg.supportedLifeGoals|length == 0 %}
                        {% set issue = {'type': 'WARNING', 'message': "L'axe de croissance '" ~ gg.title ~ "' ne soutient aucun objectif spécifique.", 'icon': 'trending-up', 'link': path('app_plan_wizard', {step: ggStep, single: 1}) ~ '&plan=CROISSANCE'} %}
                        {% set croissanceIssues = croissanceIssues|merge([issue]) %}
                    {% else %}
                        {% set croissanceScoreCurrent = croissanceScoreCurrent + 5 %}
                    {% endif %}

                    {% if gg.habits|length == 0 %}
                        {% set issue = {'type': 'CRITICAL', 'message': "L'axe de croissance '" ~ gg.title ~ "' n'a aucun rituel d'habitude configuré.", 'icon': 'zap', 'link': path('app_plan_wizard', {step: ggStep, single: 1}) ~ '&plan=CROISSANCE'} %}
                        {% set croissanceIssues = croissanceIssues|merge([issue]) %}
                    {% else %}
                        {% set croissanceScoreCurrent = croissanceScoreCurrent + 5 %}
                    {% endif %}
                {% endfor %}
                {% set croissanceHealthScore = croissanceScoreTotal == 0 ? 0 : ((croissanceScoreCurrent / croissanceScoreTotal) * 100)|round %}
                {% if croissanceIssues|length > 0 and croissanceHealthScore == 100 %}
                    {% set croissanceHealthScore = 95 %}
                {% endif %}

                {# 2. DEVELOPPEMENT Calculations #}
                {% set developpementIssues = [] %}
                {% set developpementScoreTotal = 10 %}
                {% set developpementScoreCurrent = 0 %}
                {% if not planDeVie or not planDeVie.vision or planDeVie.vision.content|length < 20 %}
                    {% set issue = {'type': 'CRITICAL', 'message': "Rédigez votre vision pour orienter vos choix stratégiques.", 'icon': 'alert-circle', 'link': path('app_plan_wizard', {step: 6, single: 1}) ~ '&plan=DEVELOPPEMENT'} %}
                    {% set developpementIssues = developpementIssues|merge([issue]) %}
                {% else %}
                    {% set developpementScoreCurrent = 10 %}
                {% endif %}

                {% set supportedIds = [] %}
                {% for gg in growthGoals.COMPETENCE %}
                    {% for sg in gg.supportedLifeGoals %}
                        {% set supportedIds = supportedIds|merge([sg.id]) %}
                    {% endfor %}
                {% endfor %}

                {% for sg in lifeGoals.DO %}
                    {% set developpementScoreTotal = developpementScoreTotal + 10 %}
                    {% if sg.id not in supportedIds %}
                        {% set issue = {'type': 'WARNING', 'message': "L'objectif '" ~ sg.title ~ "' n'est soutenu par aucun plan de compétences.", 'icon': 'target', 'link': path('app_plan_wizard', {step: 7, single: 1}) ~ '&plan=DEVELOPPEMENT'} %}
                        {% set developpementIssues = developpementIssues|merge([issue]) %}
                    {% else %}
                        {% set developpementScoreCurrent = developpementScoreCurrent + 10 %}
                    {% endif %}
                {% endfor %}

                {% for gg in growthGoals.COMPETENCE %}
                    {% set developpementScoreTotal = developpementScoreTotal + 10 %}
                    {% if gg.supportedLifeGoals|length == 0 %}
                        {% set issue = {'type': 'WARNING', 'message': "La compétence '" ~ gg.title ~ "' ne soutient aucun objectif spécifique.", 'icon': 'trending-up', 'link': path('app_plan_wizard', {step: 8, single: 1}) ~ '&plan=DEVELOPPEMENT'} %}
                        {% set developpementIssues = developpementIssues|merge([issue]) %}
                    {% else %}
                        {% set developpementScoreCurrent = developpementScoreCurrent + 5 %}
                    {% endif %}

                    {% if gg.habits|length == 0 %}
                        {% set issue = {'type': 'CRITICAL', 'message': "La compétence '" ~ gg.title ~ "' n'a aucune routine ou plan de pratique.", 'icon': 'zap', 'link': path('app_plan_wizard', {step: 8, single: 1}) ~ '&plan=DEVELOPPEMENT'} %}
                        {% set developpementIssues = developpementIssues|merge([issue]) %}
                    {% else %}
                        {% set developpementScoreCurrent = developpementScoreCurrent + 5 %}
                    {% endif %}
                {% endfor %}
                {% set developpementHealthScore = developpementScoreTotal == 0 ? 0 : ((developpementScoreCurrent / developpementScoreTotal) * 100)|round %}
                {% if developpementIssues|length > 0 and developpementHealthScore == 100 %}
                    {% set developpementHealthScore = 95 %}
                {% endif %}

                {# 3. TRANSMISSION Calculations #}
                {% set transmissionIssues = [] %}
                {% set transmissionScoreTotal = 10 %}
                {% set transmissionScoreCurrent = 0 %}
                {% if not planDeVie or not planDeVie.vision or planDeVie.vision.content|length < 20 %}
                    {% set issue = {'type': 'CRITICAL', 'message': "Rédigez votre vision pour orienter vos choix stratégiques.", 'icon': 'alert-circle', 'link': path('app_plan_wizard', {step: 6, single: 1}) ~ '&plan=TRANSMISSION'} %}
                    {% set transmissionIssues = transmissionIssues|merge([issue]) %}
                {% else %}
                    {% set transmissionScoreCurrent = 10 %}
                {% endif %}

                {% set supportedIds = [] %}
                {% for lg in legacyGoals %}
                    {% for sg in lg.supportedLifeGoals %}
                        {% set supportedIds = supportedIds|merge([sg.id]) %}
                    {% endfor %}
                {% endfor %}

                {% for sg in lifeGoals.GIVE %}
                    {% set transmissionScoreTotal = transmissionScoreTotal + 10 %}
                    {% if sg.id not in supportedIds %}
                        {% set issue = {'type': 'WARNING', 'message': "L'objectif '" ~ sg.title ~ "' n'est soutenu par aucun projet de transmission.", 'icon': 'target', 'link': path('app_plan_wizard', {step: 11, single: 1}) ~ '&plan=TRANSMISSION'} %}
                        {% set transmissionIssues = transmissionIssues|merge([issue]) %}
                    {% else %}
                        {% set transmissionScoreCurrent = transmissionScoreCurrent + 10 %}
                    {% endif %}
                {% endfor %}

                {% for lg in legacyGoals %}
                    {% set transmissionScoreTotal = transmissionScoreTotal + 10 %}
                    {% if lg.supportedLifeGoals|length == 0 %}
                        {% set issue = {'type': 'WARNING', 'message': "Le projet de transmission '" ~ lg.title ~ "' ne soutient aucun objectif spécifique.", 'icon': 'trending-up', 'link': path('app_plan_wizard', {step: 11, single: 1}) ~ '&plan=TRANSMISSION'} %}
                        {% set transmissionIssues = transmissionIssues|merge([issue]) %}
                    {% else %}
                        {% set transmissionScoreCurrent = transmissionScoreCurrent + 5 %}
                    {% endif %}

                    {% if lg.habits|length == 0 %}
