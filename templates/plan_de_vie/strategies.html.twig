                                                                        currentAxis = {
                                                                            sourceType: '{{ type }}',
                                                                            sourceId: {{ item.id }},
                                                                            text: '{{ item.text|escape('js') }}',
                                                                            strategy: '{{ item.goal ? item.goal.strategy|escape('js') : '' }}',
