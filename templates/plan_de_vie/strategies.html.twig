                                                <div class="timeline-content">
                                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; width: 100%;">
                                                        <div class="timeline-title">{{ gg.title }}</div>
                                                        <span class="timeline-category" style="background: #FFFBEB; color: #D97706; border: 1px solid rgba(217,119,6,0.15);">
                                                            Caractère
                                                        </span>
                                                    </div>
                                                    {% if gg.strategy %}
                                                        <p style="font-size: 0.8rem; color: var(--fg-muted); margin: 0.5rem 0 0 0; line-height: 1.4;">
                                                            Stratégie : {{ gg.strategy }}
                                                        </p>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                        {% if currentYear is not null %}</div></div>{% endif %}
                                    </div>
                                {% else %}
                                    <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic; text-align: center; margin: 2rem 0;">Aucune échéance définie pour ce plan.</p>
                                {% endif %}
                            </div>

                            <!-- Competence Goals Deadlines -->
                            <div x-show="activePlan === 'DEVELOPPEMENT'">
                                {% set competenceGoalsWithDl = [] %}
                                {% for gg in growthGoals.COMPETENCE %}
                                    {% if gg.deadline %}
                                        {% set competenceGoalsWithDl = competenceGoalsWithDl|merge([gg]) %}
                                    {% endif %}
                                {% endfor %}
                                
                                {% if competenceGoalsWithDl|length > 0 %}
                                    <div class="timeline-container" style="margin-top: 0.5rem;">
                                        {% set sortedCompetenceGoals = competenceGoalsWithDl|sort((a, b) => a.deadline <=> b.deadline) %}
                                        {% set currentYear = null %}
                                        {% for gg in sortedCompetenceGoals %}
                                            {% set goalYear = gg.deadline|date('Y') %}
                                            {% if goalYear != currentYear %}
                                                {% if currentYear is not null %}</div></div>{% endif %}
                                                {% set currentYear = goalYear %}
                                                <div class="timeline-year-group">
                                                    <div class="timeline-year-heading">{{ currentYear }}</div>
                                                    <div style="display: flex; flex-direction: column; gap: 1rem; width: 100%;">
