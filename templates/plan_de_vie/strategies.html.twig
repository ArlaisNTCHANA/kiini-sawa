                                                                    <strong>Stratégie :</strong> {{ item.goal.strategy|default('Aucune stratégie définie.') }}
                                                                </div>
                                                                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.5rem;">
                                                                    {% for lg in item.goal.supportedLifeGoals %}
                                                                        <span class="ks-badge badge-secondary" style="font-size: 0.7rem; background: rgba(15,118,110,0.06); color: var(--primary);">
                                                                            {{ lg.title }}
                                                                        </span>
                                                                    {% endfor %}
                                                                </div>
                                                            {% else %}
                                                                <div style="font-size: 0.8rem; color: var(--fg-muted); font-style: italic; margin-top: 0.25rem;">
                                                                    Axe non configuré.
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        
                                                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                            {% if item.goal %}
                                                                <span style="font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.5rem; border-radius: 0.35rem; text-transform: uppercase; background: {% if item.goal.subtype == 'consolidate' %}#D1F2EB; color: #0E6251;{% else %}#FCF3CF; color: #7E5109;{% endif %}">
