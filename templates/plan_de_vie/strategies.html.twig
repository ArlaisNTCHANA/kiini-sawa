graph TD
  Vision["✨ {{ planDeVie.vision.content|default('Ma Vision')|slice(0, 60)|escape('html') }}..."]
  
  {# Specific Goals BE #}
  {% for g in lifeGoals.BE %}
    Goal{{ g.id }}["🎯 {{ g.title|escape('html') }}"]
    Vision --> Goal{{ g.id }}
  {% endfor %}

  {# Axes Caractère & Conviction (💎) et Relation & Réseau (🤝) #}
  {% for gg in growthGoals.CHARACTER|merge(growthGoals.RELATION) %}
    GG{{ gg.id }}["{{ gg.axis.value == 'RELATION' ? '🤝' : '💎' }} {{ gg.title|escape('html') }}"]
    {% for sg in gg.supportedLifeGoals %}
      Goal{{ sg.id }} --> GG{{ gg.id }}
    {% endfor %}

    {# Strategy #}
    {% if gg.strategy %}
      Strat{{ gg.id }}["📋 {{ gg.strategy|slice(0, 40)|escape('html') }}..."]
      GG{{ gg.id }} --> Strat{{ gg.id }}
      
      {# Habits #}
      {% for h in gg.habits %}
        H{{ gg.id }}_{{ h.id }}["⚡ {{ h.title|escape('html') }}"]
        Strat{{ gg.id }} --> H{{ gg.id }}_{{ h.id }}
      {% endfor %}
    {% endif %}
  {% endfor %}

  style Vision fill:#fdf4ff,stroke:#d946ef,stroke-width:2px,color:#701a75
  classDef goal fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e40af
  classDef char fill:#fffbeb,stroke:#f59e0b,stroke-width:1px,color:#92400e
  classDef strat fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#334155,stroke-dasharray: 5 5
  classDef habit fill:#ecfeff,stroke:#06b6d4,stroke-width:1px,color:#083344

  {% for g in lifeGoals.BE %}
    class Goal{{ g.id }} goal
  {% endfor %}
  {% for gg in growthGoals.CHARACTER|merge(growthGoals.RELATION) %}
    class GG{{ gg.id }} char
    class Strat{{ gg.id }} strat
    {% for h in gg.habits %}
      class H{{ gg.id }}_{{ h.id }} habit
    {% endfor %}
  {% endfor %}
