                                            </div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                            </div>

                            <!-- Growth Goals Competence -->
                            <div x-show="activePlan === 'DEVELOPPEMENT'" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 0.5rem;">
