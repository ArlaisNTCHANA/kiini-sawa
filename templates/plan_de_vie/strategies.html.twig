                                                                                    {% endfor %}
                                                                                {% endif %}
                                                                            ],
                                                                            habits: [
                                                                                {% if item.goal %}
                                                                                    {% for hab in item.goal.habits %}
                                                                                        { id: {{ hab.id }}, title: '{{ hab.title|escape('js') }}', frequency: '{{ hab.frequency.value }}' }{% if not loop.last %},{% endif %}
                                                                                    {% endfor %}
                                                                                {% endif %}
                                                                            ]
                                                                        };
                                                                        if (currentAxis.actions.length === 0) currentAxis.actions.push({ title: '', deadline: '' });
                                                                        if (currentAxis.habits.length === 0) currentAxis.habits.push({ title: '', frequency: 'DAILY' });
                                                                        showAxisModal = true;
                                                                    "
