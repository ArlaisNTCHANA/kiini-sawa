                                                        <span class="timeline-category" style="background: #EFF6FF; color: #2563EB; border: 1px solid rgba(37,99,235,0.15);">
                                                            Compétence
                                                        </span>
                                                    </div>
                                                    {% if gg.strategy %}
                                                        <p style="font-size: 0.8rem; color: var(--fg-muted); margin: 0.5rem 0 0 0; line-height: 1.4;">
                                                            Stratégie : {{ gg.strategy }}
                                                        </p>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                        {% if currentYear is not null %}</div></div>{% endif %}
                                    </div>
                                {% else %}
                                    <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic; text-align: center; margin: 2rem 0;">Aucune échéance définie pour ce plan.</p>
                                {% endif %}
                            </div>

                            <!-- Relation Goals Deadlines -->
                            <div x-show="activePlan === 'CROISSANCE'">
                                {% set relationGoalsWithDl = [] %}
                                {% for gg in growthGoals.RELATION %}
                                    {% if gg.deadline %}
                                        {% set relationGoalsWithDl = relationGoalsWithDl|merge([gg]) %}
