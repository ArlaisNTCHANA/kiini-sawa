                                        <div style="padding: 1.25rem; background: #F8FAFC; border-radius: 1rem; border: 1px solid rgba(0, 0, 0, 0.04); border-left: 4px solid #2563EB;">
                                            <h3 style="font-weight: 700; font-size: 0.95rem; color: var(--fg); margin-bottom: 0.25rem;">{{ pr.title }}</h3>
                                            {% if pr.description %}<p style="font-size: 0.85rem; color: var(--fg-muted); line-height: 1.4; margin: 0;">{{ pr.description }}</p>{% endif %}
                                        </div>
