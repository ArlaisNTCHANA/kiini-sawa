<!-- Load Mermaid.js CDN -->
<script src="{{ asset('lib/mermaid-10.9.8.min.js') }}"></script>

<script>
    function initMermaid(activePlan) {
        if (!activePlan) return;
        if (window.mermaid) {
            const srcEl = document.getElementById(`mermaid-${activePlan.toLowerCase()}-src`);
            const targetEl = document.getElementById('mermaid-target');
            if (srcEl && targetEl) {
                targetEl.removeAttribute('data-processed');
                targetEl.textContent = srcEl.textContent.trim();
                
                try {
                    window.mermaid.initialize({
                        startOnLoad: false,
                        theme: 'neutral',
                        securityLevel: 'loose',
                        flowchart: {
                            useMaxWidth: true,
                            htmlLabels: true
                        }
                    });
                    window.mermaid.run({
                        nodes: [targetEl]
                    });
                } catch (e) {
                    console.error("Mermaid run failed", e);
                }
            }
        }
    }

    async function sendPlanEmail(plan, btn) {
        if (!plan || !btn) return;
        btn.disabled = true;
        btn.style.opacity = '0.7';
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span style="margin-right: 5px;">⏳</span> Envoi...';

        let path = '';
        let toastBg = '#D97706';
        let planLabel = '';
        if (plan === 'CROISSANCE') {
            path = "{{ path('app_plan_de_croissance_email') }}";
            toastBg = '#D97706';
            planLabel = 'Plan de Croissance';
        } else if (plan === 'DEVELOPPEMENT') {
            path = "{{ path('app_plan_de_developpement_email') }}";
            toastBg = '#2563EB';
            planLabel = 'Plan de Développement';
        } else if (plan === 'TRANSMISSION') {
            path = "{{ path('app_plan_de_transmission_email') }}";
            toastBg = '#DB2777';
            planLabel = 'Plan de Transmission';
        } else if (plan === 'HYGIENE') {
            path = "{{ path('app_plan_d_hygiene_email') }}";
            toastBg = '#059669';
            planLabel = "Plan d'Hygiène de Vie";
        }

        const toast = document.getElementById('toast-strategies');

        try {
            const response = await fetch(path, { method: "POST" });
            const result = await response.json();
            if (result.success) {
                if (toast) {
                    toast.style.background = toastBg;
                    toast.innerText = `${planLabel} envoyé avec succès à ${result.emailSentTo} !`;
                    toast.style.transform = 'translateY(0)';
                    setTimeout(() => {
                        toast.style.transform = 'translateY(-100px)';
                    }, 4000);
                }
            } else {
                alert("Erreur lors de l'envoi : " + result.error);
            }
        } catch (err) {
            alert("Erreur réseau ou serveur lors de l'envoi.");
        } finally {
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.innerHTML = originalText;
        }
    }
</script>
