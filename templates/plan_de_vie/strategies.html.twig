{% extends 'base.html.twig' %}

{% block title %}Mes Plans Stratégiques — KIINI SAWA{% endblock %}

{% block body %}
<style>
    .strat-wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 8rem;
    }
    @media (min-width: 1024px) {
        .strat-wrap {
            padding: 3.5rem 2rem 5rem;
        }
    }

    /* Page Header for Hub */
    .strat-header {
        margin-bottom: 3rem;
    }
    .strat-header-icon {
        width: 3rem; height: 3rem;
        border-radius: 1rem;
        background: var(--primary-glow);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }
    .strat-title {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 2.75rem);
        color: var(--primary);
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
    .strat-desc {
        color: var(--fg-muted);
        font-size: 1.05rem;
        max-width: 650px;
        line-height: 1.6;
    }

    /* Hub Grid & Cards */
    .plans-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    @media (min-width: 640px) {
        .plans-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 1024px) {
        .plans-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .plan-hub-card {
        background: white;
        border: 1px solid rgba(15, 118, 110, 0.06);
        border-radius: 2rem;
        padding: 2rem;
        box-shadow: var(--card-shadow);
        transition: all 0.3s var(--ease);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 280px;
        cursor: pointer;
        text-align: left;
    }
    .plan-hub-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--card-shadow-hover);
        border-color: rgba(15, 118, 110, 0.15);
    }
    .plan-card-decor {
        position: absolute;
        top: -2rem; right: -2rem;
        width: 8rem; height: 8rem;
        border-radius: 50%;
        opacity: 0.03;
        transition: opacity 0.3s;
    }
    .plan-hub-card:hover .plan-card-decor {
        opacity: 0.08;
    }

    .plan-card-icon {
        width: 3.25rem; height: 3.25rem;
        border-radius: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }
    .plan-card-subtitle {
        font-size: 0.725rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--fg-muted);
        margin-bottom: 0.25rem;
    }
    .plan-card-title {
        font-family: var(--font-serif);
        font-size: 1.35rem;
        font-weight: 500;
        color: var(--fg);
        margin-bottom: 0.75rem;
    }
    .plan-card-desc {
        font-size: 0.85rem;
        color: var(--fg-muted);
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }
    .plan-card-footer {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(0, 0, 0, 0.03);
    }
    .plan-card-count {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
    }
    .plan-card-number {
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--fg);
    }
    .plan-card-label {
        font-size: 0.7rem;
        color: var(--fg-muted);
        font-weight: 600;
        text-transform: uppercase;
    }
    .plan-card-arrow {
        width: 2rem; height: 2rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }
    .plan-hub-card:hover .plan-card-arrow {
        transform: translateX(3px);
    }

    /* ──────────────────────────────────────────────────────────────────────
       REPLICATED LIFE PLAN DESIGN SYSTEM
       ────────────────────────────────────────────────────────────────────── */

    /* Choice / Welcome Hero Header */
    .hero-choice {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(15, 118, 110, 0.08);
        border-radius: 2.5rem;
        padding: 2.5rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;
    }
    .hero-choice::before {
        content: '';
        position: absolute;
        top: -10%; left: -10%;
        width: 30%; height: 50%;
        background: radial-gradient(circle, rgba(13, 148, 136, 0.08) 0%, transparent 70%);
        pointer-events: none;
    }
    .hero-choice::after {
        content: '';
        position: absolute;
        bottom: -10%; right: -10%;
        width: 40%; height: 60%;
        background: radial-gradient(circle, rgba(180, 83, 9, 0.05) 0%, transparent 70%);
        pointer-events: none;
    }
    .hero-badge {
        background: var(--primary-glow);
        color: var(--primary);
        font-size: 0.725rem;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        padding: 0.5rem 1.25rem;
        border-radius: 9999px;
        border: 1px solid rgba(15, 118, 110, 0.12);
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }
    .hero-title {
        font-family: var(--font-serif);
        font-size: clamp(1.85rem, 4.5vw, 2.85rem);
        color: var(--primary);
        font-weight: 500;
        line-height: 1.2;
        max-width: 600px;
    }
    .hero-desc {
        color: var(--fg-muted);
        font-size: 1.05rem;
        max-width: 580px;
        line-height: 1.6;
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin-top: 0.5rem;
        position: relative;
        z-index: 5;
    }
    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.95rem 1.85rem;
        background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%);
        color: white;
        font-weight: 750;
        font-size: 0.95rem;
        border-radius: 1rem;
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.3);
        transition: all 0.25s var(--ease);
    }
    .btn-hero-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(15, 118, 110, 0.45);
        opacity: 0.98;
    }
    .btn-hero-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.95rem 1.85rem;
        background: white;
        color: var(--fg-light);
        font-weight: 750;
        font-size: 0.95rem;
        border-radius: 1rem;
        border: 1px solid rgba(15, 118, 110, 0.15);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
        transition: all 0.25s var(--ease);
        cursor: pointer;
    }
    .btn-hero-secondary:hover {
        background: var(--bg-alt);
        color: var(--primary);
        border-color: var(--primary-light);
        transform: translateY(-2px);
    }
    .btn-hero-secondary.active {
        background: rgba(15, 118, 110, 0.08);
        color: var(--primary);
        border-color: var(--primary);
        box-shadow: 0 0 0 1px var(--primary);
    }

    /* Tab navigation system */
    .tabs-nav {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 0.25rem;
        border-bottom: 2px solid rgba(15, 118, 110, 0.06);
        padding-bottom: 0.25rem;
        margin-bottom: 2.5rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(15, 118, 110, 0.25) transparent;
    }
    .tabs-nav::-webkit-scrollbar {
        height: 4px;
    }
    .tabs-nav::-webkit-scrollbar-track {
        background: transparent;
    }
    .tabs-nav::-webkit-scrollbar-thumb {
        background: rgba(15, 118, 110, 0.25);
        border-radius: 99px;
    }
    .tab-btn {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.75rem 0.85rem;
        background: transparent;
        border: none;
        color: var(--fg-muted);
        font-family: inherit;
        font-weight: 650;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
        position: relative;
        transition: all 0.25s;
        border-radius: 0.75rem 0.75rem 0 0;
    }
    @media (min-width: 1024px) {
        .tabs-nav {
            flex-wrap: nowrap;
            overflow-x: visible;
            gap: 0.5rem;
        }
        .tabs-nav::-webkit-scrollbar {
            display: none;
        }
        .tab-btn {
            padding: 0.85rem 1.25rem;
            font-size: 0.925rem;
            gap: 0.5rem;
        }
    }
    .tab-btn:hover {
        color: var(--primary);
        background: rgba(15, 118, 110, 0.03);
    }
    .tab-btn.active {
        color: var(--primary);
        font-weight: 750;
    }
    .tab-btn.active::after {
        content: '';
        position: absolute;
        bottom: -4px; left: 0; right: 0;
        height: 3px;
        background: var(--primary);
        border-radius: 99px;
    }

    /* Grids & Cards */
    .cards-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @media (min-width: 768px) {
        .cards-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    .grid-full {
        grid-column: span 1;
    }
    @media (min-width: 768px) {
        .grid-full {
            grid-column: span 2;
        }
    }

    .plan-card {
        background: white;
        border: 1px solid rgba(15, 118, 110, 0.06);
        border-radius: 2rem;
        padding: 2rem;
        box-shadow: var(--card-shadow);
        transition: all 0.25s var(--ease);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        min-height: 240px;
    }
    .plan-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--card-shadow-hover);
        border-color: rgba(15, 118, 110, 0.15);
    }
    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid rgba(15, 118, 110, 0.05);
        padding-bottom: 0.75rem;
    }
    .card-title-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .card-icon {
        width: 2.25rem; height: 2.25rem;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--primary);
        margin: 0;
    }
    .btn-edit-card {
        width: 2rem; height: 2rem;
        border-radius: 50%;
        border: 1px solid rgba(15, 118, 110, 0.1);
        background: transparent;
        color: var(--fg-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-edit-card:hover {
        background: var(--primary-glow);
        color: var(--primary);
        border-color: var(--primary-light);
        transform: scale(1.05);
    }
    .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* Purpose */
    .purpose-quote {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-style: italic;
        color: var(--primary-dark);
        line-height: 1.6;
        border-left: 3px solid var(--primary-light);
        padding-left: 1rem;
        margin: 0.5rem 0;
    }

    /* Tags lists */
    .badge-flex {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .ks-badge {
        padding: 0.4rem 0.85rem;
        border-radius: 9999px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-block;
    }
    .badge-primary { background: #E6F4F1; color: #0F766E; }
    .badge-secondary { background: #FEF3C7; color: #D97706; }
    .badge-tertiary { background: #F3E8FF; color: #7E22CE; }
    .badge-neutral { background: #F1F5F9; color: #475569; }

    /* Internal balance details */
    .sub-section-title {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--fg-muted);
        margin-bottom: 0.5rem;
        margin-top: 0.5rem;
    }

    /* Timeline styles */
    .timeline-container {
        position: relative;
        padding-left: 2rem;
        border-left: 2px solid rgba(15, 118, 110, 0.08);
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 1rem;
    }
    .timeline-item {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
        width: 100%;
    }
    .timeline-dot {
        position: absolute;
        left: calc(-2rem - 6px);
        top: 0.5rem;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.12);
        z-index: 2;
    }
    .timeline-date-label {
        font-size: 0.85rem;
        font-weight: 800;
        min-width: 3.5rem;
        color: var(--primary);
        font-family: monospace;
        text-align: right;
        margin-top: 0.35rem;
        white-space: nowrap;
    }
    .timeline-content {
        flex: 1;
        background: white;
        border: 1px solid rgba(15, 118, 110, 0.06);
        border-radius: 1.25rem;
        padding: 1.25rem;
        box-shadow: var(--card-shadow);
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    .timeline-content:hover {
        transform: translateY(-2px);
        box-shadow: var(--card-shadow-hover);
        border-color: rgba(15, 118, 110, 0.15);
    }
    .timeline-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--fg);
        line-height: 1.4;
    }
    .timeline-category {
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .timeline-year-heading {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 1rem;
        position: relative;
        padding-left: 0.5rem;
    }
    .timeline-year-heading::after {
        content: '';
        position: absolute;
        bottom: -4px; left: 0;
        width: 2rem; height: 2px;
        background: var(--primary);
    }
    .timeline-year-group {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        position: relative;
    }

    /* Coherence Analysis styles */
    .analysis-score-badge {
        font-size: 0.8rem;
        font-weight: 800;
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        text-transform: uppercase;
    }
    .analysis-issue-row {
        padding: 1rem 1.25rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
    }
    .analysis-issue-content {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }
    .analysis-issue-text {
        font-size: 0.9rem;
        font-weight: 550;
        color: var(--fg-light);
        line-height: 1.45;
    }
    .btn-analysis-fix {
        background: white;
        border: 1px solid transparent;
        padding: 0.4rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.75rem;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }
    .btn-analysis-fix:hover {
        background: var(--bg-alt);
        transform: scale(1.02);
    }

    /* Mermaid Legend */
    .map-legend {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 2rem;
        padding: 1.25rem;
        background: #F8FAFC;
        border-radius: 1rem;
        border: 1px solid rgba(0,0,0,0.03);
    }
    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .legend-color {
        width: 14px; height: 14px;
        border-radius: 4px;
    }
    .legend-label {
        font-size: 0.775rem;
        font-weight: 600;
        color: var(--fg-light);
    }
</style>

<div class="strat-wrap" x-data="{ 
    activePlan: null, 
    activeTab: 'INTENTION',
    showAxisModal: false,
    showPrinciplesModal: false,
    currentAxis: { sourceType: '', sourceId: 0, text: '', strategy: '', status: 'build', lifeGoals: [], actions: [], habits: [] },
    customPrinciples: [],
    hasProposed(title) {
        const activeTitles = {
            'CROISSANCE': [
                {% for pr in growthPrinciples.CROISSANCE %}
                    '{{ pr.title|escape('js') }}',
                {% endfor %}
            ],
            'DEVELOPPEMENT': [
                {% for pr in growthPrinciples.DEVELOPPEMENT %}
                    '{{ pr.title|escape('js') }}',
                {% endfor %}
            ],
            'TRANSMISSION': [
                {% for pr in growthPrinciples.TRANSMISSION %}
                    '{{ pr.title|escape('js') }}',
                {% endfor %}
            ],
            'HYGIENE': [
                {% for pr in growthPrinciples.HYGIENE %}
                    '{{ pr.title|escape('js') }}',
                {% endfor %}
            ]
        };
        const plan = this.activePlan || 'CROISSANCE';
        return (activeTitles[plan] || []).includes(title);
    }
}" x-init="
    $watch('activePlan', value => {
        if (value) {
            $nextTick(() => {
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons();
                }
            });
        }
    });
    const params = new URLSearchParams(window.location.search);
    const p = params.get('plan') || params.get('activePlan') || {{ (initialPlan ?? null)|json_encode }};
    const t = params.get('tab') || params.get('activeTab');
    if (p && ['CROISSANCE', 'DEVELOPPEMENT', 'TRANSMISSION', 'HYGIENE'].includes(p)) {
        activePlan = p;
    }
    if (t) {
        activeTab = t;
        if (t === 'MAP' && activePlan) {
            $nextTick(() => initMermaid(activePlan));
        }
    }
    $nextTick(() => {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });
">

    {# ──────────────────────────────────────────────────────────────────────
       HUB VIEW (Active Plan is Null)
       ────────────────────────────────────────────────────────────────────── #}
    <div x-show="activePlan === null" x-transition:enter="transition ease-out duration-300">
        <header class="strat-header">
            <div class="strat-header-icon">
                <i data-lucide="sparkles" style="width: 24px; height: 24px;"></i>
            </div>
            <h1 class="strat-title">Plans Stratégiques</h1>
            <p class="strat-desc">
                Pilotez votre évolution à travers quatre piliers fondamentaux. Vos objectifs de vie sont ici transformés en systèmes concrets d'exécution.
            </p>
        </header>

        <div class="plans-grid">
            {# 1. Plan de Croissance #}
            <div @click="activePlan = 'CROISSANCE'; activeTab = 'INTENTION'" class="plan-hub-card">
                <div class="plan-card-decor bg-gradient-to-br from-amber-400 to-orange-500"></div>
                <div class="plan-card-icon" style="background: #FFFBEB; color: #D97706;">
                    <i data-lucide="zap" style="width: 22px; height: 22px;"></i>
                </div>
                <div>
                    <div class="plan-card-subtitle">L'Évolution (BE)</div>
                    <h2 class="plan-card-title">Croissance</h2>
                    <p class="plan-card-desc">Caractère & Conviction, Relation & Réseau, Valeurs d'alignement.</p>
                </div>
                <div class="plan-card-footer">
                    <div class="plan-card-count">
                        <span class="plan-card-number">{{ growthGoals.CHARACTER|length + growthGoals.RELATION|length }}</span>
                        <span class="plan-card-label">éléments</span>
                    </div>
                    <div class="plan-card-arrow" style="background: #FFFBEB; color: #D97706;">
                        <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </div>
                </div>
            </div>

            {# 2. Plan de Développement #}
            <div @click="activePlan = 'DEVELOPPEMENT'; activeTab = 'INTENTION'" class="plan-hub-card">
                <div class="plan-card-decor bg-gradient-to-br from-blue-400 to-indigo-600"></div>
                <div class="plan-card-icon" style="background: #EFF6FF; color: #2563EB;">
                    <i data-lucide="graduation-cap" style="width: 22px; height: 22px;"></i>
                </div>
                <div>
                    <div class="plan-card-subtitle">L'Exécution (DO)</div>
                    <h2 class="plan-card-title">Développement</h2>
                    <p class="plan-card-desc">Compétences à acquérir, Formations & Livres d'étude.</p>
                </div>
                <div class="plan-card-footer">
                    <div class="plan-card-count">
                        <span class="plan-card-number">{{ growthGoals.COMPETENCE|length }}</span>
                        <span class="plan-card-label">éléments</span>
                    </div>
                    <div class="plan-card-arrow" style="background: #EFF6FF; color: #2563EB;">
                        <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </div>
                </div>
            </div>

            {# 3. Plan de Transmission #}
            <div @click="activePlan = 'TRANSMISSION'; activeTab = 'INTENTION'" class="plan-hub-card">
                <div class="plan-card-decor bg-gradient-to-br from-pink-400 to-rose-600"></div>
                <div class="plan-card-icon" style="background: #FDF2F8; color: #DB2777;">
                    <i data-lucide="heart" style="width: 22px; height: 22px;"></i>
                </div>
                <div>
                    <div class="plan-card-subtitle">L'Impact (GIVE)</div>
                    <h2 class="plan-card-title">Transmission</h2>
                    <p class="plan-card-desc">Projets de legs, Mentorat & Service.</p>
                </div>
                <div class="plan-card-footer">
                    <div class="plan-card-count">
                        <span class="plan-card-number">{{ legacyGoals|length }}</span>
                        <span class="plan-card-label">éléments</span>
                    </div>
                    <div class="plan-card-arrow" style="background: #FDF2F8; color: #DB2777;">
                        <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </div>
                </div>
            </div>

            {# 4. Plan d'Hygiène #}
            <div @click="activePlan = 'HYGIENE'; activeTab = 'INTENTION'" class="plan-hub-card">
                <div class="plan-card-decor bg-gradient-to-br from-emerald-400 to-teal-600"></div>
                <div class="plan-card-icon" style="background: #ECFDF5; color: #059669;">
                    <i data-lucide="shield" style="width: 22px; height: 22px;"></i>
                </div>
                <div>
                    <div class="plan-card-subtitle">Le Système</div>
                    <h2 class="plan-card-title">Hygiène de Vie</h2>
                    <p class="plan-card-desc">Sommeil, Nutrition, Sport, Méditation & Environnement.</p>
                </div>
                <div class="plan-card-footer">
                    <div class="plan-card-count">
                        <span class="plan-card-number">{{ hygieneDomains|length }}</span>
                        <span class="plan-card-label">domaines</span>
                    </div>
                    <div class="plan-card-arrow" style="background: #ECFDF5; color: #059669;">
                        <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ──────────────────────────────────────────────────────────────────────
       DETAILED VIEW (Active Plan is Set)
       ────────────────────────────────────────────────────────────────────── #}
    <div x-show="activePlan !== null" x-cloak x-transition:enter="transition ease-out duration-300">
        
        <!-- Hero Header (Replicating Life Plan style) -->
        <header class="hero-choice" style="margin-bottom: 2rem;">
            <div class="hero-badge" 
                 :style="activePlan === 'CROISSANCE' ? 'background: #FFFBEB; color: #D97706; border-color: rgba(217, 119, 6, 0.15);' : 
                         (activePlan === 'DEVELOPPEMENT' ? 'background: #EFF6FF; color: #2563EB; border-color: rgba(37, 99, 235, 0.15);' : 
                          (activePlan === 'TRANSMISSION' ? 'background: #FDF2F8; color: #DB2777; border-color: rgba(219, 39, 119, 0.15);' : 
                           'background: #ECFDF5; color: #059669; border-color: rgba(5, 150, 105, 0.15);'))">
                <template x-if="activePlan === 'CROISSANCE'"><span style="display:flex; align-items:center; gap:0.25rem;"><i data-lucide="zap" style="width: 14px; height: 14px;"></i> Plan de Croissance</span></template>
                <template x-if="activePlan === 'DEVELOPPEMENT'"><span style="display:flex; align-items:center; gap:0.25rem;"><i data-lucide="graduation-cap" style="width: 14px; height: 14px;"></i> Plan de Développement</span></template>
                <template x-if="activePlan === 'TRANSMISSION'"><span style="display:flex; align-items:center; gap:0.25rem;"><i data-lucide="heart" style="width: 14px; height: 14px;"></i> Plan de Transmission</span></template>
                <template x-if="activePlan === 'HYGIENE'"><span style="display:flex; align-items:center; gap:0.25rem;"><i data-lucide="shield" style="width: 14px; height: 14px;"></i> Plan d'Hygiène de Vie</span></template>
            </div>
            <h1 class="hero-title"
                x-text="activePlan === 'CROISSANCE' ? 'Plan de Croissance' : 
                        (activePlan === 'DEVELOPPEMENT' ? 'Plan de Développement' : 
                         (activePlan === 'TRANSMISSION' ? 'Plan de Transmission' : 'Plan d\'Hygiène de Vie'))">
            </h1>
            <p class="hero-desc"
               x-text="activePlan === 'CROISSANCE' ? 'Pilotez l\'évolution de votre Être (BE). Alignez votre caractère, vos convictions et vos valeurs.' : 
                       (activePlan === 'DEVELOPPEMENT' ? 'Pilotez l\'exécution de votre Talent (DO). Développez vos compétences et vos connaissances.' : 
                        (activePlan === 'TRANSMISSION' ? 'Pilotez l\'impact de votre Vision (GIVE). Organisez votre mentorat, service et projets de legs.' : 
                         'Gériez vos systèmes quotidiens : sommeil, nutrition, sport et environnement vital.'))">
            </p>
            <div class="hero-actions">
                <button @click="activePlan = null" class="btn-hero-secondary">
                    <i data-lucide="layout-dashboard" style="width: 18px; height: 18px;"></i>
                    Retour aux Plans
                </button>
                <a :href="activePlan ? '{{ path('app_plan_wizard') }}?plan=' + activePlan : '{{ path('app_plan_wizard') }}'" class="btn-hero-primary">
                    <i data-lucide="sparkles" style="width: 18px; height: 18px;"></i>
                    Lancer l'Assistant Guidé
                </a>
                <template x-if="activePlan === 'CROISSANCE'">
                    <span style="display: inline-flex; gap: 1rem; flex-wrap: wrap;">
                        <a href="{{ path('app_plan_de_croissance_visualize') }}" target="_blank" class="btn-hero-secondary">
                            <i data-lucide="printer" style="width: 18px; height: 18px;"></i>
                            Visualiser & Imprimer
                        </a>
                        <button @click="sendPlanEmail('CROISSANCE', $event.currentTarget)" class="btn-hero-secondary">
                            <i data-lucide="mail" style="width: 18px; height: 18px;"></i>
                            M'envoyer par email
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'MAP'; $nextTick(() => initMermaid('CROISSANCE'))">
                            <i data-lucide="map" style="width: 18px; height: 18px;"></i>
                            Carte
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'ANALYSIS'">
                            <i data-lucide="activity" style="width: 18px; height: 18px;"></i>
                            Analyse
                        </button>
                    </span>
                </template>
                <template x-if="activePlan === 'DEVELOPPEMENT'">
                    <span style="display: inline-flex; gap: 1rem; flex-wrap: wrap;">
                        <a href="{{ path('app_plan_de_developpement_visualize') }}" target="_blank" class="btn-hero-secondary">
                            <i data-lucide="printer" style="width: 18px; height: 18px;"></i>
                            Visualiser & Imprimer
                        </a>
                        <button @click="sendPlanEmail('DEVELOPPEMENT', $event.currentTarget)" class="btn-hero-secondary">
                            <i data-lucide="mail" style="width: 18px; height: 18px;"></i>
                            M'envoyer par email
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'MAP'; $nextTick(() => initMermaid('DEVELOPPEMENT'))">
                            <i data-lucide="map" style="width: 18px; height: 18px;"></i>
                            Carte
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'ANALYSIS'">
                            <i data-lucide="activity" style="width: 18px; height: 18px;"></i>
                            Analyse
                        </button>
                    </span>
                </template>
                <template x-if="activePlan === 'TRANSMISSION'">
                    <span style="display: inline-flex; gap: 1rem; flex-wrap: wrap;">
                        <a href="{{ path('app_plan_de_transmission_visualize') }}" target="_blank" class="btn-hero-secondary">
                            <i data-lucide="printer" style="width: 18px; height: 18px;"></i>
                            Visualiser & Imprimer
                        </a>
                        <button @click="sendPlanEmail('TRANSMISSION', $event.currentTarget)" class="btn-hero-secondary">
                            <i data-lucide="mail" style="width: 18px; height: 18px;"></i>
                            M'envoyer par email
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'MAP'; $nextTick(() => initMermaid('TRANSMISSION'))">
                            <i data-lucide="map" style="width: 18px; height: 18px;"></i>
                            Carte
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'ANALYSIS'">
                            <i data-lucide="activity" style="width: 18px; height: 18px;"></i>
                            Analyse
                        </button>
                    </span>
                </template>
                <template x-if="activePlan === 'HYGIENE'">
                    <span style="display: inline-flex; gap: 1rem; flex-wrap: wrap;">
                        <a href="{{ path('app_plan_d_hygiene_visualize') }}" target="_blank" class="btn-hero-secondary">
                            <i data-lucide="printer" style="width: 18px; height: 18px;"></i>
                            Visualiser & Imprimer
                        </a>
                        <button @click="sendPlanEmail('HYGIENE', $event.currentTarget)" class="btn-hero-secondary">
                            <i data-lucide="mail" style="width: 18px; height: 18px;"></i>
                            M'envoyer par email
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'MAP'; $nextTick(() => initMermaid('HYGIENE'))">
                            <i data-lucide="map" style="width: 18px; height: 18px;"></i>
                            Carte
                        </button>
                        <button class="btn-hero-secondary" @click="activeTab = 'ANALYSIS'">
                            <i data-lucide="activity" style="width: 18px; height: 18px;"></i>
                            Analyse
                        </button>
                    </span>
                </template>
            </div>
        </header>

        <!-- Sub-tabs Navigation (Replicating Life Plan style) -->
        <nav class="tabs-nav">
            <button @click="activeTab = 'INTENTION'" :class="activeTab === 'INTENTION' ? 'active' : ''" class="tab-btn">
                <i data-lucide="compass" style="width: 16px; height: 16px;"></i> Intention
            </button>
            <button @click="activeTab = 'PRIORITIES'" :class="activeTab === 'PRIORITIES' ? 'active' : ''" class="tab-btn">
                <i data-lucide="target" style="width: 16px; height: 16px;"></i>
                <span x-text="activePlan === 'CROISSANCE' ? 'Axes de Croissance' : 
                             (activePlan === 'DEVELOPPEMENT' ? 'Axes de Développement' : 
                              (activePlan === 'TRANSMISSION' ? 'Axes de Transmission' : 'Axes d\'Hygiène'))"></span>
            </button>
            <button @click="activeTab = 'LAWS'" :class="activeTab === 'LAWS' ? 'active' : ''" class="tab-btn">
                <i data-lucide="scale" style="width: 16px; height: 16px;"></i> Lois & Principes
            </button>
            <button @click="activeTab = 'SYSTEM'" :class="activeTab === 'SYSTEM' ? 'active' : ''" class="tab-btn">
                <i data-lucide="activity" style="width: 16px; height: 16px;"></i> Système
            </button>
            <button @click="activeTab = 'TIMELINE'" :class="activeTab === 'TIMELINE' ? 'active' : ''" class="tab-btn">
                <i data-lucide="calendar" style="width: 16px; height: 16px;"></i> Échéancier
            </button>
        </nav>

        <!-- Content Area -->
        <div style="margin-top: 1rem;">

            {# ════════════════ 1. INTENTION TAB ════════════════ #}
            <div x-show="activeTab === 'INTENTION'">
                <div class="cards-grid">
                    <!-- Card 1: Déclaration d'Intention & Vision -->
                    <div class="plan-card">
                        <div class="card-header">
                            <div class="card-title-group">
                                <div class="card-icon" style="background: rgba(13, 148, 136, 0.08); color: var(--primary);">
                                    <i data-lucide="compass" style="width: 18px; height: 18px;"></i>
                                </div>
                                <h2 class="card-title">Intention & Raison d'être</h2>
                            </div>
                            <a :href="'{{ path('app_plan_wizard', { step: 1, single: 1 }) }}&plan=' + activePlan" class="btn-edit-card" title="Modifier la raison d'être">
                                <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                            </a>
                        </div>
                        <div class="card-body">
                            <p style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.25rem;"
                               :style="activePlan === 'CROISSANCE' ? 'color: #D97706;' : 
                                       (activePlan === 'DEVELOPPEMENT' ? 'color: #2563EB;' : 
                                        (activePlan === 'TRANSMISSION' ? 'color: #DB2777;' : 'color: #059669;'))">
                                Intention de ce pilier
                            </p>
                            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 800; margin: 0 0 1rem 0;"
                                :style="activePlan === 'CROISSANCE' ? 'color: #D97706;' : 
                                        (activePlan === 'DEVELOPPEMENT' ? 'color: #2563EB;' : 
                                         (activePlan === 'TRANSMISSION' ? 'color: #DB2777;' : 'color: #059669;'))">
                                Ce que je vais <span style="text-decoration: underline; text-decoration-style: wavy; text-underline-offset: 4px;"
                                                    x-text="activePlan === 'CROISSANCE' ? 'DEVENIR' : 
                                                            (activePlan === 'DEVELOPPEMENT' ? 'ACCOMPLIR' : 
                                                             (activePlan === 'TRANSMISSION' ? 'LÉGUER' : 'MAÎTRISER'))"></span>
                            </h3>
                            
                            <div class="sub-section-title">Ma Raison d'être & Mission</div>
                            <p style="font-size: 0.95rem; font-weight: 600; color: var(--fg); line-height: 1.6; margin: 0 0 1rem 0;">
                                {{ planDeVie.purpose.statement|default('Aucune mission de vie définie.') }}
                            </p>

                            <div class="sub-section-title">Ma Vision</div>
                            <div class="purpose-quote">
                                "{{ planDeVie.vision.content|default('Aucune vision définie.') }}"
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Objectifs Spécifiques Associés -->
                    <div class="plan-card">
                        <div class="card-header">
                            <div class="card-title-group">
                                <div class="card-icon" style="background: rgba(59, 130, 246, 0.08); color: #3b82f6;">
                                    <i data-lucide="target" style="width: 18px; height: 18px;"></i>
                                </div>
                                <h2 class="card-title">Objectifs Spécifiques Associés</h2>
                            </div>
                            <a :href="'{{ path('app_plan_wizard', { step: 7, single: 1 }) }}&plan=' + activePlan" class="btn-edit-card" title="Modifier les objectifs">
                                <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                            </a>
                        </div>
                        <div class="card-body">
                            <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.5rem;">
                                {# Loop on goals character (BE) #}
                                <div x-show="activePlan === 'CROISSANCE'" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    {% for goal in lifeGoals.BE %}
                                        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 0.75rem; border-left: 3px solid #D97706;">
                                            <i data-lucide="arrow-up-right" style="width: 14px; height: 14px; color: #D97706; flex-shrink: 0;"></i>
                                            <span style="font-size: 0.9rem; color: var(--fg-light); font-weight: 600;">{{ goal.title }}</span>
                                        </div>
                                    {% else %}
                                        <p style="font-size: 0.85rem; color: var(--fg-muted); font-style: italic;">Aucun objectif spécifique de type 'BE' lié.</p>
                                    {% endfor %}
                                </div>
                                {# Loop on competence goals (DO) #}
                                <div x-show="activePlan === 'DEVELOPPEMENT'" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    {% for goal in lifeGoals.DO %}
                                        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 0.75rem; border-left: 3px solid #2563EB;">
                                            <i data-lucide="arrow-up-right" style="width: 14px; height: 14px; color: #2563EB; flex-shrink: 0;"></i>
                                            <span style="font-size: 0.9rem; color: var(--fg-light); font-weight: 600;">{{ goal.title }}</span>
                                        </div>
                                    {% else %}
                                        <p style="font-size: 0.85rem; color: var(--fg-muted); font-style: italic;">Aucun objectif spécifique de type 'DO' lié.</p>
                                    {% endfor %}
                                </div>
                                {# Loop on transmission goals (GIVE) #}
                                <div x-show="activePlan === 'TRANSMISSION'" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    {% for goal in lifeGoals.GIVE %}
                                        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 0.75rem; border-left: 3px solid #DB2777;">
                                            <i data-lucide="arrow-up-right" style="width: 14px; height: 14px; color: #DB2777; flex-shrink: 0;"></i>
                                            <span style="font-size: 0.9rem; color: var(--fg-light); font-weight: 600;">{{ goal.title }}</span>
                                        </div>
                                    {% else %}
                                        <p style="font-size: 0.85rem; color: var(--fg-muted); font-style: italic;">Aucun objectif spécifique de type 'GIVE' lié.</p>
                                    {% endfor %}
                                </div>
                                {# Loop on hygiene goals (HAVE) #}
                                <div x-show="activePlan === 'HYGIENE'" style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    {% for goal in lifeGoals.HAVE %}
                                        <div style="display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; background: #F8FAFC; border-radius: 0.75rem; border-left: 3px solid #059669;">
                                            <i data-lucide="arrow-up-right" style="width: 14px; height: 14px; color: #059669; flex-shrink: 0;"></i>
                                            <span style="font-size: 0.9rem; color: var(--fg-light); font-weight: 600;">{{ goal.title }}</span>
                                        </div>
                                    {% else %}
                                        <p style="font-size: 0.85rem; color: var(--fg-muted); font-style: italic;">Aucun objectif spécifique de type 'HAVE' lié.</p>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 3: Diagnostic Vitalité (HYGIENE Only) -->
                    <div class="plan-card grid-full" x-show="activePlan === 'HYGIENE'">
                        <div class="card-header">
                            <div class="card-title-group">
                                <div class="card-icon" style="background: rgba(16, 185, 129, 0.08); color: #10b981;">
                                    <i data-lucide="heart-pulse" style="width: 18px; height: 18px;"></i>
                                </div>
                                <h2 class="card-title">Diagnostic Vitalité</h2>
                            </div>
                            <a :href="'{{ path('app_plan_wizard', { step: 12, single: 1 }) }}&plan=' + activePlan" class="btn-edit-card" title="Modifier le diagnostic d'hygiène">
                                <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                            </a>
                        </div>
                        <div class="card-body">
                            {% if hygieneDomains|length > 0 %}
                                <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 0.5rem;">
                                    {% for category, hds in groupedHygieneDomains %}
                                        {% if hds|length > 0 %}
                                            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                                <div style="font-size: 0.72rem; font-weight: 800; color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 0.25rem;">
                                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--primary);"></span>
                                                    {{ category }}
                                                </div>
                                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.5rem;">
                                                    {% for hd in hds %}
                                                        <div style="background: #F8FAFC; padding: 0.6rem 0.85rem; border-radius: 0.75rem; border: 1px solid rgba(0,0,0,0.04); display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                                                            <span style="font-size: 0.82rem; font-weight: 600; color: var(--fg-light);">{{ hd.name }}</span>
                                                            <span style="font-size: 0.7rem; font-weight: 800; padding: 0.15rem 0.4rem; border-radius: 5px; text-transform: uppercase; background: {% if hd.subtype == 'leverage' %}#D1F2EB; color: #0E6251;{% elseif hd.subtype == 'consolidate' %}#D5F5E3; color: #196F3D;{% else %}#FCF3CF; color: #7E5109;{% endif %}">
                                                                {{ hd.subtype == 'leverage' ? 'À exploiter' : (hd.subtype == 'consolidate' ? 'À consolider' : 'À construire') }}
                                                            </span>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p style="font-size: 0.85rem; color: var(--fg-muted); font-style: italic; margin: 0;">Aucun domaine d'hygiène n'est configuré pour le moment.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# ════════════════ 2. PRIORITIES TAB ════════════════ #}
            <div x-show="activeTab === 'PRIORITIES'">
                <div class="cards-grid">
                    <div class="plan-card grid-full">
                        <div class="card-header">
                            <div class="card-title-group">
                                <div class="card-icon" style="background: rgba(13, 148, 136, 0.08); color: var(--primary);">
                                    <i data-lucide="target" style="width: 18px; height: 18px;"></i>
                                </div>
                                <h2 class="card-title" x-text="activePlan === 'CROISSANCE' ? 'Axes de Croissance' : 
                                                               (activePlan === 'DEVELOPPEMENT' ? 'Axes de Développement' : 
                                                                (activePlan === 'TRANSMISSION' ? 'Axes de Transmission' : 'Axes d\'Hygiène'))">Axes</h2>
                            </div>
                            <a :href="activePlan === 'CROISSANCE' ? '{{ path('app_plan_wizard', { step: 9, single: 1 }) }}&plan=CROISSANCE' : 
                                      (activePlan === 'DEVELOPPEMENT' ? '{{ path('app_plan_wizard', { step: 8, single: 1 }) }}&plan=DEVELOPPEMENT' : 
                                       (activePlan === 'TRANSMISSION' ? '{{ path('app_plan_wizard', { step: 11, single: 1 }) }}&plan=TRANSMISSION' : 
                                        '{{ path('app_plan_wizard', { step: 12, single: 1 }) }}&plan=HYGIENE'))"
                               class="btn-edit-card" title="Modifier les axes">
                                <i data-lucide="pencil" style="width: 14px; height: 14px;"></i>
                            </a>
                        </div>
                        <div class="card-body">
                            <!-- Growth Goals Character -->
                            <div x-show="activePlan === 'CROISSANCE'" style="display: flex; flex-direction: column; gap: 1.5rem; margin-top: 0.5rem;">
                                {% set categoriesMeta = {
                                    'LIMITING_BELIEF': {'label': 'Croyances Limitantes', 'icon': 'shield-alert', 'color': '#EF4444', 'bg': '#FEF2F2'},
                                    'COUNTER_VALUE': {'label': 'Contre-valeurs observées', 'icon': 'shield-x', 'color': '#F59E0B', 'bg': '#FFFBEB'},
                                    'DECLARED_VALUE': {'label': 'Valeurs déclarées & admirées', 'icon': 'star', 'color': '#3B82F6', 'bg': '#EFF6FF'},
                                    'CONVICTION': {'label': 'Caractère & Convictions', 'icon': 'heart', 'color': '#10B981', 'bg': '#ECFDF5'}
                                } %}

                                {% for type, meta in categoriesMeta %}
                                    {% set axesList = croissanceAxes[type] ?? [] %}
                                    {% if axesList|length > 0 %}
                                        <div style="background: white; border-radius: 1rem; border: 1px solid rgba(15, 118, 110, 0.08); padding: 1.25rem;">
                                            <h3 style="font-size: 1rem; font-weight: 700; color: {{ meta.color }}; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem 0;">
                                                <i data-lucide="{{ meta.icon }}" style="width: 18px; height: 18px;"></i>
                                                {{ meta.label }}
                                            </h3>
                                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                                {% for item in axesList %}
                                                    <div style="padding: 1rem; background: #F8FAFC; border-radius: 0.75rem; border: 1px solid rgba(0,0,0,0.02); display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
                                                        <div style="flex: 1; min-width: 250px;">
                                                            <div style="font-weight: 600; font-size: 0.95rem; color: var(--fg);">{{ item.text }}</div>
