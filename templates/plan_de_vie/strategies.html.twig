                                        <p style="font-size: 0.9rem; color: var(--fg-muted); font-style: italic;">Aucun principe de développement défini.</p>
                                    {% endfor %}
                                </div>

                                <!-- Growth principles matching TRANSMISSION -->
                                <div x-show="activePlan === 'TRANSMISSION'" style="display: flex; flex-direction: column; gap: 1rem;">
                                    {% for pr in growthPrinciples.TRANSMISSION %}
                                        <div style="padding: 1.25rem; background: #F8FAFC; border-radius: 1rem; border: 1px solid rgba(0, 0, 0, 0.04); border-left: 4px solid #DB2777;">
                                            <h3 style="font-weight: 700; font-size: 0.95rem; color: var(--fg); margin-bottom: 0.25rem;">{{ pr.title }}</h3>
