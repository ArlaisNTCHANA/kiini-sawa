{% extends 'base.html.twig' %}

{% block title %}Historique de mes plans{% endblock %}

{% block body %}
<div style="max-width: 760px; margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <a href="{{ path('app_plan_de_vie') }}" class="ks-header__back">← Plan de Vie</a>
    <h1 class="ks-header__title">Historique de mes plans</h1>
    <p style="color: var(--fg-muted); margin: .35rem 0 1.75rem;">Une version est enregistrée à chaque revue mensuelle et après chaque passage complet dans l'assistant. Relisez d'où vous venez.</p>

    <form method="post" action="{{ path('app_plan_history_save') }}" style="display: flex; gap: .6rem; flex-wrap: wrap; background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 1rem; margin-bottom: 1.5rem;">
        <input name="title" maxlength="200" placeholder="Nom de la version (facultatif), ex. « Avant ma reconversion »" style="flex: 1; min-width: 220px; padding: .65rem .85rem; border: 1.5px solid var(--border); border-radius: var(--r-md); font: inherit;">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('plan_history') }}">
        <button type="submit" style="padding: .65rem 1.1rem; border: none; border-radius: var(--r-md); background: var(--primary); color: #fff; font: inherit; font-weight: 600; cursor: pointer;">Enregistrer une version</button>
    </form>

    {% for v in versions %}
        <a href="{{ path('app_plan_history_show', {id: v.id}) }}" style="display: flex; justify-content: space-between; gap: 1rem; background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 1rem 1.2rem; margin-bottom: .6rem; text-decoration: none; color: var(--fg);">
            <span style="font-weight: 600;">{{ v.title }}</span>
            <span style="color: var(--fg-muted); font-size: .85rem; flex-shrink: 0;">{{ v.createdAt|format_date(pattern: 'd MMMM y', locale: 'fr') }}</span>
        </a>
    {% else %}
        <p style="color: var(--fg-muted); text-align: center; padding: 2rem;">Aucune version pour l'instant.</p>
    {% endfor %}
</div>
{% endblock %}
