{% extends 'admin/layout.html.twig' %}

{% block title %}Paiements{% endblock %}
{% block page_title %}Paiements et revenus{% endblock %}
{% block page_lead %}Validez les virements et paiements Mobile Money reçus, puis suivez ce que KIINI SAWA encaisse.{% endblock %}

{% block content %}
<div class="ks-stack">
    <div class="ks-stat-grid">
        <div class="ks-stat{{ pending|length ? ' ks-stat--attention' }}"><div class="ks-stat__value">{{ pending|length }}</div><div class="ks-stat__label">paiement(s) à vérifier</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ proCount }}</div><div class="ks-stat__label">abonnés PRO payants actifs</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ trialCount }}</div><div class="ks-stat__label">essais en cours</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ userCount }}</div><div class="ks-stat__label">comptes</div></div>
        <div class="ks-stat"><div class="ks-stat__value" style="font-size: 1.2rem;">{% for cur, total in totals %}{{ total|money(cur) }}<br>{% else %}—{% endfor %}</div><div class="ks-stat__label">encaissé depuis le début</div></div>
    </div>

    <section class="ks-card" aria-labelledby="pay-pending">
        <h2 class="ks-card__title" id="pay-pending"><i data-lucide="wallet"></i> À vérifier</h2>
        <p class="ks-muted" style="margin-bottom: 1rem;">Vérifiez la réception sur votre compte bancaire ou Mobile Money avant de valider. La validation active PRO et envoie le reçu au client.</p>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Membre</th><th>Montant</th><th>Moyen de paiement</th><th>Décision</th></tr></thead>
                <tbody>
                {% for t in pending %}
                    <tr>
                        <td><strong>{{ t.subscription.user.displayName }}</strong><br><span class="ks-small">{{ t.subscription.user.email }}</span></td>
                        <td data-label="Montant"><span><strong>{{ t.amount|money(t.currency) }}</strong><br><span class="ks-small">{{ t.description }}</span></span></td>
                        <td data-label="Moyen"><span>{{ t.methodLabel }}<br><span class="ks-small">réf. <strong>{{ t.reference ?: '—' }}</strong>{{ t.paidAt ? ' · payé le ' ~ t.paidAt|date('d/m/Y') }}</span></span></td>
                        <td data-label="">
                            <div class="ks-stack" style="gap: .5rem;">
                                <form method="post" action="{{ path('admin_payments_validate', {id: t.id}) }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_payment') }}">
                                    <button class="ks-btn ks-btn--primary ks-btn--sm" type="submit"><i data-lucide="check"></i> Reçu, valider</button>
                                </form>
                                <form method="post" action="{{ path('admin_payments_reject', {id: t.id}) }}" class="ks-inline-form">
                                    <input class="ks-input ks-input--sm" name="reason" placeholder="Motif du refus" required aria-label="Motif du refus">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_payment') }}">
                                    <button class="ks-btn ks-btn--danger ks-btn--sm" type="submit">Refuser</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty"><i data-lucide="check" class="ks-ico"></i> Aucun paiement en attente.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="ks-card" id="commandes" aria-labelledby="pay-orders">
        <h2 class="ks-card__title" id="pay-orders"><i data-lucide="building-2"></i> Commandes de places (organisations)</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Organisation</th><th>Montant</th><th>Moyen de paiement</th><th>Décision</th></tr></thead>
                <tbody>
                {% for o in pendingOrders %}
                    <tr>
                        <td><strong>{{ o.organisation.name }}</strong><br><span class="ks-small">{{ o.orderedBy ? o.orderedBy.email }}</span></td>
                        <td data-label="Montant"><span><strong>{{ o.amount|money(o.currency) }}</strong><br><span class="ks-small">{{ o.seats }} places, 1 an</span></span></td>
                        <td data-label="Moyen"><span>{{ o.methodLabel }}<br><span class="ks-small">réf. <strong>{{ o.reference ?: '—' }}</strong></span></span></td>
                        <td data-label="">
                            <div class="ks-stack" style="gap: .5rem;">
                                <form method="post" action="{{ path('admin_seat_order', {id: o.id, decision: 'valider'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_payment') }}"><button class="ks-btn ks-btn--primary ks-btn--sm" type="submit"><i data-lucide="check"></i> Reçu, activer</button></form>
                                <form method="post" action="{{ path('admin_seat_order', {id: o.id, decision: 'refuser'}) }}" class="ks-inline-form"><input class="ks-input ks-input--sm" name="reason" placeholder="Motif du refus" required aria-label="Motif du refus"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_payment') }}"><button class="ks-btn ks-btn--danger ks-btn--sm" type="submit">Refuser</button></form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Aucune commande en attente.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="ks-card" aria-labelledby="pay-months">
        <h2 class="ks-card__title" id="pay-months"><i data-lucide="bar-chart-2"></i> Revenus par mois</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Mois</th><th>Devise</th><th class="is-num">Paiements</th><th class="is-num">Total</th></tr></thead>
                <tbody>
                {% for r in revenue %}
                    <tr><td>{{ r.month }}</td><td data-label="Devise">{{ r.currency }}</td><td data-label="Paiements" class="is-num">{{ r.count }}</td><td data-label="Total" class="is-num"><strong>{{ r.total|money(r.currency) }}</strong></td></tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Pas encore de revenus.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="ks-card" aria-labelledby="pay-done">
        <h2 class="ks-card__title" id="pay-done"><i data-lucide="history"></i> Derniers paiements traités</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Date</th><th>Membre</th><th>Montant</th><th>Décision</th></tr></thead>
                <tbody>
                {% for t in processed %}
                    <tr>
                        <td>{{ t.processedAt ? t.processedAt|date('d/m/Y') }}</td>
                        <td data-label="Membre" style="overflow-wrap: anywhere;">{{ t.subscription.user.email }}</td>
                        <td data-label="Montant">{{ t.method == 'GIFT' ? 'Offert' : t.amount|money(t.currency) }} · {{ t.methodLabel }}</td>
                        <td data-label="Décision">{% if t.status == 'VALIDATED' %}<span class="ks-badge ks-badge--success">Validé</span>{% if t.receiptNumber %} <a href="{{ path('app_subscription_receipt', {id: t.id}) }}" data-turbo="false" style="color: var(--primary);">{{ t.receiptNumber }}</a>{% endif %}{% else %}<span class="ks-badge ks-badge--danger">Refusé</span> <span class="ks-small">{{ t.adminNote }}</span>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Aucun paiement traité pour l'instant.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
