{% extends 'base.html.twig' %}

{% block title %}Installer l'application{% endblock %}

{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' %}{% endif %}
<div class="ks-page ks-page--narrow" x-data="{
        canPrompt: !!window.ksInstallPrompt,
        installed: window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true,
        ios: /iphone|ipad|ipod/i.test(navigator.userAgent),
        done: false,
        async install() { const p = window.ksInstallPrompt; if (!p) return; p.prompt(); const r = await p.userChoice; if (r.outcome === 'accepted') { this.done = true; } window.ksInstallPrompt = null; this.canPrompt = false; }
    }" @ks-install-ready.document="canPrompt = true">
    {% include 'shared/_page_header.html.twig' with {
        eyebrow: 'Sur votre téléphone', icon: 'smartphone',
        title: 'Installer l\'application',
        lead: 'Ajoutez KIINI SAWA à l\'écran d\'accueil de votre téléphone : une icône, l\'ouverture en plein écran, et vos rituels à portée de pouce. Gratuit, sans passer par une boutique d\'applications, et ça ne prend presque pas de place.'
    } %}

    <div class="ks-card" style="margin-bottom: 1rem; display: flex; gap: 1rem; align-items: center;">
        <img src="/icons/icon-192.png" alt="" width="64" height="64" style="border-radius: 16px; flex-shrink: 0;">
        <div style="flex: 1;">
            <p style="font-weight: 700; color: var(--fg);">KIINI SAWA</p>
            <p style="color: var(--fg-muted); font-size: .9rem;">Plan de Vie, rituels, journal, revues</p>
        </div>
    </div>

    <div class="ks-alert ks-alert--success" x-show="installed || done" x-cloak style="margin-bottom: 1rem;">✓ L'application est installée. Retrouvez l'icône KIINI SAWA sur votre écran d'accueil.</div>

    <div x-show="!installed && !done" x-cloak>
        {# Android, Chrome, Edge : installation en un clic #}
        <div class="ks-card" x-show="canPrompt" style="margin-bottom: 1rem; text-align: center;">
            <button type="button" class="ks-btn ks-btn--primary" @click="install()"><i data-lucide="download"></i> Installer KIINI SAWA</button>
        </div>

        {# iPhone / iPad : Safari #}
        <div class="ks-card" x-show="ios" style="margin-bottom: 1rem;">
            <h2 class="ks-section-title" style="margin-top: 0;">Sur iPhone ou iPad</h2>
            <ol style="list-style: decimal; padding-left: 1.4rem; line-height: 1.9; color: var(--fg-light);">
                <li>Ouvrez <strong>app.kiinisawa.com</strong> dans <strong>Safari</strong>.</li>
                <li>Touchez le bouton <strong>Partager</strong> (le carré avec une flèche vers le haut).</li>
                <li>Choisissez <strong>« Sur l'écran d'accueil »</strong>, puis <strong>Ajouter</strong>.</li>
            </ol>
        </div>

        {# Android sans invitation automatique #}
        <div class="ks-card" x-show="!ios && !canPrompt" style="margin-bottom: 1rem;">
            <h2 class="ks-section-title" style="margin-top: 0;">Sur Android</h2>
            <ol style="list-style: decimal; padding-left: 1.4rem; line-height: 1.9; color: var(--fg-light);">
                <li>Ouvrez <strong>app.kiinisawa.com</strong> dans <strong>Chrome</strong>.</li>
                <li>Touchez le menu <strong>⋮</strong> en haut à droite.</li>
                <li>Choisissez <strong>« Installer l'application »</strong> (ou « Ajouter à l'écran d'accueil »).</li>
            </ol>
        </div>
    </div>

    <p style="color: var(--fg-muted); font-size: .85rem; margin-top: 1.5rem;">Une application à télécharger depuis l'App Store et Google Play est en préparation. Vos données restent les mêmes : un seul compte pour le site, l'application installée et, demain, l'application des boutiques.</p>
    {% if not app.user %}
        <p style="margin-top: 1.25rem;"><a href="{{ path('app_register') }}" class="ks-btn ks-btn--primary">Créer mon compte gratuit</a></p>
    {% endif %}
</div>
{% endblock %}
