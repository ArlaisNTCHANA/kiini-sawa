{# Bandeau des pages publiques (visiteur non connecté). minimal: true = seulement le nom, sans boutons (pages où une seule action compte, ex. feedback nourricier). #}
<header style="background: linear-gradient(135deg, #173D2E, #1F5F5B); color: #fff;">
    <div style="max-width: 1100px; margin: 0 auto; padding: .9rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
        <a href="{{ path('app_home') }}" style="text-decoration: none;" aria-label="KIINI SAWA">{% include 'shared/_logo.html.twig' with {tone: 'dark'} only %}</a>
        {% if not minimal|default(false) %}
        <nav style="display: flex; align-items: center; gap: 1rem; font-size: .9rem;">
            <a href="{{ path('app_login') }}" style="color: rgba(255,255,255,.85); text-decoration: none;">Se connecter</a>
            <a href="{{ path('app_register') }}" style="background: #fff; color: #173D2E; font-weight: 700; padding: .45rem .9rem; border-radius: 999px; text-decoration: none;">Commencer gratuitement</a>
        </nav>
        {% endif %}
    </div>
</header>
