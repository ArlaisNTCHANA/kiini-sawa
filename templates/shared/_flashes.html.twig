{# Messages de confirmation ou d'erreur après une action (addFlash dans les contrôleurs) #}
{% set ksFlashes = app.flashes(['success', 'info', 'error', 'dev']) %}
{% if ksFlashes|filter(m => m|length > 0)|length > 0 %}
<div style="max-width: 960px; margin: 1rem auto 0; padding: 0 1rem; display: flex; flex-direction: column; gap: .5rem;">
    {% for type, messages in ksFlashes %}
        {% for message in messages %}
            {% set c = {success: ['#ECFDF5', '#A7F3D0', '#065F46'], info: ['#EEF3EF', '#C8D6CD', '#1F4D3A'], dev: ['#EEF3EF', '#C8D6CD', '#1F4D3A'], error: ['#FEF2F2', '#FECACA', '#991B1B']}[type] %}
            <div role="{{ type == 'error' ? 'alert' : 'status' }}" style="background: {{ c[0] }}; border: 1px solid {{ c[1] }}; color: {{ c[2] }}; padding: .75rem 1rem; border-radius: 12px; font-size: .9rem;">
                {% if type == 'dev' %}<strong>[dev]</strong> {% endif %}{{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}
