{# Messages de confirmation ou d'erreur après une action (addFlash dans les contrôleurs) #}
{# « warning » (avertissement) n'était pas affiché : ajouté le 26/11/2026. Conteneur #ks-flashes toujours présent, pour les
   pages qui enregistrent sans recharger (Plan d'Intendance) #}
{% set ksFlashes = app.flashes(['success', 'info', 'warning', 'error', 'dev']) %}
<div id="ks-flashes">
{% if ksFlashes|filter(m => m|length > 0)|length > 0 %}
<div style="max-width: 960px; margin: 1rem auto 0; padding: 0 1rem; display: flex; flex-direction: column; gap: .5rem;">
    {% for type, messages in ksFlashes %}
        {% for message in messages %}
            {% set c = {success: ['#ECFDF5', '#A7F3D0', '#065F46'], info: ['#EEF3EF', '#C8D6CD', '#1F4D3A'], warning: ['#FBF4E6', '#E9D3A6', '#7A5A1F'], dev: ['#EEF3EF', '#C8D6CD', '#1F4D3A'], error: ['#FEF2F2', '#FECACA', '#991B1B']}[type] %}
            {# Point 9 (26/11/2026) : les confirmations disparaissent seules ; chaque message peut être fermé #}
            <div role="{{ type == 'error' ? 'alert' : 'status' }}" x-data="{ show: true }" x-show="show" x-transition.opacity
                 {% if type in ['success', 'info'] %}x-init="setTimeout(() => show = false, 7000)"{% endif %}
                 style="background: {{ c[0] }}; border: 1px solid {{ c[1] }}; color: {{ c[2] }}; padding: .75rem 1rem; border-radius: 12px; font-size: .9rem; display: flex; gap: .75rem; align-items: flex-start;">
                <span style="flex: 1;">{% if type == 'dev' %}<strong>[dev]</strong> {% endif %}{{ message }}</span>
                <button type="button" @click="show = false" aria-label="Fermer ce message" style="background: none; border: 0; color: inherit; font-size: 1.1rem; line-height: 1; cursor: pointer; padding: 0 .1rem;">×</button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}
</div>
