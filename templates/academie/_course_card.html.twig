{#
    Carte d'un parcours dans le catalogue : vignette, plan principal, titre, accroche, durée, leçons, accès, progression
    et pastilles des plans couverts (AcademyOverview). Paramètres : course, enrollment (ou null), is_pro,
    highlight (texte facultatif), href (adresse forcée, pour l'aperçu du studio, facultatif).
#}
{% set look = academie_apparence(course.place) %}
{% set progress = enrollment|default(null) ? enrollment.progress : null %}
{% set nb = course.lessons(true)|length %}
<a href="{{ href|default(path('app_academie_course', {slug: course.slug})) }}" class="academie-card" data-course="{{ course.slug }}">
    {% include 'academie/_vignette.html.twig' with {course: course, access: true} only %}
    <div class="academie-card__body">
        <span class="academie-eyebrow" style="--c: {{ look.color }};"><i data-lucide="{{ look.icon }}"></i> {{ academie_lieu(course.place) }}</span>
        {% if highlight|default(false) %}<span class="ks-badge ks-badge--gold" style="align-self: flex-start;">{{ highlight }}</span>{% endif %}
        <h3 class="academie-card__title">{{ course.title }}</h3>
        {% if course.subtitle %}<p class="academie-card__lead">{{ course.subtitle }}</p>{% endif %}
        <p class="academie-card__meta">
            <span><i data-lucide="clock"></i> {{ academie_duree(course.estimatedMinutes) }}</span>
            <span><i data-lucide="list-checks"></i> {{ nb }} {% if course.planJourney %}{{ nb > 1 ? t('academie.carte.seances', 'séances') : t('academie.carte.seance', 'séance') }}{% else %}{{ nb > 1 ? t('academie.carte.lecons', 'leçons') : t('academie.carte.lecon', 'leçon') }}{% endif %}</span>
            {% if not course.free %}<span>{% if is_pro|default(false) %}{{ t('academie.carte.pro_inclus', 'Inclus dans votre offre PRO') }}{% else %}<i data-lucide="lock"></i> {{ t('academie.carte.pro', 'KIINI SAWA PRO') }}{% endif %}</span>{% endif %}
        </p>
        {% if progress %}
            <div class="academie-progline">
                <div class="academie-progress" role="progressbar" aria-valuenow="{{ progress.percent }}" aria-valuemin="0" aria-valuemax="100" aria-label="{{ t('academie.carte.progression', 'Progression') }}"><span style="width: {{ progress.percent }}%;"></span></div>
                {% if enrollment.completed %}{{ t('academie.carte.termine', 'Parcours terminé') }}{% else %}{{ progress.done }}/{{ progress.total }}{% endif %}
            </div>
        {% endif %}
        {% set covered = academie_plans_couverts(course) %}
        {% if covered|length or course.couple %}
            <span class="academie-card__plans" aria-label="{{ t('academie.carte.plans', 'Plans concernés') }}">
                {% if course.couple %}<span class="academie-pastille academie-pastille--main" style="--c: var(--couple); --cs: var(--couple-soft);"><i data-lucide="heart-handshake"></i>Sanctuaire du Couple</span>{% endif %}
                {% for p in covered %}
                    <span class="academie-pastille {{ p.main ? 'academie-pastille--main' }}" style="--c: {{ p.color }}; --cs: {{ p.soft }};" title="{{ p.label }}"><i data-lucide="{{ p.icon }}"></i>{{ p.short }}</span>
                {% endfor %}
            </span>
        {% endif %}
    </div>
</a>
