{# Schéma : la machine (linéaire) face au vivant (cyclique). viewBox étroit : le texte reste lisible sur téléphone. #}
<p class="sch-titre">La machine et le vivant</p>
<svg class="sch-svg" viewBox="0 0 340 200" aria-hidden="true">
    <text x="0" y="16" style="fill: var(--fg-muted); font-size: 14px; font-weight: 700;">La machine : linéaire</text>
    <line x1="4" y1="40" x2="336" y2="40" style="stroke: var(--fg-muted); stroke-width: 4; stroke-linecap: round;"/>
    <text x="0" y="84" style="fill: var(--primary-dark); font-size: 14px; font-weight: 700;">L'être humain : cyclique</text>
    <path d="M4 140 C 30 105, 55 105, 84 140 S 140 175, 168 140 S 225 105, 252 140 S 310 175, 336 140" style="fill: none; stroke: var(--primary); stroke-width: 4; stroke-linecap: round;"/>
    <text x="44" y="104" text-anchor="middle" style="fill: var(--fg-light); font-size: 13px; font-weight: 600;">semer</text>
    <text x="126" y="192" text-anchor="middle" style="fill: var(--fg-light); font-size: 13px; font-weight: 600;">attendre</text>
    <text x="210" y="104" text-anchor="middle" style="fill: var(--fg-light); font-size: 13px; font-weight: 600;">récolter</text>
    <text x="294" y="192" text-anchor="middle" style="fill: var(--fg-light); font-size: 13px; font-weight: 600;">se reposer</text>
</svg>
<div class="sch-grille sch-grille--2" style="margin-top: .8rem;">
    <div class="sch-carte sch-carte--froid"><strong>La machine</strong><small>Production continue · mesurée par la montre (Chronos) · s'use par la casse.</small></div>
    <div class="sch-carte sch-carte--vivant"><strong>L'être humain</strong><small>Porte du fruit en saisons · cherche le moment juste (Kairos) · s'use par l'épuisement.</small></div>
</div>
