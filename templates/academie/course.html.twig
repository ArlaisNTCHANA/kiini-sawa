{% extends 'base.html.twig' %}
{% block title %}{{ course.title }} · {{ t('academie.catalogue.titre_page', 'L\'Académie') }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% include 'academie/_styles.html.twig' %}{% endblock %}
{% block body %}
{% set look = academie_apparence(course.place) %}
{% set lessons = course.lessons(true) %}
{% set next = enrollment ? enrollment.nextLesson : null %}
<article class="ks-page ks-page--reading" data-academie-course="{{ course.slug }}">
    <a href="{{ path('app_academie') }}" class="ks-header__back">← {{ t('academie.catalogue.titre', 'L\'Académie') }}</a>
    <div class="academie-cover" style="background: {{ look.soft }}; color: {{ look.color }}; margin-top: 1rem;">
        <span class="academie-cover__icon"><i data-lucide="{{ look.icon }}"></i></span>
        <div>
            <p class="ks-eyebrow" style="color: {{ look.color }};">{{ academie_lieu(course.place) }}</p>
            <h1 class="ks-header__title" style="margin: .2rem 0 0;">{{ course.title }}</h1>
        </div>
    </div>
    {% if course.subtitle %}<p class="ks-header__lead" style="margin-top: 1rem;">{{ course.subtitle }}</p>{% endif %}
    <p class="ks-small" style="margin: .6rem 0 1.2rem;">
        {{ lessons|length }} {{ lessons|length > 1 ? t('academie.carte.lecons', 'leçons') : t('academie.carte.lecon', 'leçon') }}
        · {{ t('academie.carte.duree', 'environ {minutes} min', 'text', {minutes: course.estimatedMinutes}) }}
        · {{ course.free ? t('academie.carte.gratuit', 'Gratuit') : t('academie.carte.pro', 'KIINI SAWA PRO') }}
    </p>

    {% if not course.published %}
        <div class="ks-alert ks-alert--info" style="margin-bottom: 1rem;">{{ t('academie.parcours.retire', 'Ce parcours est en cours de révision. Vous le retrouvez ici parce que vous l\'avez commencé, avec votre progression.') }}</div>
    {% endif %}

    {# Une seule action principale #}
    <div class="academie-cta">
        {% if locked %}
            <p>{{ t('academie.parcours.pro', 'Ce parcours fait partie de KIINI SAWA PRO.') }}</p>
            <a href="{{ path('app_subscription') }}" class="ks-btn ks-btn--primary"><i data-lucide="lock-open"></i> {{ t('academie.parcours.pro_bouton', 'Découvrir KIINI SAWA PRO') }}</a>
        {% elseif enrollment and enrollment.completed %}
            <p><i data-lucide="check-circle-2" style="width: 16px; height: 16px; color: var(--primary);"></i> {{ t('academie.parcours.termine', 'Vous avez terminé ce parcours. Vous pouvez relire chaque leçon quand vous le voulez.') }}</p>
            {% if boussole_due %}
                <a href="{{ path('app_public_boussole') }}" class="ks-btn ks-btn--primary"><i data-lucide="compass"></i> {{ t('academie.parcours.boussole', 'Refaire ma Boussole 360') }}</a>
            {% else %}
                <a href="{{ path('app_academie') }}" class="ks-btn ks-btn--primary">{{ t('academie.parcours.autres', 'Voir les autres parcours') }}</a>
            {% endif %}
        {% elseif next %}
            {% if enrollment.progress.done %}<p class="ks-small">{{ t('academie.carte.avancement', '{faites} leçon(s) sur {total}', 'text', {faites: enrollment.progress.done, total: enrollment.progress.total}) }}</p>{% endif %}
            <a href="{{ path('app_academie_lesson', {slug: course.slug, lessonSlug: next.slug}) }}" class="ks-btn ks-btn--primary">
                {{ enrollment.progress.done ? t('academie.parcours.reprendre', 'Reprendre : {lecon}', 'text', {lecon: next.title}) : t('academie.parcours.commencer', 'Commencer le parcours') }} <i data-lucide="arrow-right"></i>
            </a>
        {% elseif lessons|length %}
            <a href="{{ path('app_academie_lesson', {slug: course.slug, lessonSlug: lessons|first.slug}) }}" class="ks-btn ks-btn--primary">{{ t('academie.parcours.commencer', 'Commencer le parcours') }} <i data-lucide="arrow-right"></i></a>
        {% endif %}
    </div>

    {% if not locked and not (enrollment and enrollment.completed) and lessons|length %}
        {% include 'academie/_pace.html.twig' %}
    {% endif %}

    {% if course.description %}<div class="academie-texte" style="margin-top: 1.6rem;">{{ course.description|lecon_markdown }}</div>{% endif %}

    {% for m in course.modules %}
        {% set visible = m.lessons|filter(l => l.visible) %}
        {% if visible|length %}
            <section class="ks-card" style="margin-top: 1.2rem;">
                <h2 class="ks-card__title">{{ m.title }}</h2>
                {% for l in visible %}
                    {% set done = enrollment and enrollment.hasCompleted(l) %}
                    {% if locked %}
                        <div class="ks-row-link" style="cursor: default;"><span>{{ l.title }}</span><span class="ks-row-link__meta">{{ l.durationMinutes }} min</span></div>
                    {% else %}
                        <a class="ks-row-link" href="{{ path('app_academie_lesson', {slug: course.slug, lessonSlug: l.slug}) }}">
                            <span style="display: inline-flex; align-items: center; gap: .4rem;">{% if done %}<i data-lucide="check-circle-2" style="width: 15px; height: 15px; flex: none; color: var(--primary);" aria-label="{{ t('academie.lecon.faite', 'Terminée') }}"></i> {% endif %}{{ l.title }}</span>
                            <span class="ks-row-link__meta">{{ l.durationMinutes }} min{% if l.hasVideo %} · {{ t('academie.lecon.video', 'vidéo') }}{% endif %}</span>
                        </a>
                    {% endif %}
                {% endfor %}
            </section>
        {% endif %}
    {% endfor %}

    {% if notes|length %}
        <section class="ks-card ks-card--flat" style="margin-top: 1.6rem;" aria-labelledby="notes-title">
            <h2 class="ks-card__title" id="notes-title"><i data-lucide="notebook-pen"></i> {{ t('academie.notes.parcours', 'Mes notes de ce parcours') }}</h2>
            {% for n in notes %}
                <div class="academie-note">
                    <p class="ks-small">{{ n.lesson.title }}{% if n.planKey %} · {{ academie_lieu(n.planKey) }}{% endif %}</p>
                    <p>{{ n.note.content|nl2br }}</p>
                </div>
            {% endfor %}
            {% if can_journal %}<a href="{{ path('app_journal') }}" class="ks-btn ks-btn--ghost ks-btn--sm" style="margin-top: .6rem;">{{ t('academie.notes.journal', 'Ouvrir mon Journal') }}</a>{% endif %}
        </section>
    {% endif %}
</article>
{% endblock %}
