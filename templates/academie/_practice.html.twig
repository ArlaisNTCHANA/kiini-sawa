{#
    « Mettre en pratique », chez les membres. Paramètres : course, lesson, practice, completion.
    - Exercice prévu par l'auteur (practice.fixed) : la cible est fixée, le membre écrit sa réponse.
    - Sinon : le membre peut noter un point à travailler et choisir où l'envoyer.
    Rien n'est écrit dans un plan sans un clic sur le bouton d'accord ; l'autre bouton termine la leçon sans rien modifier.
#}
{% set answer = completion ? completion.response : null %}
{% set saved = completion and completion.hasCreatedEntity %}
<section class="ks-card ks-card--accent" id="pratique" style="margin-top: 2rem;" aria-labelledby="pratique-title">
    {% set seance = practice.rubric is defined or course.planJourney %}
    <h2 class="ks-card__title" id="pratique-title"><i data-lucide="{{ seance ? 'pencil-line' : 'target' }}"></i> {{ seance ? t('academie.seance.ecrire', 'Écrire dans mon plan') : t('academie.pratique.titre', 'Mettre en pratique') }}</h2>
    <form method="post" action="{{ path('app_academie_complete', {slug: course.slug, lessonSlug: lesson.slug}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('academie') }}">
        {% if practice.rubric is defined %}
            {# Séance d'un parcours de plan : la rubrique entière du plan ; ce qui y est déjà reste tel quel #}
            {% set r = practice.rubric %}
            <p style="margin-bottom: .8rem;">{{ lesson.practicePrompt|nl2br }}</p>
            {% if practice.blocker %}
                <div class="ks-alert ks-alert--info" style="margin-bottom: .8rem;">{{ practice.blocker }}</div>
            {% elseif r.kind == 'text' %}
                <label class="ks-label" for="seance-texte">{{ r.label }}</label>
                <textarea class="ks-input" id="seance-texte" name="text" rows="4" maxlength="{{ practice.action == 'write_vision' ? 5000 : 2000 }}" required placeholder="{{ r.example }}">{{ r.text }}</textarea>
                {% if r.text %}<p class="ks-small" style="margin-top: .4rem;">{{ t('academie.seance.texte_existant', 'C\'est le texte déjà écrit dans votre plan : vous pouvez le reprendre ici.') }}</p>{% endif %}
                {% if practice.action == 'write_vision' %}
                    <label class="ks-label" for="seance-horizon" style="margin-top: .7rem;">{{ t('academie.seance.horizon', 'À quel horizon ?') }}</label>
                    <input class="ks-input" id="seance-horizon" name="horizon" maxlength="50" value="{{ r.horizon }}" placeholder="5 ans">
                {% endif %}
            {% elseif r.kind == 'list' %}
                <p class="ks-label">{{ r.label }}</p>
                {% if r.items is not empty %}
                    <p class="ks-small" style="margin: 0 0 .4rem;">{{ t('academie.seance.deja', 'Déjà dans votre plan :') }}</p>
                    <ul class="academie-seance-deja">{% for item in r.items %}<li>{{ item.text }}</li>{% endfor %}</ul>
                {% endif %}
                {% for i in 1..3 %}
                    <input class="ks-input academie-seance-ligne" name="items[]" maxlength="255" aria-label="{{ r.label }} ({{ i }})" {{ i == 1 and r.items is empty ? 'required' }} placeholder="{{ i == 1 ? r.example : '' }}">
                {% endfor %}
                <p class="ks-small" style="margin-top: .4rem;">{{ t('academie.seance.lignes', 'Une réponse par ligne. Les lignes vides sont ignorées.') }}</p>
            {% elseif r.kind == 'goals' %}
                {% for cat, g in r.goals %}
                    <fieldset class="academie-seance-dimension">
                        <legend class="ks-label">{{ g.label }}</legend>
                        {% if g.items is not empty %}<ul class="academie-seance-deja">{% for item in g.items %}<li>{{ item.text }}</li>{% endfor %}</ul>{% endif %}
                        {% for i in 1..2 %}<input class="ks-input academie-seance-ligne" name="goals[{{ cat }}][]" maxlength="255" aria-label="{{ g.label }} ({{ i }})">{% endfor %}
                    </fieldset>
                {% endfor %}
                <p class="ks-small" style="margin-top: .4rem;">{{ r.example }}. {{ t('academie.seance.objectifs_aide', 'Les échéances se posent ensuite dans votre Plan de Vie.') }}</p>
            {% endif %}
            {% set button = academie_bouton(practice.target) %}
            {% set can_save = not practice.blocker %}
        {% elseif practice.fixed %}
            {% set form = practice.form %}
            <p style="margin-bottom: .8rem;">{{ lesson.practicePrompt|nl2br }}</p>
            <p class="ks-small" style="margin-bottom: .8rem;">{{ t('academie.pratique.cible', 'Votre réponse peut aller dans : {cible}.', 'text', {cible: academie_exercice(practice.target, practice.action)}) }}</p>
            {% if practice.blocker %}
                <div class="ks-alert ks-alert--info" style="margin-bottom: .8rem;">{{ practice.blocker }}{% if 'PRO' in practice.blocker %} <a href="{{ path('app_subscription') }}">{{ t('academie.pratique.decouvrir_pro', 'Découvrir KIINI SAWA PRO') }}</a>{% endif %}</div>
            {% else %}
                <label class="ks-label" for="practice-title">{{ form.title }}</label>
                {% if practice.action == 'add_note' %}
                    <textarea class="ks-input" id="practice-title" name="title" rows="4" maxlength="5000" required>{{ answer.title ?? '' }}</textarea>
                {% else %}
                    <input class="ks-input" id="practice-title" name="title" maxlength="255" required value="{{ answer.title ?? '' }}">
                {% endif %}
                {% if form.choice %}
                    <label class="ks-label" for="practice-choice" style="margin-top: .7rem;">{{ form.choice.label }}</label>
                    <select class="ks-input" id="practice-choice" name="choice">
                        {% for value, label in form.choice.options %}
                            <option value="{{ value }}" {{ (answer.choice ?? form.choice.default) == value ? 'selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                {% endif %}
                {% if form.detail %}
                    <label class="ks-label" for="practice-detail" style="margin-top: .7rem;">{{ form.detail }}</label>
                    <textarea class="ks-input" id="practice-detail" name="detail" rows="2" maxlength="2000">{{ answer.detail ?? '' }}</textarea>
                {% endif %}
            {% endif %}
            {% set button = saved ? t('academie.pratique.mettre_a_jour', 'Mettre à jour dans mes plans') : academie_bouton(practice.target) %}
            {% set can_save = not practice.blocker %}
        {% else %}
            <p style="margin-bottom: .8rem;">{{ t('academie.pratique.point_intro', 'Un point à travailler après cette leçon ? Notez-le et choisissez où l\'inscrire. C\'est facultatif.') }}</p>
            <label class="ks-label" for="practice-title">{{ t('academie.pratique.point', 'Le point à travailler') }}</label>
            <input class="ks-input" id="practice-title" name="title" maxlength="255" value="{{ answer.title ?? '' }}" placeholder="{{ t('academie.pratique.point_exemple', 'Par exemple : apprendre à dire non aux sollicitations urgentes') }}">
            <label class="ks-label" for="practice-destination" style="margin-top: .7rem;">{{ t('academie.pratique.ou', 'Où l\'inscrire') }}</label>
            {% set current = answer ? answer.target ~ '|' ~ answer.action : practice.default %}
            <select class="ks-input" id="practice-destination" name="destination">
                {% for value, d in practice.destinations %}
                    <option value="{{ value }}" {{ current == value ? 'selected' }} {{ d.blocker ? 'disabled' }}>{{ d.label }}{{ d.blocker ? ' (' ~ t('academie.pratique.indisponible', 'non disponible avec votre offre') ~ ')' }}</option>
                {% endfor %}
            </select>
            <label class="ks-label" for="practice-detail" style="margin-top: .7rem;">{{ t('academie.pratique.precisions', 'Précisions (facultatif)') }}</label>
            <textarea class="ks-input" id="practice-detail" name="detail" rows="2" maxlength="2000">{{ answer.detail ?? '' }}</textarea>
            {% set button = saved ? t('academie.pratique.mettre_a_jour', 'Mettre à jour dans mes plans') : t('academie.pratique.inscrire', 'Inscrire dans mon plan') %}
            {% set can_save = true %}
        {% endif %}

        {% if accountability|default(null) %}
            <div class="academie-redevabilite" id="redevabilite">
                <p class="academie-iconline" style="margin: 0 0 .5rem;"><i data-lucide="shield-check" style="width: 16px; height: 16px; color: var(--primary);"></i> <strong>{{ t('academie.redevabilite.titre', 'Voulez-vous qu\'un Partenaire de Redevabilité veille sur {element} ?', 'text', {element: accountability.label}) }}</strong></p>
                <p class="ks-small" style="margin: 0 0 .7rem;">{{ t('academie.redevabilite.aide', 'Vous choisissez la personne et vous voyez exactement ce qui lui sera envoyé avant d\'accepter. Votre progression dans l\'Académie ne lui est jamais montrée.') }}</p>
                <div class="ks-toolbar">
                    <a href="{{ path('app_accountability_new', {cible: accountability.target}) }}" class="ks-btn ks-btn--secondary ks-btn--sm">{{ t('academie.redevabilite.bouton', 'Choisir mon Partenaire de Redevabilité') }}</a>
                    {% if next %}<a href="{{ path('app_academie_lesson', {slug: course.slug, lessonSlug: next.slug}) }}" class="ks-btn ks-btn--ghost ks-btn--sm">{{ t('academie.redevabilite.suite', 'Plus tard, leçon suivante') }} <i data-lucide="arrow-right"></i></a>{% else %}<a href="{{ path('app_academie_course', {slug: course.slug}) }}" class="ks-btn ks-btn--ghost ks-btn--sm">{{ t('academie.redevabilite.parcours', 'Plus tard, retour au parcours') }}</a>{% endif %}
                </div>
            </div>
        {% endif %}
        {% if saved %}<p class="ks-small academie-iconline" style="margin-top: .7rem;"><i data-lucide="check" style="width: 13px; height: 13px;"></i> {{ t('academie.pratique.deja', 'Déjà enregistré dans vos plans : le modifier ici met à jour le même élément, sans en créer un second.') }}</p>{% endif %}
        <div class="ks-toolbar" style="margin-top: .9rem;">
            {% if can_save %}<button type="submit" name="mode" value="plan" class="ks-btn ks-btn--primary">{{ button }}</button>{% endif %}
            <button type="submit" name="mode" value="sans" class="ks-btn ks-btn--ghost" formnovalidate>{{ completion ? t('academie.pratique.suite', 'Continuer sans modifier mes plans') : (seance ? t('academie.seance.sans', 'Terminer la séance sans modifier mon plan') : t('academie.pratique.sans', 'Terminer la leçon sans modifier mon plan')) }}</button>
        </div>
    </form>
</section>
