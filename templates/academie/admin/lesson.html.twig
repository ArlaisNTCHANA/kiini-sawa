{% extends 'admin/layout.html.twig' %}
{% set name = lesson ? lesson.title : 'Nouvelle leçon' %}
{% set token = csrf_token('admin_academie') %}
{% block title %}{{ name }}{% endblock %}
{% block stylesheets %}{% include 'academie/admin/_styles.html.twig' %}{% include 'academie/_styles.html.twig' %}{% endblock %}
{% block page_title %}{{ name }}{% endblock %}
{% block page_lead %}Parcours « {{ course.title }} »{% if position %} · Leçon {{ position }} sur {{ total }}{% endif %}{% endblock %}
{% block crumbs %}<span aria-hidden="true">›</span><a href="{{ path('admin_academie_course', {id: course.id}) }}">{{ course.title }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ name }}</span>{% endblock %}
{% block page_actions %}
    {% if previous %}<a href="{{ path('admin_academie_lesson', {id: previous.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm" title="{{ previous.title }}"><i data-lucide="arrow-left"></i> Précédente</a>{% endif %}
    {% if next %}<a href="{{ path('admin_academie_lesson', {id: next.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm" title="{{ next.title }}">Suivante <i data-lucide="arrow-right"></i></a>{% endif %}
    {% if lesson %}<a href="{{ path('admin_academie_lesson_preview', {id: lesson.id}) }}" class="ks-btn ks-btn--secondary"><i data-lucide="eye"></i> Prévisualiser comme un apprenant</a>{% endif %}
{% endblock %}
{% block content %}
<div class="ks-stack" style="max-width: 1240px;">
    {% for e in errors %}<div class="ks-alert ks-alert--danger" role="alert">{{ e }}</div>{% endfor %}

    <form method="post" id="lesson-form" action="{{ lesson ? path('admin_academie_lesson', {id: lesson.id}) : path('admin_academie_lesson_new', {id: module.id}) }}" class="ks-stack">
        <input type="hidden" name="_csrf_token" value="{{ token }}">

        <section class="ks-card ks-stack">
            <h2 class="ks-card__title"><i data-lucide="file-text"></i> La leçon</h2>
            <div class="ks-field"><label class="ks-label" for="title">Titre</label><input class="ks-input" id="title" name="title" value="{{ data.title }}" maxlength="160" placeholder="Ce que Dieu a déposé en vous" required></div>
            <div class="ks-form-grid">
                <div class="ks-field">
                    <label class="ks-label" for="module">Module</label>
                    <select class="ks-input" id="module" name="module">{% for m in course.modules %}<option value="{{ m.id }}" {{ data.module == m.id ? 'selected' }}>{{ m.title }}</option>{% endfor %}</select>
                </div>
                <div class="ks-field"><label class="ks-label" for="duration">Durée estimée (minutes)</label><input class="ks-input" type="number" min="1" max="60" id="duration" name="duration" value="{{ data.duration }}" required><p class="ks-help">Visez 5 à 10 minutes.</p></div>
            </div>
            <label style="display: flex; gap: .6rem; align-items: center; font-size: .92rem;"><input type="checkbox" name="visible" value="1" {{ data.visible ? 'checked' }}> Visible des apprenants (une fois le parcours publié)</label>
        </section>

        {% set editorInit = editor|merge({token: token, previewUrl: path('admin_academie_markdown'), convertUrl: path('admin_academie_blocks'), uploadUrl: path('admin_academie_image_upload', {id: course.id}), diagramsUrl: path('admin_academie_diagrams_json')}) %}
        <script src="{{ asset('js/ks-rich-text.js') }}"></script>
        <script>
        document.addEventListener('alpine:init', () => {
            const empty = { paragraphe: { text: '' }, titre: { level: 2, text: '' }, liste: { ordered: false, items: '' }, citation: { text: '' },
                encadre: { kind: 'retenir', title: '', text: '' }, schema: { code: '' }, image: { src: '', alt: '' }, avance: { text: '' } };
            // Façon d'écrire de chaque bloc « comme dans Word » ; un bloc à la mise en forme particulière reste en texte (_raw)
            const RICH = { paragraphe: ['text', 'inline'], citation: ['text', 'inline'], encadre: ['text', 'doc'], liste: ['items', 'list'] };
            const prep = (b, id) => { const r = RICH[b.type]; return { ...b, _id: id, _raw: !!r && !window.KsRich.canEdit(b[r[0]], r[1], document, b.ordered) }; };
            Alpine.data('lessonEditor', (init) => { let timer = null; let uid = 0; return {
                mode: 'blocs', blocks: init.blocks.map((b) => prep(b, ++uid)), html: '', menuAt: null, dragFrom: null, busy: false, phone: false, uploading: false, uploadError: '', reloadingDiagrams: false,
                callouts: init.callouts, diagrams: init.diagrams, images: init.images,
                json() { return JSON.stringify(this.blocks.map((b) => Object.fromEntries(Object.entries(b).filter(([k]) => !k.startsWith('_'))))); },
                rich(el, b) { const r = RICH[b.type]; el._rich = window.KsRich.mount(el, b[r[0]], r[1], (v) => { b[r[0]] = v; window.__ksLessonDirty = true; }, b.ordered); },
                fmt(ev, command) { const el = ev.target.closest('.ac-bloc').querySelector('.ks-rich'); if (el) window.KsRich.format(el, command); },
                reorder(ev, b) { const el = ev.target.closest('.ac-bloc').querySelector('.ks-rich'); if (el && el._rich) el._rich.refresh(b.ordered); },
                estMinutes() {
                    const txt = this.blocks.map((b) => [b.text, b.items, b.title].filter(Boolean).join(' ')).join(' ').trim();
                    const words = txt ? txt.split(/\s+/).length : 0;
                    return Math.max(1, Math.min(60, Math.round(words / 160) || 1));
                },
                applyDuration() { const el = document.getElementById('duration'); if (el) { el.value = this.estMinutes(); el.dispatchEvent(new Event('input', { bubbles: true })); } },
                schedule() { clearTimeout(timer); timer = setTimeout(() => this.refresh(), 400); },
                async post(url, field, value) { const body = new FormData(); body.append('_csrf_token', init.token); body.append(field, value); const r = await fetch(url, { method: 'POST', body, credentials: 'same-origin' }); if (!r.ok) throw new Error(); return r; },
                async uploadImage(ev, block) {
                    const file = ev.target.files && ev.target.files[0];
                    if (!file) return;
                    this.uploading = true; this.uploadError = '';
                    try {
                        const body = new FormData(); body.append('_csrf_token', init.token); body.append('image', file);
                        const r = await fetch(init.uploadUrl, { method: 'POST', body, headers: { Accept: 'application/json' }, credentials: 'same-origin' });
                        const data = await r.json();
                        if (!r.ok || !data.path) { this.uploadError = data.error || 'Envoi impossible.'; }
                        else { if (!this.images.includes(data.path)) this.images.unshift(data.path); block.src = data.path; window.__ksLessonDirty = true; }
                    } catch (e) { this.uploadError = 'Envoi impossible : vérifiez votre connexion.'; }
                    this.uploading = false; ev.target.value = '';
                },
                async reloadDiagrams() {
                    this.reloadingDiagrams = true;
                    try { const r = await fetch(init.diagramsUrl, { credentials: 'same-origin' }); if (r.ok) { const d = await r.json(); if (Array.isArray(d.diagrams)) this.diagrams = d.diagrams; } } catch (e) {}
                    this.reloadingDiagrams = false;
                },
                async refresh() { if (this.mode !== 'blocs') return; try { this.html = await (await this.post(init.previewUrl, 'blocks', this.json())).text(); } catch (e) { this.html = '<p>Aperçu indisponible : rechargez la page.</p>'; } this.icons(); },
                icons() { this.$nextTick(() => window.lucide && window.lucide.createIcons()); },
                add(type, at) { const i = at ?? this.blocks.length; this.blocks.splice(i, 0, prep({ type, ...JSON.parse(JSON.stringify(empty[type])) }, ++uid)); this.menuAt = null; window.__ksLessonDirty = true; this.icons(); this.$nextTick(() => setTimeout(() => { const el = document.querySelector('[data-bloc="' + i + '"] .ks-rich, [data-bloc="' + i + '"] textarea, [data-bloc="' + i + '"] input'); el && el.focus(); }, 0)); },
                remove(i) { if (confirm('Retirer ce bloc ?')) { this.blocks.splice(i, 1); window.__ksLessonDirty = true; this.icons(); } },
                move(i, d) { const j = i + d; if (j < 0 || j >= this.blocks.length) return; const b = this.blocks.splice(i, 1)[0]; this.blocks.splice(j, 0, b); window.__ksLessonDirty = true; this.icons(); },
                drop(i) { if (this.dragFrom === null || this.dragFrom === i) { this.dragFrom = null; return; } const b = this.blocks.splice(this.dragFrom, 1)[0]; this.blocks.splice(i, 0, b); this.dragFrom = null; window.__ksLessonDirty = true; this.icons(); },
                wrap(ev, before, after) { const t = ev.target.closest('.ac-bloc').querySelector('textarea'); const a = t.selectionStart, z = t.selectionEnd; const sel = t.value.slice(a, z) || 'texte'; t.setRangeText(before + sel + after, a, z, 'select'); t.dispatchEvent(new Event('input')); t.focus(); },
                link(ev) { const url = prompt('Adresse du lien (https://… ou /methode/…)'); if (url) this.wrap(ev, '[', '](' + url + ')'); },
                async toTexte() { this.busy = true; try { const r = await this.post(init.convertUrl, 'blocks', this.json()); document.getElementById('content').value = (await r.json()).content; this.mode = 'texte'; } catch (e) { alert('Passage au mode avancé impossible : rechargez la page.'); } this.busy = false; this.icons(); },
                async toBlocs() { this.busy = true; try { const r = await this.post(init.convertUrl, 'content', document.getElementById('content').value); this.blocks = (await r.json()).blocks.map((b) => prep(b, ++uid)); this.mode = 'blocs'; } catch (e) { alert('Passage aux blocs impossible : rechargez la page.'); } this.busy = false; this.icons(); },
                label(type) { return { paragraphe: 'Paragraphe', titre: 'Titre', liste: 'Liste', citation: 'Citation', encadre: 'Encadré', schema: 'Schéma', image: 'Image', avance: 'Texte avancé (tableau…)' }[type]; },
                icon(type) { return { paragraphe: 'pilcrow', titre: 'heading', liste: 'list', citation: 'quote', encadre: 'square-dashed', schema: 'shapes', image: 'image', avance: 'code' }[type]; },
            }; });
        });
        </script>

        <div class="ks-stack" x-data="lessonEditor({{ editorInit|json_encode|e('html_attr') }})" x-effect="json(); schedule()">
            <input type="hidden" name="editor" :value="mode">
            <input type="hidden" name="blocks" :value="json()">
            <div class="ac-modes" role="group" aria-label="Mode d'édition du texte">
                <button type="button" :aria-pressed="(mode === 'blocs').toString()" @click="mode === 'texte' && toBlocs()" :disabled="busy"><i data-lucide="blocks"></i> Blocs</button>
                <button type="button" :aria-pressed="(mode === 'texte').toString()" @click="mode === 'blocs' && toTexte()" :disabled="busy"><i data-lucide="code"></i> Texte (avancé)</button>
            </div>

            <div class="ac-blocs-layout" x-show="mode === 'blocs'">
                <section class="ks-card ks-stack">
                    <h2 class="ks-card__title"><i data-lucide="blocks"></i> Le texte, bloc par bloc</h2>
                    <p class="ks-help">Chaque bloc est un morceau de la leçon. Pour changer l'ordre, glissez la poignée à gauche d'un bloc, ou utilisez les flèches. Le « + » entre deux blocs en ajoute un à cet endroit. L'aperçu se met à jour pendant que vous écrivez.</p>
                    <template x-if="blocks.length === 0"><p class="ks-muted">La leçon est vide : ajoutez un premier bloc ci-dessous.</p></template>

                    <template x-for="(b, i) in blocks" :key="b._id">
                        <div>
                            <div class="ac-bloc" :data-bloc="i" :class="dragFrom === i && 'is-dragging'" @dragover.prevent @drop.prevent="drop(i)">
                                <div class="ac-bloc__head">
                                    <span class="ac-bloc__handle" draggable="true" @dragstart="dragFrom = i" @dragend="dragFrom = null" title="Glisser pour déplacer" aria-hidden="true"><i data-lucide="grip-vertical"></i></span>
                                    <span class="ac-bloc__type"><i :data-lucide="icon(b.type)"></i> <span x-text="label(b.type)"></span></span>
                                    <div class="ks-toolbar">
                                        <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="move(i, -1)" :disabled="i === 0" aria-label="Monter ce bloc"><i data-lucide="arrow-up"></i></button>
                                        <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="move(i, 1)" :disabled="i === blocks.length - 1" aria-label="Descendre ce bloc"><i data-lucide="arrow-down"></i></button>
                                        <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="remove(i)" aria-label="Retirer ce bloc"><i data-lucide="trash-2"></i></button>
                                    </div>
                                </div>

                                <template x-if="b.type === 'paragraphe' && !b._raw">
                                    <div class="ks-stack">
                                        <div class="ac-bloc__tools" role="toolbar" aria-label="Mise en forme">
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'bold')" title="Gras (Ctrl+B)" aria-label="Gras"><strong>G</strong></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'italic')" title="Italique (Ctrl+I)" aria-label="Italique"><em>I</em></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'link')" title="Lien : sélectionnez des mots, puis cliquez (recliquez pour retirer le lien)" aria-label="Lien"><i data-lucide="link"></i></button>
                                        </div>
                                        <div class="ks-input ks-rich" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Paragraphe" data-placeholder="Écrivez votre paragraphe…" x-init="rich($el, b)"></div>
                                    </div>
                                </template>
                                <template x-if="b.type === 'paragraphe' && b._raw">
                                    <div class="ks-stack">
                                        <p class="ks-help">Ce paragraphe contient une mise en forme particulière : il reste modifiable ici en texte, pour ne rien perdre.</p>
                                        <div class="ac-bloc__tools">
                                            <button type="button" @click="wrap($event, '**', '**')" title="Gras"><strong>G</strong></button>
                                            <button type="button" @click="wrap($event, '*', '*')" title="Italique"><em>I</em></button>
                                            <button type="button" @click="link($event)" title="Lien"><i data-lucide="link"></i></button>
                                        </div>
                                        <textarea class="ks-input" rows="4" x-model="b.text" aria-label="Paragraphe"></textarea>
                                    </div>
                                </template>
                                <template x-if="b.type === 'titre'">
                                    <div class="ac-bloc__row">
                                        <select class="ks-input" x-model.number="b.level" aria-label="Niveau du titre"><option value="2">Titre de partie</option><option value="3">Sous-titre</option></select>
                                        <input class="ks-input" x-model="b.text" maxlength="160" aria-label="Titre" placeholder="Le titre de cette partie">
                                    </div>
                                </template>
                                <template x-if="b.type === 'liste' && !b._raw">
                                    <div class="ks-stack">
                                        <div class="ac-bloc__row" style="grid-template-columns: auto 1fr; align-items: center;">
                                            <div class="ac-bloc__tools" role="toolbar" aria-label="Mise en forme">
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'bold')" title="Gras (Ctrl+B)" aria-label="Gras"><strong>G</strong></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'italic')" title="Italique (Ctrl+I)" aria-label="Italique"><em>I</em></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'link')" title="Lien : sélectionnez des mots, puis cliquez (recliquez pour retirer le lien)" aria-label="Lien"><i data-lucide="link"></i></button>
                                            </div>
                                            <label class="ac-bloc__check"><input type="checkbox" x-model="b.ordered" @change="reorder($event, b)"> Liste numérotée (1, 2, 3…)</label>
                                        </div>
                                        <div class="ks-input ks-rich" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Points de la liste" x-init="rich($el, b)"></div>
                                        <p class="ks-help">Entrée pour un nouveau point. Coller plusieurs lignes en fait plusieurs points.</p>
                                    </div>
                                </template>
                                <template x-if="b.type === 'liste' && b._raw">
                                    <div class="ks-stack">
                                        <label class="ac-bloc__check"><input type="checkbox" x-model="b.ordered"> Liste numérotée (1, 2, 3…)</label>
                                        <textarea class="ks-input" rows="4" x-model="b.items" aria-label="Points de la liste" placeholder="Un point par ligne"></textarea>
                                        <p class="ks-help">Un point par ligne. **gras** et *italique* sont acceptés.</p>
                                    </div>
                                </template>
                                <template x-if="b.type === 'citation' && !b._raw">
                                    <div class="ks-stack">
                                        <div class="ac-bloc__tools" role="toolbar" aria-label="Mise en forme">
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'bold')" title="Gras (Ctrl+B)" aria-label="Gras"><strong>G</strong></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'italic')" title="Italique (Ctrl+I)" aria-label="Italique"><em>I</em></button>
                                            <button type="button" @mousedown.prevent @click="fmt($event, 'link')" title="Lien : sélectionnez des mots, puis cliquez (recliquez pour retirer le lien)" aria-label="Lien"><i data-lucide="link"></i></button>
                                        </div>
                                        <div class="ks-input ks-rich ks-rich--quote" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Citation" data-placeholder="« La citation », puis à la ligne : sa source (livre, verset)" x-init="rich($el, b)"></div>
                                        <p class="ks-help">Mettez la source (livre, verset) sur la dernière ligne : Entrée pour aller à la ligne.</p>
                                    </div>
                                </template>
                                <template x-if="b.type === 'citation' && b._raw">
                                    <div class="ks-stack">
                                        <textarea class="ks-input" rows="3" x-model="b.text" aria-label="Citation" placeholder="« La citation »&#10;La Méthode, chapitre 11"></textarea>
                                        <p class="ks-help">Une ligne par ligne affichée : mettez la source (livre, verset) sur la dernière.</p>
                                    </div>
                                </template>
                                <template x-if="b.type === 'encadre'">
                                    <div class="ks-stack">
                                        <div class="ac-bloc__row">
                                            <select class="ks-input" x-model="b.kind" aria-label="Sorte d'encadré">
                                                <template x-for="c in callouts" :key="c.code"><option :value="c.code" x-text="c.label" :selected="c.code === b.kind"></option></template>
                                            </select>
                                            <input class="ks-input" x-model="b.title" maxlength="80" aria-label="Titre de l'encadré" placeholder="Titre (facultatif)">
                                        </div>
                                        <template x-if="!b._raw">
                                            <div class="ks-stack">
                                                <div class="ac-bloc__tools" role="toolbar" aria-label="Mise en forme">
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'bold')" title="Gras (Ctrl+B)" aria-label="Gras"><strong>G</strong></button>
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'italic')" title="Italique (Ctrl+I)" aria-label="Italique"><em>I</em></button>
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'link')" title="Lien : sélectionnez des mots, puis cliquez (recliquez pour retirer le lien)" aria-label="Lien"><i data-lucide="link"></i></button>
                                                    <span class="ac-bloc__sep" aria-hidden="true"></span>
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'insertUnorderedList')" title="Liste à puces" aria-label="Liste à puces"><i data-lucide="list"></i></button>
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'insertOrderedList')" title="Liste numérotée" aria-label="Liste numérotée"><i data-lucide="list-ordered"></i></button>
                                                    <button type="button" @mousedown.prevent @click="fmt($event, 'quote')" title="Verset ou citation (recliquez pour revenir au texte)" aria-label="Citation"><i data-lucide="quote"></i></button>
                                                </div>
                                                <div class="ks-input ks-rich" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Texte de l'encadré" data-placeholder="Le texte de l'encadré…" x-init="rich($el, b)"></div>
                                            </div>
                                        </template>
                                        <template x-if="b._raw">
                                            <div class="ks-stack">
                                                <p class="ks-help">Cet encadré contient une mise en forme particulière : il reste modifiable ici en texte, pour ne rien perdre.</p>
                                                <textarea class="ks-input" rows="3" x-model="b.text" aria-label="Texte de l'encadré"></textarea>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                                <template x-if="b.type === 'schema'">
                                    <div class="ks-stack">
                                        <select class="ks-input" x-model="b.code" aria-label="Schéma">
                                            <option value="">Choisissez un schéma…</option>
                                            <template x-for="d in diagrams" :key="d.code"><option :value="d.code" x-text="(d.perso ? 'Atelier : ' : '') + d.label" :selected="d.code === b.code"></option></template>
                                        </select>
                                        <div class="ks-toolbar">
                                            <a href="{{ path('admin_academie_diagrams') }}" target="_blank" rel="noopener" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="external-link"></i> Ouvrir l'atelier</a>
                                            <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="reloadDiagrams()" :disabled="reloadingDiagrams"><i data-lucide="refresh-cw"></i> <span x-text="reloadingDiagrams ? 'Actualisation…' : 'Actualiser la liste'"></span></button>
                                        </div>
                                    </div>
                                </template>
                                <template x-if="b.type === 'image'">
                                    <div class="ks-stack">
                                        <div class="ks-toolbar">
                                            <label class="ks-btn ks-btn--secondary ks-btn--sm ac-upload-inline">
                                                <i data-lucide="upload"></i>
                                                <span x-text="uploading ? 'Envoi en cours…' : 'Envoyer une image ici'"></span>
                                                <input type="file" accept="image/jpeg,image/png,image/webp" @change="uploadImage($event, b)" :disabled="uploading">
                                            </label>
                                            <span class="ks-small">JPEG, PNG ou WebP · 10 Mo max</span>
                                        </div>
                                        <template x-if="uploadError"><p class="ks-small" style="color: var(--danger);" x-text="uploadError"></p></template>
                                        <template x-if="images.length === 0"><p class="ks-help">Aucune image dans ce parcours pour l'instant.</p></template>
                                        <div class="ac-insert__images">
                                            <template x-for="src in images" :key="src"><button type="button" class="ac-insert__image" :class="b.src === src && 'is-chosen'" @click="b.src = src" :aria-pressed="(b.src === src).toString()"><img :src="src" alt="" loading="lazy"></button></template>
                                        </div>
                                        <input class="ks-input" x-model="b.alt" maxlength="160" aria-label="Description de l'image" placeholder="Décrivez l'image en quelques mots (pour les personnes malvoyantes)">
                                    </div>
                                </template>
                                <template x-if="b.type === 'avance'">
                                    <div class="ks-stack">
                                        <textarea class="ks-input ac-bloc__code" rows="5" x-model="b.text" aria-label="Texte avancé"></textarea>
                                        <p class="ks-help">Texte avec ses marques de mise en forme (par exemple un tableau). Il s'affiche tel quel dans la leçon.</p>
                                    </div>
                                </template>
                            </div>
                            <div class="ac-bloc__between">
                                <button type="button" class="ac-bloc__plus" @click="menuAt = menuAt === i + 1 ? null : i + 1" aria-label="Ajouter un bloc ici"><i data-lucide="plus"></i></button>
                                <div class="ac-bloc__menu" x-show="menuAt === i + 1" x-cloak>
                                    <template x-for="t in ['paragraphe', 'titre', 'liste', 'citation', 'encadre', 'schema', 'image', 'avance']" :key="t"><button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="add(t, i + 1)"><i :data-lucide="icon(t)"></i> <span x-text="label(t)"></span></button></template>
                                </div>
                            </div>
                        </div>
                    </template>

                    <div class="ac-bloc__add">
                        <p class="ac-insert__label">Ajouter un bloc à la fin</p>
                        <div class="ac-insert__row">
                            <template x-for="t in ['paragraphe', 'titre', 'liste', 'citation', 'encadre', 'schema', 'image', 'avance']" :key="t"><button type="button" class="ks-btn ks-btn--secondary ks-btn--sm" @click="add(t)"><i :data-lucide="icon(t)"></i> <span x-text="label(t)"></span></button></template>
                        </div>
                    </div>
                </section>
                <aside class="ac-blocs-preview">
                    <div class="ac-workshop__sticky">
                        <div class="ac-workshop__bar">
                            <div>
                                <strong>Aperçu en direct</strong>
                                <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="applyDuration()" title="Appliquer cette durée estimée à la leçon" style="margin-left: .4rem;"><i data-lucide="clock"></i> <span x-text="'~ ' + estMinutes() + ' min'"></span></button>
                            </div>
                            <div class="ac-toggle" role="group" aria-label="Largeur de l'aperçu">
                                <button type="button" :aria-pressed="(!phone).toString()" @click="phone = false"><i data-lucide="monitor"></i> Ordinateur</button>
                                <button type="button" :aria-pressed="phone.toString()" @click="phone = true"><i data-lucide="smartphone"></i> Téléphone</button>
                            </div>
                        </div>
                        <div class="ac-workshop__frame academie-texte" :class="phone && 'is-phone'" x-html="html" aria-live="polite"></div>
                    </div>
                </aside>
            </div>

        <section class="ks-card ks-stack" x-show="mode === 'texte'" x-cloak x-data="{ html: '', loading: false, async show() { this.loading = true; const body = new FormData(); body.append('_csrf_token', '{{ token }}'); body.append('content', this.$refs.content.value); const r = await fetch('{{ path('admin_academie_markdown') }}', { method: 'POST', body, credentials: 'same-origin' }); this.html = r.ok ? await r.text() : '<p>Aperçu indisponible : rechargez la page.</p>'; this.loading = false; this.$nextTick(() => window.lucide && window.lucide.createIcons()); }, insert(text) { const t = this.$refs.content; const at = t.selectionStart ?? t.value.length; const before = t.value.slice(0, at); const sep = before === '' || before.endsWith('\n\n') ? '' : (before.endsWith('\n') ? '\n' : '\n\n'); t.value = before + sep + text + '\n\n' + t.value.slice(at); t.focus(); const pos = (before + sep + text).length; t.setSelectionRange(pos, pos); } }">
            <h2 class="ks-card__title"><i data-lucide="code"></i> Le texte (mode avancé)</h2>
            <p class="ks-help">Le texte brut de la leçon, avec ses marques de mise en forme. Les deux modes montrent la même leçon : passez de l'un à l'autre à tout moment.</p>
            <div class="ks-field">
                <label class="ks-label" for="content">Texte de la leçon</label>
                <textarea class="ks-input" id="content" name="content" rows="18" x-ref="content" placeholder="## Un titre de partie&#10;&#10;Un paragraphe. **Un mot important.** *Une nuance.*&#10;&#10;> Une citation ou un verset.&#10;&#10;- un point&#10;- un autre point">{{ data.content }}</textarea>
                <p class="ks-help">Mise en forme : « ## » pour un titre de partie, **gras**, *italique*, « &gt; » pour une citation, « - » pour une liste, une ligne vide entre deux paragraphes. Un retour à la ligne dans un paragraphe reste un retour à la ligne à l'écran.</p>
            </div>
            <details class="ac-insert">
                <summary><i data-lucide="layout-template"></i> Rendre la leçon plus visuelle : encadré, schéma, image</summary>
                <p class="ks-help">Placez le curseur dans le texte, puis cliquez : l'élément est inséré à cet endroit.</p>
                <p class="ac-insert__label">Encadrés</p>
                <div class="ac-insert__row">
                    {% for code, c in callouts %}
                        <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="insert(':::{{ code }}\nVotre texte\n:::')"><i data-lucide="{{ c[0] }}"></i> {{ c[1] }}</button>
                    {% endfor %}
                </div>
                <p class="ac-insert__label">Vos schémas (atelier)</p>
                {% if customDiagrams %}
                    <div class="ac-insert__row">
                        {% for d in customDiagrams %}
                            <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="insert('{{ d.token }}')"><i data-lucide="shapes"></i> {{ d.title }}</button>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="ks-help">Aucun pour l'instant.</p>
                {% endif %}
                <p class="ks-help"><a href="{{ path('admin_academie_diagrams') }}" target="_blank" rel="noopener">Créer un schéma dans l'atelier</a> (s'ouvre dans un nouvel onglet ; rechargez cette page ensuite).</p>
                <p class="ac-insert__label">Schémas dessinés sur mesure</p>
                <div class="ac-insert__row">
                    {% for code, label in diagrams %}
                        <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="insert('[[schema:{{ code }}]]')">{{ label }}</button>
                    {% endfor %}
                </div>
                <p class="ac-insert__label">Images du parcours</p>
                {% if images %}
                    <div class="ac-insert__images">
                        {% for image in images %}
                            <button type="button" class="ac-insert__image" @click="insert('![Décrivez l\'image en quelques mots]({{ image.path }})')" title="Insérer cette image"><img src="{{ image.path }}" alt="" loading="lazy"></button>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="ks-help">Aucune image pour l'instant. Ajoutez-en depuis la page du parcours, rubrique « Images du parcours ».</p>
                {% endif %}
                <p class="ks-help"><a href="{{ path('admin_academie_course', {id: course.id}) }}#images">Gérer les images du parcours</a></p>
            </details>
            <div><button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="show()"><i data-lucide="eye"></i> <span x-text="loading ? 'Mise en forme…' : 'Prévisualiser le texte'">Prévisualiser le texte</span></button></div>
            <div class="ac-preview academie-texte" x-show="html" x-cloak x-html="html" aria-live="polite"></div>
        </section>
        </div>

        <section class="ks-card ks-stack">
            <h2 class="ks-card__title"><i data-lucide="video"></i> Vidéo (facultatif)</h2>
            <div class="ks-field">
                <label class="ks-label" for="video">Lien de la vidéo YouTube ou Vimeo</label>
                <input class="ks-input" id="video" name="video" value="{{ data.video }}" inputmode="url" placeholder="https://www.youtube.com/watch?v=…">
                <p class="ks-help">Collez simplement l'adresse de la vidéo. Seuls YouTube et Vimeo sont acceptés. La vidéo ne se charge que si l'apprenant clique dessus (aucune connexion à YouTube ou Vimeo avant).</p>
            </div>
        </section>

        <section class="ks-card ks-stack">
            <h2 class="ks-card__title"><i data-lucide="target"></i> Mettre en pratique : l'exercice relié aux plans (facultatif)</h2>
            <p class="ks-muted">À la fin de la leçon, l'apprenant écrit sa décision ; avec son accord, elle s'ajoute dans le plan choisi. L'Académie ajoute toujours, elle ne remplace jamais ce que la personne a déjà écrit.</p>
            <div class="ks-field">
                <label class="ks-label" for="practice">Ce que l'exercice ajoute</label>
                <select class="ks-input" id="practice" name="practice">
                    <option value="">Pas d'exercice dans cette leçon</option>
                    {% for group, actions in practices %}
                        <optgroup label="{{ group }}">{% for value, label in actions %}<option value="{{ value }}" {{ data.practice == value ? 'selected' }}>{{ label }}</option>{% endfor %}</optgroup>
                    {% endfor %}
                </select>
            </div>
            <div class="ks-field"><label class="ks-label" for="prompt">Consigne</label><textarea class="ks-input" id="prompt" name="prompt" rows="3" placeholder="Nommez une valeur que vous voulez voir guider vos décisions cette semaine.">{{ data.prompt }}</textarea></div>
        </section>

        <div class="ks-sticky-actions">
            <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="check"></i> {{ lesson ? 'Enregistrer la leçon' : 'Créer la leçon' }}</button>
            <a href="{{ path('admin_academie_course', {id: course.id, _fragment: 'structure'}) }}" class="ks-btn ks-btn--ghost">Retour au parcours</a>
            {% if previous %}<a href="{{ path('admin_academie_lesson', {id: previous.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="arrow-left"></i> Précédente</a>{% endif %}
            {% if next %}<a href="{{ path('admin_academie_lesson', {id: next.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm">Suivante <i data-lucide="arrow-right"></i></a>{% endif %}
        </div>
    </form>

    {% if lesson %}
        <section class="ks-card" id="questions">
            <h2 class="ks-card__title"><i data-lucide="list-checks"></i> Questions de discernement ({{ lesson.questions|length }} sur {{ maxQuestions }})</h2>
            <p class="ks-muted" style="margin-bottom: .8rem;">Des mises en situation pour vérifier la compréhension. Jamais de note : l'apprenant voit l'explication et peut recommencer.</p>
            {% for q in lesson.questions %}
                <div class="ac-lesson" data-question="{{ q.id }}">
                    <div class="ac-lesson__title">
                        <a href="{{ path('admin_academie_question', {id: q.id}) }}">{{ q.question|length > 140 ? q.question|slice(0, 140) ~ '…' : q.question }}</a>
                        <div class="ac-meta"><span class="ks-small">{{ q.options|length }} réponses · {{ q.multiple ? 'plusieurs bonnes réponses' : 'une bonne réponse' }}</span></div>
                        {% set good = q.options|filter(o => o.id in q.correctOptionIds) %}
                        {% if good is not empty %}<div class="ac-q-answer">Bonne{{ good|length > 1 ? 's' }} réponse{{ good|length > 1 ? 's' }} : {{ good|map(o => o.label)|join(' ; ') }}</div>{% endif %}
                    </div>
                    <div class="ac-tools">
                        {% for sens, icon in {monter: 'arrow-up', descendre: 'arrow-down'} %}
                            <form method="post" action="{{ path('admin_academie_question_move', {id: q.id}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" name="sens" value="{{ sens }}" class="ac-icon-btn" title="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} la question" aria-label="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} la question" {{ (sens == 'monter' and loop.parent.loop.first) or (sens == 'descendre' and loop.parent.loop.last) ? 'disabled' }}><i data-lucide="{{ icon }}"></i></button></form>
                        {% endfor %}
                        <form method="post" action="{{ path('admin_academie_question_delete', {id: q.id}) }}" onsubmit="return confirm('Supprimer cette question ?');"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" class="ac-icon-btn" title="Supprimer la question" aria-label="Supprimer la question"><i data-lucide="trash-2"></i></button></form>
                    </div>
                </div>
            {% else %}
                <p class="ks-small">Aucune question pour l'instant.</p>
            {% endfor %}
            {% if lesson.questions|length < maxQuestions %}
                <a href="{{ path('admin_academie_question_new', {id: lesson.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm" style="margin-top: .6rem;"><i data-lucide="plus"></i> Ajouter une question</a>
            {% endif %}
        </section>

        <section class="ks-card ac-danger-zone">
            {% if canDelete %}
                <form method="post" action="{{ path('admin_academie_lesson_delete', {id: lesson.id}) }}" onsubmit="return confirm('Supprimer définitivement cette leçon et ses questions ?');">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button type="submit" class="ks-btn ks-btn--danger ks-btn--sm"><i data-lucide="trash-2"></i> Supprimer cette leçon</button>
                </form>
            {% else %}
                <p class="ks-small">Ce parcours a déjà été publié : pour retirer cette leçon, décochez « Visible des apprenants ». Elle n'est pas supprimée, pour que les membres gardent leur progression.</p>
            {% endif %}
        </section>
    {% endif %}
</div>
<script>
(() => {
    const form = document.getElementById('lesson-form');
    if (!form) return;
    let submitting = false;
    window.__ksLessonDirty = false;
    form.addEventListener('input', () => { window.__ksLessonDirty = true; });
    form.addEventListener('change', () => { window.__ksLessonDirty = true; });
    form.addEventListener('submit', () => { submitting = true; window.__ksLessonDirty = false; });
    window.addEventListener('beforeunload', (e) => { if (window.__ksLessonDirty && !submitting) { e.preventDefault(); e.returnValue = ''; } });
    window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') { e.preventDefault(); submitting = true; window.__ksLessonDirty = false; form.requestSubmit(); }
    });
})();
</script>
{% endblock %}
