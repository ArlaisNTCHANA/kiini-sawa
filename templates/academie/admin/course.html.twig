{% extends 'admin/layout.html.twig' %}
{% set name = course ? course.title : 'Nouveau parcours' %}
{% set token = csrf_token('admin_academie') %}
{% block title %}{{ name }}{% endblock %}
{% block stylesheets %}{% include 'academie/_styles.html.twig' %}{% include 'academie/admin/_styles.html.twig' %}{% endblock %}
{% block page_title %}{{ name }}{% endblock %}
{% block crumbs %}<span aria-hidden="true">›</span><span aria-current="page">{{ name }}</span>{% endblock %}
{% block page_actions %}{% if course %}<a href="{{ path('admin_academie_preview', {id: course.id}) }}" class="ks-btn ks-btn--secondary"><i data-lucide="eye"></i> Prévisualiser comme un apprenant</a>{% endif %}{% endblock %}
{% block content %}
<div class="ks-stack" style="max-width: 880px;">
    {% for e in errors %}<div class="ks-alert ks-alert--danger" role="alert">{{ e }}</div>{% endfor %}

    {% if course %}
        <section class="ks-card {{ course.published ? 'ks-card--accent' }}" id="statut">
            <h2 class="ks-card__title"><i data-lucide="{{ course.published ? 'globe' : 'file-pen-line' }}"></i> {{ course.published ? 'Publié : visible dans l\'Académie' : 'Brouillon : invisible des membres' }}</h2>
            {% if course.published %}
                <p class="ks-muted">Pour le retravailler sans qu'il soit visible, repassez-le en brouillon. Les membres qui l'ont commencé le gardent, avec leur progression et leurs notes.</p>
            {% elseif problems is not empty %}
                <p class="ks-muted">Avant de publier :</p>
                <ul style="margin: .4rem 0 0 1.2rem;">{% for p in problems %}<li>{{ p }}</li>{% endfor %}</ul>
            {% else %}
                <p class="ks-muted">Relisez-le avec l'aperçu, puis publiez-le quand il est prêt.</p>
            {% endif %}
            <form method="post" action="{{ path('admin_academie_status', {id: course.id}) }}" style="margin-top: .9rem;">
                <input type="hidden" name="_csrf_token" value="{{ token }}">
                {% if course.published %}
                    <button type="submit" name="action" value="retirer" class="ks-btn ks-btn--secondary"><i data-lucide="eye-off"></i> Repasser en brouillon</button>
                {% else %}
                    <button type="submit" name="action" value="publier" class="ks-btn ks-btn--secondary" {{ problems is not empty ? 'disabled' }}><i data-lucide="send"></i> Publier le parcours</button>
                {% endif %}
            </form>
        </section>
    {% endif %}

    <form method="post" action="{{ course ? path('admin_academie_course', {id: course.id}) : path('admin_academie_new') }}" class="ks-card ks-stack">
        <h2 class="ks-card__title"><i data-lucide="info"></i> Présentation du parcours</h2>
        <input type="hidden" name="_csrf_token" value="{{ token }}">
        <div class="ks-field"><label class="ks-label" for="title">Titre</label><input class="ks-input" id="title" name="title" value="{{ data.title }}" maxlength="160" placeholder="Trouver sa raison d'être" required></div>
        <div class="ks-field"><label class="ks-label" for="subtitle">Accroche</label><input class="ks-input" id="subtitle" name="subtitle" value="{{ data.subtitle }}" maxlength="255" placeholder="Sept leçons pour formuler ce pour quoi Dieu vous a fait."></div>
        <div class="ks-field"><label class="ks-label" for="description">Présentation</label><textarea class="ks-input" id="description" name="description" rows="5" placeholder="À qui s'adresse ce parcours, ce qu'il va changer, comment il se déroule.">{{ data.description }}</textarea><p class="ks-help">Mise en forme possible : **gras**, *italique*, listes avec « - ».</p></div>
        <div class="ks-form-grid">
            <div class="ks-field">
                <label class="ks-label" for="place">Plan principal</label>
                <select class="ks-input" id="place" name="place">
                    <optgroup label="Les 6 plans">
                        {% for key, label in plans %}<option value="{{ key }}" {{ data.place == key ? 'selected' }}>{{ label }}</option>{% endfor %}
                    </optgroup>
                    <optgroup label="À part">
                        <option value="COUPLE" {{ data.place == 'COUPLE' ? 'selected' }}>Sanctuaire du Couple</option>
                        <option value="" {{ data.place == '' ? 'selected' }}>Sans plan précis</option>
                    </optgroup>
                </select>
                <p class="ks-help">Donne la couleur et l'icône du parcours, et le range dans les filtres de l'Académie.</p>
            </div>
            <div class="ks-field">
                <label class="ks-label" for="access">Qui peut le suivre</label>
                <select class="ks-input" id="access" name="access">
                    {% for key, label in accessLevels %}<option value="{{ key }}" {{ data.access == key ? 'selected' }}>{{ label }}</option>{% endfor %}
                </select>
            </div>
        </div>
        <div class="ks-form-grid">
            <div class="ks-field"><label class="ks-label" for="slug">Adresse (après /academie/)</label><input class="ks-input" id="slug" name="slug" value="{{ data.slug }}" placeholder="trouver-sa-raison-d-etre"><p class="ks-help">Laissez vide pour la créer à partir du titre. Évitez de la changer une fois publié : les liens partagés ne marcheraient plus.</p></div>
            <div class="ks-field"><label class="ks-label" for="sortOrder">Ordre d'affichage</label><input class="ks-input" type="number" min="0" max="999" id="sortOrder" name="sortOrder" value="{{ data.sortOrder }}"><p class="ks-help">Les plus petits nombres apparaissent en premier.</p></div>
        </div>
        <div class="ks-sticky-actions">
            <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="check"></i> {{ course ? 'Enregistrer' : 'Créer le parcours' }}</button>
            <a href="{{ path('admin_academie') }}" class="ks-btn ks-btn--ghost">Annuler</a>
        </div>
    </form>

    {% if course %}
        {% set six = academie_six_plans(course) %}
        {% set cover_url = academie_vignette(course) %}
        <section class="ks-card" id="vignette" x-data="{ image: {{ (cover_url ?? '')|json_encode|e('html_attr') }}, word: {{ (course.coverWord ?? '')|json_encode|e('html_attr') }}, pick(e) { const f = e.target.files[0]; if (f) { this.image = URL.createObjectURL(f); } } }">
            <h2 class="ks-card__title"><i data-lucide="image"></i> Vignette et plans couverts</h2>
            <p class="ks-help">La vignette apparaît sur la carte du parcours dans l'Académie et en grand en haut de sa page. Sans image, une vignette est dessinée aux couleurs du plan principal, avec son icône et le mot de votre choix.</p>
            <div class="ac-cover-grid">
                <form method="post" action="{{ path('admin_academie_cover', {id: course.id}) }}" enctype="multipart/form-data" class="ks-stack">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <div class="ks-field">
                        <label class="ks-label" for="cover">Envoyer une image</label>
                        <input class="ks-input" type="file" id="cover" name="cover" accept="image/jpeg,image/png,image/webp" x-on:change="pick($event)">
                        <p class="ks-help">JPEG, PNG ou WebP, 10 Mo au plus, de préférence en largeur (format 16/9, 1600 × 900 pixels par exemple). L'image est allégée automatiquement. N'envoyez que des images que vous avez le droit de publier.</p>
                    </div>
                    {% if images %}
                        <fieldset class="ks-field">
                            <legend class="ks-label">Ou choisir une image du parcours</legend>
                            <div class="ac-cover-choices">
                                <label class="ac-cover-choice"><input type="radio" name="image" value="" {{ course.coverImage is null ? 'checked' }} x-on:change="image = ''"><span class="ac-cover-choice__none"><i data-lucide="sparkles"></i> Vignette dessinée</span></label>
                                {% for image in images %}
                                    <label class="ac-cover-choice"><input type="radio" name="image" value="{{ image.name }}" {{ course.coverImage == image.name ? 'checked' }} x-on:change="image = {{ image.path|json_encode|e('html_attr') }}"><img src="{{ image.path }}" alt="" loading="lazy"></label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    {% else %}
                        <input type="hidden" name="image" value="">
                    {% endif %}
                    <div class="ks-field">
                        <label class="ks-label" for="coverWord">Mot sur la vignette dessinée</label>
                        <input class="ks-input" id="coverWord" name="coverWord" value="{{ course.coverWord }}" maxlength="40" placeholder="Fécondité" x-model="word">
                        <p class="ks-help">Un ou deux mots, écrits en italique sur la vignette quand il n'y a pas d'image.</p>
                    </div>
                    <fieldset class="ks-field">
                        <legend class="ks-label">Plans couverts</legend>
                        <p class="ks-help" style="margin-bottom: .5rem;">Le plan principal et les plans où écrivent les exercices des leçons sont repérés automatiquement. Cochez-en d'autres si le parcours les aborde sans exercice. Le Sanctuaire du Couple s'affiche toujours à part.</p>
                        <div class="ac-plan-checks">
                            {% for p in six %}
                                {% set auto = p.main or p.exercises > 0 %}
                                <label class="ac-plan-check {{ auto ? 'is-auto' }}" style="--c: {{ p.color }};">
                                    <input type="checkbox" name="plans[]" value="{{ p.key }}" {{ p.key in course.extraPlans or auto ? 'checked' }} {{ auto ? 'disabled' }}>
                                    <i data-lucide="{{ p.icon }}"></i>
                                    <span>{{ p.label }}{% if p.main %}<small>plan principal</small>{% elseif p.exercises %}<small>{{ p.exercises }} exercice{{ p.exercises > 1 ? 's' }}</small>{% elseif p.key in course.extraPlans %}<small>ajouté à la main</small>{% endif %}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                    <div><button type="submit" class="ks-btn ks-btn--secondary"><i data-lucide="check"></i> Enregistrer la vignette et les plans</button></div>
                </form>
                <div>
                    <p class="ks-label">Aperçu de la carte</p>
                    <div class="ac-cover-preview" data-cover-preview>
                        {% set look = academie_apparence(course.place) %}
                        <div class="academie-card" style="pointer-events: none;">
                            <div class="academie-vignette" style="--c: {{ look.color }};">
                                <img x-show="image" x-bind:src="image" src="{{ cover_url }}" alt="" {% if not cover_url %}style="display: none;"{% endif %}>
                                <div class="academie-vignette__dessin" x-show="!image" {% if cover_url %}style="display: none;"{% endif %} aria-hidden="true">
                                    <span class="academie-vignette__icone"><i data-lucide="{{ look.icon }}"></i></span>
                                    <span class="academie-vignette__mot" x-text="word">{{ course.coverWord }}</span>
                                </div>
                                <span class="academie-vignette__acces {{ course.free ? 'academie-vignette__acces--libre' }}">{% if course.free %}Gratuit{% else %}<i data-lucide="sparkles"></i> PRO{% endif %}</span>
                            </div>
                            <div class="academie-card__body">
                                <span class="academie-eyebrow" style="--c: {{ look.color }};"><i data-lucide="{{ look.icon }}"></i> {{ academie_lieu(course.place) }}</span>
                                <h3 class="academie-card__title">{{ course.title }}</h3>
                                {% if course.subtitle %}<p class="academie-card__lead">{{ course.subtitle }}</p>{% endif %}
                                <p class="academie-card__meta"><span><i data-lucide="clock"></i> {{ academie_duree(course.estimatedMinutes) }}</span><span><i data-lucide="list-checks"></i> {{ course.lessons(true)|length }} leçon{{ course.lessons(true)|length > 1 ? 's' }}</span></p>
                                <span class="academie-card__plans">
                                    {% if course.couple %}<span class="academie-pastille academie-pastille--main" style="--c: var(--couple); --cs: var(--couple-soft);"><i data-lucide="heart-handshake"></i>Sanctuaire du Couple</span>{% endif %}
                                    {% for p in academie_plans_couverts(course) %}<span class="academie-pastille {{ p.main ? 'academie-pastille--main' }}" style="--c: {{ p.color }}; --cs: {{ p.soft }};"><i data-lucide="{{ p.icon }}"></i>{{ p.short }}</span>{% endfor %}
                                </span>
                            </div>
                        </div>
                    </div>
                    <p class="ks-help" style="margin-top: .6rem;">Les plans de l'aperçu sont ceux enregistrés. <a href="{{ path('admin_academie_preview', {id: course.id}) }}">Voir la page du parcours</a></p>
                </div>
            </div>
        </section>

        <section class="ks-card" id="structure">
            <h2 class="ks-card__title"><i data-lucide="list-tree"></i> Modules et leçons</h2>
            <p class="ks-muted" style="margin-bottom: 1rem;">{{ course.lessons(true)|length }} leçon{{ course.lessons(true)|length > 1 ? 's' }} visible{{ course.lessons(true)|length > 1 ? 's' }} · environ {{ course.estimatedMinutes }} minutes au total.</p>
            {% for m in course.modules %}
                <div class="ac-module" data-module="{{ m.id }}">
                    <div class="ac-module__head">
                        <form method="post" action="{{ path('admin_academie_module_rename', {id: m.id}) }}" class="ac-rename">
                            <input type="hidden" name="_csrf_token" value="{{ token }}">
                            <label class="sr-only" for="module-{{ m.id }}">Titre du module</label>
                            <input class="ks-input" id="module-{{ m.id }}" name="title" value="{{ m.title }}" maxlength="160" style="font-weight: 700;">
                            <button type="submit" class="ac-icon-btn" title="Renommer le module" aria-label="Renommer le module"><i data-lucide="check"></i></button>
                        </form>
                        <div class="ac-tools">
                            {% for sens, icon in {monter: 'arrow-up', descendre: 'arrow-down'} %}
                                <form method="post" action="{{ path('admin_academie_module_move', {id: m.id}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" name="sens" value="{{ sens }}" class="ac-icon-btn" title="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} le module" aria-label="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} le module" {{ (sens == 'monter' and loop.parent.loop.first) or (sens == 'descendre' and loop.parent.loop.last) ? 'disabled' }}><i data-lucide="{{ icon }}"></i></button></form>
                            {% endfor %}
                            {% if m.lessons is empty or canDelete %}
                                <form method="post" action="{{ path('admin_academie_module_delete', {id: m.id}) }}" onsubmit="return confirm('Supprimer ce module{{ m.lessons is empty ? '' : ' et ses leçons' }} ?');"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" class="ac-icon-btn" title="Supprimer le module" aria-label="Supprimer le module"><i data-lucide="trash-2"></i></button></form>
                            {% endif %}
                        </div>
                    </div>
                    {% for l in m.lessons %}
                        <div class="ac-lesson {{ l.visible ? '' : 'is-hidden' }}" data-lesson="{{ l.id }}">
                            <div class="ac-lesson__title">
                                <a href="{{ path('admin_academie_lesson', {id: l.id}) }}">{{ l.title }}</a>
                                <div class="ac-meta">
                                    {% if not l.visible %}<span class="ks-badge ks-badge--warning">Masquée</span>{% endif %}
                                    <span class="ks-small">{{ l.durationMinutes }} min{% if l.hasVideo %} · vidéo {{ academie_video_source(l.mediaProvider) }}{% endif %}{% if l.questions|length %} · {{ l.questions|length }} question{{ l.questions|length > 1 ? 's' }}{% endif %}{% if l.hasPractice %} · exercice : {{ academie_exercice(l.targetPlan, l.targetAction) }}{% endif %}</span>
                                </div>
                            </div>
                            <div class="ac-tools">
                                {% for sens, icon in {monter: 'arrow-up', descendre: 'arrow-down'} %}
                                    <form method="post" action="{{ path('admin_academie_lesson_move', {id: l.id}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" name="sens" value="{{ sens }}" class="ac-icon-btn" title="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} la leçon" aria-label="{{ sens == 'monter' ? 'Monter' : 'Descendre' }} la leçon" {{ (sens == 'monter' and loop.parent.loop.first) or (sens == 'descendre' and loop.parent.loop.last) ? 'disabled' }}><i data-lucide="{{ icon }}"></i></button></form>
                                {% endfor %}
                                <form method="post" action="{{ path('admin_academie_lesson_visibility', {id: l.id}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button type="submit" class="ac-icon-btn" title="{{ l.visible ? 'Masquer aux apprenants' : 'Rendre visible' }}" aria-label="{{ l.visible ? 'Masquer aux apprenants' : 'Rendre visible' }}"><i data-lucide="{{ l.visible ? 'eye' : 'eye-off' }}"></i></button></form>
                                <a href="{{ path('admin_academie_lesson_preview', {id: l.id}) }}" class="ac-icon-btn" title="Aperçu de la leçon" aria-label="Aperçu de la leçon"><i data-lucide="monitor-play"></i></a>
                            </div>
                        </div>
                    {% else %}
                        <p class="ks-small" style="padding: .4rem .2rem;">Aucune leçon dans ce module.</p>
                    {% endfor %}
                    <a href="{{ path('admin_academie_lesson_new', {id: m.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm" style="margin-top: .4rem;"><i data-lucide="plus"></i> Ajouter une leçon</a>
                </div>
            {% endfor %}
            <form method="post" action="{{ path('admin_academie_module_add', {id: course.id}) }}" class="ks-toolbar" style="margin-top: 1rem;">
                <input type="hidden" name="_csrf_token" value="{{ token }}">
                <label class="sr-only" for="new-module">Titre du nouveau module</label>
                <input class="ks-input" id="new-module" name="title" maxlength="160" placeholder="Titre du nouveau module" style="flex: 1 1 240px;">
                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="folder-plus"></i> Ajouter un module</button>
            </form>
        </section>

        <section class="ks-card ks-stack" id="images">
            <h2 class="ks-card__title"><i data-lucide="image"></i> Images du parcours</h2>
            <p class="ks-help">Photos ou illustrations pour les leçons : JPEG, PNG ou WebP, 10 Mo au plus. Chaque image est allégée automatiquement. N'envoyez que des images que vous avez le droit de publier. Pour en placer une dans une leçon, ouvrez la leçon : le panneau « Rendre la leçon plus visuelle » les propose.</p>
            <form method="post" action="{{ path('admin_academie_image_upload', {id: course.id}) }}" enctype="multipart/form-data" class="ks-toolbar" style="flex-wrap: wrap;">
                <input type="hidden" name="_csrf_token" value="{{ token }}">
                <label class="sr-only" for="image">Image à envoyer</label>
                <input class="ks-input" type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" required style="flex: 1 1 240px;">
                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="upload"></i> Envoyer l'image</button>
            </form>
            {% if images %}
                <ul class="ac-images">
                    {% for image in images %}
                        <li id="image-{{ image.name }}">
                            <img src="{{ image.path }}" alt="" loading="lazy">
                            <code>![Description]({{ image.path }})</code>
                            <form method="post" action="{{ path('admin_academie_image_delete', {id: course.id, name: image.name}) }}" onsubmit="return confirm('Supprimer cette image ?');">
                                <input type="hidden" name="_csrf_token" value="{{ token }}">
                                <button type="submit" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="trash-2"></i> Supprimer</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="ks-card ac-danger-zone">
            {% if canDelete %}
                <form method="post" action="{{ path('admin_academie_course_delete', {id: course.id}) }}" onsubmit="return confirm('Supprimer définitivement ce parcours, ses modules, ses leçons et ses questions ?');">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button type="submit" class="ks-btn ks-btn--danger ks-btn--sm"><i data-lucide="trash-2"></i> Supprimer ce parcours</button>
                    <span class="ks-small">Possible tant qu'il n'a jamais été publié.</span>
                </form>
            {% else %}
                <p class="ks-small">Ce parcours a déjà été publié : il ne peut plus être supprimé, pour que les membres gardent leur progression. Repassez-le en brouillon pour le retirer du catalogue.</p>
            {% endif %}
        </section>
    {% endif %}
</div>
{% endblock %}
