{% extends 'base.html.twig' %}
{% block title %}Aperçu : {{ course.title }}{% endblock %}
{% block stylesheets %}{{ parent() }}{% include 'academie/_styles.html.twig' %}{% endblock %}
{% block body %}
<article style="max-width: 1100px; margin: 0 auto; padding: 1.5rem 1rem 6rem;" data-academie-preview>
    {% include 'academie/admin/_preview_banner.html.twig' with {back: path('admin_academie_course', {id: course.id})} %}
    {% include 'academie/_presentation.html.twig' with {preview: true, enrollment: null, locked: false, notes: [], boussole_due: false, can_journal: false} %}
</article>
{% endblock %}
