{% extends 'compte/email/_layout.html.twig' %}
{# Pause automatique après 3 e-mails sans leçon terminée. Variables : name, course, lesson, actionUrl. #}
{% block content %}
  <p>Bonjour {{ name }},</p>
  <p style="font-family:Georgia,serif;font-size:19px;font-weight:bold;color:#2E6B53;margin:18px 0 8px;">{{ t('academie.email_pause.titre', 'Nous mettons votre rythme en pause') }}</p>
  <p>{{ t('academie.email_pause.texte', 'Vous n\'avez pas eu le temps d\'ouvrir les dernières leçons du parcours « {parcours} », et c\'est bien ainsi : chaque saison a son rythme. Pour ne pas encombrer votre boîte, nous arrêtons les e-mails de ce parcours.', 'text', {parcours: course.title}) }}</p>
  <p>{{ t('academie.email_pause.reprise', 'Votre progression est gardée. Quand vous le voudrez, reprenez en un clic depuis la page du parcours, au rythme qui vous convient.') }}</p>
  {% if actionUrl %}
    <p style="text-align:center;margin:28px 0;"><a href="{{ actionUrl }}" style="background:#2E6B53;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">{{ t('academie.email_pause.bouton', 'Reprendre à mon rythme') }}</a></p>
  {% endif %}
  <p style="font-family:Georgia,serif;font-style:italic;color:#1F4D3A;border-left:3px solid #f59e0b;padding-left:12px;margin:24px 0 8px;">{{ t('academie.email_pause.verset', '« Il y a un temps pour tout, un temps pour toute chose sous les cieux. » Ecclésiaste 3:1') }}</p>
  <p style="margin-top:24px;">{{ t('academie.email.signature', 'Avec vous sur le chemin,') }}<br><strong>L'équipe KIINI SAWA</strong></p>
{% endblock %}
{% block footer %}
  {{ t('academie.email_pause.pied', 'Vous recevez ce dernier e-mail parce que vous suiviez un parcours de l\'Académie avec un rythme par e-mail. Plus aucun e-mail de ce parcours ne vous sera envoyé tant que vous ne l\'aurez pas repris.') }}
{% endblock %}
