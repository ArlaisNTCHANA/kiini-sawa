{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<style>
    .dash-wrap {
        max-width: var(--page-standard);
        margin: 0 auto;
        padding: 2rem 1.5rem 8rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
    /* Mobile : carte d'accueil compacte, pour voir les premiers pas et les rituels sans faire défiler */
    @media (max-width: 640px) {
        .dash-hero { padding: 1.5rem 1.35rem !important; border-radius: 1.75rem !important; }
        .dash-hero h1 { font-size: 1.75rem !important; }
        .dash-hero-quote { margin-top: 1rem !important; padding-left: 1rem !important; }
        .dash-hero-quote p { font-size: 1rem !important; line-height: 1.55 !important; }
        .dash-wrap { gap: 1.5rem; padding-top: 1rem; }
        .dash-step-cta { display: none; }
        /* Le bonjour d'abord, puis l'action du moment (contre-audit visuel du 25/11/2026) */
        .next-step { margin: 0 !important; }
    }
    .dash-done { display: flex; align-items: center; gap: .6rem; align-self: center; color: var(--gold-light); font-family: var(--font-serif); font-size: 1.1rem; font-style: italic; }
    .dash-done__dot { width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 5px rgba(200, 150, 46, .25); }
    .dash-streak { margin-top: .35rem; font-size: .78rem; color: var(--gold-light); font-weight: 600; }
    .dash-note-link { margin-left: auto; display: inline-flex; align-items: center; gap: .45rem; padding: .5rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.22); color: var(--card-bg); font-size: .85rem; font-weight: 600; text-decoration: none; background: rgba(255,255,255,.06); }
    .dash-note-link:hover, .dash-note-link:focus-visible { background: rgba(255,255,255,.14); }
    .dash-note-link svg { width: 15px; height: 15px; }
    @media (max-width: 640px) { .dash-note-link { margin-left: 0; } }
    .dash-birth { width: 100%; box-sizing: border-box; padding: .9rem 1.1rem !important; }
    .dash-birth label { font-size: .95rem; }
    @media (min-width: 1024px) {
        .dash-wrap {
            padding: 2.5rem 2rem 5rem;
            gap: 2rem;
        }
    }

    


    /* Habit Cards */
    .habit-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        border-radius: 1.25rem;
        background: #ffffff;
        cursor: pointer;
        border: 1px solid rgba(46, 107, 83, 0.05);
        box-shadow: 0 4px 12px rgba(46, 107, 83, 0.02);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
        position: relative;
    }
    
    /* Circular Checkbox */
    .custom-chk {
        width: 1.35rem;
        height: 1.35rem;
        border-radius: 50%;
        flex-shrink: 0;
        border: 2px solid var(--border-strong);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        background: white;
    }


    /* Pillar buttons active state */
    .btn-pillar.active {
        background: var(--p-color) !important;
        color: white !important;
        border-color: var(--p-color) !important;
        box-shadow: 0 8px 20px -4px var(--p-glow) !important;
        transform: translateY(-1px);
    }
</style>
<div class="dash-wrap">
    {% if app.user %}

    {# Carte « Bravo » juste après l'accueil des nouveaux inscrits (contre-audit visuel du 25/11/2026) #}
    {% set welcome = app.flashes('welcome')|first %}
    {% if welcome %}
    <section class="welcome-card" role="status">
        <span class="welcome-card__dot" aria-hidden="true"></span>
        <p class="ks-eyebrow" style="margin: 0;">{{ t('accueil.bravo.surtitre', 'Bravo') }}</p>
        <h2 class="welcome-card__title">{{ t('accueil.bravo.titre', 'Vos fondations sont posées') }}</h2>
        {% if welcome.purpose %}<blockquote class="welcome-card__purpose">« {{ welcome.purpose }} »</blockquote>{% endif %}
        {% if welcome.values|length %}
            <ul class="welcome-card__values">{% for v in welcome.values %}<li>{{ v }}</li>{% endfor %}</ul>
        {% endif %}
        <p class="welcome-card__text">{{ t('accueil.bravo.texte', 'C\'est le cœur de votre Plan de Vie. Prenez le temps de le relire : la suite, vos plans et vos rituels, en découle.') }}</p>
        <div class="welcome-card__actions">
            {# Parcours guidés (26/11/2026) : à la fin de l'accueil, proposer de remplir ses plans par un parcours #}
            {% if nextStep|default(null) and nextStep.kind in ['plan-journey-start', 'first-step'] %}
            <a href="{{ path('app_academie_start') }}" class="ks-btn ks-btn--primary">{{ t('accueil.bravo.parcours', 'Choisir mon parcours guidé') }}</a>
            <a href="{{ path('app_plan_de_vie') }}" class="welcome-card__link">{{ t('accueil.bravo.action', 'Voir mon Plan de Vie') }}</a>
            {% else %}
            <a href="{{ path('app_plan_de_vie') }}" class="ks-btn ks-btn--primary">{{ t('accueil.bravo.action', 'Voir mon Plan de Vie') }}</a>
            <a href="{{ path('app_plan_de_vie', {onglet: 'analysis'}) }}" class="welcome-card__link">{{ t('accueil.bravo.analyse', 'Comment l\'enrichir') }}</a>
            {% endif %}
        </div>
    </section>
    <style>
        .welcome-card { position: relative; background: var(--card-bg); border: 1px solid var(--border); border-top: 3px solid var(--gold); border-radius: var(--r-lg, 16px); padding: 1.75rem 1.5rem; box-shadow: var(--card-shadow); }
        .welcome-card__dot { position: absolute; top: 1.5rem; right: 1.5rem; width: 12px; height: 12px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 6px var(--gold-soft); }
        .welcome-card__title { font-family: var(--font-serif); font-weight: 600; color: var(--primary-dark); font-size: 1.6rem; margin: .35rem 0 .75rem; }
        .welcome-card__purpose { font-family: var(--font-serif); font-style: italic; font-size: 1.15rem; line-height: 1.5; color: var(--fg); border-left: 3px solid var(--gold); padding-left: 1rem; margin: 0 0 1rem; }
        .welcome-card__values { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 0 0 1rem; }
        .welcome-card__values li { background: var(--primary-soft); color: var(--primary-dark); border-radius: 999px; padding: .35rem .85rem; font-size: .88rem; font-weight: 600; }
        .welcome-card__text { color: var(--fg-muted); margin: 0 0 1.25rem; line-height: 1.6; }
        .welcome-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; }
        .welcome-card__link { color: var(--primary); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    </style>
    {% endif %}

    {# ══════════════════════════════════════════════════════
       SECTION 1 — HERO (DashboardSummary)
       Atmospheric Gradient with mesh glow effects
     ══════════════════════════════════════════════════════ #}
    <section class="dash-hero" style="
        background: linear-gradient(135deg, #173D2E 0%, var(--primary-dark) 45%, var(--primary) 100%);
        border-radius: 2rem; padding: 1.9rem 2.4rem; color: white;
        position: relative; overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 25px 60px -15px rgba(46, 107, 83, 0.35), 0 4px 20px rgba(0,0,0,0.15);"
    >
        {# Ambient Glows #}
        <div style="position: absolute; top: -10%; left: -10%; width: 40%; height: 60%; background: radial-gradient(circle, rgba(122, 158, 126, 0.30) 0%, transparent 70%); filter: blur(40px); pointer-events: none;"></div>
        <div style="position: absolute; bottom: -20%; right: -10%; width: 50%; height: 70%; background: radial-gradient(circle, rgba(200, 150, 46, 0.22) 0%, transparent 70%); filter: blur(50px); pointer-events: none;"></div>
        <div style="position: absolute; top: 20%; right: 10%; width: 45%; height: 55%; background: radial-gradient(circle, rgba(94, 148, 121, 0.18) 0%, transparent 70%); filter: blur(40px); pointer-events: none;"></div>

        {# Dot Grid Overlay #}
        <div style="position: absolute; inset: 0; pointer-events: none; opacity: 0.18;
                    background-image: radial-gradient(circle, rgba(255,255,255,0.15) 1.5px, transparent 1.5px);
                    background-size: 24px 24px;"></div>

        <div style="position: relative; z-index: 1;">
            {# Date + Avatar #}
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: .25rem;">
                <div>
                    {# Date badge #}
                    <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.85rem; 
                                background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); 
                                border: 1px solid rgba(255,255,255,0.1); border-radius: 9999px; 
                                font-size: 0.725rem; font-weight: 700; color: var(--primary-tint); margin-bottom: 0.6rem;
                                letter-spacing: 0.05em;">
                        <i data-lucide="calendar" style="width: 12px; height: 12px;"></i>
                        <span>{{ "now"|format_date(pattern: "EEEE d MMMM y", locale: "fr")|upper }}</span>
                    </div>

                    <h1 style="font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.6rem);
                               font-weight: 500; color: white; line-height: 1.15;">
                        Bonjour, <span style="background: linear-gradient(135deg, #FFFFFF 30%, #E9C46A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{{ app.user.displayName }}</span>
                    </h1>
                </div>

            </div>

            {# Quote in modern styled block #}
            <div class="dash-hero-quote" style="position: relative; margin-top: 1.1rem; padding-left: 1.25rem; border-left: 3px solid var(--primary-light);">
                <p style="font-family: var(--font-serif); font-style: italic;
                          font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.6;
                          color: rgba(255,255,255,0.92); text-shadow: 0 2px 10px rgba(0,0,0,0.15);">
                    {% if quote is defined and quote %}
                        « {{ quote.content|trim('"«» ') }} »
                    {% else %}
                        « L'espace de votre croissance. Construisez la vie que vous méritez, un pas à la fois. »
                    {% endif %}
                </p>
                {% if quote is defined and quote and quote.author is defined %}
                <p style="font-size: 0.8rem; color: var(--primary-tint); opacity: .8; margin-top: 0.5rem;
                          letter-spacing: 0.12em; font-weight: 700; text-transform: uppercase;">— {{ quote.author }}</p>
                {% endif %}
            </div>

            {# Quick Stats #}
            <div style="display: flex; gap: 1rem 2rem; margin-top: 1.25rem; padding-top: 1rem; align-items: center;
                        border-top: 1px solid rgba(255,255,255,0.12); flex-wrap: wrap;">
                {# Point 9 : pas de « 0/0 » ni de tiret seul quand aucun rituel n'est prévu aujourd'hui (27/11/2026) #}
                {% if stats is defined and stats and stats.habitsToday is defined and stats.habitsToday.total > 0 %}
                <div>
                    <p style="font-size: 1.75rem; font-weight: 700; color: white; font-family: var(--font-serif); line-height: 1.2;">
                        {{ stats.habitsToday.done ~ '/' ~ stats.habitsToday.total }}
                    </p>
                    <p style="font-size: 0.65rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; margin-top: 2px;">Rituels du jour</p>
                </div>
                {# Récompense sobre : le point d'or quand la journée est tenue (contre-audit visuel du 25/11/2026) #}
                {% if stats.habitsToday.done >= stats.habitsToday.total %}
                <div class="dash-done" role="status">
                    <span class="dash-done__dot" aria-hidden="true"></span>
                    <span>{{ t('accueil.journee_tenue', 'Journée tenue. Bravo !') }}</span>
                </div>
                {% endif %}
                {% endif %}
                {% if stats is defined and stats and stats.streak is defined and stats.streak > 0 %}
                <div>
                    <p style="font-size: 1.75rem; font-weight: 700; color: white; font-family: var(--font-serif); line-height: 1.2;">
                        {{ stats.streak }}j
                    </p>
                    <p style="font-size: 0.65rem; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; margin-top: 2px;">Série actuelle</p>
                    {% if stats.streak >= 7 %}<p class="dash-streak">{{ stats.streak >= 30 ? t('accueil.serie_mois', 'Un mois de fidélité') : (stats.streak >= 21 ? t('accueil.serie_trois', 'Trois semaines de suite') : t('accueil.serie_semaine', 'Une semaine de suite')) }}</p>{% endif %}
                </div>
                {% endif %}
                {# La Note rapide a quitté l'accueil (27/11/2026) : un lien ouvre directement l'écriture dans le Journal #}
                <a href="{{ path('app_journal') }}#ecrire" class="dash-note-link"><i data-lucide="pencil-line" aria-hidden="true"></i> {{ t('accueil.noter', 'Noter une pensée') }}</a>
            </div>
        </div>
    </section>

    {# Ma prochaine étape : une seule action en tête (NextStep), puis deux « ensuite » #}
    {% if nextStep|default(null) %}
        <section class="ks-card ks-card--accent next-step" data-next-step="{{ nextStep.kind }}"{% if nextStep.kind == 'journey' %} data-journey-reminder{% elseif nextStep.kind == 'journey-start' %} data-journey-invite{% endif %} style="max-width: 1100px; margin: 1.25rem auto 0;">
            <p class="ks-eyebrow" style="margin: 0;"><i data-lucide="{{ nextStep.icon }}" class="ks-ico" aria-hidden="true"></i> Ma prochaine étape · {{ nextStep.eyebrow }}</p>
            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem 1.25rem; margin-top: .35rem;">
                <div style="flex: 1 1 320px; min-width: 0;">
                    <p class="next-step__title">{{ nextStep.title }}</p>
                    <p class="next-step__text">{{ nextStep.text }}</p>
                </div>
                <a href="{{ path(nextStep.route, nextStep.params) }}{{ nextStep.fragment ? '#' ~ nextStep.fragment : '' }}" class="ks-btn ks-btn--primary">{{ nextStep.cta }}</a>
            </div>
            {% if nextSteps|length %}
                {# Les premiers pas, dans la même carte : plus de doublon avec « Ma prochaine étape » (27/11/2026) #}
                {% set doneCount = nextSteps|filter(s => s.done)|length %}
                {% set firstUndone = nextSteps|filter(s => not s.done)|first %}
                <div class="next-step__first">
                    <div class="next-step__first-head"><span>Vos premiers pas</span><span>{{ doneCount }} {{ doneCount > 1 ? "faits" : "fait" }} sur {{ nextSteps|length }}</span></div>
                    <div class="next-step__bar" aria-hidden="true"><div style="width: {{ (doneCount / nextSteps|length * 100)|round }}%;"></div></div>
                    <ol class="next-step__list">
                        {% for step in nextSteps %}
                            {% set isNext = step == firstUndone %}
                            <li data-first-step="{{ step.key|default('') }}" class="{{ step.done ? 'is-done' : (isNext ? 'is-next' : '') }}">
                                <a href="{{ step.url }}">
                                    <span class="next-step__num">{% if step.done %}<i data-lucide="check" aria-hidden="true"></i><span class="sr-only">Fait :</span>{% else %}{{ loop.index }}{% endif %}</span>
                                    <span class="next-step__label">{{ step.label }}</span>
                                    {% if isNext %}<span class="dash-step-cta">{{ step.cta|default('Commencer') }} →</span>{% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ol>
                    {% if is_trialing() and pro_until() %}
                        <p class="next-step__trial"><i data-lucide="sparkles" class="ks-ico" aria-hidden="true"></i> Votre essai PRO est actif jusqu'au <strong>{{ pro_until()|date('d/m/Y') }}</strong> : profitez-en pour bâtir aussi vos plans de Croissance, Développement personnel, Hygiène de vie, Intendance et Transmission. <a href="{{ path('app_subscription') }}">En savoir plus</a></p>
                    {% endif %}
                </div>
            {% elseif nextStep.then|length %}
                <p class="next-step__then"><span>Ensuite :</span>
                    {% for t in nextStep.then %}<a href="{{ path(t.route, t.params) }}">{{ t.title }}</a>{{ loop.last ? '' : ' · ' }}{% endfor %}
                </p>
            {% endif %}
        </section>
        <style>
            .next-step__title { font-family: var(--font-serif); font-size: 1.35rem; line-height: 1.25; margin: 0; color: var(--fg); }
            .next-step__text { margin: .3rem 0 0; color: var(--fg-muted); }
            .next-step__then { margin: .9rem 0 0; font-size: .88rem; color: var(--fg-muted); }
            .next-step__then span { font-weight: 700; margin-right: .25rem; }
            .next-step__then a { color: var(--primary); font-weight: 600; text-decoration: none; }
            @media (max-width: 560px) { .next-step .ks-btn { width: 100%; justify-content: center; } }
            .next-step__first { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--border); }
            .next-step__first-head { display: flex; justify-content: space-between; font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--fg-muted); }
            .next-step__bar { height: 5px; background: var(--border); border-radius: 99px; margin: .5rem 0 .6rem; overflow: hidden; }
            .next-step__bar div { height: 5px; background: var(--primary); }
            .next-step__list { list-style: none; padding: 0; margin: 0; display: grid; gap: .15rem; }
            .next-step__list a { display: flex; align-items: center; gap: .65rem; padding: .4rem .5rem; border-radius: var(--r-md); text-decoration: none; color: var(--fg); font-size: .92rem; }
            .next-step__list a:hover { background: var(--bg-alt); }
            .next-step__list .is-next a { font-weight: 600; }
            .next-step__list .is-done .next-step__label { color: var(--fg-muted); text-decoration: line-through; }
            .next-step__num { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 700; border: 2px solid var(--border-strong); color: var(--fg-muted); }
            .next-step__num svg { width: 13px; height: 13px; }
            .next-step__list .is-done .next-step__num { background: var(--primary); border-color: var(--primary); color: var(--card-bg); }
            .next-step__label { flex: 1; min-width: 0; }
            .next-step .dash-step-cta { flex-shrink: 0; font-size: .82rem; font-weight: 700; color: var(--primary); }
            .next-step__trial { margin: .8rem 0 0; font-size: .85rem; color: var(--fg-light); background: var(--warning-soft); border-radius: var(--r-md); padding: .55rem .85rem; }
            .next-step__trial a { color: var(--primary); font-weight: 600; }
        </style>
    {% endif %}

    {# Proposition d'activer les notifications (application installée uniquement) #}
    {% include 'shared/_push_toggle.html.twig' with {compact: true} %}

    {# Défis collectifs en cours #}
    {% for ch in challenges %}
        <section class="ks-card ks-card--accent" style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
            <div style="flex: 1; min-width: 220px;">
                <p class="ks-eyebrow"><i data-lucide="trophy" class="ks-ico" aria-hidden="true"></i> {{ ch.c.title }}{% if ch.phase == 'running' %} · jour {{ ch.day }} sur {{ ch.c.durationDays }}{% endif %}</p>
                {% if ch.phase == 'running' %}
                    <p style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--fg); margin-top: .3rem;">{{ ch.c.actionForDay(ch.day) }}</p>
                {% else %}
                    <p style="color: var(--fg-muted); margin-top: .3rem;">Commence le {{ ch.c.startDate|format_date(pattern: 'd MMMM', locale: 'fr') }}.</p>
                {% endif %}
            </div>
            {% if ch.phase == 'running' %}
                {% if ch.checked %}
                    <span class="ks-badge">✓ Journée validée</span>
                {% else %}
                    <form method="post" action="{{ path('app_challenge_checkin', {slug: ch.c.slug}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('challenge_checkin') }}">
                        <input type="hidden" name="from" value="dashboard">
                        <button type="submit" class="ks-btn ks-btn--primary">J'ai fait ma part ✓</button>
                    </form>
                {% endif %}
            {% else %}
                <a href="{{ path('app_challenge', {slug: ch.c.slug}) }}" class="ks-btn ks-btn--secondary">Voir le défi</a>
            {% endif %}
        </section>
    {% endfor %}

    {# ══════════════════════════════════════════════════════
       SECTION 3 — VOS RITUELS (HabitTracker with filtering)
    ══════════════════════════════════════════════════════ #}
    <section style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
                    border-radius: 2.5rem; padding: 2.25rem 2.75rem;
                    border: 1px solid rgba(46, 107, 83, 0.06); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.03);">

        {# Section Header #}
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 2rem;">
            <div style="width: 6px; height: 12px; background: var(--primary); border-radius: 999px;"></div>
            <span style="font-size: 0.725rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase;
                         color: var(--fg-muted); white-space: nowrap;">Vos Rituels</span>
            <div style="height: 1px; flex: 1; background: rgba(46, 107, 83, 0.08);"></div>
            <a href="{{ path('app_user_habits') }}"
               style="display: flex; align-items: center; gap: 0.375rem; font-size: 0.725rem; font-weight: 700;
                      color: var(--fg-muted); text-decoration: none; transition: all 0.2s var(--ease); padding: 0.45rem 1rem;
                      border-radius: 9999px; border: 1.5px solid rgba(46, 107, 83, 0.1); background: white;"
               onmouseover="this.style.color='var(--primary)'; this.style.borderColor='rgba(46, 107, 83, 0.3)'; this.style.boxShadow='0 4px 12px rgba(46, 107, 83,0.05)'"
               onmouseout="this.style.color='var(--fg-muted)'; this.style.borderColor='rgba(46, 107, 83, 0.1)'; this.style.boxShadow='none'">
                <i data-lucide="settings-2" style="width: 14px; height: 14px;"></i>
                <span>Configurer</span>
            </a>
        </div>

        {% if habits is defined and habits is not empty %}
        <div x-data="{ pillar: 'ALL' }">

            {# Pillar Filters #}
            {% set pillars = [
                { id: 'ALL',          label: 'Tout',          color: '#2E6B53', glow: 'rgba(46, 107, 83, 0.15)' },
                { id: 'CROISSANCE',   label: 'Croissance',    color: '#1F4D3A', glow: 'rgba(31, 77, 58, 0.15)' },
                { id: 'DEVELOPPEMENT',label: 'Développement', color: '#2E6B53', glow: 'rgba(46, 107, 83, 0.15)' },
                { id: 'TRANSMISSION', label: 'Transmission',  color: '#A87A1F', glow: 'rgba(168, 122, 31, 0.15)' },
                { id: 'HYGIENE',      label: 'Hygiène',       color: '#5D7368', glow: 'rgba(93, 115, 104, 0.15)' },
            ] %}
            <div class="ks-scroll-row" style="margin-bottom: 0.5rem;">
                {% for p in pillars %}
                <button @click="pillar = '{{ p.id }}'"
                        class="btn-pillar"
                        :class="pillar === '{{ p.id }}' ? 'active' : ''"
                        style="--p-color: {{ p.color }}; --p-glow: {{ p.glow }};
                               display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1.25rem;
                               border-radius: 9999px; font-size: 0.75rem; font-weight: 750; letter-spacing: 0.05em;
                               text-transform: uppercase; cursor: pointer; border: 1.5px solid transparent;
                               transition: all 0.25s var(--ease); font-family: var(--font-sans);
                               background: rgba(241, 245, 249, 0.8); color: var(--fg-light);
                               box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);"
                        onmouseover="if(this.className.indexOf('active') === -1) { this.style.borderColor='rgba(46, 107, 83,0.15)'; this.style.color='#2E6B53'; }"
                        onmouseout="if(this.className.indexOf('active') === -1) { this.style.borderColor='transparent'; this.style.color='#475569'; }">
                    {% if p.id != 'ALL' %}
                    <span style="width: 0.5rem; height: 0.5rem; border-radius: 50%; background: {{ p.color }}; display: inline-block;"></span>
                    {% endif %}
                    {{ p.label }}
                </button>
                {% endfor %}
            </div>

            {# Pillar Config & Colors Metadata mapping #}
            {% set pillarMeta = {
                'CROISSANCE':   { color: '#1F4D3A', glow: 'rgba(31, 77, 58, 0.08)', bg: '#E4ECE7', border: '#C8D6CD' },
                'DEVELOPPEMENT':{ color: '#2E6B53', glow: 'rgba(46, 107, 83, 0.08)', bg: '#E9F1EC', border: '#C8D6CD' },
                'TRANSMISSION': { color: '#A87A1F', glow: 'rgba(168, 122, 31, 0.08)', bg: '#FAF4E6', border: '#EAD49A' },
                'HYGIENE':      { color: '#2E6B53', glow: 'rgba(79, 70, 229, 0.08)', bg: '#E0E7FF', border: '#C7D2FE' },
                'ALL':          { color: '#2E6B53', glow: 'rgba(46, 107, 83, 0.08)', bg: '#E6F4F1', border: '#B2DFDB' }
            } %}

            {# Ritual Groups #}
            {% set habitGroups = [
                { key: 'DAILY',   label: 'Ma Journée' },
                { key: 'WEEKLY',  label: 'Ma Semaine' },
                { key: 'MONTHLY', label: 'Mon Mois' },
            ] %}

            {% for group in habitGroups %}
            {% set groupHabits = habits|filter(h => h.frequency.value == group.key) %}
            {% if groupHabits is not empty %}
            <div style="margin-bottom: 2rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                    <h2 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--primary); font-weight: 500; white-space: nowrap;">{{ group.label }}</h2>
                    <div style="height: 1px; flex: 1; background: rgba(46, 107, 83, 0.06);"></div>
                    <span style="font-size: 0.725rem; color: var(--fg-muted); font-weight: 700; background: rgba(46, 107, 83,0.06); padding: 0.2rem 0.5rem; border-radius: var(--r-sm);">{{ groupHabits|length }}</span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem;">
                    {% for habit in groupHabits %}
                        {# Detect Pillar #}
                        {% set hPillar = 'ALL' %}
                        {% if habit.growthGoal is not null %}
                            {% set hPillar = 'CROISSANCE' %}
                        {% elseif habit.skillGoal is not null %}
                            {% set hPillar = 'DEVELOPPEMENT' %}
                        {% elseif habit.legacyGoal is not null %}
                            {% set hPillar = 'TRANSMISSION' %}
                        {% elseif habit.hygieneDomain is not null %}
                            {% set hPillar = 'HYGIENE' %}
                        {% endif %}
                        {% set meta = pillarMeta[hPillar] %}

                        <div class="habit-card"
                               x-show="pillar === 'ALL' || pillar === '{{ hPillar }}'"
                               x-data="{ checked: {{ habit.isCompletedForCurrentPeriod() ? 'true' : 'false' }}, isToggling: false }"
                               style="--pillar-color: {{ meta.color }}; --pillar-glow: {{ meta.glow }};"
                               onmouseover="this.style.borderColor='{{ meta.color }}'; this.style.boxShadow='0 10px 24px {{ meta.glow }}'; this.style.transform='translateY(-2px)'"
                               onmouseout="this.style.borderColor='rgba(46, 107, 83, 0.05)'; this.style.boxShadow='0 4px 12px rgba(46, 107, 83, 0.02)'; this.style.transform=''"
                               @click="if (isToggling) return; isToggling = true; const original = checked; checked = !checked; fetch('/api/habits/{{ habit.id }}/log', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: checked }) }).then(res => { if (!res.ok) throw new Error(); return res.json(); }).then(data => { if (data.success) { checked = data.isCompleted; } else { throw new Error(); } }).catch(() => { checked = original; }).finally(() => { isToggling = false; })"
                        >
                            {# Left Accent Bar #}
                            <span style="position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: {{ meta.color }};"></span>

                            {# Custom Circular Checkbox #}
                            <span class="custom-chk" :style="checked ? 'border-color: var(--pillar-color); background: var(--pillar-glow);' : 'border-color: {{ meta.color }}50;'">
                                <span style="width: 0.6rem; height: 0.6rem; background: var(--pillar-color); border-radius: 50%; transition: all 0.25s var(--ease);"
                                      :style="checked ? 'opacity: 1; transform: scale(1);' : 'opacity: 0; transform: scale(0.5);'"></span>
                            </span>

                            {# Title #}
                            <div style="flex: 1; min-width: 0;">
                                <p style="font-size: 0.95rem; font-weight: 600; transition: color 0.2s;"
                                   :style="checked ? 'color: var(--fg-muted); text-decoration: line-through;' : 'color: var(--fg);'">
                                    {{ habit.title }}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            {% endfor %}
        </div>

        {% else %}
        {# Empty State (Luxurious) #}
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center;
                    padding: 4rem 2rem; background: rgba(255, 255, 255, 0.5); border-radius: 2rem;
                    border: 2px dashed rgba(46, 107, 83, 0.15);
                    box-shadow: inset 0 2px 8px rgba(0,0,0,0.01);">
            <div style="width: 4.5rem; height: 4.5rem; border-radius: 50%; background: white;
                        border: 1px solid rgba(46, 107, 83, 0.08); display: flex; align-items: center;
                        justify-content: center; margin-bottom: 1.5rem;
                        box-shadow: 0 4px 16px rgba(46, 107, 83, 0.06);">
                <i data-lucide="compass" style="width: 32px; height: 32px; color: var(--fg-muted);"></i>
            </div>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: var(--primary);
                       font-weight: 500; margin-bottom: 0.75rem;">Aucun rituel pour l'instant</h3>
            <p style="color: var(--fg-muted); font-size: 0.95rem; line-height: 1.7; max-width: 24rem; margin-bottom: 2rem;">
                Un rituel est une petite action régulière (prière du matin, lecture, sport…) qui nourrit vos objectifs. Commencez par un seul.
            </p>
            <a href="{{ path('app_user_habits') }}"
               style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.75rem;
                      background: var(--primary); color: white; border-radius: 9999px; font-weight: 700;
                      font-size: 0.875rem; text-decoration: none; transition: all 0.25s var(--ease);
                      box-shadow: 0 4px 16px rgba(46, 107, 83, 0.35); font-family: var(--font-sans);"
               onmouseover="this.style.background='var(--primary-dark)'; this.style.transform='translateY(-1px)'"
               onmouseout="this.style.background='var(--primary)'; this.style.transform=''">
                <span>Créer mon premier rituel</span>
                <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
            </a>
        </div>
        {% endif %}
    </section>

    {# ══════════════════════════════════════════════════════
       SECTION 1 bis — MA BOUSSOLE : raison d'être et prochaines échéances
    ══════════════════════════════════════════════════════ #}
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-top: 1.5rem;">
        {# Point 9 : la carte « Bravo » montre déjà la raison d'être juste écrite : pas deux fois #}
        {% if not welcome %}
        <a href="{{ path('app_plan_de_vie') }}" style="display: block; text-decoration: none; background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem; border-left: 4px solid var(--primary);">
            <p style="font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem;">
                <i data-lucide="compass" style="width: 14px; height: 14px;"></i> Ma raison d'être
            </p>
            {% if planDeVie and planDeVie.purpose and planDeVie.purpose.statement %}
                <p style="font-family: var(--font-serif); font-size: 1.1rem; line-height: 1.55; color: var(--fg);">« {{ planDeVie.purpose.statement|length > 220 ? planDeVie.purpose.statement|slice(0, 220) ~ '…' : planDeVie.purpose.statement }} »</p>
            {% else %}
                <p style="color: var(--fg-muted); font-size: 0.95rem;">Vous n'avez pas encore formulé votre raison d'être. <span style="color: var(--primary); font-weight: 600;">La rédiger →</span></p>
            {% endif %}
        </a>
        {% endif %}

        <div style="background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem;">
            <p style="font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.4rem;">
                <i data-lucide="flag" style="width: 14px; height: 14px;"></i> Prochaines échéances
            </p>
            {% for d in deadlines %}
                <a href="{{ path(d.route) }}" style="display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.5rem 0; border-top: {{ loop.first ? 'none' : '1px solid var(--bg-alt)' }}; text-decoration: none;">
                    <span style="color: var(--fg); font-size: 0.9rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{{ d.title }}
                        <small style="display: block; color: var(--fg-muted); font-size: 0.72rem; font-weight: 400;">{{ d.plan }}</small>
                    </span>
                    <span style="flex-shrink: 0; font-size: 0.8rem; font-weight: 700; color: {{ d.overdue ? 'var(--danger)' : 'var(--fg-light)' }};">{{ d.overdue ? 'En retard · ' }}{{ d.date|format_date(pattern: 'd MMM y', locale: 'fr') }}</span>
                </a>
            {% else %}
                <p style="color: var(--fg-muted); font-size: 0.9rem;">Aucune échéance à venir. Donnez une date à vos objectifs pour les voir ici.</p>
            {% endfor %}
        </div>
    </section>

    {# Parcours de 90 jours (livre, annexe A) #}
    {% if nextStep|default(null) %}
        {# le parcours est présenté dans « Ma prochaine étape » (action principale ou « ensuite ») #}
    {% elseif journeyWeek|default(null) %}
        <section class="ks-card" data-journey-reminder style="max-width: 1100px; margin: 1.25rem auto 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem;">
            <div>
                <p class="ks-eyebrow" style="margin: 0;">Mon parcours de 90 jours · semaine {{ journeyWeek.n }} sur 13</p>
                <p style="font-family: var(--font-serif); font-size: 1.1rem; margin: .2rem 0 0;">{{ journeyWeek.produce }}</p>
            </div>
            <a href="{{ path('app_journey') }}#semaine-{{ journeyWeek.n }}" class="ks-btn ks-btn--secondary ks-btn--sm">Voir ma semaine</a>
        </section>
    {% elseif journey|default(null) is null %}
        <section class="ks-card ks-card--flat" data-journey-invite style="max-width: 1100px; margin: 1.25rem auto 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem;">
            <p style="margin: 0;"><strong>Le parcours de 90 jours</strong> : treize semaines pour écrire vos six plans, chapitre après chapitre.</p>
            <a href="{{ path('app_journey') }}" class="ks-btn ks-btn--ghost ks-btn--sm">Découvrir le parcours</a>
        </section>
    {% endif %}

    {# Premiers pas : guide l'utilisateur après l'onboarding, disparaît quand tout est fait #}
    {% if nextSteps|length and not nextStep|default(null) %}
        {% set doneCount = nextSteps|filter(s => s.done)|length %}
        {% set firstUndone = nextSteps|filter(s => not s.done)|first %}
        <section style="margin-top: 1.5rem; background: var(--card-bg); border-radius: var(--r-lg); box-shadow: var(--card-shadow); padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap;">
                <h2 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--fg);">Vos premiers pas</h2>
                <span style="font-size: .8rem; color: var(--fg-muted); font-weight: 600;">{{ doneCount }} sur {{ nextSteps|length }}</span>
            </div>
            <div style="height: 6px; background: var(--border); border-radius: 99px; margin: .75rem 0 1.25rem; overflow: hidden;"><div style="height: 6px; width: {{ (doneCount / nextSteps|length * 100)|round }}%; background: var(--primary);"></div></div>
            <ol style="list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem;">
                {% for step in nextSteps %}
                    {% set isNext = step == firstUndone %}
                    <li data-first-step="{{ step.key|default('') }}">
                        <a href="{{ step.url }}" style="display: flex; align-items: center; gap: .85rem; padding: .7rem .9rem; border-radius: var(--r-md); text-decoration: none; {{ isNext ? 'background: var(--primary-soft); border: 1px solid #C8D6CD;' : 'border: 1px solid transparent;' }}">
                            <span style="flex-shrink: 0; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .8rem; font-weight: 700; {{ step.done ? 'background: var(--primary); color: #fff;' : 'border: 2px solid var(--border-strong); color: var(--fg-muted);' }}">{{ step.done ? '✓' : loop.index }}</span>
                            <span style="flex: 1;">
                                <span style="display: block; font-weight: 600; color: {{ step.done ? 'var(--fg-muted)' : 'var(--fg)' }}; {{ step.done ? 'text-decoration: line-through;' : '' }}">{{ step.label }}</span>
                                {% if isNext %}<span style="display: block; font-size: .85rem; color: var(--fg-light);">{{ step.hint }}</span>{% endif %}
                            </span>
                            {% if isNext %}<span class="dash-step-cta" style="flex-shrink: 0; font-size: .85rem; font-weight: 700; color: var(--primary);">{{ step.cta|default('Commencer') }} →</span>{% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ol>
            {% if is_trialing() and pro_until() %}
                <p style="margin-top: 1rem; font-size: .85rem; color: var(--fg-light); background: var(--warning-soft); border-radius: var(--r-md); padding: .6rem .9rem;"><i data-lucide="sparkles" class="ks-ico" aria-hidden="true"></i> Votre essai PRO est actif jusqu'au <strong>{{ pro_until()|date('d/m/Y') }}</strong> : profitez-en pour bâtir aussi vos plans de Croissance, Développement personnel, Hygiène de vie, Intendance et Transmission. <a href="{{ path('app_subscription') }}" style="color: var(--primary); font-weight: 600;">En savoir plus</a></p>
            {% endif %}
        </section>
    {% endif %}

    {# Comptes créés avant que la date de naissance soit demandée : invitation proposée une seule fois #}
    {% if askBirthDate|default(false) %}
        <section class="ks-card ks-card--flat dash-birth" data-birth-date-prompt>
            <form method="post" action="{{ path('app_profile_birth_date') }}" style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: .8rem;">
                <div style="flex: 1 1 260px;">
                    <label for="homeDateOfBirth" style="display: block; font-weight: 700;">{{ t('accueil.naissance.titre', 'Votre date de naissance') }}</label>
                    <p style="margin: .15rem 0 .5rem; color: var(--fg-muted); font-size: .9rem;">{{ t('accueil.naissance.aide', 'Pour vérifier l\'âge requis.') }}</p>
                    <input type="date" id="homeDateOfBirth" name="dateOfBirth" required autocomplete="bday" max="{{ 'now'|date('Y-m-d') }}" class="ks-input" style="max-width: 220px;">
                </div>
                <input type="hidden" name="retour" value="accueil">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_birth_date') }}">
                <div style="display: flex; gap: .5rem; flex-wrap: wrap;">
                    <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm">{{ t('accueil.naissance.enregistrer', 'Enregistrer') }}</button>
                    <button type="submit" form="birthDateLater" class="ks-btn ks-btn--ghost ks-btn--sm">{{ t('accueil.naissance.plus_tard', 'Plus tard') }}</button>
                </div>
            </form>
            <form method="post" action="{{ path('app_profile_birth_date_dismiss') }}" id="birthDateLater">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_birth_date_dismiss') }}">
            </form>
        </section>
    {% endif %}


    {% endif %}
</div>
{% endblock %}
