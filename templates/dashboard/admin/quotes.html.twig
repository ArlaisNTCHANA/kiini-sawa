{% extends 'admin/layout.html.twig' %}

{% block title %}Citations du jour{% endblock %}
{% block page_title %}Citations du jour{% endblock %}
{% block page_lead %}Le verset ou la citation affiché chaque jour sur l'accueil des membres.{% endblock %}

{% block content %}
<div class="ks-stack">
    <section class="ks-card ks-card--accent">
        <h2 class="ks-card__title"><i data-lucide="sun"></i> Aujourd'hui sur l'accueil</h2>
        {% if today %}
            <p style="font-family: var(--font-serif); font-style: italic; font-size: 1.1rem; line-height: 1.6;">« {{ today.content }} »</p>
            <p class="ks-small" style="margin-top: .3rem;">{{ today.author }}</p>
        {% else %}
            <p class="ks-muted">Aucune citation active : l'accueil affiche le texte par défaut. Lancez <code>php bin/console app:quotes:seed</code> pour ajouter les versets proposés.</p>
        {% endif %}
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="plus-circle"></i> Ajouter une citation</h2>
        <form method="post" action="{{ path('admin_quotes_add') }}" class="ks-stack" style="margin-top: .9rem;">
            <div class="ks-field"><label class="ks-label" for="q-content">Texte</label><textarea id="q-content" class="ks-input" name="content" rows="3" required placeholder="Texte"></textarea></div>
            <div class="ks-form-grid">
                <div class="ks-field"><label class="ks-label" for="q-author">Auteur ou référence</label><input id="q-author" class="ks-input" name="author" placeholder="ex. Psaume 23:1 (LSG)"></div>
                <div class="ks-field"><label class="ks-label" for="q-cat">Catégorie</label><input id="q-cat" class="ks-input" name="category" placeholder="VERSET, MOTIVATION…"></div>
                <div class="ks-field"><label class="ks-label" for="q-date">Date d'affichage (facultatif)</label><input id="q-date" class="ks-input" type="date" name="displayDate"></div>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_quote') }}">
            <div><button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="plus"></i> Ajouter</button></div>
        </form>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title">Toutes les citations ({{ quotes|length }})</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Citation</th><th>Date</th><th>État</th><th></th></tr></thead>
                <tbody>
                {% for q in quotes %}
                    <tr{% if not q.active %} style="opacity: .6;"{% endif %}>
                        <td>« {{ q.content }} »<br><span class="ks-small">{{ q.author }}</span></td>
                        <td data-label="Date" style="white-space: nowrap;">{{ q.displayDate ? q.displayDate|date('d/m/Y') : 'Rotation' }}</td>
                        <td data-label="État"><span class="ks-badge {{ q.active ? 'ks-badge--success' : 'ks-badge--muted' }}">{{ q.active ? 'Active' : 'Masquée' }}</span></td>
                        <td data-label="">
                            <div class="ks-inline-form">
                                <form method="post" action="{{ path('admin_quotes_toggle', {id: q.id}) }}" class="ks-inline-form"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_quote') }}"><button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit"><i data-lucide="{{ q.active ? 'eye-off' : 'eye' }}"></i> {{ q.active ? 'Masquer' : 'Activer' }}</button></form>
                                <form method="post" action="{{ path('admin_quotes_delete', {id: q.id}) }}" class="ks-inline-form" onsubmit="return confirm('Supprimer cette citation ?')"><input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_quote') }}"><button class="ks-btn ks-btn--danger ks-btn--sm" type="submit"><i data-lucide="trash-2"></i> Supprimer</button></form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Aucune citation pour l'instant. Ajoutez la première ci-dessus.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
