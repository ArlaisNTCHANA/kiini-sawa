{# Figure des six plans (livre, « Le système ») en SVG : nette à toute taille, noms complets. Statique, sans progression. #}
<svg viewBox="0 0 660 520" role="img" aria-label="Les six plans : le Plan de Vie au centre, entouré des plans de Croissance, de Développement personnel, d'Hygiène de vie, d'Intendance et de Transmission" style="display: block; width: 100%; max-width: 520px; height: auto; margin: 0 auto; font-family: inherit;">
    <circle cx="330" cy="260" r="230" fill="#EEF3EF"/>
    <circle cx="330" cy="260" r="230" fill="none" stroke="#7A9E7E" stroke-width="2" stroke-dasharray="6 6"/>
    <text x="330" y="45" text-anchor="middle" font-size="13" font-weight="700" fill="#2E6B53" letter-spacing="2">LE SYSTÈME</text>
    {% set nodes = [
        {x: 330, y: 108, lines: ['Plan de', 'Croissance'], q: 'Qui je deviens'},
        {x: 475, y: 213, lines: ['Plan de', 'Développement', 'personnel'], q: 'Ce que je développe'},
        {x: 419, y: 383, lines: ["Plan d'Hygiène", 'de vie'], q: 'Ce qui me soutient'},
        {x: 241, y: 383, lines: ['Plan', "d'Intendance"], q: 'Ce que je gère'},
        {x: 185, y: 213, lines: ['Plan de', 'Transmission'], q: 'Ce que je laisse'},
    ] %}
    {% for n in nodes %}
        {% set three = n.lines|length == 3 %}
        <circle cx="{{ n.x }}" cy="{{ n.y }}" r="58" fill="#2E6B53"/>
        <text text-anchor="middle" font-size="13.5" font-weight="700" fill="#fff">
            {% for l in n.lines %}<tspan x="{{ n.x }}" y="{{ n.y - (three ? 22 : 14) + loop.index0 * (three ? 15 : 16) }}">{{ l }}</tspan>{% endfor %}
        </text>
        <text x="{{ n.x }}" y="{{ n.y + (three ? 31 : 30) }}" text-anchor="middle" font-size="{{ three ? 9.5 : 10 }}" font-style="italic" fill="#C8D6CD">{{ n.q }}</text>
    {% endfor %}
    <circle cx="330" cy="260" r="78" fill="#1F4D3A" stroke="#C8962E" stroke-width="4"/>
    <text x="330" y="252" text-anchor="middle" font-size="19" font-weight="700" fill="#fff" font-family="Georgia, 'Times New Roman', serif">Plan de Vie</text>
    <text x="330" y="276" text-anchor="middle" font-size="11" font-style="italic" fill="#C8D6CD">Qui je suis, où je vais</text>
    <circle cx="330" cy="302" r="7" fill="#C8962E"/>
</svg>
