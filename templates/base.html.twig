<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="theme-color" content="#2C5559">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>{% block title %}KIINI SAWA{% endblock %} — KIINI SAWA</title>
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}

    <style>
        /* ══════════════════════════════════════════════════════
           KIINI SAWA — Design System
        ══════════════════════════════════════════════════════ */
        :root {
            --bg:               #F8FAFC; /* Slate 50 - extremely crisp and clean */
            --bg-alt:           #F1F5F9; /* Slate 100 */
            --fg:               #0F172A; /* Slate 900 */
            --fg-light:         #334155; /* Slate 700 */
            --fg-muted:         #64748B; /* Slate 500 */

            --primary:          #0F766E; /* Teal 700 */
            --primary-dark:     #115E59; /* Teal 800 */
            --primary-light:    #0D9488; /* Teal 600 */
            --primary-glow:     rgba(13, 148, 136, 0.08);

            --accent:           #B45309; /* Amber 700 */

            --card-bg:          #ffffff;
            --card-shadow:      0 4px 20px -2px rgba(15, 118, 110, 0.06), 0 1px 4px rgba(0, 0, 0, 0.02);
            --card-shadow-hover:0 12px 32px -4px rgba(15, 118, 110, 0.12);

            --success:          #10B981;
            --danger:           #EF4444;
            --danger-light:     #FEF2F2;

            --font-serif:       'Playfair Display', Georgia, serif;
            --font-sans:        'Inter', -apple-system, sans-serif;

            --r-sm:   8px;
            --r-md:   12px;
            --r-lg:   16px;
            --r-xl:   24px;
            --r-2xl:  32px;
            --r-full: 9999px;

            --ease:     cubic-bezier(0.16, 1, 0.3, 1);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--fg);
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
        }
        a { color: inherit; text-decoration: none; }
        h1,h2,h3,h4,h5,h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            line-height: 1.25;
            color: var(--primary);
        }

        /* ── Layout ── */
        .ks-layout {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Top Nav (desktop ≥1024px) ── */
        #ks-top-nav {
            display: none;
        }
        @media (min-width: 1024px) {
            #ks-top-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: fixed;
                top: 0; left: 0; right: 0;
                height: 72px;
                background: rgba(255, 255, 255, 0.88);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid rgba(15, 118, 110, 0.08);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
                z-index: 1000;
                padding: 0 2rem;
            }
            .ks-main {
                padding-top: 72px;
                margin-left: 0;
            }
        }

        .topnav-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }
        .topnav-logo-icon {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 0.75rem;
            background: linear-gradient(135deg, #0F766E 0%, #0D9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(15, 118, 110, 0.25);
        }
        .topnav-logo-text {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.01em;
            line-height: 1.1;
        }
        .topnav-logo-sub {
            font-family: var(--font-sans);
            font-size: 0.55rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--fg-muted);
        }

        .topnav-links {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            height: 100%;
        }
        /* Menu « Plus » des pages de plans */
        .hero-more { position: relative; display: inline-block; }
        .hero-choice:has(.hero-more) { overflow: visible !important; }
        .hero-more-menu { position: absolute; top: calc(100% + .5rem); left: 50%; transform: translateX(-50%); z-index: 40; min-width: 15rem;
            background: #fff; border-radius: 14px; padding: .4rem; box-shadow: 0 16px 40px rgba(15,23,42,.14), 0 0 0 1px rgba(15,23,42,.05); text-align: left; }
        .hero-more-menu a, .hero-more-menu button { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .6rem .75rem; border: none; background: none;
            border-radius: 10px; font: inherit; font-size: .9rem; color: var(--fg); text-decoration: none; cursor: pointer; }
        .hero-more-menu a:hover, .hero-more-menu button:hover { background: var(--bg-alt, #F1F5F9); }
        .hero-more-menu svg { width: 16px; height: 16px; color: var(--fg-muted); flex-shrink: 0; }
        [x-cloak] { display: none !important; }
        .topnav-item {
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            border-radius: var(--r-full);
            color: #475569;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s var(--ease);
            cursor: pointer;
            text-decoration: none;
            position: relative;
        }
        .topnav-item:hover {
            background: rgba(15, 118, 110, 0.05);
            color: var(--primary);
        }
        .topnav-item.active {
            background: var(--primary);
            color: white !important;
            box-shadow: 0 4px 12px rgba(15, 118, 110, 0.2);
        }
        .topnav-item .ti-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .topnav-item .ti-icon svg {
            width: 16px; height: 16px;
            stroke: currentColor;
            stroke-width: 2px;
        }
        .topnav-item.active .ti-icon svg {
            stroke-width: 2.5px;
        }

        .topnav-user-zone {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .topnav-user {
            position: relative;
        }
        .topnav-user-trigger {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
            border-radius: var(--r-full);
            cursor: pointer;
            transition: all 0.2s var(--ease);
            border: 1px solid rgba(15, 118, 110, 0.1);
            background: rgba(255,255,255,0.6);
            outline: none;
        }
        .topnav-user-trigger:hover {
            background: rgba(15, 118, 110, 0.04);
            border-color: rgba(15, 118, 110, 0.2);
        }
        .topnav-user-avatar {
            width: 2rem; height: 2rem;
            border-radius: 50%;
            background: linear-gradient(135deg, #0F766E, #0D9488);
            border: 2px solid white;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(15, 118, 110, 0.2);
            position: relative;
        }
        .topnav-user-name {
            font-size: 0.8125rem;
            font-weight: 650;
            color: #334155;
            max-width: 100px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .topnav-user-dropdown {
            position: absolute;
            top: calc(100% + 0.5rem);
            right: 0;
            width: 16rem;
            border-radius: 1.25rem;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(15, 118, 110, 0.08);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            z-index: 1100;
        }

        /* Menu items dans le dropdown */
        .dd-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.875rem;
            margin: 0.25rem 0.375rem;
            border-radius: 0.75rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--fg-light);
            transition: all 0.2s var(--ease);
            cursor: pointer;
            background: transparent;
            border: none;
            width: calc(100% - 0.75rem);
            text-align: left;
            text-decoration: none;
        }
        .dd-item:hover { background: var(--bg-alt); color: var(--fg); }
        .dd-item-icon {
            width: 1.875rem;
            height: 1.875rem;
            border-radius: 0.5rem;
            background: var(--bg-alt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s;
        }
        .dd-item:hover .dd-item-icon { background: white; box-shadow: 0 2px 8px rgba(15, 118, 110, 0.08); }
        .dd-item.danger { color: var(--danger); }
        .dd-item.danger:hover { background: var(--danger-light); }
        .dd-section-label {
            font-size: 0.58rem;
            font-weight: 800;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--fg-muted);
            padding: 0.625rem 1.25rem 0.25rem;
        }
        .dd-divider {
            height: 1px;
            background: rgba(15, 118, 110, 0.06);
            margin: 0.375rem 0.875rem;
        }

        /* ── Bottom pill (mobile <1024px) ── */
        #ks-bottom-nav {
            display: flex;
        }
        @media (min-width: 1024px) {
            #ks-bottom-nav { display: none !important; }
        }

        .pill-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 0.5rem 0.625rem;
            border-radius: var(--r-full);
            color: var(--fg-muted);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.2s var(--ease);
            min-width: 48px;
            cursor: pointer;
            background: transparent;
            border: none;
            flex: 1;
        }
        .pill-item:hover { background: rgba(0,0,0,0.04); color: var(--fg); }
        .pill-item.active { background: var(--bg-alt); color: var(--primary); }
        .pill-item svg { width: 20px; height: 20px; }
        .pill-label { display: none; }
        .pill-item.active .pill-label { display: block; }

        /* ── Main content ── */
        .ks-main {
            flex: 1;
            min-height: 100vh;
        }

        /* ── Scrollbar ── */
        .ks-scroll::-webkit-scrollbar { width: 4px; }
        .ks-scroll::-webkit-scrollbar-track { background: transparent; }
        .ks-scroll::-webkit-scrollbar-thumb { background: var(--bg-alt); border-radius: 4px; }

        [x-cloak] { display: none !important; }
        .hidden { display: none !important; }
    </style>

    <script defer src="{{ asset('lib/alpinejs-3.17.5.min.js') }}"></script>
    <script src="{{ asset('lib/lucide-1.73.0.min.js') }}"></script>
</head>
<body>
<div class="ks-layout">

    {% if app.user %}
    {% set cp = app.request.pathinfo %}

    {# ══════════════════════════════════════════════════════════════════════
       TOP NAV — Desktop ≥1024px
    ══════════════════════════════════════════════════════════════════════ #}
    <header id="ks-top-nav"
            x-data="{ userOpen: false }"
            @click.outside.window="userOpen = false">

        {# Logo #}
        <a href="{{ path('app_dashboard') }}" class="topnav-logo">
            <div class="topnav-logo-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div>
                <div class="topnav-logo-text">KIINI SAWA</div>
                <div class="topnav-logo-sub">Plan de Vie</div>
            </div>
        </a>

        {# Navigation Links #}
        <nav class="topnav-links">
        {# 6 entrées au plus (audit du 16/11/2026) ; le reste est dans le menu du compte #}
        {% set mainNav = [
                { label: 'Accueil',     path: path('app_dashboard'),   icon: 'home' },
                { label: 'Plan de Vie', path: path('app_plan_de_vie'), icon: 'compass' },
                { label: 'Stratégies',  path: path('app_strategies'),  icon: 'trending-up' },
                { label: 'Rituels',     path: path('app_user_habits'), icon: 'activity' },
                { label: 'Journal',     path: path('app_journal'),     icon: 'book-open' },
                { label: 'Bilan',       path: path('app_bilan'),       icon: 'bar-chart-2' },
            ] %}

            {% for item in mainNav %}
            {% set active = (item.path != '#' and (cp == item.path or (item.path != path('app_dashboard') and cp starts with item.path))) %}
            <a href="{{ item.path }}" class="topnav-item {% if active %}active{% endif %}">
                <span class="ti-icon">
                    <i data-lucide="{{ item.icon }}"></i>
                </span>
                <span>{{ item.label }}</span>
            </a>
            {% endfor %}
        </nav>

        {# User Zone #}
        <div class="topnav-user-zone">
            {% set unread = unread_notifications() %}
            <a href="{{ path('app_notifications') }}" title="Notifications{{ unread ? ' (' ~ unread ~ ' non lue' ~ (unread > 1 ? 's') ~ ')' }}" aria-label="Notifications"
               style="position: relative; display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; color: var(--fg-light); margin-right: .25rem;">
                <i data-lucide="bell" style="width: 19px; height: 19px;"></i>
                {% if unread %}
                    <span style="position: absolute; top: 2px; right: 2px; min-width: 1.05rem; height: 1.05rem; padding: 0 .25rem; border-radius: 999px; background: var(--danger); color: #fff; font-size: .62rem; font-weight: 800; display: flex; align-items: center; justify-content: center;">{{ unread > 9 ? '9+' : unread }}</span>
                {% endif %}
            </a>
            <div class="topnav-user">
                {# Bouton trigger #}
                <button class="topnav-user-trigger" @click="userOpen = !userOpen">
                    <div class="topnav-user-avatar">
                        <div style="width:0.55rem;height:0.55rem;background:#10B981;border-radius:50%;
                                    box-shadow:0 0 8px rgba(16,185,129,0.5); position: absolute; bottom: 0; right: 0; border: 1.5px solid white;"></div>
                    </div>
                    <span class="topnav-user-name">{{ app.user.displayName }}</span>
                    <i data-lucide="chevron-down" style="width:14px;height:14px;color:var(--fg-muted);flex-shrink:0;"></i>
                </button>

                {# Dropdown (s'ouvre vers le bas) #}
                <div x-show="userOpen" x-cloak
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                     x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                     class="topnav-user-dropdown">

                    {# Header #}
                    <div style="padding: 1rem 1.25rem 0.75rem; border-bottom: 1px solid rgba(15,76,110,0.06);">
                        <p style="font-size: 0.9rem; font-weight: 700; color: #0F172A; line-height: 1.2;">
                            {{ app.user.displayName|capitalize }}
                        </p>
                        <p style="font-size: 0.7rem; color: var(--fg-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis;">
                            {{ app.user.email }}
                        </p>
                    </div>

                    {# Groupe 1 #}
                    <div style="padding: 0.375rem 0;">
                        <p class="dd-section-label">Moi & Ma Croissance</p>
                        {# Règle : n'afficher que des pages qui existent. À réactiver avec leur module :
                           Mon Coaching (phase 6), Mes Listes (plus tard). #}
                        {% set ddItems1 = [
                            { label: 'Mon Profil',      icon: 'user',          href: path('app_profile'),                desc: 'Compte & données' },
                            { label: is_pro() ? (is_trialing() ? 'Essai PRO' : 'Mon abonnement') : 'Passer à PRO', icon: 'crown', href: path('app_subscription'), desc: is_trialing() ? 'Jusqu\'au ' ~ pro_until()|date('d/m') : (is_pro() ? 'Offre PRO' : 'Débloquer les 4 plans') },
                            { label: 'Agenda',          icon: 'calendar',      href: path('app_planner'),                desc: 'Tâches, jalons, frise' },
                            { label: 'Partenaires',     icon: 'users',         href: path('app_social'),                 desc: 'Redevabilité et partages' },
                            { label: 'Mes tests',       icon: 'sparkles',      href: path('app_personality_index'),      desc: 'Personnalité, dons, bilans' },
                            { label: 'Notre couple',    icon: 'heart',         href: path('app_couple'), desc: 'Vision et projets à deux' },
                            { label: 'Mon organisation', icon: 'building-2',  href: path('app_organisation_index'), desc: 'Église, association…' },
                            { label: 'La Méthode',      icon: 'book-open',     href: path('app_methode_index'), desc: 'Les chapitres du livre' },
                        ] %}
                        {% for it in ddItems1 %}
                        <a href="{{ it.href }}" @click="userOpen = false" class="dd-item">
                            <div class="dd-item-icon">
                                <i data-lucide="{{ it.icon }}" style="width:15px;height:15px;color:var(--fg-muted);"></i>
                            </div>
                            <div>
                                <div style="line-height:1.2;">{{ it.label }}</div>
                                <div style="font-size:0.65rem;color:var(--fg-muted);font-weight:400;">{{ it.desc }}</div>
                            </div>
                        </a>
                        {% endfor %}
                    </div>

                    {# Notifications : cloche dans la barre du haut et page /notifications #}

                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="dd-divider"></div>
                    <div style="padding: 0.375rem 0;">
                        <p class="dd-section-label">Aide & Système</p>
                        <a href="/admin" @click="userOpen = false" class="dd-item">
                            <div class="dd-item-icon">
                                <i data-lucide="shield" style="width:15px;height:15px;color:var(--fg-muted);"></i>
                            </div>
                            <div style="line-height:1.2;">Admin</div>
                        </a>
                    </div>
                    {% endif %}

                    {# Logout #}
                    <div style="padding: 0.375rem 0; border-top: 1px solid rgba(15,76,110,0.06); margin-top: 0.25rem;">
                        <a href="{{ path('app_logout') }}" class="dd-item danger">
                            <div class="dd-item-icon" style="color: var(--danger);">
                                <i data-lucide="log-out" style="width:15px;height:15px;"></i>
                            </div>
                            <div style="line-height:1.2;">Déconnexion</div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    {# ══════════════════════════════════════════════════════════════════════
       BOTTOM PILL NAV — Mobile <1024px
    ══════════════════════════════════════════════════════════════════════ #}
    <nav id="ks-bottom-nav"
         style="position: fixed; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
                background: rgba(255,255,255,0.88); backdrop-filter: blur(20px);
                border: 1px solid rgba(44,85,89,0.08);
                box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                border-radius: var(--r-full);
                padding: 0.375rem 0.5rem;
                z-index: 100;
                width: calc(100% - 2rem); max-width: 420px;
                align-items: center; gap: 2px;">

        {% set mobileNav = [
            { label: 'Accueil',  path: path('app_dashboard'),   icon: 'home' },
            { label: 'Plan',     path: path('app_plan_de_vie'),   icon: 'compass' },
            { label: 'Journal',  path: path('app_journal'),     icon: 'book-open' },
            { label: 'Rituels',  path: path('app_user_habits'),      icon: 'activity' },
        ] %}
        {% for item in mobileNav %}
        {% set active = (item.path != '#' and (cp == item.path or (item.path != path('app_dashboard') and cp starts with item.path))) %}
        <a href="{{ item.path }}" class="pill-item {% if active %}active{% endif %}">
            <i data-lucide="{{ item.icon }}" style="width:20px;height:20px;stroke-width:{% if active %}2.5{% else %}2{% endif %};"></i>
            <span class="pill-label">{{ item.label }}</span>
        </a>
        {% endfor %}

        {# More — mobile #}
        <div style="position:relative;flex:1;" x-data="{ o: false }" @click.outside="o = false">
            <button @click="o = !o" class="pill-item" :class="o ? 'active' : ''" style="width:100%;">
                <i data-lucide="grid-3x3" style="width:20px;height:20px;" :style="o ? 'stroke-width:2.5' : 'stroke-width:2'"></i>
                <span class="pill-label">Plus</span>
            </button>
            <div x-show="o" x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 scale-95 translate-y-2"
                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 style="position:absolute;bottom:calc(100% + 1rem);right:0;width:13rem;max-height:calc(100vh - 7rem);overflow-y:auto;
                        background:rgba(255,255,255,0.97);backdrop-filter:blur(24px);
                        border-radius:1.25rem;padding:0.5rem;
                        box-shadow:0 16px 40px rgba(44,85,89,0.15),0 0 0 1px rgba(44,85,89,0.06);">
                {% set mobileMore = [
                    { label: 'Notifications' ~ (unread_notifications() ? ' (' ~ unread_notifications() ~ ')' : ''), path: path('app_notifications'), icon: 'bell' },
                    { label: 'Mes Stratégies', path: path('app_strategies'),  icon: 'trending-up' },
                    { label: 'Agenda',       path: path('app_planner'),        icon: 'calendar' },
                    { label: 'Bilan',        path: path('app_bilan'),          icon: 'bar-chart-2' },
                    { label: 'Partenaires',  path: path('app_social'),         icon: 'users' },
                    { label: 'Mes tests', path: path('app_personality_index'), icon: 'sparkles' },
                    { label: 'Notre couple', path: path('app_couple'),         icon: 'heart' },
                    { label: 'Mon organisation', path: path('app_organisation_index'), icon: 'building-2' },
                    { label: 'La Méthode',   path: path('app_methode_index'),  icon: 'book-open' },
                    { label: is_pro() ? (is_trialing() ? 'Essai PRO' : 'Mon abonnement') : 'Passer à PRO', path: path('app_subscription'), icon: 'crown' },
                ] %}
                {% for mm in mobileMore %}
                <a href="{{ mm.path }}" @click="o = false"
                   style="display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;
                          border-radius:0.75rem;color:var(--fg-light);font-size:0.825rem;font-weight:500;
                          transition:all 0.2s;text-decoration:none;"
                   onmouseover="this.style.background='var(--bg-alt)';this.style.color='var(--fg)'"
                   onmouseout="this.style.background='';this.style.color='var(--fg-light)'">
                    <i data-lucide="{{ mm.icon }}" style="width:16px;height:16px;color:var(--fg-muted);flex-shrink:0;"></i>
                    {{ mm.label }}
                </a>
                {% endfor %}
                <div style="height:1px;background:rgba(44,85,89,0.06);margin:0.375rem 0.375rem;"></div>
                <a href="{{ path('app_profile') }}" @click="o = false"
                   style="display:flex;align-items:center;gap:0.625rem;padding:0.625rem 0.75rem;
                          border-radius:0.75rem;color:var(--fg-light);font-size:0.825rem;font-weight:500;text-decoration:none;">
                    <i data-lucide="user" style="width:16px;height:16px;color:var(--fg-muted);flex-shrink:0;"></i>
                    Mon Profil
                </a>
            </div>
        </div>
    </nav>
    {% endif %}

    {# ══════════════════════════════════════════════════════════════════════
       CONTENU PRINCIPAL
    ══════════════════════════════════════════════════════════════════════ #}
    <main class="ks-main">
        {% include 'shared/_flashes.html.twig' %}
        {% block body %}{% endblock %}
    </main>

</div>

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
    document.addEventListener('alpine:initialized', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
    document.addEventListener('alpine:updated', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
</script>
</body>
</html>
