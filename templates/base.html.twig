<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <meta name="theme-color" content="#2E6B53">
    {% include 'shared/_pwa_head.html.twig' %}
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>{% block title %}KIINI SAWA{% endblock %} — KIINI SAWA</title>
    {% block head_meta %}{% endblock %}
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
    {% include 'shared/_design_tokens.html.twig' %}

    <style>
        /* ══════════════════════════════════════════════════════
           KIINI SAWA — Design System
        ══════════════════════════════════════════════════════ */

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--fg);
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
        }
        a { color: inherit; text-decoration: none; }
        h1,h2,h3,h4,h5,h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            line-height: 1.25;
            color: var(--primary);
        }

        /* ── Layout ── */
        .ks-layout {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── Top Nav (desktop ≥1024px) ── */
        #ks-top-nav {
            display: none;
        }
        @media (min-width: 1024px) {
            #ks-top-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: fixed;
                top: 0; left: 0; right: 0;
                height: 72px;
                background: rgba(255, 255, 255, 0.88);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid rgba(46, 107, 83, 0.08);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
                z-index: 1000;
                padding: 0 2rem;
            }
            .ks-main {
                padding-top: 72px;
                margin-left: 0;
            }
        }

        .topnav-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }
        .topnav-logo-icon {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 0.75rem;
            background: linear-gradient(135deg, #2E6B53 0%, #3D7A5F 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 14px rgba(46, 107, 83, 0.25);
        }
        .topnav-logo-text {
            font-family: var(--font-serif);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.01em;
            line-height: 1.1;
        }
        .topnav-logo-sub {
            font-family: var(--font-sans);
            font-size: 0.55rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--fg-muted);
        }

        .topnav-links {
            display: flex;
            align-items: center;
            gap: 0.375rem;
            height: 100%;
        }
        /* Menu « Plus » des pages de plans */
        .hero-more { position: relative; display: inline-block; }
        .hero-choice:has(.hero-more) { overflow: visible !important; }
        .hero-more-menu { position: absolute; top: calc(100% + .5rem); left: 50%; transform: translateX(-50%); z-index: 40; min-width: 15rem;
            background: #fff; border-radius: 14px; padding: .4rem; box-shadow: 0 16px 40px rgba(15,23,42,.14), 0 0 0 1px rgba(15,23,42,.05); text-align: left; }
        .hero-more-menu a, .hero-more-menu button { display: flex; align-items: center; gap: .6rem; width: 100%; padding: .6rem .75rem; border: none; background: none;
            border-radius: 10px; font: inherit; font-size: .9rem; color: var(--fg); text-decoration: none; cursor: pointer; }
        .hero-more-menu a:hover, .hero-more-menu button:hover { background: var(--bg-alt, #F1F5F9); }
        .hero-more-menu svg { width: 16px; height: 16px; color: var(--fg-muted); flex-shrink: 0; }
        [x-cloak] { display: none !important; }
        .topnav-item {
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            border-radius: var(--r-full);
            color: #475569;
            font-size: 0.875rem;
            font-weight: 600;
            transition: all 0.2s var(--ease);
            cursor: pointer;
            text-decoration: none;
            position: relative;
        }
        .topnav-item:hover {
            background: rgba(46, 107, 83, 0.05);
            color: var(--primary);
        }
        .topnav-item.active {
            background: var(--primary);
            color: white !important;
            box-shadow: 0 4px 12px rgba(46, 107, 83, 0.2);
        }
        .topnav-item .ti-icon {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .topnav-item .ti-icon svg {
            width: 16px; height: 16px;
            stroke: currentColor;
            stroke-width: 2px;
        }
        .topnav-item.active .ti-icon svg {
            stroke-width: 2.5px;
        }

        .topnav-user-zone {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .topnav-user {
            position: relative;
        }
        .topnav-user-trigger {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
            border-radius: var(--r-full);
            cursor: pointer;
            transition: all 0.2s var(--ease);
            border: 1px solid rgba(46, 107, 83, 0.1);
            background: rgba(255,255,255,0.6);
            outline: none;
        }
        .topnav-user-trigger:hover {
            background: rgba(46, 107, 83, 0.04);
            border-color: rgba(46, 107, 83, 0.2);
        }
        .topnav-user-avatar {
            width: 2rem; height: 2rem;
            border-radius: 50%;
            background: linear-gradient(135deg, #2E6B53, #3D7A5F);
            border: 2px solid white;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(46, 107, 83, 0.2);
            position: relative;
        }
        .topnav-user-name {
            font-size: 0.8125rem;
            font-weight: 650;
            color: #334155;
            max-width: 100px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .topnav-user-dropdown {
            position: absolute;
            top: calc(100% + 0.5rem);
            right: 0;
            width: 16rem;
            border-radius: 1.25rem;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(46, 107, 83, 0.08);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            z-index: 1100;
        }

        /* Menu items dans le dropdown */
        .dd-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.625rem 0.875rem;
            margin: 0.25rem 0.375rem;
            border-radius: 0.75rem;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--fg-light);
            transition: all 0.2s var(--ease);
            cursor: pointer;
            background: transparent;
            border: none;
            width: calc(100% - 0.75rem);
            text-align: left;
            text-decoration: none;
        }
        .dd-item:hover { background: var(--bg-alt); color: var(--fg); }
        .dd-item-icon {
            width: 1.875rem;
            height: 1.875rem;
            border-radius: 0.5rem;
            background: var(--bg-alt);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s;
        }
        .dd-item:hover .dd-item-icon { background: white; box-shadow: 0 2px 8px rgba(46, 107, 83, 0.08); }
        .dd-item.danger { color: var(--danger); }
        .dd-item.danger:hover { background: var(--danger-light); }
        .dd-section-label {
            font-size: 0.58rem;
            font-weight: 800;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--fg-muted);
            padding: 0.625rem 1.25rem 0.25rem;
        }
        .dd-divider {
            height: 1px;
            background: rgba(46, 107, 83, 0.06);
            margin: 0.375rem 0.875rem;
        }

        /* ── Bottom pill (mobile <1024px) ── */
        #ks-bottom-nav {
            display: flex;
        }
        @media (min-width: 1024px) {
            #ks-bottom-nav { display: none !important; }
        }

        .pill-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 0.5rem 0.625rem;
            border-radius: var(--r-full);
            color: var(--fg-muted);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            text-decoration: none;
            transition: all 0.2s var(--ease);
            min-width: 48px;
            cursor: pointer;
            background: transparent;
            border: none;
            flex: 1;
        }
        .pill-item:hover { background: rgba(0,0,0,0.04); color: var(--fg); }
        .pill-item.active { background: var(--bg-alt); color: var(--primary); }
        .pill-item svg { width: 20px; height: 20px; }
        /* Libellés toujours visibles (lisibilité : une icône seule ne suffit pas) */
        .pill-item { padding: 0.45rem 0.2rem; gap: 3px; min-width: 0; }
        .pill-label { display: block; font-size: 10px; font-weight: 600; letter-spacing: 0; text-transform: none; line-height: 1.1; white-space: nowrap; }
        .pill-item.active .pill-label { font-weight: 700; }

        /* ── Navigation par rubriques (NavigationExtension) ── */
        .topnav-section { position: relative; height: 100%; display: flex; align-items: center; }
        .topnav-item .ti-chevron { width: 13px; height: 13px; opacity: .55; margin-left: -.15rem; }
        .nav-panel { position: absolute; top: calc(100% - .35rem); left: 50%; transform: translateX(-50%); z-index: 60; width: 21rem;
            background: #fff; border-radius: 18px; padding: .5rem; box-shadow: 0 18px 44px rgba(15,23,42,.14), 0 0 0 1px rgba(15,23,42,.05); }
        .nav-panel a { display: flex; gap: .75rem; align-items: flex-start; padding: .65rem .75rem; border-radius: 12px; text-decoration: none; color: var(--fg); }
        .nav-panel a:hover, .nav-panel a.current { background: var(--bg-alt); }
        .nav-panel a.current .np-title { color: var(--primary); }
        .np-icon { flex: none; width: 2.1rem; height: 2.1rem; border-radius: 10px; background: rgba(46, 107, 83,.08); color: var(--primary); display: flex; align-items: center; justify-content: center; }
        .np-icon svg { width: 17px; height: 17px; }
        .np-title { font-weight: 700; font-size: .9rem; line-height: 1.25; }
        .np-desc { font-size: .75rem; color: var(--fg-muted); line-height: 1.35; margin-top: 1px; }
        @media (max-width: 1240px) { .topnav-item .ti-label-long { display: none; } }
        /* Menu du téléphone */
        .ks-sheet { position: fixed; inset: 0; z-index: 120; background: rgba(15,23,42,.35); display: flex; align-items: flex-end; }
        .ks-sheet__panel { width: 100%; max-height: 86vh; overflow-y: auto; background: #fff; border-radius: 22px 22px 0 0; padding: 1rem 1rem 6.5rem; }
        .ks-sheet__title { font-size: .68rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-muted); margin: 1rem .25rem .4rem; }
        .ks-sheet__grid { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
        .ks-sheet__link { display: flex; align-items: center; gap: .55rem; padding: .7rem .75rem; border-radius: 12px; background: var(--bg-alt); color: var(--fg); text-decoration: none; font-size: .85rem; font-weight: 600; }
        .ks-sheet__link.current { background: var(--primary); color: #fff; }
        .ks-sheet__link svg { width: 16px; height: 16px; flex: none; }

        /* ── Main content ── */
        .ks-main {
            flex: 1;
            min-height: 100vh;
        }

        /* ── Scrollbar ── */
        .ks-scroll::-webkit-scrollbar { width: 4px; }
        .ks-scroll::-webkit-scrollbar-track { background: transparent; }
        .ks-scroll::-webkit-scrollbar-thumb { background: var(--bg-alt); border-radius: 4px; }

        [x-cloak] { display: none !important; }
        .hidden { display: none !important; }
    </style>

    <script defer src="{{ asset('lib/alpinejs-3.17.5.min.js') }}"></script>
    <script src="{{ asset('lib/lucide-1.73.0.min.js') }}"></script>
</head>
<body>
<div class="ks-layout">

    {% if app.user %}
    {% set cp = app.request.pathinfo %}

    {# ══════════════════════════════════════════════════════════════════════
       TOP NAV — Desktop ≥1024px
    ══════════════════════════════════════════════════════════════════════ #}
    <header id="ks-top-nav"
            x-data="{ userOpen: false }"
            @click.outside.window="userOpen = false">

        {# Logo #}
        <a href="{{ path('app_dashboard') }}" class="topnav-logo">
            <div class="topnav-logo-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div>
                <div class="topnav-logo-text">KIINI SAWA</div>
                <div class="topnav-logo-sub">Plan de Vie</div>
            </div>
        </a>

        {# Navigation : six rubriques (une seule définition : App\Shared\Twig\NavigationExtension) #}
        {% set activeSection = nav_active_section() %}
        <nav class="topnav-links" x-data="{ open: null }" @keydown.escape.window="open = null" @click.outside="open = null">
            {% for key, sec in nav_sections() %}
                {% if sec.items is empty %}
                    <a href="{{ path(sec.route) }}" class="topnav-item {{ activeSection == key ? 'active' }}">
                        <span class="ti-icon"><i data-lucide="{{ sec.icon }}"></i></span><span>{{ sec.label }}</span>
                    </a>
                {% else %}
                    <div class="topnav-section" @mouseenter="open = '{{ key }}'" @mouseleave="open = null">
                        <button type="button" class="topnav-item {{ activeSection == key ? 'active' }}" style="border: none; font: inherit; font-size: .875rem; font-weight: 600; background: {{ activeSection == key ? 'var(--primary)' : 'transparent' }};"
                                @click="open = '{{ key }}'" @focus="open = '{{ key }}'" :aria-expanded="open === '{{ key }}'" aria-haspopup="true">
                            <span class="ti-icon"><i data-lucide="{{ sec.icon }}"></i></span><span>{{ sec.label }}</span><i data-lucide="chevron-down" class="ti-chevron"></i>
                        </button>
                        <div class="nav-panel" x-show="open === '{{ key }}'" x-cloak x-transition.opacity.duration.150ms>
                            {% if sec.desc is defined %}<p style="font-size: .74rem; color: var(--fg-muted); padding: .4rem .75rem .2rem; line-height: 1.4;">{{ sec.desc }}</p>{% endif %}
                            {% for it in sec.items %}
                                {% set href = path(it[1]) %}
                                <a href="{{ href }}" class="{{ cp == href or cp == href ~ '/' ? 'current' }}">
                                    <span class="np-icon"><i data-lucide="{{ it[2] }}"></i></span>
                                    <span><span class="np-title" style="display: block;">{{ it[0] }}{% if it[4] is defined and not is_pro() %} <span style="font-size: .62rem; font-weight: 800; letter-spacing: .05em; padding: .1rem .4rem; border-radius: 999px; background: var(--gold-soft); color: var(--accent); vertical-align: 1px;">PRO</span>{% endif %}</span><span class="np-desc" style="display: block;">{{ it[3] }}</span></span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </nav>

        {# User Zone #}
        <div class="topnav-user-zone">
            {% set unread = unread_notifications() %}
            <a href="{{ path('app_notifications') }}" title="Notifications{{ unread ? ' (' ~ unread ~ ' non lue' ~ (unread > 1 ? 's') ~ ')' }}" aria-label="Notifications"
               style="position: relative; display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; color: var(--fg-light); margin-right: .25rem;">
                <i data-lucide="bell" style="width: 19px; height: 19px;"></i>
                {% if unread %}
                    <span style="position: absolute; top: 2px; right: 2px; min-width: 1.05rem; height: 1.05rem; padding: 0 .25rem; border-radius: 999px; background: var(--danger); color: #fff; font-size: .62rem; font-weight: 800; display: flex; align-items: center; justify-content: center;">{{ unread > 9 ? '9+' : unread }}</span>
                {% endif %}
            </a>
            <div class="topnav-user">
                {# Bouton trigger #}
                <button class="topnav-user-trigger" @click="userOpen = !userOpen">
                    <div class="topnav-user-avatar">
                        <div style="width:0.55rem;height:0.55rem;background:#10B981;border-radius:50%;
                                    box-shadow:0 0 8px rgba(16,185,129,0.5); position: absolute; bottom: 0; right: 0; border: 1.5px solid white;"></div>
                    </div>
                    <span class="topnav-user-name">{{ app.user.displayName }}</span>
                    <i data-lucide="chevron-down" style="width:14px;height:14px;color:var(--fg-muted);flex-shrink:0;"></i>
                </button>

                {# Dropdown (s'ouvre vers le bas) #}
                <div x-show="userOpen" x-cloak
                     x-transition:enter="transition ease-out duration-200"
                     x-transition:enter-start="opacity-0 scale-95 -translate-y-2"
                     x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-150"
                     x-transition:leave-start="opacity-100 scale-100"
                     x-transition:leave-end="opacity-0 scale-95 -translate-y-2"
                     class="topnav-user-dropdown">

                    {# Header #}
                    <div style="padding: 1rem 1.25rem 0.75rem; border-bottom: 1px solid rgba(15,76,110,0.06);">
                        <p style="font-size: 0.9rem; font-weight: 700; color: #0F172A; line-height: 1.2;">
                            {{ app.user.displayName|capitalize }}
                        </p>
                        <p style="font-size: 0.7rem; color: var(--fg-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis;">
                            {{ app.user.email }}
                        </p>
                    </div>

                    {# Compte uniquement : les fonctionnalités sont dans les rubriques #}
                    <div style="padding: 0.375rem 0;">
                        {% set ddItems1 = [
                            { label: 'Mon profil',      icon: 'user',          href: path('app_profile'),                desc: 'Compte, préférences et données' },
                            { label: is_pro() ? (is_trialing() ? 'Essai PRO' : 'Mon abonnement') : 'Passer à PRO', icon: 'crown', href: path('app_subscription'), desc: is_trialing() ? 'Jusqu\'au ' ~ pro_until()|date('d/m') : (is_pro() ? 'Offre PRO' : 'Débloquer tous les plans') },
                            { label: 'Notifications',   icon: 'bell',          href: path('app_notifications'),          desc: unread_notifications() ? unread_notifications() ~ ' non lue' ~ (unread_notifications() > 1 ? 's') : 'Tout est lu' },
                            { label: 'Installer l\'application', icon: 'smartphone', href: path('app_install'), desc: 'Sur votre téléphone' },
                        ] %}
                        {% for it in ddItems1 %}
                        <a href="{{ it.href }}" @click="userOpen = false" class="dd-item">
                            <div class="dd-item-icon">
                                <i data-lucide="{{ it.icon }}" style="width:15px;height:15px;color:var(--fg-muted);"></i>
                            </div>
                            <div>
                                <div style="line-height:1.2;">{{ it.label }}</div>
                                <div style="font-size:0.65rem;color:var(--fg-muted);font-weight:400;">{{ it.desc }}</div>
                            </div>
                        </a>
                        {% endfor %}
                    </div>

                    {# Notifications : cloche dans la barre du haut et page /notifications #}

                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="dd-divider"></div>
                    <div style="padding: 0.375rem 0;">
                        <p class="dd-section-label">Aide & Système</p>
                        <a href="/admin" @click="userOpen = false" class="dd-item">
                            <div class="dd-item-icon">
                                <i data-lucide="shield" style="width:15px;height:15px;color:var(--fg-muted);"></i>
                            </div>
                            <div style="line-height:1.2;">Admin</div>
                        </a>
                    </div>
                    {% endif %}

                    {# Avis sur l'application #}
                    <div style="padding: 0.375rem 0; border-top: 1px solid rgba(15,76,110,0.06);">
                        <a href="{{ path('app_app_feedback', {page: app.request.pathInfo}) }}" @click="userOpen = false" class="dd-item">
                            <div class="dd-item-icon"><i data-lucide="message-square" style="width:15px;height:15px;color:var(--fg-muted);"></i></div>
                            <div style="line-height:1.2;">Donner mon avis</div>
                        </a>
                    </div>

                    {# Logout #}
                    <div style="padding: 0.375rem 0; border-top: 1px solid rgba(15,76,110,0.06); margin-top: 0.25rem;">
                        <form method="post" action="{{ path('app_logout') }}" style="margin: 0;" data-turbo="false">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout_form') }}">
                        <button type="submit" class="dd-item danger" style="width: 100%; border: 0; background: transparent; font: inherit; text-align: left; cursor: pointer;">
                            <div class="dd-item-icon" style="color: var(--danger);">
                                <i data-lucide="log-out" style="width:15px;height:15px;"></i>
                            </div>
                            <div style="line-height:1.2;">Déconnexion</div>
                        </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    {# ══════════════════════════════════════════════════════════════════════
       BOTTOM PILL NAV — Mobile <1024px
    ══════════════════════════════════════════════════════════════════════ #}
    <nav id="ks-bottom-nav"
         style="position: fixed; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
                background: rgba(255,255,255,0.88); backdrop-filter: blur(20px);
                border: 1px solid rgba(44,85,89,0.08);
                box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                border-radius: var(--r-full);
                padding: 0.375rem 0.5rem;
                z-index: 100;
                width: calc(100% - 2rem); max-width: 420px;
                align-items: center; gap: 2px;">

        {% set activeSection = nav_active_section() %}
        {% for item in nav_mobile_bar() %}
        {% set href = path(item[1]) %}
        {% set active = cp == href or cp starts with href ~ '/' or (item[3] == 'plans' and activeSection == 'plans') %}
        <a href="{{ href }}" class="pill-item {% if active %}active{% endif %}">
            <i data-lucide="{{ item[2] }}" style="width:20px;height:20px;stroke-width:{% if active %}2.5{% else %}2{% endif %};"></i>
            <span class="pill-label">{{ item[0] }}</span>
        </a>
        {% endfor %}

        {# Menu complet : les six rubriques, puis le compte #}
        <div style="flex:1;" x-data="{ o: false }" @keydown.escape.window="o = false">
            <button @click="o = true" class="pill-item" :class="o ? 'active' : ''" style="width:100%;" aria-label="Menu">
                <i data-lucide="layout-grid" style="width:20px;height:20px;"></i>
                <span class="pill-label">Menu</span>
            </button>
            <template x-teleport="body">
                <div class="ks-sheet" x-show="o" x-cloak x-transition.opacity @click.self="o = false">
                    <div class="ks-sheet__panel" x-show="o" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="translate-y-8 opacity-0" x-transition:enter-end="translate-y-0 opacity-100">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <strong style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--fg);">Menu</strong>
                            <button type="button" @click="o = false" aria-label="Fermer" style="border:none;background:var(--bg-alt);border-radius:50%;width:2.2rem;height:2.2rem;display:flex;align-items:center;justify-content:center;"><i data-lucide="x" style="width:18px;height:18px;"></i></button>
                        </div>
                        {% for key, sec in nav_sections() %}
                            <p class="ks-sheet__title">{{ sec.label }}</p>
                            {% if sec.desc is defined %}<p style="font-size: .75rem; color: var(--fg-muted); margin: -.2rem .25rem .45rem;">{{ sec.desc }}</p>{% endif %}
                            <div class="ks-sheet__grid">
                                {% set links = sec.items is empty ? [[sec.label, sec.route, sec.icon]] : sec.items %}
                                {% for it in links %}
                                    {% set href = path(it[1]) %}
                                    <a href="{{ href }}" class="ks-sheet__link {{ cp == href or cp == href ~ '/' ? 'current' }}" @click="o = false"><i data-lucide="{{ it[2] }}"></i>{{ it[0] }}{% if it[4] is defined and not is_pro() %} <span style="font-size: .6rem; font-weight: 800; padding: .05rem .35rem; border-radius: 999px; background: var(--gold-soft); color: var(--accent);">PRO</span>{% endif %}</a>
                                {% endfor %}
                            </div>
                        {% endfor %}
                        <p class="ks-sheet__title">Mon compte</p>
                        <div class="ks-sheet__grid">
                            <a href="{{ path('app_quick') }}" class="ks-sheet__link" @click="o = false"><i data-lucide="zap"></i>Aujourd'hui en un geste</a>
                            <a href="{{ path('app_profile') }}" class="ks-sheet__link" @click="o = false"><i data-lucide="user"></i>Mon profil</a>
                            <a href="{{ path('app_notifications') }}" class="ks-sheet__link" @click="o = false"><i data-lucide="bell"></i>Notifications{{ unread_notifications() ? ' (' ~ unread_notifications() ~ ')' }}</a>
                            <a href="{{ path('app_subscription') }}" class="ks-sheet__link" @click="o = false"><i data-lucide="crown"></i>{{ is_pro() ? (is_trialing() ? 'Essai PRO' : 'Mon abonnement') : 'Passer à PRO' }}</a>
                            <a href="{{ path('app_install') }}" class="ks-sheet__link" @click="o = false"><i data-lucide="smartphone"></i>Installer l'application</a>
                            <a href="{{ path('app_app_feedback', {page: app.request.pathInfo}) }}" class="ks-sheet__link" @click="o = false"><i data-lucide="message-square"></i>Donner mon avis</a>
                            <form method="post" action="{{ path('app_logout') }}" style="margin: 0; display: contents;" data-turbo="false"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout_form') }}"><button type="submit" class="ks-sheet__link" style="color: var(--danger); border: 0; font: inherit; cursor: pointer; width: 100%; text-align: left;"><i data-lucide="log-out"></i>Déconnexion</button></form>
                        </div>
                    </div>
                </div>
            </template>
        </div>
    </nav>
    {% endif %}

    {# ══════════════════════════════════════════════════════════════════════
       CONTENU PRINCIPAL
    ══════════════════════════════════════════════════════════════════════ #}
    <main class="ks-main">
        {% include 'shared/_flashes.html.twig' %}
        {% block body %}{% endblock %}
    </main>

</div>

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
    document.addEventListener('alpine:initialized', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
    document.addEventListener('alpine:updated', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });
    // Turbo remplace le <body> à chaque navigation : sans ceci, les icônes (menu compris) disparaissent après un clic.
    ['turbo:load', 'turbo:render', 'turbo:frame-load'].forEach((evt) => document.addEventListener(evt, () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }));
</script>
</body>
</html>
