{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
<div style="max-width: 720px; margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <h1 class="ks-header__title">Notifications</h1>
        <div style="display: flex; gap: .75rem; align-items: center;">
            <a href="{{ path('app_profile') }}#notifications" style="font-size: .85rem; color: var(--fg-muted);">Préférences</a>
            {% if notifications|filter(n => not n.read)|length > 0 %}
                <form method="post" action="{{ path('app_notifications_read_all') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('notification') }}">
                    <button type="submit" style="border: none; background: var(--bg-alt); padding: .5rem .9rem; border-radius: var(--r-md); font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer;">Tout marquer comme lu</button>
                </form>
            {% endif %}
        </div>
    </div>

    {% for n in notifications %}
        <form method="post" action="{{ path('app_notification_open', {id: n.id}) }}" style="margin: 0 0 .6rem;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('notification') }}">
            <button type="submit" style="width: 100%; text-align: left; display: flex; gap: .9rem; align-items: flex-start; background: {{ n.read ? 'var(--card-bg)' : 'var(--primary-soft)' }}; border: 1px solid {{ n.read ? 'var(--bg-alt)' : '#C8D6CD' }}; border-radius: var(--r-lg); padding: 1rem 1.1rem; font: inherit; cursor: pointer; color: inherit;">
                <span style="flex-shrink: 0; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: {{ n.read ? 'var(--bg-alt)' : 'var(--primary)' }}; color: {{ n.read ? 'var(--fg-muted)' : '#fff' }}; display: flex; align-items: center; justify-content: center;">
                    <i data-lucide="{{ n.type.icon }}" style="width: 16px; height: 16px;"></i>
                </span>
                <span style="flex: 1; min-width: 0;">
                    <span style="display: block; font-weight: {{ n.read ? 600 : 700 }}; color: var(--fg);">{{ n.title }}</span>
                    <span style="display: block; font-size: .88rem; color: var(--fg-light); margin-top: .15rem;">{{ n.message }}</span>
                    <span style="display: block; font-size: .75rem; color: var(--fg-muted); margin-top: .35rem;">{{ n.createdAt|format_datetime(pattern: "d MMMM 'à' HH:mm", locale: 'fr') }}</span>
                </span>
            </button>
        </form>
    {% else %}
        <div style="text-align: center; padding: 3rem 1rem; color: var(--fg-muted);">
            <i data-lucide="bell" style="width: 32px; height: 32px; margin-bottom: .75rem;"></i>
            <p>Aucune notification pour l'instant.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
