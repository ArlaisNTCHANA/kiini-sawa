{% extends 'admin/layout.html.twig' %}

{% block title %}{{ a.title }} · Écrire aux membres{% endblock %}
{% block page_title %}{{ a.title }}{% endblock %}
{% block page_lead %}{{ a.audienceLabel }}{% if organisation %} : {{ organisation.name }}{% endif %} · {{ a.withEmail ? 'dans l\'application et par e-mail' : 'dans l\'application seulement' }}{% endblock %}

{% block content %}
{% set token = csrf_token('admin_announcement') %}
<div class="ks-stack">
    <p><a href="{{ path('admin_announcements') }}" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="arrow-left"></i> Toutes les annonces</a></p>

    {% if a.draft %}
        <section class="ks-card ks-card--accent">
            <h2 class="ks-card__title"><i data-lucide="send"></i> Prête à partir</h2>
            <p>Elle partira vers <strong>{{ count }} membre{{ count > 1 ? 's' }}</strong>{% if a.withEmail %} (sans ceux qui ont coupé « Les annonces de l'équipe » dans leur profil){% endif %}. Relisez-la ci-dessous, envoyez-vous un essai, puis envoyez.</p>
            <div class="ks-toolbar">
                <form method="post" action="{{ path('admin_announcements_test', {id: a.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button type="submit" class="ks-btn ks-btn--secondary"><i data-lucide="mail-check"></i> M'envoyer un essai</button>
                </form>
                <form method="post" action="{{ path('admin_announcements_send', {id: a.id}) }}" onsubmit="return confirm('Envoyer cette annonce à {{ count }} membre(s) ? Elle ne pourra plus être modifiée.');">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button type="submit" class="ks-btn ks-btn--primary" {{ count == 0 ? 'disabled' }}><i data-lucide="send"></i> Envoyer à {{ count }} membre{{ count > 1 ? 's' }}</button>
                </form>
            </div>
        </section>
    {% elseif a.sending %}
        <section class="ks-card ks-card--accent" x-data="{ reached: {{ a.reached }}, done: false, error: '' }" x-init="
            const step = async () => {
                const body = new FormData(); body.append('_csrf_token', '{{ token }}');
                try {
                    const r = await fetch('{{ path('admin_announcements_continue', {id: a.id}) }}', { method: 'POST', body, credentials: 'same-origin' });
                    const d = await r.json();
                    if (!r.ok) { error = d.error || 'Envoi interrompu.'; return; }
                    reached = d.reached; done = d.done;
                    if (!done) setTimeout(step, 300); else setTimeout(() => location.reload(), 800);
                } catch (e) { error = 'Connexion interrompue : l\'envoi reprendra tout seul (tâche planifiée) ou en rechargeant cette page.'; }
            };
            step();">
            <h2 class="ks-card__title"><i data-lucide="loader"></i> Envoi en cours</h2>
            <p><strong x-text="reached"></strong> membre(s) prévenu(s) pour l'instant. Gardez cette page ouverte jusqu'à la fin ; si vous la fermez, l'envoi se termine tout seul plus tard, sans doublon.</p>
            <p class="ks-small" x-show="error" x-text="error" style="color: var(--danger);"></p>
        </section>
    {% else %}
        <section class="ks-card">
            <p><span class="ks-badge ks-badge--success">Envoyée le {{ a.sentAt|date('d/m/Y à H\\hi') }}</span> à <strong>{{ a.reached }} membre{{ a.reached > 1 ? 's' }}</strong>{% if a.author %}, par {{ a.author.displayName }}{% endif %}.</p>
        </section>
    {% endif %}

    <div class="an-previews">
        <section class="ks-card">
            <h2 class="ks-card__title"><i data-lucide="bell"></i> Dans l'application</h2>
            <div class="an-notif">
                <span class="an-notif__icon"><i data-lucide="megaphone"></i></span>
                <div>
                    <strong>{{ a.title }}</strong>
                    <p>{{ a.message|length > 220 ? a.message|slice(0, 220) ~ '…' : a.message }}</p>
                    {% if a.actionUrl %}<span class="ks-small">Lien : {{ a.actionUrl }}</span>{% endif %}
                </div>
            </div>
        </section>
        {% if a.withEmail %}
        <section class="ks-card">
            <h2 class="ks-card__title"><i data-lucide="mail"></i> Par e-mail</h2>
            {% set emailHtml %}{% include 'notification/email/announcement.html.twig' with {name: 'Prénom', title: a.title, message: a.message, actionUrl: a.actionUrl ? (a.actionUrl starts with '/' ? url('app_home')|trim('/', 'right') ~ a.actionUrl : a.actionUrl) : null, actionLabel: a.actionLabel, unsubscribeUrl: '#'} %}{% endset %}
            <iframe class="an-mail" title="Aperçu de l'e-mail" srcdoc="{{ emailHtml|e('html_attr') }}" sandbox></iframe>
        </section>
        {% endif %}
    </div>

    {% if a.draft %}
        <section class="ks-card">
            <h2 class="ks-card__title"><i data-lucide="pencil"></i> Modifier</h2>
            {% include 'notification/admin/_form.html.twig' with {a: a, action: path('admin_announcements_edit', {id: a.id}), submit: 'Enregistrer', submitClass: 'ks-btn--secondary'} %}
            <form method="post" action="{{ path('admin_announcements_delete', {id: a.id}) }}" onsubmit="return confirm('Supprimer ce brouillon ?');" style="margin-top: 1rem;">
                <input type="hidden" name="_csrf_token" value="{{ token }}">
                <button type="submit" class="ks-btn ks-btn--danger ks-btn--sm"><i data-lucide="trash-2"></i> Supprimer le brouillon</button>
            </form>
        </section>
    {% endif %}
</div>
<style>
    .an-previews { display: grid; gap: 1rem; }
    @media (min-width: 1000px) { .an-previews { grid-template-columns: 1fr 1.3fr; align-items: start; } }
    .an-notif { display: flex; gap: .8rem; padding: .9rem; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--card-bg); }
    .an-notif__icon { flex: none; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--primary-soft); color: var(--primary); display: inline-flex; align-items: center; justify-content: center; }
    .an-notif__icon svg { width: 16px; height: 16px; }
    .an-notif p { margin: .25rem 0; color: var(--fg-muted); font-size: .92rem; white-space: pre-line; }
    .an-mail { width: 100%; height: 560px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--card-bg); }
</style>
{% endblock %}
