{% extends 'compte/email/_layout.html.twig' %}
{# Message d'anniversaire : une nouvelle année de vie, invitation à relire son Plan de Vie (BirthdayGreeter) #}
{% block content %}
  <p style="font-size: 20px; font-weight: bold; color: #2E6B53; margin: 0 0 12px;">🎂 {{ title }}</p>
  <p>{{ message }}</p>
  {% if actionUrl %}
    <p style="text-align:center;margin:28px 0;"><a href="{{ actionUrl }}" style="background:#2E6B53;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">{{ actionLabel }}</a></p>
  {% endif %}
  <p style="font-size: 12px; color: #64748b; margin-top: 28px;">Vous ne souhaitez plus recevoir de message pour votre anniversaire ? <a href="{{ unsubscribeUrl }}" style="color:#64748b;">Se désabonner en un clic</a>. Vos autres préférences se règlent dans votre profil.</p>
{% endblock %}
