{% extends 'compte/email/_layout.html.twig' %}
{% block content %}
  <p>Bonjour {{ name }},</p>
  <p style="font-size: 17px; font-weight: bold; color: #0f766e; margin: 18px 0 8px;">{{ title }}</p>
  <p>{{ message }}</p>
  {% if actionUrl %}
    <p style="text-align:center;margin:28px 0;"><a href="{{ actionUrl }}" style="background:#0f766e;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">Ouvrir KIINI SAWA</a></p>
  {% endif %}
  <p style="font-size: 12px; color: #64748b; margin-top: 28px;">Vous ne souhaitez plus recevoir ce type de rappel ? <a href="{{ unsubscribeUrl }}" style="color:#64748b;">Se désabonner en un clic</a>. Vos autres préférences se règlent dans votre profil.</p>
{% endblock %}
