{% extends 'compte/email/_layout.html.twig' %}
{# Annonce de l'équipe (AnnouncementSender). Le message est un texte simple : paragraphes séparés par une ligne vide. #}
{% block content %}
  <p>Bonjour {{ name }},</p>
  <p style="font-size: 18px; font-weight: bold; color: #2E6B53; margin: 18px 0 10px;">{{ title }}</p>
  {% for para in message|split("\n\n") %}{% if para|trim %}<p>{{ para|trim|nl2br }}</p>{% endif %}{% endfor %}
  {% if actionUrl %}
    <p style="text-align:center;margin:28px 0;"><a href="{{ actionUrl }}" style="background:#2E6B53;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">{{ actionLabel|default('Ouvrir KIINI SAWA') }}</a></p>
  {% endif %}
  <p>Avec vous sur le chemin,<br>L'équipe KIINI SAWA</p>
  <p style="font-size: 12px; color: #66706A; margin-top: 28px;">Vous ne souhaitez plus recevoir les annonces de l'équipe ? <a href="{{ unsubscribeUrl }}" style="color:#66706A;">Se désabonner en un clic</a>. Vos autres préférences se règlent dans votre profil.</p>
{% endblock %}
{% block footer %}Vous recevez cette annonce parce que vous avez un compte KIINI SAWA. Une question ? Répondez simplement à cet e-mail.{% endblock %}
