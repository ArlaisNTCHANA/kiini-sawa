{% extends 'admin/layout.html.twig' %}

{% macro pct(a, b) %}{{ b > 0 ? ((a / b * 100)|round) ~ ' %' : '—' }}{% endmacro %}

{% block title %}D'où viennent les inscrits{% endblock %}
{% block page_title %}D'où viennent les inscrits{% endblock %}
{% block page_lead %}Les réseaux, campagnes et liens qui amènent de nouveaux membres, et ceux qui deviennent payants.{% endblock %}

{% block content %}
{% import _self as m %}
<div class="ks-stack">
    <nav class="ks-tabs" aria-label="Période">
        {% for key, label in periods %}
            <a href="{{ path('admin_origins', {periode: key}) }}" class="ks-tab{{ key == period ? ' is-active' }}">{{ label }}</a>
        {% endfor %}
    </nav>

    <div class="ks-stat-grid">
        <div class="ks-stat"><div class="ks-stat__value">{{ totals.signups }}</div><div class="ks-stat__label">inscrits</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ m.pct(totals.verified, totals.signups) }}</div><div class="ks-stat__label">ont vérifié leur email</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ m.pct(totals.onboarded, totals.signups) }}</div><div class="ks-stat__label">ont posé leurs fondations</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ totals.paying }}</div><div class="ks-stat__label">devenus payants</div></div>
    </div>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="radar"></i> Par canal</h2>
        {% if bySource is empty %}
            <p class="ks-muted">Aucun inscrit sur cette période. Les inscriptions sont rattachées à leur canal depuis le 16/11/2026.</p>
        {% else %}
            {% set max = bySource|map(r => r.signups)|reduce((a, b) => max(a, b), 1) %}
            <div class="ks-table-wrap">
                <table class="ks-table ks-table--cards">
                    <thead><tr><th>Canal</th><th style="width: 24%;"><span class="sr-only">Proportion</span></th><th class="is-num">Inscrits</th><th class="is-num">Email vérifié</th><th class="is-num">Fondations posées</th><th class="is-num">Payants</th><th class="is-num">Conversion</th></tr></thead>
                    <tbody>
                    {% for r in bySource %}
                        <tr>
                            <td><strong>{{ sources[r.label] ?? r.label|capitalize }}</strong></td>
                            <td data-label=""><div class="ks-bar" style="width: {{ (r.signups / max * 100)|round }}%;"></div></td>
                            <td data-label="Inscrits" class="is-num">{{ r.signups }}</td>
                            <td data-label="Email vérifié" class="is-num">{{ r.verified }}</td>
                            <td data-label="Fondations posées" class="is-num">{{ r.onboarded }}</td>
                            <td data-label="Payants" class="is-num">{{ r.paying }}</td>
                            <td data-label="Conversion" class="is-num">{{ m.pct(r.paying, r.signups) }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="ks-muted" style="margin-top: .8rem;">« Direct » : arrivée sans lien suivi ni site d'origine (adresse tapée, favori, application de messagerie qui masque l'origine). « Invitation » : conjoint ou membre d'organisation invité.</p>
        {% endif %}
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="megaphone"></i> Par campagne</h2>
        {% if byCampaign is empty %}
            <p class="ks-muted">Aucune campagne pour l'instant.</p>
        {% else %}
            <div class="ks-table-wrap">
                <table class="ks-table ks-table--cards">
                    <thead><tr><th>Campagne</th><th class="is-num">Inscrits</th><th class="is-num">Email vérifié</th><th class="is-num">Fondations posées</th><th class="is-num">Payants</th></tr></thead>
                    <tbody>
                    {% for r in byCampaign %}
                        <tr><td>{{ r.label }}</td><td data-label="Inscrits" class="is-num">{{ r.signups }}</td><td data-label="Email vérifié" class="is-num">{{ r.verified }}</td><td data-label="Fondations posées" class="is-num">{{ r.onboarded }}</td><td data-label="Payants" class="is-num">{{ r.paying }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    <section class="ks-card ks-card--accent" x-data="{ source: 'tiktok', medium: 'bio', campaign: '', content: '', page: '/', copied: false,
    get url() { const p = new URLSearchParams({ utm_source: this.source, utm_medium: this.medium }); if (this.campaign.trim()) p.set('utm_campaign', this.slug(this.campaign)); if (this.content.trim()) p.set('utm_content', this.slug(this.content)); return '{{ baseUrl }}' + this.page + '?' + p.toString(); },
    slug(v) { return v.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); } }">
        <h2 class="ks-card__title"><i data-lucide="link"></i> Créer un lien suivi</h2>
        <p class="ks-muted" style="margin-bottom: 1rem;">Utilisez un lien différent par plateforme et par campagne : les inscriptions apparaîtront dans les tableaux ci-dessus.</p>
        <div class="ks-form-grid">
            <div class="ks-field"><label class="ks-label" for="l-src">Plateforme</label><select id="l-src" class="ks-input" x-model="source">{% for k, v in sources %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></div>
            <div class="ks-field"><label class="ks-label" for="l-med">Emplacement</label><select id="l-med" class="ks-input" x-model="medium">{% for k, v in mediums %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></div>
            <div class="ks-field"><label class="ks-label" for="l-camp">Campagne (facultatif)</label><input id="l-camp" class="ks-input" x-model="campaign" placeholder="ex. defi21-discipline"></div>
            <div class="ks-field"><label class="ks-label" for="l-cont">Contenu (facultatif)</label><input id="l-cont" class="ks-input" x-model="content" placeholder="ex. video-12"></div>
            <div class="ks-field"><label class="ks-label" for="l-page">Page d'arrivée</label><select id="l-page" class="ks-input" x-model="page"><option value="/">Page d'accueil</option><option value="/inscription">Inscription directe</option><option value="/methode/introduction">Introduction du livre</option></select></div>
        </div>
        <div class="ks-toolbar" style="margin-top: 1rem;">
            <input class="ks-input" :value="url" readonly aria-label="Lien à copier">
            <button type="button" class="ks-btn ks-btn--primary" @click="navigator.clipboard.writeText(url); copied = true; setTimeout(() => copied = false, 2000)"><i data-lucide="copy"></i><span x-text="copied ? 'Copié ✓' : 'Copier'">Copier</span></button>
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="user-plus"></i> Derniers inscrits</h2>
        {% if latest is empty %}
            <p class="ks-muted">Pas encore d'inscrit rattaché à un canal.</p>
        {% else %}
            <div class="ks-table-wrap">
                <table class="ks-table ks-table--cards">
                    <thead><tr><th>Prénom</th><th>Date</th><th>Canal</th><th>Emplacement</th><th>Campagne</th><th>Contenu</th><th>Site d'origine</th></tr></thead>
                    <tbody>
                    {% for o in latest %}
                        <tr>
                            <td><strong>{{ o.user.displayName }}</strong></td>
                            <td data-label="Date">{{ o.createdAt|date('d/m/Y H:i') }}</td>
                            <td data-label="Canal">{{ sources[o.source] ?? o.source|capitalize }}</td>
                            <td data-label="Emplacement">{{ mediums[o.medium] ?? o.medium ?? '—' }}</td>
                            <td data-label="Campagne">{{ o.campaign ?? '—' }}</td>
                            <td data-label="Contenu">{{ o.content ?? '—' }}</td>
                            <td data-label="Site d'origine" style="overflow-wrap: anywhere;">{{ o.referrer ?? '—' }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
