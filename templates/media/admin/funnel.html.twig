{% extends 'admin/layout.html.twig' %}

{% block title %}Entonnoir{% endblock %}
{% block page_title %}Entonnoir d'acquisition{% endblock %}

{% block stylesheets %}
<style>
    .k-muted { color: var(--text-secondary); font-size: 13px; }
    .k-tabs { display: flex; gap: 6px; margin-bottom: 20px; }
    .k-tab { padding: 6px 12px; border-radius: 999px; font-size: 13px; text-decoration: none; color: inherit; border: 1px solid rgba(255,255,255,.12); }
    .k-tab.on { background: #2E6B53; border-color: #2E6B53; color: #fff; }
    .k-step { display: grid; grid-template-columns: 220px 1fr 140px; gap: 14px; align-items: center; padding: 12px 0; border-top: 1px solid rgba(255,255,255,.06); }
    .k-bar { height: 10px; border-radius: 5px; background: #5E9479; min-width: 3px; }
    .k-num { text-align: right; font-variant-numeric: tabular-nums; }
</style>
{% endblock %}

{% block content %}
<div class="k-tabs">
    {% for d in [7, 30, 90] %}<a class="k-tab {{ days == d ? 'on' }}" href="{{ path('admin_funnel', {jours: d}) }}">{{ d }} jours</a>{% endfor %}
</div>
<div class="ks-card">
    <p class="k-muted" style="margin-bottom: 12px;">Depuis le {{ since|date('d/m/Y') }}. Les inscrits sont ceux créés pendant la période ; le pourcentage est la part de l'étape précédente.
    {% if visitsSince %}Les visites sont comptées depuis le {{ visitsSince|date('d/m/Y') }} (compteur par jour, robots écartés, aucune donnée personnelle).{% else %}Le comptage des visites commence avec la mise en ligne de cette page : revenez dans quelques jours.{% endif %}</p>
    {% set top = steps[0].count > 0 ? steps[0].count : (steps[1].count > 0 ? steps[1].count : 1) %}
    {% for st in steps %}
        <div class="k-step">
            <strong>{{ st.label }}</strong>
            <div><div class="k-bar" style="width: {{ min((st.count / top * 100)|round, 100) }}%;"></div></div>
            <div class="k-num"><strong>{{ st.count }}</strong>{% if st.rate is not null %} <span class="k-muted">· {{ st.rate|number_format(1, ',') }} %</span>{% endif %}</div>
        </div>
    {% endfor %}
</div>
<p class="k-muted" style="margin-top: 14px;">Où agir : si peu de visiteurs créent un compte, c'est la vitrine ; si peu terminent l'onboarding, c'est le premier usage ; si peu commencent le parcours, c'est l'accueil.</p>
{% endblock %}
