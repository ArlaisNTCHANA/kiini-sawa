{% extends 'admin/layout.html.twig' %}
{% block title %}Qui revient{% endblock %}
{% block page_title %}Qui revient{% endblock %}
{% block page_lead %}La part des inscrits qui reviennent dans l'application après 7, 30 et 90 jours.{% endblock %}
{% macro rate(v) %}{% if v is null %}<span class="ks-small">—</span>{% else %}<strong class="{{ v >= 40 ? 'ks-text-success' : (v >= 20 ? 'ks-text-warning' : 'ks-text-danger') }}">{{ v }} %</strong>{% endif %}{% endmacro %}
{% block content %}
{% import _self as m %}
<div class="ks-stack">
    <div class="ks-stat-grid">
        <div class="ks-stat"><div class="ks-stat__value">{{ headline.verified }}</div><div class="ks-stat__label">membres (email vérifié)</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ headline.active7 }}</div><div class="ks-stat__label">actifs ces 7 derniers jours</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ headline.active30 }}</div><div class="ks-stat__label">actifs ces 30 derniers jours</div></div>
        <div class="ks-stat"><div class="ks-stat__value">{{ headline.verified > 0 ? ((headline.active30 / headline.verified * 100)|round) ~ ' %' : '—' }}</div><div class="ks-stat__label">part des membres actifs sur 30 jours</div></div>
    </div>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="calendar-range"></i> Par semaine d'inscription</h2>
        <p class="ks-muted" style="margin-bottom: 1rem;">Part des inscrits revenus au moins une fois 7, 30 ou 90 jours après leur inscription. « — » : inscrits trop récents pour le calculer.</p>
        {% if weeks is empty %}<p class="ks-muted">Pas encore d'inscrits.</p>{% else %}
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Semaine</th><th class="is-num">Inscrits</th>{% for h in horizons %}<th class="is-num">Revenus après {{ h }} j</th>{% endfor %}</tr></thead>
                <tbody>{% for w in weeks %}<tr><td>{{ w.label }}</td><td data-label="Inscrits" class="is-num">{{ w.signups }}</td>{% for h in horizons %}<td data-label="Après {{ h }} j" class="is-num">{{ m.rate(w.rates[h]) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
            </table>
        </div>
        {% endif %}
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="radar"></i> Par canal (12 derniers mois)</h2>
        <p class="ks-muted" style="margin-bottom: 1rem;">Les canaux qui font venir des gens qui restent valent plus que ceux qui font venir du monde. Comparez avec « D'où viennent les inscrits ».</p>
        {% if channels is empty %}<p class="ks-muted">Pas encore d'inscrits.</p>{% else %}
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Canal</th><th class="is-num">Inscrits</th>{% for h in horizons %}<th class="is-num">Revenus après {{ h }} j</th>{% endfor %}</tr></thead>
                <tbody>{% for c in channels %}<tr><td>{{ sources[c.label] ?? c.label|capitalize }}</td><td data-label="Inscrits" class="is-num">{{ c.signups }}</td>{% for h in horizons %}<td data-label="Après {{ h }} j" class="is-num">{{ m.rate(c.rates[h]) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
            </table>
        </div>
        {% endif %}
        <p class="ks-alert ks-alert--info" style="margin-top: 1rem;">Repères pour une application de développement personnel : 30 à 40 % après 7 jours et 15 à 25 % après 30 jours sont de bons résultats. Les rappels, les défis et la revue de la semaine sont vos meilleurs leviers.</p>
    </section>
</div>
{% endblock %}
