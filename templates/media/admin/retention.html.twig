{% extends 'admin/layout.html.twig' %}
{% block title %}Rétention{% endblock %}
{% block page_title %}Rétention des inscrits{% endblock %}
{% macro rate(v) %}{% if v is null %}<span style="color: var(--text-secondary);">—</span>{% else %}<span style="font-weight: 700; color: {{ v >= 40 ? '#34d399' : (v >= 20 ? '#fbbf24' : '#f87171') }};">{{ v }} %</span>{% endif %}{% endmacro %}
{% block stylesheets %}
<style>
    .k-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .k-stat { font-size: 26px; font-weight: 800; }
    .k-label { font-size: 12px; color: var(--text-secondary); }
    .k-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .k-table th, .k-table td { padding: 10px 8px; border-top: 1px solid rgba(255,255,255,.06); text-align: left; }
    .k-table th { font-size: 12px; color: var(--text-secondary); }
    .k-num { text-align: right !important; }
    h2.k-h { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
    .k-muted { color: var(--text-secondary); font-size: 13px; }
</style>
{% endblock %}
{% block content %}
{% import _self as m %}
<div class="k-grid">
    <div class="ks-card"><div class="k-stat">{{ headline.verified }}</div><div class="k-label">membres (email vérifié)</div></div>
    <div class="ks-card"><div class="k-stat">{{ headline.active7 }}</div><div class="k-label">actifs ces 7 derniers jours</div></div>
    <div class="ks-card"><div class="k-stat">{{ headline.active30 }}</div><div class="k-label">actifs ces 30 derniers jours</div></div>
    <div class="ks-card"><div class="k-stat">{{ headline.verified > 0 ? ((headline.active30 / headline.verified * 100)|round) ~ ' %' : '—' }}</div><div class="k-label">part des membres actifs sur 30 jours</div></div>
</div>

<div class="ks-card" style="margin-bottom: 24px;">
    <h2 class="k-h">Par semaine d'inscription</h2>
    <p class="k-muted" style="margin-bottom: 12px;">Part des inscrits revenus au moins une fois 7, 30 ou 90 jours après leur inscription. « — » : inscrits trop récents pour le calculer.</p>
    {% if weeks is empty %}<p class="k-muted">Pas encore d'inscrits.</p>{% else %}
    <table class="k-table">
        <thead><tr><th>Cohorte</th><th class="k-num">Inscrits</th>{% for h in horizons %}<th class="k-num">Revenus après {{ h }} j</th>{% endfor %}</tr></thead>
        <tbody>{% for w in weeks %}<tr><td>{{ w.label }}</td><td class="k-num">{{ w.signups }}</td>{% for h in horizons %}<td class="k-num">{{ m.rate(w.rates[h]) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    {% endif %}
</div>

<div class="ks-card">
    <h2 class="k-h">Par canal (12 derniers mois)</h2>
    <p class="k-muted" style="margin-bottom: 12px;">Les canaux qui font venir des gens qui restent valent plus que ceux qui font venir du monde. Comparez avec « Provenance des inscrits ».</p>
    {% if channels is empty %}<p class="k-muted">Pas encore d'inscrits.</p>{% else %}
    <table class="k-table">
        <thead><tr><th>Canal</th><th class="k-num">Inscrits</th>{% for h in horizons %}<th class="k-num">Revenus après {{ h }} j</th>{% endfor %}</tr></thead>
        <tbody>{% for c in channels %}<tr><td>{{ sources[c.label] ?? c.label|capitalize }}</td><td class="k-num">{{ c.signups }}</td>{% for h in horizons %}<td class="k-num">{{ m.rate(c.rates[h]) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table>
    {% endif %}
    <p class="k-muted" style="margin-top: 12px;">Repères pour une application de développement personnel : 30 à 40 % après 7 jours et 15 à 25 % après 30 jours sont de bons résultats. Les rappels, les défis et la revue de la semaine sont vos meilleurs leviers.</p>
</div>
{% endblock %}
