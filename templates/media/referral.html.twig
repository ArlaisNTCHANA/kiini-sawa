{% extends 'base.html.twig' %}

{% block title %}Inviter mes proches{% endblock %}

{% block body %}
{% set message = 'Je construis mon Plan de Vie avec KIINI SAWA : raison d\'être, vision, rituels, revues… Crée ton compte avec mon lien, tu auras un mois PRO offert pour essayer : ' ~ url %}
<div class="ks-page ks-page--narrow" x-data="{ copied: false }">
    {% include 'shared/_page_header.html.twig' with {
        eyebrow: 'Parrainage', icon: 'gift', title: 'Inviter mes proches',
        lead: 'Faites découvrir KIINI SAWA aux personnes qui comptent pour vous. Chacun y gagne.'
    } %}

    <div class="ks-grid" style="margin-bottom: 1rem;">
        <div class="ks-card"><p style="font-size: 1.8rem;">🎁</p><p style="font-weight: 700; color: var(--fg); margin: .3rem 0;">Vous</p><p style="color: var(--fg-muted);"><strong>1 mois PRO offert</strong> pour chaque ami qui crée son compte et vérifie son email.</p></div>
        <div class="ks-card"><p style="font-size: 1.8rem;">🤝</p><p style="font-weight: 700; color: var(--fg); margin: .3rem 0;">Votre ami</p><p style="color: var(--fg-muted);"><strong>Un mois d'essai PRO</strong> au lieu de 14 jours, pour bâtir tous ses plans.</p></div>
    </div>

    <div class="ks-card" style="margin-bottom: 1rem;">
        <p class="ks-eyebrow" style="margin-bottom: .5rem;">Votre lien personnel</p>
        <div style="display: flex; gap: .6rem; flex-wrap: wrap;">
            <input class="ks-input" style="flex: 1; min-width: 220px;" value="{{ url }}" readonly>
            <button type="button" class="ks-btn ks-btn--secondary" @click="navigator.clipboard.writeText('{{ url|e('js') }}'); copied = true; setTimeout(() => copied = false, 2000)"><span x-text="copied ? 'Copié ✓' : 'Copier'">Copier</span></button>
        </div>
        <div style="display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1rem;">
            <a class="ks-btn ks-btn--primary" style="background: #25D366;" target="_blank" rel="noopener" href="https://wa.me/?text={{ message|url_encode }}"><i data-lucide="message-circle"></i> Envoyer sur WhatsApp</a>
            <a class="ks-btn ks-btn--secondary" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ url|url_encode }}"><i data-lucide="share-2"></i> Facebook</a>
            <a class="ks-btn ks-btn--secondary" href="mailto:?subject={{ 'Je t\'invite sur KIINI SAWA'|url_encode }}&body={{ message|url_encode }}"><i data-lucide="mail"></i> Email</a>
        </div>
    </div>

    <div class="ks-card">
        <h2 class="ks-section-title" style="margin-top: 0;">Vos invitations</h2>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; text-align: center; margin-bottom: 1rem;">
            <div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.invited }}</p><p class="ks-eyebrow">inscrits</p></div>
            <div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.rewarded }}</p><p class="ks-eyebrow">confirmés</p></div>
            <div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.monthsEarned }}</p><p class="ks-eyebrow">mois offerts</p></div>
        </div>
        {% for r in referrals %}
            <div style="display: flex; justify-content: space-between; padding: .55rem 0; border-top: 1px solid var(--border); font-size: .92rem;">
                <span>{{ r.referred.displayName }} · {{ r.createdAt|format_date(pattern: 'd MMM y', locale: 'fr') }}</span>
                <span style="color: {{ r.rewardedAt ? 'var(--success)' : 'var(--fg-muted)' }};">{{ r.rewardedAt ? '✓ 1 mois offert' : 'En attente de vérification de son email' }}</span>
            </div>
        {% else %}
            <p style="color: var(--fg-muted);">Personne pour l'instant. Partagez votre lien à une personne qui cherche à donner une direction à sa vie.</p>
        {% endfor %}
        <p style="color: var(--fg-muted); font-size: .8rem; margin-top: 1rem;">Jusqu'à {{ maxPerYear }} mois offerts par an. Le mois offert s'ajoute à la fin de votre accès PRO en cours.</p>
    </div>
</div>
{% endblock %}
