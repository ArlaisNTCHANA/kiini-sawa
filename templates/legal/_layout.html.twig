<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} — KIINI SAWA</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0F766E">
    <style>
        :root { --primary: #0f766e; --text: #1e293b; --muted: #64748b; --bg: #f8faf9; --border: #e2e8f0; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: -apple-system, 'Segoe UI', Inter, Arial, sans-serif; color: var(--text); background: var(--bg); line-height: 1.65; }
        header { background: var(--primary); color: #fff; padding: 1rem 1.5rem; }
        header a { color: #fff; text-decoration: none; font-family: Georgia, serif; font-weight: 700; font-size: 1.25rem; }
        main { max-width: 780px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
        h1 { font-family: Georgia, serif; color: var(--primary); font-size: 2rem; margin: 0 0 .25rem; }
        h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; color: var(--text); }
        .updated { color: var(--muted); font-size: .875rem; margin-bottom: 1.5rem; }
        .draft { background: #fef9c3; border: 1px solid #fde68a; color: #854d0e; border-radius: 10px; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1.5rem; }
        .todo { background: #fef3c7; padding: 0 .25rem; border-radius: 4px; font-weight: 600; }
        table { border-collapse: collapse; width: 100%; font-size: .9rem; margin: .75rem 0; }
        th, td { border: 1px solid var(--border); padding: .5rem .65rem; text-align: left; vertical-align: top; }
        th { background: #f1f5f9; }
        nav.legal-nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .875rem; margin-bottom: 2rem; }
        nav.legal-nav a { color: var(--primary); text-decoration: none; }
        nav.legal-nav a.active { font-weight: 700; text-decoration: underline; }
        a { color: var(--primary); }
    </style>
</head>
<body>
    <header><a href="{{ app.user ? path('app_dashboard') : path('app_login') }}">KIINI SAWA</a></header>
    <main>
        <nav class="legal-nav" aria-label="Pages légales">
            {% for slug, label in pages %}
                <a href="{{ path('app_legal', {page: slug}) }}" class="{{ slug == page ? 'active' }}">{{ label }}</a>
            {% endfor %}
        </nav>
        <h1>{{ title }}</h1>
        <p class="updated">Dernière mise à jour : {{ updatedAt }}</p>
        <div class="draft">Version de travail : les passages <span class="todo">[À COMPLÉTER]</span> doivent être remplis, et l'ensemble relu par un juriste avant la mise en ligne.</div>
        {% block content %}{% endblock %}
    </main>
</body>
</html>
