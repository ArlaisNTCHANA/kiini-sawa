<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ title }} — KIINI SAWA</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include 'shared/_pwa_head.html.twig' %}
    <meta name="theme-color" content="#2E6B53">
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">
    {% include 'shared/_design_tokens.html.twig' %}
    {# Mêmes polices et couleurs que l'application (contre-audit visuel du 25/11/2026) #}
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: var(--font-sans); color: var(--fg-light); background: var(--bg); line-height: 1.7; -webkit-font-smoothing: antialiased; }
        header { background: linear-gradient(135deg, var(--primary-dark), var(--primary)); padding: .9rem 1.25rem; }
        header a { text-decoration: none; }
        main { max-width: 780px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
        h1 { font-family: var(--font-serif); color: var(--primary-dark); font-weight: 600; font-size: 2.1rem; line-height: 1.2; margin: 0 0 .35rem; }
        h2 { font-family: var(--font-serif); font-weight: 600; font-size: 1.3rem; margin: 2.25rem 0 .5rem; color: var(--fg); }
        h3 { font-size: 1rem; margin: 1.5rem 0 .4rem; color: var(--fg); }
        .updated { color: var(--fg-muted); font-size: .875rem; margin-bottom: 1.5rem; }
        .draft { background: var(--primary-soft); border-left: 3px solid var(--gold); color: var(--fg-light); border-radius: 0 10px 10px 0; padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1.5rem; }
        .todo { color: var(--fg-muted); font-style: italic; }
        table { border-collapse: collapse; width: 100%; font-size: .9rem; margin: .75rem 0; display: block; overflow-x: auto; }
        th, td { border: 1px solid var(--border); padding: .5rem .65rem; text-align: left; vertical-align: top; }
        th { background: var(--bg-alt); color: var(--fg); }
        nav.legal-nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .9rem; margin-bottom: 2rem; }
        nav.legal-nav a { color: var(--primary); text-decoration: none; }
        nav.legal-nav a.active { font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
        a { color: var(--primary); }
    </style>
</head>
<body>
    <header><a href="{{ app.user ? path('app_dashboard') : path('app_home') }}" aria-label="KIINI SAWA">{% include 'shared/_logo.html.twig' with {tone: 'dark'} only %}</a></header>
    <main>
        <nav class="legal-nav" aria-label="Pages légales">
            {% for slug, label in pages %}
                <a href="{{ path('app_legal', {page: slug}) }}" class="{{ slug == page ? 'active' }}">{{ label }}</a>
            {% endfor %}
        </nav>
        <h1>{{ title }}</h1>
        <p class="updated">{{ t('legal.mise_a_jour_label', 'Dernière mise à jour') }} : {{ t('legal.mise_a_jour', '15 novembre 2026') }}</p>
        {% if todo > 0 %}<div class="draft">{{ t('legal.en_cours', 'KIINI SAWA est en cours d\'immatriculation : les informations indiquées « à compléter » seront ajoutées dès que la structure juridique sera créée.') }}</div>{% endif %}
        {% block content %}{% endblock %}
    </main>
</body>
</html>
