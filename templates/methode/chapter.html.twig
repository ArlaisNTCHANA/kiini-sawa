{% extends 'base.html.twig' %}

{% block title %}{{ chapter.title }}{% endblock %}

{% block body %}
<style>
    .book-body { font-size: 1.05rem; line-height: 1.8; color: var(--fg-light); }
    .book-body h2, .book-body h3 { font-family: var(--font-serif); color: var(--fg); margin: 1.75rem 0 .6rem; }
    .book-body h3 { font-size: 1.2rem; }
    .book-body p, .book-body ul, .book-body ol { margin-bottom: 1rem; }
    .book-body ul, .book-body ol { padding-left: 1.4rem; }
    .book-body blockquote { border-left: 3px solid var(--gold); background: var(--primary-soft); padding: .75rem 1rem; border-radius: 0 10px 10px 0; color: var(--primary-dark); margin: 1.25rem 0; font-family: var(--font-serif); }
    .book-body hr { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
    .book-body strong { color: var(--fg); }
    .book-body table { border-collapse: collapse; width: 100%; font-size: .9rem; margin: 1rem 0; }
    .book-body th, .book-body td { border: 1px solid var(--border); padding: .45rem .6rem; text-align: left; }
</style>
{% if not app.user %}{% include 'shared/_public_header.html.twig' %}{% endif %}
<article style="max-width: var(--page-reading); margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <a href="{{ path('app_methode_index') }}" class="ks-header__back">← La méthode</a>
    {% set partCovers = {'plan-et-providence': 1, 'but-de-dieu': 2, 'puissance-sans-plan': 3, 'competence-et-connaissance': 4, 'hygiene-de-vie': 5, 'intendance': 6, 'perspective-de-l-eternite': 7, 'carte-strategique': 8} %}
    {% if partCovers[chapter.slug] is defined %}
        <img src="{{ asset('images/livre/ouverture_partie' ~ partCovers[chapter.slug] ~ '.png') }}" alt="Ouverture de la partie {{ partCovers[chapter.slug] }} du livre" loading="lazy" data-part-cover style="display: block; width: 100%; max-width: 260px; margin: 1rem auto 1.5rem; border-radius: 14px; box-shadow: var(--card-shadow);">
    {% endif %}
    <h1 class="ks-header__title">{{ chapter.title }}</h1>
    <p style="color: var(--fg-muted); font-size: .85rem; margin-bottom: 2rem;">Lecture : {{ chapter.minutes }} min</p>
    {% if mode == 'locked' %}
        <p class="book-body">{{ chapter.excerpt }}</p>
        <div style="background: var(--primary-soft); border: 1px solid #C8D6CD; border-radius: var(--r-lg); padding: 1.5rem; margin-top: 1.5rem; text-align: center;">
            <p style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--fg); margin-bottom: .4rem;">La suite de ce chapitre vous attend</p>
            <p style="color: var(--fg-muted); margin-bottom: 1rem;">Créez votre compte gratuit pour lire l'essentiel de chaque chapitre, et le mettre en pratique dans votre Plan de Vie.</p>
            <a href="{{ path('app_register') }}" style="display: inline-block; background: var(--primary); color: #fff; font-weight: 700; padding: .7rem 1.4rem; border-radius: 999px; text-decoration: none;">Créer mon compte gratuit</a>
            <p style="font-size: .85rem; margin-top: .75rem;"><a href="{{ path('app_login') }}" style="color: var(--primary);">J'ai déjà un compte</a></p>
        </div>
    {% elseif mode == 'essentials' %}
        <p class="ks-eyebrow" data-book-essentials style="margin-bottom: 1rem;">L'essentiel du chapitre</p>
        <div class="book-body">{{ chapter.essentials|raw }}</div>
        <div style="background: var(--primary-soft); border-radius: var(--r-lg); padding: 1.5rem; margin-top: 2rem; text-align: center;">
            <p style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--fg); margin-bottom: .4rem;">Le chapitre complet, avec ses histoires et son enseignement</p>
            <p style="color: var(--fg-muted); margin-bottom: 1rem;">Vous avez ici de quoi mettre ce chapitre en pratique. Le texte intégral du livre fait partie de KIINI SAWA PRO.</p>
            <a href="{{ path('app_subscription', {fonction: 'method'}) }}" class="ks-btn ks-btn--primary">Lire le livre en entier avec PRO</a>
        </div>
    {% else %}
        <div class="book-body">{{ chapter.html|raw }}</div>
        {% if not app.user %}
            <div style="background: var(--primary-soft); border-radius: var(--r-lg); padding: 1.25rem 1.5rem; margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
                <p style="color: var(--fg); margin: 0;">Prêt à poser vos fondations ? Trois minutes suffisent.</p>
                <a href="{{ path('app_register') }}" style="background: var(--primary); color: #fff; font-weight: 700; padding: .6rem 1.2rem; border-radius: 999px; text-decoration: none;">Commencer gratuitement</a>
            </div>
        {% endif %}
    {% endif %}
    {% if retour %}
        {# Point 8 : chapitre ouvert depuis un plan. Il s'ouvre dans un nouvel onglet : on le ferme si possible, sinon on y retourne #}
        <div class="ks-card ks-card--accent" data-chapter-return style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: space-between;">
            <p style="margin: 0; font-weight: 600;">{{ t('livre.retour.texte', 'Vous avez lu ce chapitre : c\'est le moment d\'écrire.') }}</p>
            <a class="ks-btn ks-btn--primary" href="{{ retour }}" onclick="if (history.length <= 1) { window.close(); }">{{ t('livre.retour.bouton', 'Revenir à mon plan et écrire') }}</a>
        </div>
    {% endif %}
    <nav style="display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-size: .9rem;">
        {% if previous %}<a href="{{ path('app_methode_chapter', {slug: previous.slug}) }}" style="color: var(--primary); text-decoration: none;">← {{ previous.title }}</a>{% else %}<span></span>{% endif %}
        {% if next %}<a href="{{ path('app_methode_chapter', {slug: next.slug}) }}" style="color: var(--primary); text-decoration: none; text-align: right;">{{ next.title }} →</a>{% endif %}
    </nav>
</article>
{% endblock %}
