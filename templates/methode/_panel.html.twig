{# Encart « Comprendre cette étape » (fonction Twig book_panel), dans le style des encadrés du livre : vert pâle, filet d'or #}
<details class="book-panel" {{ open ? 'open' }} style="margin: 0 0 1.25rem; background: var(--primary-soft); border-left: 3px solid var(--gold); border-radius: 0 12px 12px 0; padding: .85rem 1.1rem; font-size: .9rem; color: var(--fg-light);">
    <summary class="book-panel__summary">
        <i data-lucide="book-open" class="book-panel__icon" aria-hidden="true"></i>
        <span class="book-panel__labels">
            <span class="book-panel__label">Comprendre cette étape</span>
            <span class="book-panel__chapter">{{ chapter.title }}</span>
        </span>
        <i data-lucide="chevron-down" class="book-panel__chevron" aria-hidden="true"></i>
    </summary>
    <p style="margin: .6rem 0 .5rem; line-height: 1.6;">{{ chapter.excerpt }}</p>
    {% if chapter.sanctuary %}
        <details class="book-panel__sanctuary" data-sanctuary style="margin: .4rem 0 .7rem; background: #FFFFFF; border-radius: 10px; padding: .55rem .8rem;">
            <summary style="cursor: pointer; font-weight: 700; color: var(--primary-dark); display: flex; align-items: center; gap: .4rem;"><i data-lucide="flame" style="width: 14px; height: 14px; color: var(--gold);" aria-hidden="true"></i> {{ chapter.sanctuary.title }}</summary>
            <div style="margin-top: .5rem; line-height: 1.6;">{{ chapter.sanctuary.html|raw }}</div>
        </details>
    {% endif %}
    <a href="{{ path('app_methode_chapter', {slug: chapter.slug}) }}" target="_blank" rel="noopener" style="color: var(--accent); font-weight: 700; text-decoration: none;">Lire le chapitre ({{ chapter.minutes }} min) →</a>
</details>
