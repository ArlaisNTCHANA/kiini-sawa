<!-- Interactive Alpine Logic -->
<script>
function plannerData() {
    return {
        // States
        year: new Date().getFullYear(),
        month: new Date().getMonth(),
        events: [],
        dailyIntention: '',
        tempIntention: '',
        editingIntention: false,
        selectedDate: new Date(),
        currentView: 'month',
        filters: {
            task: true,
            habit: true,
            milestone: true,
            challenge: true
        },
        
        // Modals
        taskModalOpen: false,
        eventModalOpen: false,
        isEditMode: false,
        modalTask: {
            id: null,
            title: '',
            date: '',
            startTime: '',
            endTime: '',
            growthGoalId: '',
            description: ''
        },
        selectedEvent: {},

        initPlanner() {
            this.fetchEvents();
            this.fetchDailyIntention();
        },

        get currentMonthName() {
            const months = ["Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"];
            return `${months[this.month]} ${this.year}`;
        },

        get calendarDays() {
            let d = new Date(this.year, this.month, 1);
            let dayOfWeek = d.getDay(); // 0 (Sun) - 6 (Sat)
            // Mon = 0, ..., Sun = 6
            let offset = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
            
            let days = [];
            
            // Prev month padding
            let prevMonthEnd = new Date(this.year, this.month, 0).getDate();
            for (let i = offset - 1; i >= 0; i--) {
                days.push({
                    date: new Date(this.year, this.month - 1, prevMonthEnd - i),
                    isCurrentMonth: false
                });
            }
            
            // Current month
            let currentMonthEnd = new Date(this.year, this.month + 1, 0).getDate();
            for (let i = 1; i <= currentMonthEnd; i++) {
                days.push({
                    date: new Date(this.year, this.month, i),
                    isCurrentMonth: true
                });
            }
            
            // Next month padding
            let totalCells = 42;
            let remaining = totalCells - days.length;
            for (let i = 1; i <= remaining; i++) {
                days.push({
                    date: new Date(this.year, this.month + 1, i),
                    isCurrentMonth: false
                });
            }
            
            return days;
        },

        get upcomingEvents() {
            const today = new Date();
            today.setHours(0,0,0,0);
            
            const nextWeek = new Date(today);
            nextWeek.setDate(today.getDate() + 7);
            
            return this.events
                .filter(e => {
                    const eDate = new Date(e.date);
                    return eDate >= today && eDate <= nextWeek;
                })
                .filter(e => e.type !== 'HABIT')
                .filter(e => this.matchesFilter(e.type))
                .sort((a, b) => new Date(a.date) - new Date(b.date));
        },

        matchesFilter(type) {
            if (type === 'TASK') return this.filters.task;
            if (type === 'HABIT') return this.filters.habit;
            if (type === 'MILESTONE') return this.filters.milestone;
            if (type === 'CHALLENGE') return this.filters.challenge;
            return false;
        },

        filteredEventsByDate(date) {
            const dateStr = this.formatDateIso(date);
            const priority = { 'MILESTONE': 1, 'TASK': 2, 'CHALLENGE': 3, 'HABIT': 4 };
            return this.events
                .filter(e => e.date.substring(0, 10) === dateStr)
                .filter(e => this.matchesFilter(e.type))
                .sort((a, b) => (priority[a.type] || 99) - (priority[b.type] || 99));
        },

        hasEventType(date, type) {
            return this.filteredEventsByDate(date).some(e => e.type === type);
        },

        getUniqueEvents(date) {
            return this.filteredEventsByDate(date).filter(e => e.type !== 'HABIT');
        },

        getCellTooltip(date) {
            const events = this.filteredEventsByDate(date);
            if (events.length === 0) return "Double-cliquer pour ajouter une tâche";
            
            const lines = events.map(e => {
                const time = e.startTime ? `[${e.startTime}] ` : '';
                const typeStr = e.type === 'TASK' ? 'Tâche' : e.type === 'HABIT' ? 'Rituel' : e.type === 'MILESTONE' ? 'Jalon' : 'Défi';
                const status = e.isCompleted ? '✓' : '◯';
                return `${status} ${time}${e.title} (${typeStr})`;
            });
            return `Double-cliquer pour ajouter une tâche\n\nActivités :\n${lines.join('\n')}`;
        },

        getHabitsProgress(date) {
            if (!this.filters.habit) return null;
            const habits = this.filteredEventsByDate(date).filter(e => e.type === 'HABIT');
            if (habits.length === 0) return null;
            
            const completed = habits.filter(e => e.isCompleted).length;
            return {
                completed,
                total: habits.length,
                pct: Math.round((completed / habits.length) * 100)
            };
        },

        get currentWeekName() {
            const days = this.weekDays;
            if (!days || days.length === 0) return '';
            const start = days[0];
            const end = days[6];
            const options = { day: 'numeric', month: 'short' };
            const startStr = start.toLocaleDateString('fr-FR', options);
            const endStr = end.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' });
            return `Semaine du ${startStr} au ${endStr}`;
        },

        get weekDays() {
            const current = new Date(this.selectedDate);
            const day = current.getDay();
            const diff = current.getDate() - day + (day === 0 ? -6 : 1);
            const monday = new Date(current.setDate(diff));
            
            const days = [];
            for (let i = 0; i < 7; i++) {
                const date = new Date(monday);
                date.setDate(monday.getDate() + i);
                days.push(date);
            }
            return days;
        },

        get ganttDates() {
            const current = new Date(this.selectedDate);
            const day = current.getDay();
            const diff = current.getDate() - day + (day === 0 ? -6 : 1);
            const monday = new Date(current.setDate(diff));
            
            const dates = [];
            for (let i = 0; i < 14; i++) {
                const date = new Date(monday);
                date.setDate(monday.getDate() + i);
                dates.push(date);
            }
            return dates;
        },

        get ganttEvents() {
            const dates = this.ganttDates;
            if (!dates || dates.length === 0) return [];
            const startStr = this.formatDateIso(dates[0]);
            const endStr = this.formatDateIso(dates[dates.length - 1]);
            
            return this.events.filter(e => {
                if (e.type === 'HABIT') return false;
                const eDate = e.date.substring(0, 10);
                return eDate >= startStr && eDate <= endStr;
            });
        },

        getGanttStyle(event) {
            const dates = this.ganttDates;
            if (!dates || dates.length === 0) return 'display: none';
            const startStr = this.formatDateIso(dates[0]);
            const endStr = this.formatDateIso(dates[dates.length - 1]);
            
            const eStart = (event.startDate || event.date).substring(0, 10);
            const eEnd = event.date.substring(0, 10);
            
            let startIdx = dates.findIndex(d => this.formatDateIso(d) === eStart);
            let endIdx = dates.findIndex(d => this.formatDateIso(d) === eEnd);
            
            if (startIdx === -1) {
                if (eStart < startStr) startIdx = 0;
                else return 'display: none';
            }
            if (endIdx === -1) {
                if (eEnd > endStr) endIdx = dates.length - 1;
                else return 'display: none';
            }
            
            const colStart = startIdx + 1;
            const colSpan = Math.max(1, endIdx - startIdx + 1);
            
            return `grid-column: ${colStart} / span ${colSpan};`;
        },

        get viewTitle() {
            if (this.currentView === 'month') {
                return this.currentMonthName;
            } else if (this.currentView === 'week') {
                return this.currentWeekName;
            } else if (this.currentView === 'day') {
                return this.formatDateFull(this.selectedDate);
            } else if (this.currentView === 'gantt') {
                return `Planification Gantt — ${this.currentMonthName}`;
            }
            return '';
        },

        prev() {
            if (this.currentView === 'month') {
                this.prevMonth();
            } else if (this.currentView === 'week' || this.currentView === 'gantt') {
                this.prevWeek();
            } else if (this.currentView === 'day') {
                this.prevDay();
            }
        },

        next() {
            if (this.currentView === 'month') {
                this.nextMonth();
            } else if (this.currentView === 'week' || this.currentView === 'gantt') {
                this.nextWeek();
            } else if (this.currentView === 'day') {
                this.nextDay();
            }
        },

        prevWeek() {
            const current = new Date(this.selectedDate);
            current.setDate(current.getDate() - 7);
            this.selectedDate = current;
            this.year = current.getFullYear();
            this.month = current.getMonth();
            this.fetchEvents();
        },

        nextWeek() {
            const current = new Date(this.selectedDate);
            current.setDate(current.getDate() + 7);
            this.selectedDate = current;
            this.year = current.getFullYear();
            this.month = current.getMonth();
            this.fetchEvents();
        },

        prevDay() {
            const current = new Date(this.selectedDate);
            current.setDate(current.getDate() - 1);
            this.selectedDate = current;
            this.year = current.getFullYear();
            this.month = current.getMonth();
            this.fetchEvents();
        },

        nextDay() {
            const current = new Date(this.selectedDate);
            current.setDate(current.getDate() + 1);
            this.selectedDate = current;
            this.year = current.getFullYear();
            this.month = current.getMonth();
            this.fetchEvents();
        },

        // Network interactions
        fetchEvents() {
            const startDate = new Date(this.year, this.month, 1);
            startDate.setDate(startDate.getDate() - 7);
            const endDate = new Date(this.year, this.month + 1, 0);
            endDate.setDate(endDate.getDate() + 14);

            const startStr = startDate.toISOString().split('T')[0];
            const endStr = endDate.toISOString().split('T')[0];

            fetch(`/api/planner/events?start=${startStr}&end=${endStr}`)
                .then(res => res.json())
                .then(data => {
                    this.events = data;
                });
        },

        fetchDailyIntention() {
            fetch('/api/planner/daily-intention')
                .then(res => res.json())
                .then(data => {
                    this.dailyIntention = data.intention;
                    this.tempIntention = data.intention;
                });
        },

        saveIntention() {
            fetch('/api/planner/intention', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ intention: this.tempIntention })
            })
            .then(res => res.json())
            .then(data => {
                this.dailyIntention = data.intention;
                this.editingIntention = false;
            });
        },

        toggleEventStatus(event) {
            const dateStr = new Date(event.date).toISOString().split('T')[0];
            fetch(`/api/planner/toggle/${event.type}/${event.sourceId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ date: dateStr })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    event.isCompleted = data.isCompleted;
                    this.fetchEvents(); // Re-sync logs and indicators
                }
            });
        },

        // Tasks operations
        openAddTaskModal(date) {
            this.isEditMode = false;
            this.modalTask = {
                id: null,
                title: '',
                date: this.formatDateIso(date),
                startTime: '',
                endTime: '',
                growthGoalId: '',
                description: ''
            };
            this.taskModalOpen = true;
        },

        openEditTaskModal(event) {
            this.isEditMode = true;
            this.modalTask = {
                id: event.sourceId,
                title: event.title,
                date: this.formatDateIso(new Date(event.startDate || event.date)),
                startTime: event.startTime || '',
                endTime: event.endTime || '',
                growthGoalId: event.linkedGoalId || '',
                description: event.description || ''
            };
            this.taskModalOpen = true;
        },

        openEventModal(event) {
            this.selectedEvent = event;
            this.eventModalOpen = true;
        },

        saveTask() {
            if (!this.modalTask.title || !this.modalTask.date) {
                alert("Veuillez saisir un titre et une date.");
                return;
            }

            const url = this.isEditMode 
                ? `/api/planner/task/${this.modalTask.id}/update` 
                : '/api/planner/task/create';

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.modalTask)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    this.taskModalOpen = false;
                    this.fetchEvents();
                } else {
                    alert(data.error || "Une erreur est survenue.");
                }
            });
        },

        deleteTask() {
            if (!confirm("Voulez-vous vraiment supprimer cette tâche ?")) return;

            fetch(`/api/planner/task/${this.modalTask.id}/delete`, {
                method: 'DELETE'
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    this.taskModalOpen = false;
                    this.fetchEvents();
                }
            });
        },

        // Month Switching navigation
        prevMonth() {
            if (this.month === 0) {
                this.month = 11;
                this.year--;
            } else {
                this.month--;
            }
            this.selectedDate = new Date(this.year, this.month, 1);
            this.fetchEvents();
        },

        nextMonth() {
            if (this.month === 11) {
                this.month = 0;
                this.year++;
            } else {
                this.month++;
            }
            this.selectedDate = new Date(this.year, this.month, 1);
            this.fetchEvents();
        },

        today() {
            const today = new Date();
            this.year = today.getFullYear();
            this.month = today.getMonth();
            this.selectedDate = today;
            this.fetchEvents();
        },

        // Utils
        isToday(date) {
            return date.toDateString() === new Date().toDateString();
        },

        isSelected(date) {
            return date.toDateString() === this.selectedDate.toDateString();
        },

        // Safely converts Date to ISO YYYY-MM-DD local string
        formatDateIso(date) {
            const offset = date.getTimezoneOffset();
            const localDate = new Date(date.getTime() - (offset*60*1000));
            return localDate.toISOString().split('T')[0];
        },

        formatDateShort(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        },

        formatDateFull(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        },

        getBadgeClass(type) {
            if (type === 'TASK') return 'bg-blue-100 text-blue-700 border-blue-200';
            if (type === 'HABIT') return 'bg-emerald-100 text-emerald-700 border-emerald-200';
            if (type === 'MILESTONE') return 'bg-purple-100 text-purple-700 border-purple-200';
            if (type === 'CHALLENGE') return 'bg-orange-100 text-orange-700 border-orange-200';
            return 'bg-slate-100 text-slate-700 border-slate-200';
        }
    }
}
</script>
{% endblock %}
