{% extends 'admin/layout.html.twig' %}

{% block title %}Organisations{% endblock %}
{% block page_title %}Organisations{% endblock %}
{% block page_lead %}Églises, associations et entreprises : créez une organisation pilote et gérez les places de chaque licence.{% endblock %}

{% block content %}
<div class="ks-stack">
    <section class="ks-card" aria-labelledby="org-new">
        <h2 class="ks-card__title" id="org-new"><i data-lucide="plus-circle"></i> Créer une organisation (pilote, contrat négocié)</h2>
        <form method="post" action="{{ path('admin_organisations_create') }}" class="ks-form-grid" style="margin-top: .9rem;">
            <div class="ks-field"><label class="ks-label" for="org-name">Nom</label><input id="org-name" class="ks-input" name="name" required placeholder="Église de…"></div>
            <div class="ks-field"><label class="ks-label" for="org-type">Type</label><select id="org-type" class="ks-input" name="type">{% for k, l in types %}<option value="{{ k }}">{{ l }}</option>{% endfor %}</select></div>
            <div class="ks-field"><label class="ks-label" for="org-owner">Email du responsable</label><input id="org-owner" class="ks-input" name="ownerEmail" type="email" required placeholder="responsable@exemple.com"></div>
            <div class="ks-field"><label class="ks-label" for="org-seats">Places</label><input id="org-seats" class="ks-input" name="seats" type="number" min="0" value="25"></div>
            <div class="ks-field"><label class="ks-label" for="org-until">Valable jusqu'au</label><input id="org-until" class="ks-input" name="validUntil" type="date" value="{{ 'now'|date_modify('+1 year')|date('Y-m-d') }}"></div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_org') }}">
            <div><button type="submit" class="ks-btn ks-btn--primary" style="width: 100%;"><i data-lucide="plus"></i> Créer</button></div>
        </form>
    </section>

    <section class="ks-card" aria-labelledby="org-list">
        <h2 class="ks-card__title" id="org-list">{{ organisations|length }} organisation{{ organisations|length > 1 ? 's' }}</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Organisation</th><th class="is-num">Membres</th><th>Licence</th><th>Modifier la licence</th></tr></thead>
                <tbody>
                {% for o in organisations %}
                    <tr>
                        <td><strong>{{ o.name }}</strong><br><span class="ks-small">{{ o.typeLabel }} · créée le {{ o.createdAt|date('d/m/Y') }}{{ o.createdBy ? ' par ' ~ o.createdBy.email }}</span></td>
                        <td data-label="Membres" class="is-num">{{ o.usedSeats }}</td>
                        <td data-label="Licence">{% if o.licenseValid %}<span class="ks-badge ks-badge--success">{{ o.seats }} places</span> <span class="ks-small">jusqu'au {{ o.seatsValidUntil|date('d/m/Y') }}</span>{% else %}<span class="ks-badge ks-badge--muted">inactive</span>{% endif %}</td>
                        <td data-label="Modifier">
                            <form method="post" action="{{ path('admin_organisations_license', {id: o.id}) }}" class="ks-inline-form">
                                <input name="seats" type="number" min="0" value="{{ o.seats }}" class="ks-input ks-input--sm" style="width: 5rem;" aria-label="Places">
                                <input name="validUntil" type="date" value="{{ o.seatsValidUntil ? o.seatsValidUntil|date('Y-m-d') }}" class="ks-input ks-input--sm" aria-label="Valable jusqu'au">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_org') }}">
                                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm">Enregistrer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Aucune organisation pour l'instant. Créez la première avec le formulaire ci-dessus.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
