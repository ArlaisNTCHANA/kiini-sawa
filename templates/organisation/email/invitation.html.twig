{% extends 'compte/email/_layout.html.twig' %}
{% block content %}
  <p>Bonjour,</p>
  <p><strong>{{ inviter }}</strong> vous invite à rejoindre <strong>{{ org.name }}</strong> sur KIINI SAWA, l'application qui aide à discerner sa raison d'être, bâtir son Plan de Vie et le vivre au quotidien.</p>
  {% if message %}<p style="background:#EEF3EF;border-left:3px solid #2E6B53;padding:10px 14px;font-style:italic;">{{ message }}</p>{% endif %}
  <p style="text-align:center;margin:28px 0;"><a href="{{ url }}" style="background:#2E6B53;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">Rejoindre {{ org.name }}</a></p>
  <p style="font-size:13px;color:#66706A;">Votre journal reste toujours privé. Vous choisissez ce que vous partagez.</p>
{% endblock %}
