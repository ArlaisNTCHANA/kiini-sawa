{% extends 'base.html.twig' %}

{% block title %}Avant d'activer votre engagement{% endblock %}

{% block body %}
<style>
    .ac-mail { border: 1px dashed var(--border-strong); border-radius: var(--r-lg); padding: 1.25rem; background: #fff; font-size: .95rem; line-height: 1.6; }
    .ac-mail p { margin-bottom: .75rem; }
    .ac-step { font-size: .78rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--primary); margin: 1.75rem 0 .5rem; }
    .ac-list { list-style: decimal; }
    .ac-list li { margin-bottom: .4rem; padding-left: .2rem; }
</style>
<div class="ks-page ks-page--narrow">
    {% include 'shared/_page_header.html.twig' with {
        back: {url: path('app_accountability_new'), label: 'Modifier'},
        eyebrow: 'Partenaires', icon: 'shield-check',
        title: 'Avant d\'activer votre engagement',
        lead: 'Voici exactement ce qui va se passer, et ce que ' ~ partnerName ~ ' recevra.'
    } %}

    <section class="ks-card">
        <h2 class="ks-section-title" style="margin-top: 0;">Ce qui va se passer</h2>
        <ol class="ac-list" style="margin-left: 1.2rem;">
            <li><strong>{{ partnerName }}</strong> reçoit une invitation à devenir votre partenaire de redevabilité. <strong>Rien d'autre ne sera envoyé tant que l'invitation n'aura pas été acceptée.</strong></li>
            {% set alerts = [] %}
            {% if targetType == 'HABIT' and data.alertHabitDays > 0 %}{% set alerts = alerts|merge(['vous ne validez pas ce rituel pendant ' ~ data.alertHabitDays ~ ' jours de suite']) %}{% endif %}
            {% if targetType == 'GOAL' and data.alertGoalDays > 0 %}{% set alerts = alerts|merge(['votre objectif n\'avance pas pendant ' ~ data.alertGoalDays ~ ' jours']) %}{% endif %}
            {% if data.alertInactiveDays > 0 %}{% set alerts = alerts|merge(['vous ne vous connectez plus à KIINI SAWA pendant ' ~ data.alertInactiveDays ~ ' jours']) %}{% endif %}
            {% if alerts is not empty %}
                <li><strong>Sans que vous ayez à le demander</strong>, {{ partnerName }} sera prévenu(e) si {{ alerts|join(', ou si ') }}.</li>
            {% else %}
                <li>Aucune alerte automatique : {{ partnerName }} ne sera prévenu(e) que si vous le demandez.</li>
            {% endif %}
            <li>Vous pourrez aussi, à tout moment, lui demander un coup de main. <strong>Au plus un message tous les {{ minDays }} jours</strong>, et <strong>vous recevrez une copie</strong> de chacun.</li>
            <li>{{ partnerName }} indiquera en un clic ce qui a été fait (appel, message, rencontre, prière). Vous serez prévenu(e) et vous le verrez dans « Ma redevabilité ».</li>
            <li>{{ partnerName }} ne verra que cet engagement : <strong>ni votre journal, ni vos autres plans, ni vos tests</strong>.</li>
            <li>Vous pouvez mettre en pause ou arrêter à tout moment ; {{ partnerName }} aussi.</li>
        </ol>
    </section>

    <p class="ac-step">L'invitation que {{ partnerName }} recevra</p>
    <div class="ac-mail">
        {% include 'social/accountability/_invitation_body.html.twig' with {owner: owner, partnerName: partnerName, label: label, why: data.why, minDays: minDays, url: null} %}
    </div>

    {% if alerts is not empty %}
        {% set sampleFact = targetType == 'HABIT' and data.alertHabitDays > 0
            ? owner ~ ' n\'a pas validé son rituel « ' ~ label ~ ' » depuis ' ~ data.alertHabitDays ~ ' jours.'
            : (targetType == 'GOAL' and data.alertGoalDays > 0
                ? 'L\'objectif « ' ~ label ~ ' » de ' ~ owner ~ ' n\'a pas avancé depuis ' ~ data.alertGoalDays ~ ' jours.'
                : owner ~ ' ne s\'est pas connecté(e) à KIINI SAWA depuis ' ~ data.alertInactiveDays ~ ' jours.') %}
        <p class="ac-step">Exemple d'alerte automatique</p>
        <div class="ac-mail">
            {% include 'social/accountability/_nudge_body.html.twig' with {owner: owner, partnerName: partnerName, label: label, why: data.why, message: null, actions: actions, respondUrl: null, fact: sampleFact} %}
        </div>
    {% endif %}

    <p class="ac-step">Exemple de demande de coup de main (quand vous la ferez)</p>
    <div class="ac-mail">
        {% include 'social/accountability/_nudge_body.html.twig' with {owner: owner, partnerName: partnerName, label: label, why: data.why, message: 'Cette semaine est difficile, j\'ai besoin d\'un coup de pouce.', actions: actions, respondUrl: null} %}
    </div>

    <form method="post" action="{{ path('app_accountability_create') }}" class="ks-card" style="margin-top: 1.5rem;">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('accountability') }}">
        {% for k, v in data %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
        <label style="display: flex; gap: .6rem; align-items: flex-start; cursor: pointer;">
            <input type="checkbox" name="consent" value="1" required style="margin-top: .3rem; accent-color: var(--primary);">
            <span>J'ai compris : {{ partnerName }} recevra ces messages{{ alerts is not empty ? ' (alertes automatiques comprises)' }}, j'en recevrai une copie, et ses réponses seront enregistrées dans KIINI SAWA.</span>
        </label>
        <div style="margin-top: 1rem; display: flex; gap: .5rem; flex-wrap: wrap;">
            <button class="ks-btn ks-btn--primary" type="submit">Activer et inviter {{ partnerName }}</button>
            <a class="ks-btn ks-btn--ghost" href="{{ path('app_accountability') }}">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
