{# Un engagement de redevabilité, dans la fiche de son Partenaire de Redevabilité (point 6, 26/11/2026).
   Variables : c (AccountabilityCommitment), stats, nextAllowed, token (CSRF « accountability »). #}
{% set statusLabels = {PENDING: 'En attente de l\'accord du partenaire', ACTIVE: 'Actif', PAUSED: 'En pause', DECLINED: 'Refusé par le partenaire', STOPPED: 'Arrêté'} %}
{% set s = stats[c.id] %}
<section class="ac-card" id="engagement-{{ c.id }}">
    <div class="ac-top">
        <div>
            <p class="ac-label">{{ c.targetLabel }}</p>
            <p class="ac-mini">Engagement · depuis le {{ c.createdAt|date('d/m/Y') }}</p>
        </div>
        <span class="ks-badge{{ c.active ? '' : ' ks-badge--muted' }}">{{ c.active ? 'Actif' : statusLabels[c.status] }}</span>
    </div>

    {% if c.active or s.nudges > 0 %}
        <div class="ac-stats">
            <div class="ac-stat"><strong>{{ s.nudges }}</strong><span class="ac-mini">interpellation{{ s.nudges > 1 ? 's' }}</span></div>
            <div class="ac-stat"><strong>{{ s.rate is null ? '–' : s.rate ~ ' %' }}</strong><span class="ac-mini">de réponses</span></div>
            <div class="ac-stat"><strong>{{ s.nudges > 0 ? s.resumed ~ ' / ' ~ s.nudges : '–' }}</strong><span class="ac-mini">reprises dans les 72 h</span></div>
            <div class="ac-stat"><strong>{{ s.avgHours is null ? '–' : (s.avgHours < 1 ? '< 1 h' : (s.avgHours < 24 ? s.avgHours ~ ' h' : (s.avgHours / 24)|round ~ ' j')) }}</strong><span class="ac-mini">délai moyen de réponse</span></div>
        </div>
    {% endif %}

    {% set rules = [] %}
    {% if c.alertHabitDays %}{% set rules = rules|merge(['rituel non validé ' ~ c.alertHabitDays ~ ' jours de suite']) %}{% endif %}
    {% if c.alertGoalDays %}{% set rules = rules|merge(['objectif sans avancée ' ~ c.alertGoalDays ~ ' jours']) %}{% endif %}
    {% if c.alertInactiveDays %}{% set rules = rules|merge(['pas de connexion ' ~ c.alertInactiveDays ~ ' jours']) %}{% endif %}
    {% if c.open %}
        <p class="ac-mini" style="margin-bottom: .75rem;"><i data-lucide="bell-ring" class="ks-ico" aria-hidden="true"></i>
            {{ rules is not empty ? c.partnerName ~ ' reçoit automatiquement un message si : ' ~ rules|join(', ') ~ '.' : 'Pas d\'alerte automatique : seulement vos demandes.' }}</p>
    {% endif %}
    {% if c.active %}
        {% if nextAllowed[c.id] %}
            <p class="ac-mini">Prochaine interpellation possible le {{ nextAllowed[c.id]|date('d/m/Y') }} (au plus une tous les {{ c.minDaysBetweenNudges }} jours).</p>
        {% else %}
            <form method="post" action="{{ path('app_accountability_nudge', {id: c.id}) }}" style="display: grid; gap: .5rem;" onsubmit="return confirm('{{ c.partnerName|e('js') }} va recevoir un e-mail, et vous une copie. Envoyer ?')">
                <input type="hidden" name="_csrf_token" value="{{ token }}">
                <textarea name="message" class="ks-input" rows="2" maxlength="1000" placeholder="Écrire à {{ c.partnerName }} : où vous en êtes, ce qui est difficile (facultatif)" aria-label="Un mot pour votre partenaire"></textarea>
                <div><button class="ks-btn ks-btn--primary ks-btn--sm" type="submit">J'ai besoin d'un coup de main</button></div>
            </form>
        {% endif %}
    {% elseif c.pending %}
        <p class="ac-mini">{{ c.partnerName }} a reçu une invitation le {{ c.createdAt|date('d/m/Y') }}. Tant que l'invitation n'est pas acceptée, rien d'autre n'est envoyé.</p>
    {% endif %}

    {% if s.last is not empty %}
        <p class="ac-mini" style="margin-top: 1rem; font-weight: 700;">Historique</p>
        {% for n in s.last %}
            <div class="ac-hist">
                {{ n.reasonLabel }} du {{ n.sentAt|date('d/m/Y') }}{% if n.resumedAt %} <span class="ks-badge" style="margin-left: .3rem;">reprise</span>{% endif %} :
                {% if n.respondedAt %}
                    <strong>{{ n.responseActionLabel }}</strong> ({{ n.respondedAt|date('d/m') }}){% if n.responseNote %} · « {{ n.responseNote }} »{% endif %}
                {% else %}
                    <span class="ac-mini">pas encore de réponse</span>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}

    {% if c.open %}
        <div class="ac-actions">
            {% if c.active %}
                <form method="post" action="{{ path('app_accountability_manage', {id: c.id, action: 'pause'}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button class="ks-btn ks-btn--ghost ks-btn--sm" type="submit">Mettre en pause</button></form>
            {% elseif c.paused %}
                <form method="post" action="{{ path('app_accountability_manage', {id: c.id, action: 'resume'}) }}"><input type="hidden" name="_csrf_token" value="{{ token }}"><button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit">Reprendre</button></form>
            {% endif %}
            <form method="post" action="{{ path('app_accountability_manage', {id: c.id, action: 'stop'}) }}" onsubmit="return confirm('Arrêter cet engagement ? {{ c.partnerName|e('js') }} ne recevra plus de messages.')"><input type="hidden" name="_csrf_token" value="{{ token }}"><button class="ks-btn ks-btn--ghost ks-btn--sm" type="submit">Arrêter</button></form>
        </div>
    {% endif %}
</section>
