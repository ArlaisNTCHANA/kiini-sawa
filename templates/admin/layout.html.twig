{#
    Gabarit commun de l'administration (docs/design.md, section Administration).
    Même palette et mêmes composants ks-… que l'application ; menu défini une seule fois dans
    App\Admin\Twig\AdminNavigationExtension (admin_nav, admin_current, admin_todo).

    Blocs d'une page :
      title          titre de l'onglet du navigateur
      page_title     titre affiché en haut de la page
      page_lead      phrase d'introduction (facultatif)
      page_actions   l'action principale de l'écran, à droite du titre (une seule ks-btn--primary)
      crumbs         étapes supplémentaires du fil d'Ariane, après la page du menu (facultatif)
      content        le contenu
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#2E6B53">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Administration{% endblock %} · Administration KIINI SAWA</title>
    <link rel="icon" href="{{ asset('icons/favicon-32.png') }}" sizes="32x32">
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% include 'shared/_design_tokens.html.twig' %}
    <style>
        /* Anciens noms de variables de l'administration, conservés pour les styles propres à certaines pages. */
        :root {
            --text-primary: var(--fg); --text-secondary: var(--fg-muted); --text-muted: var(--fg-subtle);
            --bg-card: var(--card-bg); --bg-card-hover: var(--bg-alt); --bg-input: var(--card-bg); --bg-body: var(--bg);
            --accent-gradient: var(--primary); --accent-gradient-subtle: var(--primary-soft); --accent-light: var(--primary);
            --border-active: var(--primary-light);
            --radius-sm: var(--r-sm); --radius-md: var(--r-md); --radius-lg: var(--r-lg); --radius-xl: var(--r-xl);
            --shadow-card: var(--card-shadow); --shadow-glow: var(--card-shadow-hover);
            --transition: .2s var(--ease);
        }
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; }
        h1, h2, h3, h4, p, ul, ol { margin: 0; }
        [x-cloak] { display: none !important; }
    </style>
    {% block stylesheets %}{% endblock %}
    <script defer src="{{ asset('lib/alpinejs-3.17.5.min.js') }}"></script>
    <script src="{{ asset('lib/lucide-1.73.0.min.js') }}"></script>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="ks-admin" x-data="{ menu: false }" @keydown.escape.window="menu = false">
{% set nav = admin_nav() %}
{% set here = admin_current() %}
{% set todo = admin_todo() %}
{% set waiting = todo.payments + todo.feedback %}

<aside class="ks-admin-side" :class="{ 'is-open': menu }" aria-label="Menu de l'administration" id="admin-menu">
    <a class="ks-admin-brand" href="{{ path('admin_dashboard') }}">
        <img src="{{ asset('icons/icon-192.png') }}" alt="" width="36" height="36">
        <span><span class="ks-admin-brand__name">KIINI SAWA</span><span class="ks-admin-brand__sub">Administration</span></span>
    </a>
    <nav class="ks-admin-nav">
        {% for key, group in nav %}
            {% if key != 'home' %}<p class="ks-admin-nav__label">{{ group.label }}</p>{% endif %}
            {% for it in group.items %}
                <a href="{{ path(it.route) }}" class="ks-admin-nav__link{{ it.active ? ' is-active' }}"{% if it.active %} aria-current="page"{% endif %}>
                    <i data-lucide="{{ it.icon }}"></i><span>{{ it.label }}</span>
                    {% if it.count %}<span class="ks-admin-nav__count" title="{{ it.count }} à traiter">{{ it.count }}</span>{% endif %}
                </a>
            {% endfor %}
        {% endfor %}
    </nav>
    <div class="ks-admin-side__foot">
        <a href="{{ path('app_dashboard') }}" class="ks-admin-nav__link"><i data-lucide="arrow-left"></i><span>Retour à l'application</span></a>
        <form method="post" action="{{ path('app_logout') }}" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout_form') }}">
            <button type="submit" class="ks-admin-nav__link" id="nav-logout"><i data-lucide="log-out"></i><span>Se déconnecter</span></button>
        </form>
        <p class="ks-small" style="padding: .4rem .75rem 0; overflow-wrap: anywhere;">Connecté : {{ app.user.email }}</p>
    </div>
</aside>
<div class="ks-admin-overlay" :class="{ 'is-open': menu }" @click="menu = false"></div>

<div class="ks-admin-main">
    <header class="ks-admin-top">
        <button type="button" class="ks-admin-top__btn" @click="menu = true" aria-controls="admin-menu" :aria-expanded="menu.toString()">
            <i data-lucide="menu"></i> Menu
        </button>
        <span class="ks-admin-top__title">Administration</span>
        {% if waiting %}<a class="ks-badge ks-badge--gold ks-admin-top__count" href="{{ path('admin_dashboard') }}">{{ waiting }} à traiter</a>{% endif %}
    </header>

    <main class="ks-admin-content">
        <nav class="ks-admin-crumbs" aria-label="Fil d'Ariane">
            {% if here and here.home %}
                <span aria-current="page">Administration</span>
            {% else %}
                <a href="{{ path('admin_dashboard') }}">Administration</a>
                {% if here %}
                    <span aria-hidden="true">›</span><span>{{ here.group }}</span>
                    {% set extra %}{% block crumbs %}{% endblock %}{% endset %}
                    <span aria-hidden="true">›</span>
                    {% if extra|trim %}<a href="{{ path(here.route) }}">{{ here.label }}</a>{{ extra }}{% else %}<span aria-current="page">{{ here.label }}</span>{% endif %}
                {% endif %}
            {% endif %}
        </nav>

        <div class="ks-admin-head">
            <header class="ks-header">
                <h1 class="ks-header__title">{% block page_title %}Tableau de bord{% endblock %}</h1>
                {% set lead %}{% block page_lead %}{% endblock %}{% endset %}
                {% if lead|trim %}<p class="ks-header__lead">{{ lead }}</p>{% endif %}
            </header>
            {% set actions %}{% block page_actions %}{% endblock %}{% endset %}
            {% if actions|trim %}<div class="ks-admin-head__actions">{{ actions }}</div>{% endif %}
        </div>

        {% set ksFlashes = app.flashes(['success', 'info', 'error', 'warning', 'dev']) %}
        {% if ksFlashes|filter(m => m|length > 0)|length > 0 %}
            <div class="ks-admin-flashes">
                {% for type, messages in ksFlashes %}
                    {% for message in messages %}
                        <div class="ks-alert ks-alert--{{ {success: 'success', info: 'info', dev: 'info', warning: 'warning', error: 'danger'}[type] }}" role="{{ type == 'error' ? 'alert' : 'status' }}">
                            {% if type == 'dev' %}<strong>[dev]</strong> {% endif %}{{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>
</div>

<script>
    // Turbo remplace le <body> à chaque clic : on recrée les icônes à chaque fois.
    ['DOMContentLoaded', 'turbo:load', 'turbo:render'].forEach((evt) => document.addEventListener(evt, () => {
        if (window.lucide) lucide.createIcons();
    }));
</script>
</body>
</html>
