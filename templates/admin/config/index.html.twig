{% extends 'admin/layout.html.twig' %}

{% block title %}Réglages de l'application{% endblock %}
{% block page_title %}Réglages de l'application{% endblock %}
{% block page_lead %}Prix, coordonnées de paiement et ce qui reste gratuit. Les changements s'appliquent dès l'enregistrement.{% endblock %}

{% macro field(f, wide) %}
    <div class="ks-field{{ wide|default(false) ? ' ks-field--wide' }}">
        {{ form_label(f, null, {label_attr: {class: 'ks-label'}}) }}
        {{ form_widget(f, {attr: {class: 'ks-input'}}) }}
        {% if f.vars.help %}<p class="ks-help">{{ form_help(f) }}</p>{% endif %}
        {{ form_errors(f) }}
    </div>
{% endmacro %}

{% block content %}
{% import _self as m %}
{{ form_start(form) }}
<div class="ks-stack" style="max-width: 860px;">
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="tag"></i> Prix et essai</h2>
        <div class="ks-form-grid" style="margin-top: .9rem;">
            {{ m.field(form.proMonthlyPrice) }}
            {{ m.field(form.proYearlyPrice) }}
            {{ m.field(form.proMonthlyPriceXaf) }}
            {{ m.field(form.proYearlyPriceXaf) }}
            {{ m.field(form.duoYearlyPriceEur) }}
            {{ m.field(form.duoYearlyPriceXaf) }}
            {{ m.field(form.orgSeatYearlyPriceEur) }}
            {{ m.field(form.orgSeatYearlyPriceXaf) }}
            {{ m.field(form.trialDurationDays) }}
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="wallet"></i> Paiements manuels</h2>
        <div class="ks-stack" style="margin-top: .9rem; gap: 1rem;">
            {% for f in ['bankTransferInstructions', 'mobileMoneyInstructions', 'paymentNotificationEmail'] %}{{ m.field(form[f], true) }}{% endfor %}
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="gift"></i> Accessible gratuitement</h2>
        <p class="ks-muted">Décoché = réservé à PRO. Le Plan de Vie, les rituels, le journal, l'agenda et la revue de la semaine restent toujours gratuits.</p>
        <div class="ks-form-grid" style="margin: .9rem 0;">
            {{ m.field(form.maxHabitsFree) }}
            {{ m.field(form.maxConnectionsFree) }}
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .6rem 1.25rem;">
            {% for f in ['enableGrowthFree', 'enableDevelopmentFree', 'enableTransmissionFree', 'enableHygieneFree', 'enableStewardshipFree', 'enableMapFree', 'enablePrintFree', 'enableMonthlyReviewsFree', 'enablePlanHistoryFree', 'enableCoherenceAnalysisFree', 'enableMethodFree'] %}
                <label style="display: flex; gap: .55rem; align-items: center; font-size: .92rem;">{{ form_widget(form[f]) }} {{ form[f].vars.label }}</label>
            {% endfor %}
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="sparkles"></i> Tests de personnalité gratuits</h2>
        <p class="ks-muted">{{ form_help(form.freeTests) }}</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .6rem 1.25rem; margin-top: .9rem;">
            {% for choice in form.freeTests %}
                <label style="display: flex; gap: .55rem; align-items: center; font-size: .92rem;">{{ form_widget(choice) }} {{ choice.vars.label }}</label>
            {% endfor %}
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="lightbulb"></i> Messages « Saviez-vous que… »</h2>
        <p class="ks-muted">{{ form_help(form.enabledTips) }}</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: .6rem 1.25rem; margin-top: .9rem;">
            {% for choice in form.enabledTips %}
                <label style="display: flex; gap: .55rem; align-items: center; font-size: .92rem;">{{ form_widget(choice) }} {{ choice.vars.label }}</label>
            {% endfor %}
        </div>
    </section>

    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="compass"></i> Texte proposé aux nouveaux membres</h2>
        <div style="margin-top: .9rem;">{{ m.field(form.defaultPurposeStatement, true) }}</div>
    </section>

    <div class="ks-sticky-actions" style="background: linear-gradient(to top, var(--bg) 75%, transparent);">
        <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="save"></i> Enregistrer les modifications</button>
    </div>
</div>
{{ form_end(form) }}
{% endblock %}
