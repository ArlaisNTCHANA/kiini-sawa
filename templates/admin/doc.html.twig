<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Documentation Technique - {{ currentPage|capitalize }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- HighlightJS for Code Highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    
    <style>
        :root {
            --bg-color: #0b0f19;
            --sidebar-bg: rgba(17, 24, 39, 0.7);
            --content-bg: rgba(22, 30, 49, 0.4);
            --accent-color: #6366f1;
            --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --text-color: #cbd5e1;
            --text-heading: #f8fafc;
            --border-color: rgba(255, 255, 255, 0.08);
            --sidebar-width: 280px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.12) 0px, transparent 50%);
        }

        /* Sidebar Styling */
        aside {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-right: 1px solid var(--border-color);
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 10;
        }

        .logo {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--text-heading);
            margin-bottom: 2.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .logo span {
            font-size: 0.8rem;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            border: 1px solid rgba(99, 102, 241, 0.3);
            color: #818cf8;
            -webkit-text-fill-color: #818cf8;
        }

        nav {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .nav-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .nav-item {
            display: block;
            padding: 0.75rem 1rem;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .nav-item:hover {
            color: var(--text-heading);
            background-color: rgba(255, 255, 255, 0.03);
            border-color: rgba(255, 255, 255, 0.02);
        }

        .nav-item.active {
            color: #ffffff;
            background: var(--accent-gradient);
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        /* Main Content Container */
        main {
            margin-left: var(--sidebar-width);
            flex-grow: 1;
            padding: 3rem 4rem;
            max-width: 1200px;
        }

        /* Markdown Styles */
        .markdown-body {
            background-color: var(--content-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 3rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .markdown-body h1 {
            font-size: 2.2rem;
            color: var(--text-heading);
            margin-bottom: 1.5rem;
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 1rem;
        }

        .markdown-body h2 {
            font-size: 1.5rem;
            color: var(--text-heading);
            margin-top: 2rem;
            margin-bottom: 1rem;
            font-weight: 600;
        }

        .markdown-body h3 {
            font-size: 1.2rem;
            color: var(--text-heading);
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
            font-weight: 600;
        }

        .markdown-body p {
            line-height: 1.7;
            margin-bottom: 1.25rem;
            font-size: 1rem;
        }

        .markdown-body ul, .markdown-body ol {
            margin-bottom: 1.25rem;
            padding-left: 1.5rem;
        }

        .markdown-body li {
            margin-bottom: 0.5rem;
            line-height: 1.6;
        }

        .markdown-body a {
            color: #818cf8;
            text-decoration: none;
            border-bottom: 1px dashed rgba(129, 140, 248, 0.4);
            transition: all 0.2s ease;
        }

        .markdown-body a:hover {
            color: #a5b4fc;
            border-bottom-color: #a5b4fc;
        }

        .markdown-body code {
            font-family: 'Fira Code', monospace;
            background-color: rgba(255, 255, 255, 0.06);
            padding: 0.2rem 0.4rem;
            border-radius: 6px;
            font-size: 0.9em;
            color: #f43f5e;
        }

        .markdown-body pre {
            margin-bottom: 1.5rem;
            margin-top: 1rem;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .markdown-body pre code {
            display: block;
            padding: 1.5rem;
            overflow-x: auto;
            background-color: #0d1117 !important;
            color: #c9d1d9;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .markdown-body hr {
            border: 0;
            height: 1px;
            background-color: var(--border-color);
            margin: 2.5rem 0;
        }

        .markdown-body blockquote {
            border-left: 4px solid var(--accent-color);
            padding: 0.75rem 1.5rem;
            background-color: rgba(99, 102, 241, 0.05);
            border-radius: 0 8px 8px 0;
            margin-bottom: 1.5rem;
            font-style: italic;
        }

        .markdown-body blockquote p {
            margin-bottom: 0;
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            body {
                flex-direction: column;
            }
            aside {
                width: 100%;
                position: relative;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
                padding: 1.5rem;
            }
            main {
                margin-left: 0;
                padding: 1.5rem;
                width: 100%;
            }
            .markdown-body {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>

    <aside>
        <div class="logo">
            Kiini Sawa <span>DevPortal</span>
        </div>
        
        <div class="nav-title">Documentation</div>
        <nav>
            {% for item in menu %}
                <a href="{{ path('admin_doc', {page: item.slug}) }}" class="nav-item {% if item.active %}active{% endif %}">
                    {{ item.title }}
                </a>
            {% endfor %}
        </nav>
    </aside>

    <main>
        <article class="markdown-body">
            {{ content|raw }}
        </article>
    </main>

    <!-- Syntax Highlighting Scripts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
</body>
</html>
