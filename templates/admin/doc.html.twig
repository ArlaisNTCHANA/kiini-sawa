{% extends 'admin/layout.html.twig' %}

{% set current = menu|filter(i => i.active)|first %}
{% block title %}{{ current ? current.title : 'Documentation technique' }}{% endblock %}
{% block page_title %}Documentation technique{% endblock %}
{% block page_lead %}Les notes de travail du projet (dossier docs/), surtout utiles aux développeurs et aux IA qui reprennent le travail.{% endblock %}
{% block crumbs %}{% if current and currentPage != 'index' %}<span aria-hidden="true">›</span><span aria-current="page">{{ current.title }}</span>{% endif %}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('lib/highlight-github-dark-11.9.0.min.css') }}">
<style>
    .doc-cols { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 1.25rem; align-items: start; }
    .doc-nav { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow-y: auto; padding: .75rem; }
    .doc-nav a { display: block; padding: .45rem .6rem; border-radius: var(--r-sm); font-size: .84rem; line-height: 1.35; color: var(--fg-light); text-decoration: none; }
    .doc-nav a:hover { background: var(--bg-alt); color: var(--primary); }
    .doc-nav a.is-active { background: var(--primary-soft); color: var(--primary-dark); font-weight: 700; }
    .doc-pick { display: none; }
    .markdown-body { line-height: 1.7; color: var(--fg-light); overflow-wrap: anywhere; }
    .markdown-body h1, .markdown-body h2, .markdown-body h3, .markdown-body h4 { font-family: var(--font-serif); color: var(--primary); line-height: 1.3; margin: 1.6rem 0 .7rem; }
    .markdown-body h1 { font-size: 1.8rem; margin-top: 0; padding-bottom: .6rem; border-bottom: 1px solid var(--border); }
    .markdown-body h2 { font-size: 1.4rem; }
    .markdown-body h3 { font-size: 1.15rem; color: var(--fg); }
    .markdown-body p, .markdown-body ul, .markdown-body ol, .markdown-body table, .markdown-body pre, .markdown-body blockquote { margin: 0 0 1rem; }
    .markdown-body ul, .markdown-body ol { padding-left: 1.4rem; }
    .markdown-body li { margin: .25rem 0; }
    .markdown-body a { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; }
    .markdown-body code { font-size: .85em; background: var(--bg-alt); color: var(--primary-dark); padding: .1rem .35rem; border-radius: 4px; }
    .markdown-body pre { background: var(--primary-dark); border-radius: var(--r-md); padding: 1rem; overflow-x: auto; }
    .markdown-body pre code { background: none; color: inherit; padding: 0; font-size: .82rem; }
    .markdown-body blockquote { border-left: 4px solid var(--gold); background: var(--gold-soft); padding: .7rem 1rem; border-radius: 0 var(--r-sm) var(--r-sm) 0; }
    .markdown-body blockquote p:last-child { margin-bottom: 0; }
    .markdown-body table { display: block; overflow-x: auto; border-collapse: collapse; font-size: .88rem; }
    .markdown-body th, .markdown-body td { border: 1px solid var(--border); padding: .45rem .7rem; text-align: left; vertical-align: top; }
    .markdown-body th { background: var(--bg-alt); color: var(--fg); }
    .markdown-body hr { border: 0; border-top: 1px solid var(--border); margin: 1.5rem 0; }
    .markdown-body img { max-width: 100%; }
    @media (max-width: 1023px) {
        .doc-cols { grid-template-columns: 1fr; }
        .doc-nav { display: none; }
        .doc-pick { display: block; }
    }
</style>
{% endblock %}

{% block content %}
<div class="doc-cols">
    <nav class="ks-card ks-card--flat doc-nav" aria-label="Pages de la documentation">
        {% for item in menu %}
            <a href="{{ path('admin_doc', {page: item.slug}) }}" class="{{ item.active ? 'is-active' }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {% endfor %}
    </nav>
    <div class="ks-stack">
        <form class="doc-pick ks-field" method="get" onsubmit="return false;">
            <label class="ks-label" for="doc-pick">Choisir une page</label>
            <select id="doc-pick" class="ks-input" onchange="window.location.href = this.value;">
                {% for item in menu %}<option value="{{ path('admin_doc', {page: item.slug}) }}" {{ item.active ? 'selected' }}>{{ item.title }}</option>{% endfor %}
            </select>
        </form>
        <article class="ks-card markdown-body">
            {{ content|raw }}
        </article>
    </div>
</div>
<script src="{{ asset('lib/highlight-11.9.0.min.js') }}"></script>
<script>if (window.hljs) hljs.highlightAll();</script>
{% endblock %}
