{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block stylesheets %}
<style>
    /* ===== Dashboard Grid ===== */
    .dash-greeting {
        margin-bottom: 28px;
    }
    .dash-greeting h2 {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .dash-greeting p {
        color: var(--text-secondary);
        font-size: 14px;
    }

    /* --- Stat Cards Grid --- */
    .dash-stats {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px;
        position: relative;
        overflow: hidden;
        transition: all var(--transition);
        backdrop-filter: blur(8px);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
        background: var(--accent-gradient);
        opacity: 0;
        transition: opacity var(--transition);
    }

    .stat-card:hover {
        border-color: var(--border-active);
        background: var(--bg-card-hover);
        transform: translateY(-2px);
        box-shadow: var(--shadow-glow);
    }

    .stat-card:hover::before { opacity: 1; }

    .stat-card__icon {
        width: 40px; height: 40px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        font-size: 18px;
    }

    .stat-card__icon--indigo { background: rgba(99, 102, 241, 0.15); color: #818cf8; }
    .stat-card__icon--violet { background: rgba(139, 92, 246, 0.15); color: #a78bfa; }
    .stat-card__icon--fuchsia { background: rgba(168, 85, 247, 0.15); color: #c084fc; }
    .stat-card__icon--pink { background: rgba(236, 72, 153, 0.15); color: #f472b6; }
    .stat-card__icon--emerald { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .stat-card__icon--amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
    .stat-card__icon--cyan { background: rgba(6, 182, 212, 0.15); color: #22d3ee; }
    .stat-card__icon--rose { background: rgba(244, 63, 94, 0.15); color: #fb7185; }

    .stat-card__value {
        font-size: 28px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 4px;
        background: linear-gradient(135deg, var(--text-primary) 0%, var(--text-secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .stat-card__label {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* --- Charts Section --- */
    .dash-charts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 28px;
    }

    .chart-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        backdrop-filter: blur(8px);
    }

    .chart-card__title {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .chart-card__title i {
        color: var(--accent-light);
        width: 18px; height: 18px;
    }

    .chart-card__canvas {
        position: relative;
        height: 260px;
    }

    /* --- Plans Breakdown --- */
    .dash-plans {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }

    .plan-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        transition: all var(--transition);
    }

    .plan-pill:hover {
        border-color: var(--border-active);
        transform: translateY(-1px);
    }

    .plan-pill__dot {
        width: 10px; height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .plan-pill__info {
        flex: 1;
        min-width: 0;
    }

    .plan-pill__name {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .plan-pill__count {
        font-size: 20px;
        font-weight: 700;
    }

    /* --- Recent Users Table --- */
    .dash-table-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        backdrop-filter: blur(8px);
    }

    .dash-table-card__title {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dash-table-card__title i {
        color: var(--accent-light);
        width: 18px; height: 18px;
    }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dash-table th {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        padding: 8px 12px;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }

    .dash-table td {
        padding: 12px;
        font-size: 13px;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border);
    }

    .dash-table tr:last-child td { border-bottom: none; }

    .dash-table tr:hover td {
        color: var(--text-primary);
        background: rgba(99, 102, 241, 0.03);
    }

    .dash-table__email {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dash-table__avatar {
        width: 30px; height: 30px;
        border-radius: 50%;
        background: var(--accent-gradient-subtle);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 11px;
        color: var(--accent-light);
        flex-shrink: 0;
    }

    .badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge--admin {
        background: rgba(99, 102, 241, 0.15);
        color: #818cf8;
    }

    .badge--user {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
    }

    /* --- Responsive --- */
    @media (max-width: 1024px) {
        .dash-charts { grid-template-columns: 1fr; }
        .dash-plans { grid-template-columns: repeat(3, 1fr); }
    }

    @media (max-width: 640px) {
        .dash-stats { grid-template-columns: repeat(2, 1fr); }
        .dash-plans { grid-template-columns: 1fr 1fr; }
    }

    /* --- Fade-in Animation --- */
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .animate-in {
        animation: fadeUp 0.5s ease both;
    }

    .animate-in:nth-child(1) { animation-delay: 0s; }
    .animate-in:nth-child(2) { animation-delay: 0.05s; }
    .animate-in:nth-child(3) { animation-delay: 0.1s; }
    .animate-in:nth-child(4) { animation-delay: 0.15s; }
    .animate-in:nth-child(5) { animation-delay: 0.2s; }
    .animate-in:nth-child(6) { animation-delay: 0.25s; }
    .animate-in:nth-child(7) { animation-delay: 0.3s; }
    .animate-in:nth-child(8) { animation-delay: 0.35s; }
</style>
{% endblock %}

{% block content %}
    {# ===== Greeting ===== #}
    <div class="dash-greeting animate-in">
        <h2>Bienvenue, {{ app.user.email }} 👋</h2>
        <p>Voici un aperçu de l'activité sur la plateforme Kiini Sawa.</p>
    </div>

    {# ===== Stat Cards ===== #}
    <section class="dash-stats" aria-label="Métriques clés">
        <div class="stat-card animate-in" id="stat-users">
            <div class="stat-card__icon stat-card__icon--indigo">
                <i data-lucide="users"></i>
            </div>
            <div class="stat-card__value">{{ totalUsers }}</div>
            <div class="stat-card__label">Utilisateurs</div>
        </div>

        <div class="stat-card animate-in" id="stat-plans">
            <div class="stat-card__icon stat-card__icon--violet">
                <i data-lucide="layers"></i>
            </div>
            <div class="stat-card__value">{{ totalPlans }}</div>
            <div class="stat-card__label">Plans actifs</div>
        </div>

        <div class="stat-card animate-in" id="stat-habits">
            <div class="stat-card__icon stat-card__icon--fuchsia">
                <i data-lucide="repeat"></i>
            </div>
            <div class="stat-card__value">{{ totalHabits }}</div>
            <div class="stat-card__label">Rituels</div>
        </div>

        <div class="stat-card animate-in" id="stat-habit-logs">
            <div class="stat-card__icon stat-card__icon--emerald">
                <i data-lucide="check-circle"></i>
            </div>
            <div class="stat-card__value">{{ totalHabitLogs }}</div>
            <div class="stat-card__label">Logs d'habitudes</div>
        </div>

        <div class="stat-card animate-in" id="stat-goals">
            <div class="stat-card__icon stat-card__icon--amber">
                <i data-lucide="target"></i>
            </div>
            <div class="stat-card__value">{{ totalGrowthGoals }}</div>
            <div class="stat-card__label">Objectifs croissance</div>
        </div>

        <div class="stat-card animate-in" id="stat-journal">
            <div class="stat-card__icon stat-card__icon--cyan">
                <i data-lucide="book-open"></i>
            </div>
            <div class="stat-card__value">{{ totalReflectionNotes }}</div>
            <div class="stat-card__label">Notes de réflexion</div>
        </div>

        <div class="stat-card animate-in" id="stat-tests">
            <div class="stat-card__icon stat-card__icon--pink">
                <i data-lucide="brain"></i>
            </div>
            <div class="stat-card__value">{{ totalTests }}</div>
            <div class="stat-card__label">Tests passés</div>
        </div>

        <div class="stat-card animate-in" id="stat-challenges">
            <div class="stat-card__icon stat-card__icon--rose">
                <i data-lucide="trophy"></i>
            </div>
            <div class="stat-card__value">{{ totalChallenges }}</div>
            <div class="stat-card__label">Défis</div>
        </div>
    </section>

    {# ===== Plans Breakdown ===== #}
    <section class="dash-plans" aria-label="Distribution des plans">
        {% set plan_colors = ['#6366f1', '#8b5cf6', '#a855f7', '#c084fc', '#e879f9'] %}
        {% set plan_names = ['Vie', 'Croissance', 'PDP', 'Hygiène', 'Transmission'] %}
        {% set plan_keys  = ['vie', 'croissance', 'pdp', 'hygiene', 'transmission'] %}

        {% for i in 0..4 %}
        <div class="plan-pill animate-in">
            <div class="plan-pill__dot" style="background: {{ plan_colors[i] }};"></div>
            <div class="plan-pill__info">
                <div class="plan-pill__name">{{ plan_names[i] }}</div>
                <div class="plan-pill__count">{{ plansData[plan_keys[i]] }}</div>
            </div>
        </div>
        {% endfor %}
    </section>

    {# ===== Charts ===== #}
    <section class="dash-charts" aria-label="Graphiques">
        <div class="chart-card animate-in">
            <div class="chart-card__title">
                <i data-lucide="pie-chart"></i>
                Répartition des Plans
            </div>
            <div class="chart-card__canvas">
                <canvas
                    data-controller="chart"
                    data-chart-type-value="doughnut"
                    data-chart-data-value='{{ plansChartData|json_encode|raw }}'
                ></canvas>
            </div>
        </div>

        <div class="chart-card animate-in">
            <div class="chart-card__title">
                <i data-lucide="activity"></i>
                Activité des rituels (6 mois)
            </div>
            <div class="chart-card__canvas">
                <canvas
                    data-controller="chart"
                    data-chart-type-value="line"
                    data-chart-data-value='{{ activityChartData|json_encode|raw }}'
                ></canvas>
            </div>
        </div>
    </section>

    {# ===== Recent Users Table ===== #}
    <section class="dash-table-card animate-in" aria-label="Utilisateurs récents">
        <div class="dash-table-card__title">
            <i data-lucide="user-plus"></i>
            Derniers utilisateurs inscrits
        </div>
        <table class="dash-table" id="recent-users-table">
            <thead>
                <tr>
                    <th>Utilisateur</th>
                    <th>Rôle</th>
                    <th>ID</th>
                </tr>
            </thead>
            <tbody>
                {% for user in recentUsers %}
                <tr>
                    <td>
                        <div class="dash-table__email">
                            <div class="dash-table__avatar">{{ user.email|slice(0,1)|upper }}</div>
                            {{ user.email }}
                        </div>
                    </td>
                    <td>
                        {% if 'ROLE_ADMIN' in user.roles %}
                            <span class="badge badge--admin">Admin</span>
                        {% else %}
                            <span class="badge badge--user">User</span>
                        {% endif %}
                    </td>
                    <td>#{{ user.id }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="3" style="text-align:center; color: var(--text-muted);">Aucun utilisateur</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
