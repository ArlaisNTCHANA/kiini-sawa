{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Bonjour {{ app.user.displayName }}{% endblock %}
{% block page_lead %}Ce qui vous attend aujourd'hui, puis la santé de KIINI SAWA en un coup d'œil.{% endblock %}

{% block stylesheets %}
<style>
    .dash-cols { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.25rem; }
    .dash-chart { position: relative; height: 260px; }
    .dash-plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; }
    .dash-plan { display: flex; align-items: center; gap: .6rem; padding: .7rem .9rem; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--card-bg); }
    .dash-plan__dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .dash-plan__name { font-size: .8rem; color: var(--fg-muted); line-height: 1.3; display: block; }
    .dash-plan__count { font-weight: 800; color: var(--fg); font-variant-numeric: tabular-nums; }
    @media (max-width: 900px) { .dash-cols { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block content %}
{% set todo = admin_todo() %}
<div class="ks-stack">

    {# ===== À traiter ===== #}
    <section class="ks-card" aria-labelledby="todo-title">
        <h2 class="ks-card__title" id="todo-title"><i data-lucide="inbox"></i> À traiter</h2>
        {% set tasks = [
            {n: todo.transactions, icon: 'wallet', one: 'paiement à vérifier', many: 'paiements à vérifier', hint: 'Vérifiez la réception, puis validez : PRO s\'active et le reçu part.', url: path('admin_payments')},
            {n: todo.orders, icon: 'building-2', one: 'commande de places à vérifier', many: 'commandes de places à vérifier', hint: 'Organisations qui attendent leurs places.', url: path('admin_payments') ~ '#commandes'},
            {n: todo.feedback, icon: 'message-square-heart', one: 'avis à lire', many: 'avis à lire', hint: 'Les messages envoyés depuis l\'application.', url: path('admin_app_feedback')},
            {n: todo.drafts, icon: 'file-pen-line', one: 'texte du site en brouillon', many: 'textes du site en brouillon', hint: 'Pas encore en ligne : relisez-les puis publiez-les.', url: path('admin_site_texts', {etat: 'draft'})},
        ] %}
        {% set open = tasks|filter(t => t.n > 0) %}
        <div class="ks-todo">
            {% for t in open %}
                <a class="ks-todo__item" href="{{ t.url }}">
                    <span class="ks-todo__icon"><i data-lucide="{{ t.icon }}"></i></span>
                    <span class="ks-todo__text"><strong>{{ t.n }} {{ t.n > 1 ? t.many : t.one }}</strong><small>{{ t.hint }}</small></span>
                    <i data-lucide="chevron-right" class="ks-ico"></i>
                </a>
            {% else %}
                <div class="ks-todo__item ks-todo__item--done">
                    <span class="ks-todo__icon"><i data-lucide="check"></i></span>
                    <span class="ks-todo__text"><strong>Tout est à jour.</strong><small>Aucun paiement, aucune commande, aucun avis ni brouillon ne vous attend.</small></span>
                </div>
            {% endfor %}
        </div>
    </section>

    {# ===== Les membres ===== #}
    <section aria-labelledby="members-title">
        <h2 class="ks-section-title" id="members-title" style="margin-top: .5rem;">Les membres</h2>
        <div class="ks-stat-grid">
            <div class="ks-stat" id="stat-users"><div class="ks-stat__value">{{ totalUsers }}</div><div class="ks-stat__label">comptes au total</div></div>
            <div class="ks-stat"><div class="ks-stat__value">{{ members.new7 }}</div><div class="ks-stat__label">nouveaux ces 7 derniers jours</div></div>
            <div class="ks-stat"><div class="ks-stat__value">{{ members.active30 }}</div><div class="ks-stat__label">actifs ces 30 derniers jours</div></div>
            <div class="ks-stat"><div class="ks-stat__value">{{ members.pro }}</div><div class="ks-stat__label">abonnés PRO payants</div></div>
            <div class="ks-stat"><div class="ks-stat__value">{{ members.trial }}</div><div class="ks-stat__label">essais PRO en cours</div></div>
        </div>
    </section>

    {# ===== Ce que les membres font ===== #}
    <section aria-labelledby="usage-title">
        <h2 class="ks-section-title" id="usage-title" style="margin-top: .5rem;">Ce que les membres construisent</h2>
        <div class="ks-stat-grid">
            <div class="ks-stat" id="stat-plans"><div class="ks-stat__value">{{ totalPlans }}</div><div class="ks-stat__label">plans commencés</div></div>
            <div class="ks-stat" id="stat-habits"><div class="ks-stat__value">{{ totalHabits }}</div><div class="ks-stat__label">rituels</div></div>
            <div class="ks-stat" id="stat-habit-logs"><div class="ks-stat__value">{{ totalHabitLogs }}</div><div class="ks-stat__label">rituels cochés</div></div>
            <div class="ks-stat" id="stat-goals"><div class="ks-stat__value">{{ totalGrowthGoals }}</div><div class="ks-stat__label">objectifs du Plan de Croissance</div></div>
            <div class="ks-stat" id="stat-journal"><div class="ks-stat__value">{{ totalReflectionNotes }}</div><div class="ks-stat__label">notes de réflexion</div></div>
            <div class="ks-stat" id="stat-tests"><div class="ks-stat__value">{{ totalTests }}</div><div class="ks-stat__label">tests passés</div></div>
            <div class="ks-stat" id="stat-challenges"><div class="ks-stat__value">{{ totalChallenges }}</div><div class="ks-stat__label">défis collectifs</div></div>
        </div>
    </section>

    {# ===== Les plans ===== #}
    <div class="dash-cols">
        <section class="ks-card" aria-labelledby="plans-title">
            <h2 class="ks-card__title" id="plans-title"><i data-lucide="pie-chart"></i> Plans commencés, par plan</h2>
            <div class="dash-plans" style="margin: .75rem 0 1rem;">
                {% for i, label in plansChartData.labels %}
                    <div class="dash-plan">
                        <span class="dash-plan__dot" style="background: {{ ['var(--plan-vie)', 'var(--plan-croissance)', 'var(--plan-developpement)', 'var(--plan-hygiene)', 'var(--plan-intendance)', 'var(--plan-transmission)'][i] }};"></span>
                        <span><span class="dash-plan__name">{{ label }}</span><span class="dash-plan__count">{{ plansChartData.data[i] }}</span></span>
                    </div>
                {% endfor %}
            </div>
            <div class="dash-chart">
                <canvas data-controller="chart" data-chart-type-value="doughnut" data-chart-data-value='{{ plansChartData|json_safe }}' aria-label="Répartition des plans commencés"></canvas>
            </div>
        </section>
        <section class="ks-card" aria-labelledby="activity-title">
            <h2 class="ks-card__title" id="activity-title"><i data-lucide="activity"></i> Rituels cochés, mois par mois</h2>
            <p class="ks-muted">Les six derniers mois.</p>
            <div class="dash-chart" style="margin-top: 1rem;">
                <canvas data-controller="chart" data-chart-type-value="line" data-chart-data-value='{{ activityChartData|json_safe }}' aria-label="Rituels cochés sur six mois"></canvas>
            </div>
        </section>
    </div>

    {# ===== Derniers inscrits ===== #}
    <section class="ks-card" aria-labelledby="recent-title">
        <div class="ks-card__head">
            <h2 class="ks-card__title" id="recent-title"><i data-lucide="user-plus"></i> Derniers inscrits</h2>
            <a class="ks-btn ks-btn--ghost ks-btn--sm" href="{{ path('admin_users') }}">Voir tous les membres →</a>
        </div>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards" id="recent-users-table">
                <thead><tr><th>Membre</th><th>Rôle</th><th>Inscrit le</th><th class="is-num">N°</th></tr></thead>
                <tbody>
                {% for user in recentUsers %}
                    <tr>
                        <td><strong>{{ user.displayName }}</strong><br><span class="ks-small">{{ user.email }}</span></td>
                        <td data-label="Rôle">{% if 'ROLE_ADMIN' in user.roles %}<span class="ks-badge ks-badge--gold">Administrateur</span>{% else %}<span class="ks-badge ks-badge--muted">Membre</span>{% endif %}</td>
                        <td data-label="Inscrit le">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '—' }}</td>
                        <td data-label="N°" class="is-num">{{ user.id }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Personne ne s'est encore inscrit.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
