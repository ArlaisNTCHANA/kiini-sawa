{# Page d'erreur de production (codes 403, 404, 500…). Sobre et autonome : elle ne dépend d'aucune donnée. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KIINI SAWA</title>
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">
    {# Même fond clair, mêmes polices que l'application (contre-audit visuel du 25/11/2026) #}
    <style>
        body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; font-family: Inter, -apple-system, 'Segoe UI', Arial, sans-serif; background: #F7F8F5; color: #374238; text-align: center; padding: 1.5rem; }
        .card { max-width: 440px; background: #fff; border: 1px solid #E1E6DF; border-radius: 20px; padding: 2.5rem 2rem; box-shadow: 0 18px 40px -18px rgba(31, 77, 58, .28); }
        h1 { font-family: 'Playfair Display', Georgia, serif; color: #1F4D3A; font-size: 1.8rem; font-weight: 600; margin: .5rem 0; }
        .code { font-size: .75rem; letter-spacing: .14em; color: #9A6B12; font-weight: 700; }
        .home { display: inline-block; margin-top: 1.5rem; background: #2E6B53; color: #fff; padding: .8rem 1.4rem; border-radius: 12px; font-weight: 700; text-decoration: none; }
        .home:hover { background: #1F4D3A; }
    </style>
</head>
<body>
    {% include 'shared/_logo.html.twig' only %}
    <div class="card">
        <div class="code">ERREUR {{ status_code }}</div>
        {% if status_code == 404 %}
            <h1>Cette page n'existe pas</h1>
            <p>Le lien est peut-être ancien ou mal recopié.</p>
        {% elseif status_code == 403 %}
            <h1>Accès réservé</h1>
            <p>Cette page n'est pas accessible avec votre compte.</p>
        {% else %}
            <h1>Un imprévu s'est produit</h1>
            <p>Nous avons été prévenus et nous corrigeons cela. Réessayez dans quelques instants.</p>
        {% endif %}
        <a class="home" href="/">Revenir à l'accueil</a>
    </div>
</body>
</html>
