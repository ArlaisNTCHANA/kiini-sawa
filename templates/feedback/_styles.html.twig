    .fb-past li:first-child { border-top: 0; }
    /* Page du membre : toutes les cartes ont la largeur de la page */
    .fb-section { margin-bottom: 1rem; }
    .fb-section .ks-section-title { margin-top: 0; display: flex; align-items: center; gap: .5rem; }
    .fb-section .ks-section-title svg { width: 20px; height: 20px; color: var(--gold); flex: none; }
    .fb-section .ks-eyebrow { margin-bottom: .3rem; }
    .fb-text { color: var(--fg-light); line-height: 1.65; margin: 0 0 1.1rem; }
    .fb-quote { margin: 0 0 1.1rem; padding: .7rem 1rem; border-left: 3px solid var(--gold); background: var(--primary-soft); border-radius: 0 12px 12px 0; font-family: var(--font-serif); font-style: italic; color: var(--fg-light); line-height: 1.55; }
    .fb-quote cite { display: block; margin-top: .3rem; font-family: var(--font-sans); font-style: normal; font-size: .78rem; color: var(--fg-muted); }
    .fb-tips { list-style: none; padding: 0; margin: 0; display: grid; gap: .9rem; }
