    @media (max-width: 480px) { .fb-invite__actions { justify-content: center; } .fb-invite__actions .ks-btn { width: 100%; justify-content: center; } }
    .fb-invite__link { font-size: .9rem; color: var(--primary); font-weight: 600; }
</style>
