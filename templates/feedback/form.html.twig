{% extends 'base.html.twig' %}

{% block title %}Votre regard sur {{ firstName }}{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex"><meta property="og:title" content="{{ firstName }} aimerait votre regard"><meta property="og:description" content="3 minutes pour dire à {{ firstName }} les qualités que vous voyez en lui ou en elle."><meta property="og:image" content="{{ absolute_url('/icons/icon-512.png') }}">{% endblock %}

{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' %}{% endif %}
<div class="ks-page ks-page--narrow">
    {% include 'shared/_page_header.html.twig' with {
        eyebrow: 'Feedback nourricier', icon: 'heart',
        title: firstName ~ ' aimerait votre regard',
        lead: firstName ~ ' avance sur son Plan de Vie avec KIINI SAWA et vous demande, en toute confiance, ce que vous voyez en lui ou en elle. 3 minutes. ' ~ (request.forceRealName ? 'Votre prénom sera indiqué.' : 'Vos réponses sont anonymes.'),
    } %}
    {% if alreadyDone %}
        <p class="ks-alert ks-alert--success">Vous avez déjà répondu. Merci pour votre bienveillance !</p>
    {% else %}
    {% for e in errors %}<p class="ks-alert ks-alert--danger" style="margin-bottom: .6rem;">{{ e }}</p>{% endfor %}
    <form method="post" class="ks-card" x-data="{ picked: {{ data.qualities|length }} }">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback_form') }}">
        <div style="position: absolute; left: -9999px;" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>

        <div class="ks-field" style="margin-bottom: 1.25rem;">
            <label class="ks-label" for="relationship">Vous êtes…</label>
            <select class="ks-input" id="relationship" name="relationship">{% for k, v in relationships %}<option value="{{ k }}" {{ data.relationship == k ? 'selected' }}>{{ v }}</option>{% endfor %}</select>
        </div>

        <p class="ks-label" style="margin-bottom: .5rem;">Les qualités que vous voyez en {{ firstName }} ({{ maxQualities }} au plus)</p>
        <div style="display: flex; flex-wrap: wrap; gap: .45rem; margin-bottom: 1.25rem;">
            {% for q in qualities %}
                <label style="cursor: pointer;">
                    <input type="checkbox" name="qualities[]" value="{{ q }}" {{ q in data.qualities ? 'checked' }} style="position: absolute; opacity: 0;"
                           @change="picked += $event.target.checked ? 1 : -1; if (picked > {{ maxQualities }}) { $event.target.checked = false; picked--; }">
                    <span class="ks-badge ks-badge--muted" style="font-size: .85rem; padding: .35rem .8rem;" :class="$el.previousElementSibling.checked ? '' : 'ks-badge--muted'" x-effect="picked; $el.className = $el.previousElementSibling.checked ? 'ks-badge' : 'ks-badge ks-badge--muted'">{{ q }}</span>
                </label>
            {% endfor %}
        </div>

        <div class="ks-field" style="margin-bottom: 1.25rem;">
            <label class="ks-label" for="strengths">Ce que {{ firstName }} fait de mieux</label>
            <textarea class="ks-input" id="strengths" name="strengths" rows="3" required placeholder="Un talent, une façon d'être, un moment où vous l'avez vu(e) briller…">{{ data.strengths }}</textarea>
        </div>
        <div class="ks-field" style="margin-bottom: 1.25rem;">
            <label class="ks-label" for="improvements">Un point où {{ firstName }} gagnerait à grandir (facultatif)</label>
            <textarea class="ks-input" id="improvements" name="improvements" rows="3" placeholder="Avec bienveillance : ce qui l'aiderait à aller plus loin.">{{ data.improvements }}</textarea>
        </div>
        <div class="ks-field" style="margin-bottom: 1.25rem;">
            <label class="ks-label" for="name">Votre prénom {{ request.forceRealName ? '' : '(facultatif : laissez vide pour rester anonyme)' }}</label>
            <input class="ks-input" id="name" name="name" value="{{ data.name }}" maxlength="100" {{ request.forceRealName ? 'required' }}>
        </div>
        <button type="submit" class="ks-btn ks-btn--primary">Envoyer mon regard</button>
    </form>
    {% endif %}
</div>
{% endblock %}
