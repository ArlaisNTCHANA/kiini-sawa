{% extends 'base.html.twig' %}

{% block title %}Feedback nourricier{% endblock %}

{% block body %}
{% include 'feedback/_styles.html.twig' %}
<div class="ks-page ks-page--narrow fb-member">
    {% include 'shared/_page_header.html.twig' with {
        eyebrow: 'Mes tests · le regard des autres', icon: 'users',
        title: 'Feedback nourricier',
        lead: t('feedback.membre.intro', 'Les tests disent comment vous vous voyez ; vos proches voient parfois ce que vous ne voyez pas. Demandez-leur, en toute bienveillance.'),
        back: {url: path('app_personality_index'), label: 'Mes tests'},
    } %}

    {% set createForm %}
        <form method="post" action="{{ path('app_feedback_open') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}">
            {% if needsFirstName %}
                <div class="ks-field" style="margin-bottom: 1rem;">
                    <label class="ks-label" for="firstName">{{ t('feedback.membre.prenom', 'Votre prénom, tel que vos proches le verront') }}</label>
                    <input class="ks-input" id="firstName" name="firstName" maxlength="60" required autocomplete="given-name" style="max-width: 320px;">
                </div>
            {% endif %}
            <label style="display: flex; gap: .6rem; align-items: flex-start; margin-bottom: 1rem; color: var(--fg-light);"><input type="checkbox" name="forceRealName" value="1" style="margin-top: .3rem; accent-color: var(--primary);"> {{ t('feedback.membre.option_prenom', 'Demander à chaque personne d\'indiquer son prénom (sinon, les réponses sont anonymes, ce qui libère souvent la parole)') }}</label>
            <button type="submit" class="ks-btn ks-btn--{{ request and canExtend ? 'secondary' : 'primary' }}"><i data-lucide="link"></i> {{ request ? t('feedback.membre.nouveau', 'Créer un nouveau lien') : t('feedback.membre.creer', 'Créer mon lien') }}</button>
            <p style="font-size: .85rem; color: var(--fg-muted); margin: .6rem 0 0;">{{ t('feedback.membre.duree', 'Le lien reste ouvert une semaine. Vous pourrez le prolonger.') }}</p>
        </form>
    {% endset %}

    {# Les explications : les trois témoins du livre, puis le mode d'emploi. Placées avant le bouton pour une première demande, après les résultats ensuite. #}
    {% set explain %}
        <section class="ks-card fb-section" id="trois-temoins">
            <p class="ks-eyebrow">{{ t('feedback.membre.temoins_surtitre', 'Le livre KIINI, chapitre 12 · Confirmations') }}</p>
            <h2 class="ks-section-title">{{ t('feedback.membre.temoins_titre', 'Pourquoi demander le regard des autres ?') }}</h2>
            <p class="fb-text">{{ t('feedback.membre.temoins_intro', 'Nous avons tous tendance à nous voir plus grands, ou plus petits, que nous ne le sommes. Le livre KIINI, à l\'origine de KIINI SAWA, s\'appuie sur un principe biblique : « Toute affaire se réglera sur la déclaration de deux ou de trois témoins » (2 Corinthiens 13:1). Ce que vous croyez de vous-même devient une certitude quand **trois témoins** vont dans le même sens. Le feedback nourricier est le troisième : touchez chaque cercle pour voir ce qu\'il apporte.', 'inline') }}</p>
            {% include 'feedback/_temoins.html.twig' with {mode: 'membre'} only %}
        </section>

        <section class="ks-card fb-section">
            <h2 class="ks-section-title"><i data-lucide="user-check" aria-hidden="true"></i> {{ t('feedback.membre.choisir_titre', 'Bien choisir les personnes') }}</h2>
            <blockquote class="fb-quote">{{ t('feedback.membre.choisir_citation', '« Choisis des personnes qui t\'aiment assez pour te dire la vérité, et qui t\'ont vu agir. »') }}<cite>{{ t('feedback.membre.choisir_source', 'Le livre KIINI, chapitre 12') }}</cite></blockquote>
            <ul class="fb-tips">
                <li><i data-lucide="eye" aria-hidden="true"></i><div><strong>{{ t('feedback.membre.choisir_1_titre', 'Qui vous ont vu agir') }}</strong><p>{{ t('feedback.membre.choisir_1', 'Plutôt quelqu\'un qui vous côtoie vraiment qu\'une connaissance flatteuse. Un regard juste vaut mieux qu\'un compliment poli.') }}</p></div></li>
                <li><i data-lucide="layers" aria-hidden="true"></i><div><strong>{{ t('feedback.membre.choisir_2_titre', 'Dans des cercles différents') }}</strong><p>{{ t('feedback.membre.choisir_2', 'Famille, couple, amitié, travail, Église : chacun vous voit sous un autre jour. Les qualités citées partout sont souvent les plus sûres.') }}</p></div></li>
                <li><i data-lucide="users" aria-hidden="true"></i><div><strong>{{ t('feedback.membre.choisir_3_titre', '5 à 10 personnes') }}</strong><p>{{ t('feedback.membre.choisir_3', 'La synthèse s\'ouvre dès {min} réponses, pour protéger l\'anonymat. Toutes ne répondront pas : invitez-en un peu plus.', 'text', {min: min}) }}</p></div></li>
                <li><i data-lucide="message-circle" aria-hidden="true"></i><div><strong>{{ t('feedback.membre.choisir_4_titre', 'Une invitation personnelle') }}</strong><p>{{ t('feedback.membre.choisir_4', 'Envoyez le message à chaque personne séparément, et dites-lui pourquoi son regard compte pour vous.') }}</p></div></li>
            </ul>
        </section>

        <div class="fb-duo">
            <section class="ks-card fb-section">
                <h2 class="ks-section-title"><i data-lucide="smartphone" aria-hidden="true"></i> {{ t('feedback.membre.verront_titre', 'Ce que vos proches verront') }}</h2>
                <ul class="fb-list">
                    <li>{{ t('feedback.membre.verront_1', 'Votre prénom et une courte présentation : vous bâtissez votre Plan de Vie avec KIINI SAWA, et le schéma des trois témoins.') }}</li>
                    <li>{{ t('feedback.membre.verront_2', 'La question du lien qui vous unit : famille, couple, amitié, travail, Église…') }}</li>
                    <li>{{ t('feedback.membre.verront_3', 'Jusqu\'à 5 qualités à choisir dans une liste, ou à ajouter avec leurs propres mots.') }}</li>
                    <li>{{ t('feedback.membre.verront_4', 'Deux questions en un mot : comment vous décrire, et ce que vous n\'êtes pas.') }}</li>
                    <li>{{ t('feedback.membre.verront_5', 'Ce que vous faites de mieux, et, s\'ils le veulent, un point où vous gagneriez à grandir.') }}</li>
                </ul>
                <p class="fb-note"><i data-lucide="lock" aria-hidden="true"></i> {{ t('feedback.membre.verront_prive', 'Environ 3 minutes. Ils ne voient ni vos tests, ni votre Plan de Vie, ni les réponses des autres.') }}</p>
            </section>
            <section class="ks-card fb-section">
                <h2 class="ks-section-title"><i data-lucide="gift" aria-hidden="true"></i> {{ t('feedback.membre.recevrez_titre', 'Ce que vous recevrez') }}</h2>
                <ul class="fb-list">
                    <li>{{ t('feedback.membre.recevrez_1', 'Une notification à chaque réponse.') }}</li>
                    <li>{{ t('feedback.membre.recevrez_2', 'Dès {min} réponses, la synthèse : les qualités les plus citées, les mots qui reviennent, ce que vous faites de mieux et les pistes pour grandir.', 'text', {min: min}) }}</li>
                    <li>{{ t('feedback.membre.recevrez_3', 'Des réponses mélangées : sans prénom, impossible de savoir qui a écrit quoi.') }}</li>
                    <li>{{ t('feedback.membre.recevrez_4', 'Vos résultats restent ici, même quand le lien est terminé.') }}</li>
                </ul>
            </section>
        </div>

        <section class="ks-card fb-section">
            <h2 class="ks-section-title"><i data-lucide="sprout" aria-hidden="true"></i> {{ t('feedback.membre.relire_titre', 'Relire avec bienveillance') }}</h2>
            <p class="fb-text">{{ t('feedback.membre.relire_intro', 'Le livre KIINI appelle ce retour un **feedback nourricier** : une ressource gratuite que les autres vous offrent pour voir vos angles morts. « Les blessures d\'un ami prouvent sa fidélité » (Proverbes 27:6).', 'inline') }}</p>
            <ol class="fb-steps">
                <li><strong>{{ t('feedback.membre.relire_1_titre', 'Recevoir') }}</strong><p>{{ t('feedback.membre.relire_1', 'Ne vous justifiez pas. Dites simplement merci, même pour ce qui pique.') }}</p></li>
                <li><strong>{{ t('feedback.membre.relire_2_titre', 'Filtrer') }}</strong><p>{{ t('feedback.membre.relire_2', 'Retenez ce qui nourrit votre but, laissez tomber le reste. Ce qui revient plusieurs fois mérite plus d\'attention qu\'une remarque isolée.') }}</p></li>
                <li><strong>{{ t('feedback.membre.relire_3_titre', 'Croiser') }}</strong><p>{{ t('feedback.membre.relire_3', 'Rapprochez ce regard de vos actes et de vos résultats de tests. Accord : une confirmation. Écart : un angle mort à explorer, sans vous condamner.') }}</p></li>
                <li><strong>{{ t('feedback.membre.relire_4_titre', 'Agir') }}</strong><p>{{ t('feedback.membre.relire_4', 'Reportez vos dons confirmés dans votre Plan de Vie, et choisissez un seul point de croissance pour votre Plan de Croissance.') }}</p></li>
            </ol>
            <p class="fb-note"><i data-lucide="book-open" aria-hidden="true"></i> {{ t('feedback.membre.relire_banque', 'Gardez une trace de ce que vous découvrez, et relisez-le lors de votre revue annuelle : le livre KIINI parle de votre « banque de découvertes ».') }}</p>
        </section>

        <section class="fb-more">
            <h2 class="ks-eyebrow">{{ t('feedback.membre.plus_loin', 'Pour aller plus loin dans le livre KIINI') }}</h2>
            {{ book_panel('personnalite') }}
            <div class="fb-more__links">
                <a href="{{ path('app_methode_chapter', {slug: 'confirmations'}) }}" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="book-open"></i> {{ t('feedback.membre.lien_chap12', 'Chapitre 12 : Confirmations') }}</a>
                <a href="{{ path('app_methode_chapter', {slug: 'revues-feedback-et-defis'}) }}" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="book-open"></i> {{ t('feedback.membre.lien_chap23', 'Chapitre 23 : Revues, Feedback & Défis') }}</a>
            </div>
        </section>
    {% endset %}

    {% if not request %}
        <p style="margin: -.5rem 0 1rem;"><a href="#creer" class="ks-btn ks-btn--ghost ks-btn--sm" style="padding-left: 0;"><i data-lucide="arrow-down"></i> {{ t('feedback.membre.raccourci', 'Aller directement à la création de mon lien') }}</a></p>
        {{ explain }}
        <div class="ks-card fb-section fb-start" id="creer">
            <h2 class="ks-section-title">{{ t('feedback.membre.comment_titre', 'Comment ça marche') }}</h2>
            <ol class="fb-howto">
                <li>{{ t('feedback.membre.comment_1', 'Vous créez votre lien personnel, valable une semaine.') }}</li>
                <li>{{ t('feedback.membre.comment_2', 'Vous l\'envoyez à 5 à 10 personnes qui vous connaissent bien : famille, amis, collègues, membres de votre Église.') }}</li>
                <li>{{ t('feedback.membre.comment_3', 'Chacune choisit les qualités qu\'elle voit chez vous, vous décrit en un mot, dit ce que vous faites de mieux, et un point où vous gagneriez à grandir.') }}</li>
                <li>{{ t('feedback.membre.comment_4', 'Dès {min} réponses, vous découvrez la synthèse.', 'text', {min: min}) }}</li>
            </ol>
            {{ createForm }}
        </div>
    {% elseif open %}
        <div class="ks-card fb-section"
             x-data="{ tone: 'tu', messages: {{ messages|json_encode|e('html_attr') }}, msg: '', copied: '', canShare: !!navigator.share,
                       init() { this.msg = this.messages.tu },
                       setTone(t) { this.tone = t; this.msg = this.messages[t] },
                       copy(text, what) { const done = () => { this.copied = what; setTimeout(() => this.copied = '', 2500) };
                           const fallback = () => { const a = document.createElement('textarea'); a.value = text; a.setAttribute('readonly', ''); a.style.position = 'fixed'; a.style.opacity = '0'; document.body.appendChild(a); a.select(); try { document.execCommand('copy') } catch (e) {} a.remove(); done() };
                           if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done, fallback) } else { fallback() } } }">
            <p class="ks-eyebrow" style="margin-bottom: .35rem;">Votre lien · {{ request.forceRealName ? 'avec prénom' : 'réponses anonymes' }}</p>
            <p style="color: var(--fg-light); margin: 0 0 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem;">{% if request.expiresAt %}<i data-lucide="calendar" style="width: 16px; height: 16px; flex: none;"></i> {{ t('feedback.membre.ouvert_jusqua', 'Ouvert jusqu\'au {date}.', 'text', {date: expiresLabel}) }}{% endif %}
                {% if canExtend and request.expiresAt and request.expiresAt|date('U') < 'now'|date_modify('+3 days')|date('U') %}<form method="post" action="{{ path('app_feedback_extend') }}" style="display: inline;"><input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}"><button type="submit" class="ks-btn ks-btn--ghost ks-btn--sm" style="padding: .1rem .4rem;">{{ t('feedback.membre.prolonger', 'Prolonger d\'une semaine') }}</button></form>{% endif %}
            </p>

            <label class="ks-label" for="fb-message">{{ t('feedback.membre.message_titre', 'Votre message, prêt à envoyer') }}</label>
            <div class="fb-tone" role="group" aria-label="Tutoiement ou vouvoiement">
                <button type="button" :aria-pressed="tone === 'tu'" @click="setTone('tu')">{{ t('feedback.membre.ton_tu', 'Pour mes proches (tu)') }}</button>
                <button type="button" :aria-pressed="tone === 'vous'" @click="setTone('vous')">{{ t('feedback.membre.ton_vous', 'Plus formel (vous)') }}</button>
            </div>
            <textarea id="fb-message" class="ks-input fb-message" x-model="msg">{{ messages.tu }}</textarea>
            <p style="font-size: .82rem; color: var(--fg-muted); margin: .35rem 0 0;">{{ t('feedback.membre.message_aide', 'Vous pouvez modifier le texte avant de l\'envoyer. Astuce : envoyez-le à chaque personne séparément plutôt que dans un groupe, chaque personne se sent ainsi invitée personnellement.') }}</p>

            <div class="fb-actions">
                <a class="ks-btn ks-btn--primary" target="_blank" rel="noopener" :href="'https://wa.me/?text=' + encodeURIComponent(msg)" href="https://wa.me/?text={{ messages.tu|url_encode }}"><i data-lucide="message-circle"></i> {{ t('feedback.membre.whatsapp', 'Envoyer sur WhatsApp') }}</a>
                <button type="button" class="ks-btn ks-btn--secondary" @click="copy(msg, 'message')"><i data-lucide="copy"></i> <span x-text="copied === 'message' ? 'Message copié ✓' : 'Copier le message'">{{ t('feedback.membre.copier_message', 'Copier le message') }}</span></button>
                <button type="button" class="ks-btn ks-btn--secondary" x-show="canShare" x-cloak @click="navigator.share({ text: msg }).catch(() => {})"><i data-lucide="share-2"></i> {{ t('feedback.membre.partager', 'Partager…') }}</button>
                <a class="ks-btn ks-btn--ghost" :href="'mailto:?subject=' + encodeURIComponent({{ emailSubject|json_encode|e('html_attr') }}) + '&body=' + encodeURIComponent(msg)" href="mailto:?subject={{ emailSubject|url_encode }}&body={{ messages.tu|url_encode }}"><i data-lucide="mail"></i> {{ t('feedback.membre.email', 'Par e-mail') }}</a>
            </div>

            <div style="display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
                <input class="ks-input" style="flex: 1; min-width: 200px; font-size: .85rem;" value="{{ url }}" readonly aria-label="Votre lien">
                <button type="button" class="ks-btn ks-btn--ghost ks-btn--sm" @click="copy({{ url|json_encode|e('html_attr') }}, 'lien')"><span x-text="copied === 'lien' ? 'Lien copié ✓' : 'Copier le lien seul'">Copier le lien seul</span></button>
            </div>
        </div>
    {% else %}
        <div class="ks-card fb-section">
            <p class="ks-eyebrow" style="margin-bottom: .35rem;">{{ request.isActive ? 'Lien arrivé à son terme' : 'Demande fermée' }}</p>
            <p style="color: var(--fg-light); margin: 0 0 1rem;">
                {% if request.isActive %}{{ t('feedback.membre.termine', 'Votre lien n\'accepte plus de réponses depuis le {date}. Vos résultats restent ci-dessous.', 'text', {date: expiresLabel}) }}
                {% else %}{{ t('feedback.membre.ferme', 'Vous avez fermé cette demande. Vos résultats restent ci-dessous.') }}{% endif %}
            </p>
            {% if canExtend %}
                <form method="post" action="{{ path('app_feedback_extend') }}" style="margin-bottom: 1rem;"><input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}"><button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="calendar-plus"></i> {{ t('feedback.membre.rouvrir', 'Rouvrir ce lien une semaine') }}</button></form>
            {% endif %}
            {{ createForm }}
        </div>
    {% endif %}

    {% if request %}
        {% include 'feedback/_summary.html.twig' %}
    {% endif %}

    {% if open %}
        <form method="post" action="{{ path('app_feedback_close') }}" style="margin-bottom: 1rem;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}">
            <button type="submit" class="ks-btn ks-btn--ghost" style="padding-left: 0;" onclick="return confirm('Fermer cette demande ? Le lien ne fonctionnera plus ; vos résultats resteront visibles.')">Fermer cette demande</button>
        </form>
    {% endif %}

    {% if past is not empty %}
        <div class="ks-card fb-section">
            <h2 class="ks-section-title" style="margin-top: 0;">{{ t('feedback.membre.passees', 'Mes demandes précédentes') }}</h2>
            <ul class="fb-past">
                {% for p in past %}
                    <li><span>Demande du {{ p.request.createdAt|format_date(pattern: 'd MMMM y', locale: 'fr') }} · {{ p.count }} réponse{{ p.count > 1 ? 's' }}</span>
                        <a href="{{ path('app_feedback_past', {id: p.request.id}) }}" class="ks-btn ks-btn--ghost ks-btn--sm">Voir</a></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if request %}
        {{ explain }}
    {% endif %}
</div>
{% endblock %}
