{% extends 'base.html.twig' %}

{% block title %}Feedback nourricier{% endblock %}

{% block body %}
{% set message = 'Bonjour ! J\'avance sur mon Plan de Vie et j\'aimerais connaître ton regard sur moi : quelles qualités tu vois, ce que je fais de mieux, et un point où je pourrais grandir. 3 minutes, anonyme si tu veux : ' ~ url %}
<div class="ks-page ks-page--narrow" x-data="{ copied: false }">
    {% include 'shared/_page_header.html.twig' with {
        eyebrow: 'Mes tests · le regard des autres', icon: 'users',
        title: 'Feedback nourricier',
        lead: 'Les tests disent comment vous vous voyez ; vos proches voient parfois ce que vous ne voyez pas. Demandez-leur, en toute bienveillance.',
        back: {url: path('app_personality_index'), label: 'Mes tests'},
    } %}
    <div style="max-width: 680px; margin-bottom: 1rem;">{{ book_panel('personnalite') }}</div>

    {% if not request %}
        <div class="ks-card">
            <h2 class="ks-section-title" style="margin-top: 0;">Comment ça marche</h2>
            <ol style="list-style: decimal; padding-left: 1.3rem; line-height: 1.9; color: var(--fg-light); margin-bottom: 1rem;">
                <li>Vous créez votre lien personnel.</li>
                <li>Vous l'envoyez à 5 à 10 personnes qui vous connaissent bien : famille, amis, collègues, membres de votre Église.</li>
                <li>Chacune choisit les qualités qu'elle voit en vous, dit ce que vous faites de mieux, et un point où vous gagneriez à grandir.</li>
                <li>Dès {{ min }} réponses, vous découvrez la synthèse.</li>
            </ol>
            <form method="post" action="{{ path('app_feedback_open') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}">
                <label style="display: flex; gap: .6rem; align-items: flex-start; margin-bottom: 1rem; color: var(--fg-light);"><input type="checkbox" name="forceRealName" value="1" style="margin-top: .3rem; accent-color: var(--primary);"> Demander à chacun d'indiquer son prénom (sinon, les réponses sont anonymes, ce qui libère souvent la parole)</label>
                <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="link"></i> Créer mon lien</button>
            </form>
        </div>
    {% else %}
        <div class="ks-card" style="margin-bottom: 1rem;">
            <p class="ks-eyebrow" style="margin-bottom: .5rem;">Votre lien · {{ request.forceRealName ? 'avec prénom' : 'réponses anonymes' }}</p>
            <div style="display: flex; gap: .6rem; flex-wrap: wrap;">
                <input class="ks-input" style="flex: 1; min-width: 220px;" value="{{ url }}" readonly>
                <button type="button" class="ks-btn ks-btn--secondary" @click="navigator.clipboard.writeText('{{ url|e('js') }}'); copied = true; setTimeout(() => copied = false, 2000)"><span x-text="copied ? 'Copié ✓' : 'Copier'">Copier</span></button>
            </div>
            <div style="display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1rem;">
                <a class="ks-btn ks-btn--primary" style="background: #25D366;" target="_blank" rel="noopener" href="https://wa.me/?text={{ message|url_encode }}"><i data-lucide="message-circle"></i> Demander sur WhatsApp</a>
                <a class="ks-btn ks-btn--secondary" href="mailto:?subject={{ 'J\'aimerais ton regard sur moi'|url_encode }}&body={{ message|url_encode }}"><i data-lucide="mail"></i> Par email</a>
            </div>
        </div>

        <div class="ks-card" style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <h2 class="ks-section-title" style="margin-top: 0;">Ce que vos proches voient en vous</h2>
                <span class="ks-badge">{{ summary.count }} réponse{{ summary.count > 1 ? 's' }}</span>
            </div>
            {% if not summary.detail %}
                <div class="ks-empty" style="padding: 1.5rem 0;">
                    <div class="ks-empty__icon"><i data-lucide="hourglass" style="width: 24px; height: 24px;"></i></div>
                    <p class="ks-empty__text">Encore {{ min - summary.count }} réponse{{ min - summary.count > 1 ? 's' }} avant de découvrir la synthèse. Ce seuil protège l'anonymat de ceux qui répondent.</p>
                </div>
            {% else %}
                {% set top = summary.qualities|keys|slice(0, 1)|first %}
                <p class="ks-eyebrow" style="margin: .5rem 0;">Les qualités les plus citées</p>
                <div style="display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.25rem;">
                    {% for q, n in summary.qualities %}
                        <span class="ks-badge" style="font-size: {{ n > 1 ? (0.8 + n * 0.08)|round(2) : 0.8 }}rem; padding: .3rem .75rem;">{{ q }} · {{ n }}</span>
                    {% endfor %}
                </div>
                <p class="ks-eyebrow" style="margin-bottom: .5rem;">Ce que vous faites de mieux</p>
                {% for s in summary.strengths %}
                    <blockquote style="border-left: 3px solid var(--primary); padding: .4rem .9rem; margin: 0 0 .6rem; color: var(--fg-light);">« {{ s.text }} »{% if s.from %}<span style="display: block; font-size: .8rem; color: var(--fg-muted); margin-top: .2rem;">— {{ s.from }}</span>{% endif %}</blockquote>
                {% endfor %}
                {% if summary.improvements|length %}
                    <p class="ks-eyebrow" style="margin: 1.25rem 0 .5rem;">Là où vous pourriez grandir</p>
                    {% for s in summary.improvements %}
                        <blockquote style="border-left: 3px solid var(--warning); padding: .4rem .9rem; margin: 0 0 .6rem; color: var(--fg-light);">« {{ s.text }} »{% if s.from %}<span style="display: block; font-size: .8rem; color: var(--fg-muted); margin-top: .2rem;">— {{ s.from }}</span>{% endif %}</blockquote>
                    {% endfor %}
                {% endif %}
                <p class="ks-alert ks-alert--info" style="margin-top: 1.25rem;">Reportez ce qui vous touche dans votre Plan de Vie (« Dons et talents ») et choisissez un point de croissance pour votre Plan de Croissance. Remerciez ceux qui ont pris le temps de répondre.</p>
            {% endif %}
        </div>

        <form method="post" action="{{ path('app_feedback_close') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('feedback') }}">
            <button type="submit" class="ks-btn ks-btn--ghost" style="padding-left: 0;" onclick="return confirm('Fermer cette demande ? Le lien ne fonctionnera plus.')">Fermer cette demande</button>
        </form>
    {% endif %}
</div>
{% endblock %}
