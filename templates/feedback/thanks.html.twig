{% extends 'base.html.twig' %}
{% block title %}Merci{% endblock %}
{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' %}{% endif %}
<div class="ks-page ks-page--narrow">
    <div class="ks-card ks-empty">
        <div class="ks-empty__icon"><i data-lucide="heart" style="width: 26px; height: 26px;"></i></div>
        <h1 class="ks-empty__title">Merci pour votre regard</h1>
        <p class="ks-empty__text">{{ firstName }} découvrira ce que vous voyez en lui ou en elle. Ce genre de parole peut changer une trajectoire.</p>
    </div>
    {% if not app.user %}
        <div class="ks-card" style="text-align: center; margin-top: 1rem;">
            <h2 class="ks-section-title" style="margin-top: 0;">Et vous ?</h2>
            <p style="color: var(--fg-muted); margin-bottom: 1rem;">Découvrez votre raison d'être, vos dons et votre personnalité, et bâtissez votre Plan de Vie. Gratuit.</p>
            <a href="{{ path('app_register', {utm_source: 'feedback', utm_medium: 'formulaire', utm_campaign: 'feedback-nourricier'}) }}" class="ks-btn ks-btn--primary">Créer mon Plan de Vie</a>
        </div>
    {% endif %}
</div>
{% endblock %}
