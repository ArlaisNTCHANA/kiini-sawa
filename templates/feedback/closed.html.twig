{% extends 'base.html.twig' %}
{% block title %}{{ t('feedback.ferme.onglet', 'Lien terminé') }}{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex">{% endblock %}
{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' with {minimal: true} %}{% endif %}
{% include 'feedback/_styles.html.twig' %}
<div class="ks-page ks-page--narrow fb-public">
    <div class="ks-card ks-empty">
        <div class="ks-empty__icon"><i data-lucide="hourglass" style="width: 26px; height: 26px;"></i></div>
        <h1 class="ks-empty__title">{{ t('feedback.ferme.titre', 'Ce lien n\'accepte plus de réponses') }}</h1>
        <p class="ks-empty__text">
            {% if firstName and expired %}
                {{ t('feedback.ferme.expire', 'Le délai pour répondre à {prenom} est passé. Si vous aviez envie de répondre, dites-le à {prenom} : un nouveau lien se crée en un instant.', 'text', {prenom: firstName}) }}
            {% elseif firstName %}
                {{ t('feedback.ferme.clos', '{prenom} a clôturé cette demande. Si vous aviez envie de répondre, dites-le à {prenom} : un nouveau lien se crée en un instant.', 'text', {prenom: firstName}) }}
            {% else %}
                {{ t('feedback.ferme.inconnu', 'Ce lien n\'existe pas ou n\'est plus actif. Vérifiez-le auprès de la personne qui vous l\'a envoyé.') }}
            {% endif %}
        </p>
    </div>
    {% include 'feedback/_discover.html.twig' with {content: 'lien-termine'} %}
</div>
{% endblock %}
