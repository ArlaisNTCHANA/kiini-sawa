{% extends 'admin/layout.html.twig' %}
{# Fiche d'un membre (MemberFile, 27/11/2026) : faits de compte et compteurs, jamais le contenu de ses plans ni de son journal. #}

{% block title %}{{ member.displayName }} · Membres{% endblock %}
{% block page_title %}{{ member.displayName }}{% endblock %}
{% block page_lead %}{{ member.email }}{% if file.isAdmin %} · administrateur{% endif %}{% endblock %}

{% set testNames = {MBTI: 'Type de fonctionnement', DISC: 'DISC', BIG5: 'Profil complet', ENNEAGRAM: 'Ennéagramme', ENNEAGRAMME: 'Ennéagramme', HYGIENE: 'Hygiène de vie', DONS: 'Dons spirituels', SPIRITUAL_GIFTS: 'Dons spirituels', EQUILIBRE: 'Équilibre de vie', WHEEL: 'Roue de la vie'} %}

{% block content %}
<div class="ks-stack mf">
    <p><a href="{{ path('admin_users') }}" class="ks-btn ks-btn--ghost ks-btn--sm"><i data-lucide="arrow-left"></i> Tous les membres</a></p>

    <div class="ks-grid">
        {# Compte #}
        <section class="ks-card">
            <h2 class="ks-card__title"><i data-lucide="user-round"></i> Compte</h2>
            <dl class="mf-dl">
                <dt>Inscrit le</dt><dd>{{ member.createdAt ? member.createdAt|date('d/m/Y') : '—' }}</dd>
                <dt>Dernière visite</dt><dd>{{ member.lastActiveAt ? member.lastActiveAt|date('d/m/Y à H\\hi') : 'jamais' }}</dd>
                <dt>Adresse e-mail</dt>
                <dd>
                    {% if member.verified %}<span class="ks-badge ks-badge--success">vérifiée</span>
                    {% else %}<span class="ks-badge ks-badge--warning">pas encore vérifiée</span>{% endif %}
                </dd>
                <dt>Accueil terminé</dt><dd>{{ member.onboardingCompleted ? 'oui' : 'pas encore' }}</dd>
                <dt>Arrivé par</dt>
                <dd>{% if file.origin %}{{ file.origin.source }}{% if file.origin.medium %} · {{ file.origin.medium }}{% endif %}{% if file.origin.campaign %} · {{ file.origin.campaign }}{% endif %}{% else %}inscription directe{% endif %}</dd>
            </dl>
            {% if not member.verified %}
                <form method="post" action="{{ path('admin_users_code', {id: member.id}) }}" style="margin-top: .8rem;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                    <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="mail"></i> Renvoyer le code de vérification</button>
                </form>
            {% endif %}
        </section>

        {# Offre #}
        <section class="ks-card">
            <h2 class="ks-card__title"><i data-lucide="crown"></i> Offre</h2>
            <p style="margin: .2rem 0 .9rem;">
                {% if file.isAdmin %}<span class="ks-badge ks-badge--gold">Administrateur</span>
                {% elseif file.trialing %}<span class="ks-badge ks-badge--warning">Essai PRO</span> jusqu'au {{ file.until|date('d/m/Y') }}
                {% elseif file.isPro %}<span class="ks-badge ks-badge--success">PRO</span> jusqu'au {{ file.until|date('d/m/Y') }}
                {% else %}<span class="ks-badge ks-badge--muted">Gratuit</span>{% endif %}
            </p>
            <form method="post" action="{{ path('admin_users_gift', {id: member.id}) }}" class="ks-inline-form">
                <label class="ks-small" for="mf-months">Offrir PRO</label>
                <select id="mf-months" name="months" class="ks-input ks-input--sm">
                    {% for m in [1, 3, 6, 12] %}<option value="{{ m }}">{{ m }} mois</option>{% endfor %}
                </select>
                <input type="hidden" name="retour" value="fiche">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm" onclick="return confirm('Offrir PRO à {{ member.email|e('js') }} ?')"><i data-lucide="gift"></i> Offrir</button>
            </form>
            {% if file.memberships|length or file.couple %}
                <dl class="mf-dl" style="margin-top: 1rem;">
                    {% for m in file.memberships %}
                        <dt>Organisation</dt><dd>{{ m.organisation.name }} · {{ m.roleLabel }}{% if not m.active %} (inactif){% endif %}</dd>
                    {% endfor %}
                    {% if file.couple %}
                        <dt>Couple</dt><dd>{% if file.couple.with %}avec {{ file.couple.with.displayName }}{% else %}invitation envoyée à {{ file.couple.invited|default('—') }}{% endif %}, depuis le {{ file.couple.since|date('d/m/Y') }}</dd>
                    {% endif %}
                </dl>
            {% endif %}
        </section>
    </div>

    {# Paiements #}
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="wallet"></i> Paiements</h2>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Date</th><th>Montant</th><th>Moyen</th><th>Décision</th></tr></thead>
                <tbody>
                {% for t in file.transactions %}
                    <tr>
                        <td data-label="Date">{{ t.createdAt ? t.createdAt|date('d/m/Y') : '—' }}</td>
                        <td data-label="Montant">{{ t.amount|number_format(t.currency == 'XOF' or t.currency == 'XAF' ? 0 : 2, ',', ' ') }} {{ t.currency == 'EUR' ? '€' : 'FCFA' }}{% if t.description %}<br><span class="ks-small">{{ t.description }}</span>{% endif %}</td>
                        <td data-label="Moyen">{{ t.methodLabel }}{% if t.reference %}<br><span class="ks-small">réf. {{ t.reference }}</span>{% endif %}</td>
                        <td data-label="Décision">
                            {% if t.pending %}<a href="{{ path('admin_payments') }}" class="ks-badge ks-badge--warning">à vérifier</a>
                            {% elseif t.status == 'VALIDATED' %}<span class="ks-badge ks-badge--success">validé</span>{% if t.receiptNumber %} <a href="{{ path('app_subscription_receipt', {id: t.id}) }}" data-turbo="false" class="ks-small">reçu {{ t.receiptNumber }}</a>{% endif %}
                            {% elseif t.status == 'REJECTED' %}<span class="ks-badge ks-badge--danger">refusé</span>{% if t.adminNote %} <span class="ks-small">{{ t.adminNote }}</span>{% endif %}
                            {% else %}<span class="ks-badge ks-badge--muted">{{ t.status|lower }}</span>{% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="is-empty">Aucun paiement.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# Ce qu'il construit : des compteurs seulement #}
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="sprout"></i> Ce que {{ member.displayName }} construit</h2>
        <p class="ks-help">Des compteurs et des dates seulement : vous ne voyez jamais le contenu de ses plans, de son journal ni les résultats de ses tests.</p>
        <div class="mf-plans">
            {% for label, started in file.plans %}
                <span class="mf-plan {{ started ? 'is-on' }}"><i data-lucide="{{ started ? 'circle-check' : 'circle' }}" aria-hidden="true"></i> {{ label }}<span class="sr-only">{{ started ? ' : commencé' : ' : pas commencé' }}</span></span>
            {% endfor %}
        </div>
        <div class="mf-stats">
            <div><strong>{{ file.habits }}</strong><span>rituel{{ file.habits > 1 ? 's' }}{% if file.lastTick %}, dernière coche le {{ file.lastTick|date('d/m/Y') }}{% endif %}</span></div>
            <div><strong>{{ file.notes }}</strong><span>note{{ file.notes > 1 ? 's' }} dans le Journal</span></div>
            <div><strong>{{ file.tests|length }}</strong><span>test{{ file.tests|length > 1 ? 's' }} passé{{ file.tests|length > 1 ? 's' }}</span></div>
            <div><strong>{{ file.boussole }}</strong><span>Boussole{{ file.boussole > 1 ? 's' }} 360</span></div>
            <div><strong>{{ file.partners }}</strong><span>Partenaire{{ file.partners > 1 ? 's' }} de Redevabilité</span></div>
            <div><strong>{{ file.partnerOf }}</strong><span>fois Partenaire de Redevabilité d'un autre</span></div>
        </div>
        {% if file.tests|length %}
            <p class="ks-small" style="margin-top: .8rem;">Tests : {% for type, date in file.tests %}{{ testNames[type]|default(type) }} ({{ date ? date|date('d/m/Y') : '—' }}){{ loop.last ? '' : ' · ' }}{% endfor %}</p>
        {% endif %}
        {% if file.courses|length %}
            <h3 class="mf-h3">Parcours de l'Académie</h3>
            <ul class="mf-courses">
                {% for c in file.courses %}
                    <li>
                        <span>{{ c.title }}</span>
                        <span class="mf-bar" aria-hidden="true"><span style="width: {{ c.total > 0 ? (c.done / c.total * 100)|round : 0 }}%;"></span></span>
                        <span class="ks-small">{{ c.completed ? 'terminé le ' ~ c.completed|date('d/m/Y') : c.done ~ ' sur ' ~ c.total ~ ', dernière activité le ' ~ c.last|date('d/m/Y') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {# Assistance #}
    {% if not file.isAdmin %}
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="life-buoy"></i> Assistance</h2>
        <form method="post" action="{{ path('admin_users_email', {id: member.id}) }}" class="mf-form">
            <label class="ks-label" for="mf-email">Corriger son adresse e-mail</label>
            <p class="ks-help">Si le membre s'est trompé d'adresse. La nouvelle adresse reçoit un code, qu'il saisira à sa prochaine connexion.</p>
            <div class="ks-toolbar">
                <input id="mf-email" type="email" name="email" class="ks-input" required maxlength="180" placeholder="nouvelle@adresse.com" style="max-width: 320px;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm">Corriger</button>
            </div>
        </form>
        <details class="mf-danger">
            <summary>Supprimer le compte, à la demande du membre</summary>
            <p>Le compte et <strong>toutes</strong> ses données (plans, journal, rituels, tests, échanges) sont supprimés définitivement. Le membre reçoit une confirmation. On ne peut pas revenir en arrière.</p>
            <form method="post" action="{{ path('admin_users_delete', {id: member.id}) }}">
                <label class="ks-label" for="mf-confirm">Pour confirmer, recopiez son adresse : {{ member.email }}</label>
                <div class="ks-toolbar">
                    <input id="mf-confirm" type="text" name="confirm" class="ks-input" required autocomplete="off" style="max-width: 320px;">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                    <button type="submit" class="ks-btn ks-btn--danger ks-btn--sm"><i data-lucide="trash-2"></i> Supprimer définitivement</button>
                </div>
            </form>
        </details>
    </section>
    {% endif %}
</div>
<style>
    .mf-dl { display: grid; grid-template-columns: auto 1fr; gap: .45rem 1rem; margin: .6rem 0 0; font-size: .93rem; }
    .mf-dl dt { color: var(--fg-muted); }
    .mf-dl dd { margin: 0; }
    .mf-plans { display: flex; flex-wrap: wrap; gap: .45rem; margin: .8rem 0 1rem; }
    .mf-plan { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .7rem; border-radius: 999px; border: 1px solid var(--border); color: var(--fg-muted); font-size: .85rem; }
    .mf-plan svg { width: 15px; height: 15px; }
    .mf-plan.is-on { background: var(--primary-soft); border-color: transparent; color: var(--primary-dark); font-weight: 600; }
    .mf-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .6rem; }
    .mf-stats div { background: var(--bg-alt); border-radius: var(--r-md); padding: .7rem .85rem; display: grid; gap: .1rem; }
    .mf-stats strong { font-family: var(--font-serif); font-size: 1.45rem; color: var(--fg); }
    .mf-stats span { font-size: .82rem; color: var(--fg-muted); }
    .mf-h3 { font-size: 1rem; margin: 1.2rem 0 .5rem; }
    .mf-courses { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
    .mf-courses li { display: grid; gap: .25rem; }
    .mf-bar { display: block; height: 6px; background: var(--border); border-radius: 99px; overflow: hidden; }
    .mf-bar span { display: block; height: 6px; background: var(--primary); }
    .mf-form { margin-bottom: 1.2rem; }
    .mf-danger { border: 1px solid var(--danger-soft); border-radius: var(--r-md); padding: .7rem .9rem; }
    .mf-danger summary { cursor: pointer; color: var(--danger); font-weight: 600; }
    .mf-danger p { font-size: .9rem; color: var(--fg-muted); }
</style>
{% endblock %}
