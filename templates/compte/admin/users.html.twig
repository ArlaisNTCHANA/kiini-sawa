{% extends 'admin/layout.html.twig' %}

{% block title %}Utilisateurs{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}

{% block content %}
{% for label, messages in app.flashes %}{% for m in messages %}<div style="padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; background: rgba(16,185,129,.1); color: #34d399;">{{ m }}</div>{% endfor %}{% endfor %}

<form method="get" class="ks-card" style="display: flex; gap: 10px; margin-bottom: 20px;">
    <input name="q" value="{{ q }}" placeholder="Rechercher par email ou nom" style="flex: 1; padding: 10px; border-radius: 8px; background: rgba(0,0,0,.2); color: inherit; border: 1px solid rgba(255,255,255,.12);">
    <button type="submit" style="padding: 10px 18px; border-radius: 8px; border: none; background: var(--accent-gradient); color: #fff; font-weight: 600; cursor: pointer;">Rechercher</button>
</form>

<div class="ks-card">
    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <tr style="text-align: left; color: var(--text-secondary);"><th style="padding: 8px;">Utilisateur</th><th style="padding: 8px;">Inscrit</th><th style="padding: 8px;">Dernière activité</th><th style="padding: 8px;">Offre</th><th style="padding: 8px;">Offrir PRO</th></tr>
        {% for row in users %}
            {% set u = row.user %}
            <tr style="border-top: 1px solid rgba(255,255,255,.06);">
                <td style="padding: 8px;"><strong>{{ u.displayName }}</strong><br><span style="font-size: 12px; color: var(--text-secondary);">{{ u.email }}{{ not u.verified ? ' · email non vérifié' }}</span></td>
                <td style="padding: 8px;">{{ u.createdAt ? u.createdAt|date('d/m/Y') : '—' }}</td>
                <td style="padding: 8px;">{{ u.lastActiveAt ? u.lastActiveAt|date('d/m/Y') : '—' }}</td>
                <td style="padding: 8px;">
                    {% if 'ROLE_ADMIN' in u.roles %}Admin
                    {% elseif row.trialing %}<span style="color: #fbbf24;">Essai</span> → {{ row.until|date('d/m') }}
                    {% elseif row.isPro %}<span style="color: #34d399;">PRO</span> → {{ row.until|date('d/m/Y') }}
                    {% else %}Gratuit{% endif %}
                </td>
                <td style="padding: 8px;">
                    <form method="post" action="{{ path('admin_users_gift', {id: u.id, q: q}) }}" style="display: flex; gap: 6px;">
                        <select name="months" style="padding: 6px; border-radius: 6px; background: rgba(0,0,0,.2); color: inherit; border: 1px solid rgba(255,255,255,.12);">
                            {% for m in [1, 3, 6, 12] %}<option value="{{ m }}">{{ m }} mois</option>{% endfor %}
                        </select>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                        <button type="submit" style="padding: 6px 10px; border-radius: 6px; border: 1px solid rgba(255,255,255,.15); background: transparent; color: inherit; cursor: pointer;" onclick="return confirm('Offrir PRO à {{ u.email|e('js') }} ?')">Offrir</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td style="padding: 16px; color: var(--text-secondary);" colspan="5">Aucun utilisateur trouvé.</td></tr>
        {% endfor %}
    </table>
</div>
{% endblock %}
