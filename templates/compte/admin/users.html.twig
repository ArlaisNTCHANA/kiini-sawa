{% extends 'admin/layout.html.twig' %}

{% block title %}Membres{% endblock %}
{% block page_title %}Membres{% endblock %}
{% block page_lead %}Retrouvez un membre, voyez son offre et offrez-lui quelques mois de PRO. Cliquez sur un nom pour ouvrir sa fiche.{% endblock %}

{% block content %}
<div class="ks-stack">
    <form method="get" class="ks-card ks-card--flat ks-toolbar" role="search">
        <label for="users-q" class="ks-label" style="flex-basis: 100%;">Rechercher un membre</label>
        <input id="users-q" class="ks-input" name="q" value="{{ q }}" placeholder="Email ou prénom" type="search">
        <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="search"></i> Rechercher</button>
        {% if q %}<a class="ks-btn ks-btn--ghost" href="{{ path('admin_users') }}">Effacer</a>{% endif %}
    </form>

    <section class="ks-card">
        <div class="ks-card__head">
            <h2 class="ks-card__title">{{ users|length }} membre{{ users|length > 1 ? 's' }}{{ q ? ' pour « ' ~ q ~ ' »' }}</h2>
        </div>
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Membre</th><th>Inscrit le</th><th>Dernière visite</th><th>Offre</th><th>Offrir PRO</th></tr></thead>
                <tbody>
                {% for row in users %}
                    {% set u = row.user %}
                    <tr>
                        <td><a href="{{ path('admin_users_show', {id: u.id}) }}"><strong>{{ u.displayName }}</strong></a><br><span class="ks-small">{{ u.email }}</span>{% if not u.verified %} <span class="ks-badge ks-badge--warning">email non vérifié</span>{% endif %}</td>
                        <td data-label="Inscrit le">{{ u.createdAt ? u.createdAt|date('d/m/Y') : '—' }}</td>
                        <td data-label="Dernière visite">{{ u.lastActiveAt ? u.lastActiveAt|date('d/m/Y') : '—' }}</td>
                        <td data-label="Offre">
                            {% if 'ROLE_ADMIN' in u.roles %}<span class="ks-badge ks-badge--gold">Administrateur</span>
                            {% elseif row.trialing %}<span class="ks-badge ks-badge--warning">Essai</span> <span class="ks-small">jusqu'au {{ row.until|date('d/m') }}</span>
                            {% elseif row.isPro %}<span class="ks-badge ks-badge--success">PRO</span> <span class="ks-small">jusqu'au {{ row.until|date('d/m/Y') }}</span>
                            {% else %}<span class="ks-badge ks-badge--muted">Gratuit</span>{% endif %}
                        </td>
                        <td data-label="Offrir PRO">
                            <form method="post" action="{{ path('admin_users_gift', {id: u.id, q: q}) }}" class="ks-inline-form">
                                <select name="months" class="ks-input ks-input--sm" aria-label="Durée offerte à {{ u.displayName }}">
                                    {% for m in [1, 3, 6, 12] %}<option value="{{ m }}">{{ m }} mois</option>{% endfor %}
                                </select>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user') }}">
                                <button type="submit" class="ks-btn ks-btn--secondary ks-btn--sm" onclick="return confirm('Offrir PRO à {{ u.email|e('js') }} ?')"><i data-lucide="gift"></i> Offrir</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="is-empty">{{ q ? 'Aucun membre ne correspond à « ' ~ q ~ ' ». Essayez une partie de l\'e-mail.' : 'Personne ne s\'est encore inscrit.' }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
