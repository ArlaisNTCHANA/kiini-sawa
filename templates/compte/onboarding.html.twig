{% extends 'base.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block body %}
<style>
    .ob-body { display: flex; align-items: flex-start; justify-content: center; min-height: calc(100vh - 72px); padding: 2.5rem 1rem 8rem;
               background: linear-gradient(135deg, #022c22 0%, var(--primary) 50%, #014751 100%); position: relative; overflow: hidden; }
    .ob-glow { position: absolute; top: -10%; left: -10%; width: 50vw; height: 50vh; background: radial-gradient(circle, rgba(45,212,191,.2) 0%, transparent 70%); filter: blur(60px); pointer-events: none; }
    .ob-card { width: 100%; max-width: 560px; padding: 2.5rem 2rem; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
               border-radius: 28px; box-shadow: 0 25px 50px -12px rgba(0,0,0,.35); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
               color: var(--border-strong); position: relative; z-index: 1; }
    .ob-progress { display: flex; gap: .4rem; margin-bottom: 2rem; }
    .ob-progress span { flex: 1; height: 4px; border-radius: 4px; background: rgba(255,255,255,.12); transition: background .3s; }
    .ob-progress span.on { background: #2dd4bf; }
    .ob-step-label { font-size: .75rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: #2dd4bf; margin-bottom: .5rem; }
    .ob-card h1 { font-family: var(--font-serif); color: #fff; font-size: 1.75rem; line-height: 1.25; margin-bottom: .75rem; }
    .ob-text { font-size: .95rem; line-height: 1.6; margin-bottom: 1.5rem; }
    .ob-card input[type=text], .ob-card input[type=date], .ob-card textarea {
        width: 100%; padding: .9rem 1.1rem; background: rgba(0,0,0,.25); border: 1.5px solid rgba(255,255,255,.08); border-radius: 12px;
        color: var(--bg); font: inherit; font-size: 1rem; color-scheme: dark; }
    .ob-card input:focus, .ob-card textarea:focus { outline: none; border-color: #2dd4bf; box-shadow: 0 0 0 4px rgba(45,212,191,.15); }
    .ob-card textarea { min-height: 7rem; resize: vertical; line-height: 1.5; }
    .ob-examples { font-size: .8rem; color: var(--fg-subtle); margin-top: .6rem; line-height: 1.5; font-style: italic; }
    .ob-values { display: grid; gap: .6rem; }
    .ob-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
    .ob-chip { padding: .4rem .85rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.15); background: transparent; color: var(--border); font: inherit; font-size: .825rem; cursor: pointer; }
    .ob-chip:hover { border-color: #2dd4bf; color: #2dd4bf; }
    .ob-cats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; margin: 1rem 0; }
    .ob-cats label { text-align: center; padding: .65rem .25rem; border-radius: 12px; border: 1.5px solid rgba(255,255,255,.1); cursor: pointer; font-weight: 600; font-size: .9rem; color: var(--border); }
    .ob-cats input { position: absolute; opacity: 0; pointer-events: none; }
    .ob-cats label:has(input:checked) { border-color: #2dd4bf; background: rgba(45,212,191,.12); color: #fff; }
    .ob-field-label { display: block; font-size: .75rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--fg-subtle); margin: 1rem 0 .4rem; }
    .ob-error { color: #fca5a5; font-size: .85rem; margin-top: .5rem; }
    .ob-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; gap: 1rem; }
    .ob-btn { padding: .9rem 1.5rem; border-radius: 12px; border: none; font: inherit; font-weight: 700; cursor: pointer; background: linear-gradient(135deg, #2dd4bf 0%, var(--primary-light) 100%); color: #fff; box-shadow: 0 4px 14px rgba(13,148,136,.3); }
    .ob-btn:disabled { opacity: .45; cursor: not-allowed; }
    .ob-link { background: none; border: none; color: var(--fg-subtle); font: inherit; font-size: .875rem; cursor: pointer; padding: .5rem 0; }
    .ob-link:hover { color: #fff; }
</style>

{# Si le serveur renvoie une erreur, on rouvre l'étape concernée #}
{% set firstErrorStep = errors.firstName is defined ? 1 : (errors.purpose is defined ? 2 : (errors.values is defined ? 3 : (errors|length > 0 ? 4 : 1))) %}

<div class="ob-body">
    <div class="ob-glow"></div>
    <form method="post" class="ob-card"
          x-data="{
              step: {{ firstErrorStep }},
              firstName: {{ data.firstName|json_encode }},
              purpose: {{ data.purpose|json_encode }},
              values: {{ data.values|json_encode }},
              goalTitle: {{ data.goalTitle|json_encode }},
              addValue(v) { const i = this.values.findIndex(x => !x.trim()); if (i >= 0 && !this.values.some(x => x.toLowerCase() === v.toLowerCase())) this.values[i] = v; },
              valid() {
                  if (this.step === 1) return this.firstName.trim().length > 0;
                  if (this.step === 2) return this.purpose.trim().length >= 10;
                  if (this.step === 3) { const v = this.values.map(x => x.trim().toLowerCase()).filter(Boolean); return v.length === 3 && new Set(v).size === 3; }
                  return this.goalTitle.trim().length >= 3;
              }
          }"
          @keydown.enter="if ($event.target.tagName !== 'TEXTAREA' && step < 4) { $event.preventDefault(); if (valid()) step++; }">

        <div class="ob-progress" aria-hidden="true">
            <template x-for="i in 4"><span :class="i <= step ? 'on' : ''"></span></template>
        </div>

        {# Étape 1 — Prénom #}
        <div x-show="step === 1">
            <p class="ob-step-label">Étape 1 sur 4 · Bienvenue</p>
            <h1>Bâtissons ensemble une vie alignée sur ce qui compte vraiment.</h1>
            <p class="ob-text">En 3 minutes, vous allez poser les fondations de votre Plan de Vie. Vous pourrez tout approfondir ensuite. Comment souhaitez-vous qu'on vous appelle ?</p>
            <input type="text" name="firstName" x-model="firstName" maxlength="100" autocomplete="given-name" placeholder="Votre prénom" aria-label="Prénom">
            {% if errors.firstName is defined %}<p class="ob-error">{{ errors.firstName }}</p>{% endif %}
        </div>

        {# Étape 2 — Raison d'être #}
        <div x-show="step === 2" x-cloak>
            <p class="ob-step-label">Étape 2 sur 4 · Raison d'être</p>
            <h1>Pourquoi êtes-vous là, <span x-text="firstName"></span> ?</h1>
            <p class="ob-text">En une ou deux phrases, ce pour quoi vous voulez que votre vie compte. Pas besoin que ce soit parfait : vous l'affinerez.</p>
            <textarea name="purpose" x-model="purpose" maxlength="1000" aria-label="Raison d'être"></textarea>
            <p class="ob-examples">Exemples : « Aider les jeunes de ma ville à révéler leurs talents. » · « Bâtir une famille unie et servir mon église avec mes dons d'enseignement. »</p>
            {% if errors.purpose is defined %}<p class="ob-error">{{ errors.purpose }}</p>{% endif %}
        </div>

        {# Étape 3 — Valeurs #}
        <div x-show="step === 3" x-cloak>
            <p class="ob-step-label">Étape 3 sur 4 · Valeurs</p>
            <h1>Quelles sont vos 3 valeurs non négociables ?</h1>
            <p class="ob-text">Ce qui guide vos décisions, même quand c'est difficile.</p>
            <div class="ob-values">
                <template x-for="(v, i) in values" :key="i">
                    <input type="text" name="values[]" x-model="values[i]" maxlength="255" :placeholder="'Valeur ' + (i + 1)" :aria-label="'Valeur ' + (i + 1)">
                </template>
            </div>
            <div class="ob-chips">
                {% for s in suggestions %}
                    <button type="button" class="ob-chip" @click="addValue({{ s|json_encode }})">{{ s }}</button>
                {% endfor %}
            </div>
            {% if errors.values is defined %}<p class="ob-error">{{ errors.values }}</p>{% endif %}
        </div>

        {# Étape 4 — Premier objectif #}
        <div x-show="step === 4" x-cloak>
            <p class="ob-step-label">Étape 4 sur 4 · Premier objectif</p>
            <h1>Un objectif qui découle de votre raison d'être.</h1>
            <p class="ob-text">Quelque chose de concret que vous voulez voir se réaliser.</p>
            <input type="text" name="goalTitle" x-model="goalTitle" maxlength="255" placeholder="Ex. : Lancer un atelier d'orientation pour 20 jeunes" aria-label="Objectif">
            {% if errors.goalTitle is defined %}<p class="ob-error">{{ errors.goalTitle }}</p>{% endif %}

            <span class="ob-field-label">C'est un objectif pour…</span>
            <div class="ob-cats">
                {% for key, label in categories %}
                    <label><input type="radio" name="goalCategory" value="{{ key }}" {{ data.goalCategory == key ? 'checked' }}>{{ label }}</label>
                {% endfor %}
            </div>

            <label class="ob-field-label" for="goalDeadline">Échéance</label>
            <input type="date" id="goalDeadline" name="goalDeadline" value="{{ data.goalDeadline }}" min="{{ 'tomorrow'|date('Y-m-d') }}">
            {% if errors.goalDeadline is defined %}<p class="ob-error">{{ errors.goalDeadline }}</p>{% endif %}
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('onboarding') }}">

        <div class="ob-nav">
            <button type="button" class="ob-link" x-show="step > 1" @click="step--">← Retour</button>
            <button type="submit" class="ob-link" name="skip" value="1" formnovalidate x-show="step === 1">Plus tard</button>
            <button type="button" class="ob-btn" x-show="step < 4" :disabled="!valid()" @click="step++">Continuer</button>
            <button type="submit" class="ob-btn" x-show="step === 4" x-cloak :disabled="!valid()">Voir mon Plan de Vie</button>
        </div>
    </form>
</div>
{% endblock %}
