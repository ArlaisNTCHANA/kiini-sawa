{% extends 'compte/email/_layout.html.twig' %}
{% block content %}
  <p>Bonjour {{ name }},</p>
  <p>{{ isEmailChange ? 'Pour confirmer votre nouvelle adresse email' : 'Pour activer votre compte' }}, saisissez ce code :</p>
  <p style="font-size:32px;font-weight:bold;letter-spacing:8px;text-align:center;background:#EEF3EF;color:#2E6B53;padding:16px;border-radius:12px;margin:24px 0;">{{ code }}</p>
  <p>Ce code est valable 15 minutes. Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.</p>
{% endblock %}
