<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>
<body style="margin:0;padding:0;background:#f1f5f4;font-family:-apple-system,'Segoe UI',Arial,sans-serif;color:#1e293b;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f4;padding:32px 16px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:16px;overflow:hidden;">
        <tr><td style="background:#0f766e;padding:20px 32px;color:#ffffff;font-family:Georgia,serif;font-size:22px;font-weight:bold;">KIINI SAWA</td></tr>
        <tr><td style="padding:32px;font-size:15px;line-height:1.6;">
          {% block content %}{% endblock %}
        </td></tr>
        <tr><td style="padding:16px 32px 28px;font-size:12px;color:#64748b;border-top:1px solid #e2e8f0;">
          {% block footer %}Vous recevez cet email parce qu'une action a été demandée sur un compte KIINI SAWA associé à cette adresse.{% endblock %}
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
