{% extends 'compte/email/_layout.html.twig' %}
{% block content %}
  <p>Bonjour {{ name }},</p>
  <p>Vous avez demandé à réinitialiser votre mot de passe. Ce lien est valable une heure :</p>
  <p style="text-align:center;margin:28px 0;"><a href="{{ url }}" style="background:#0f766e;color:#ffffff;text-decoration:none;padding:14px 28px;border-radius:10px;font-weight:bold;display:inline-block;">Choisir un nouveau mot de passe</a></p>
  <p style="font-size:13px;color:#64748b;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br>{{ url }}</p>
  <p>Si vous n'avez rien demandé, ignorez cet email : votre mot de passe actuel reste valable.</p>
{% endblock %}
