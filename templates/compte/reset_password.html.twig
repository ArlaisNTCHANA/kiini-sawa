{% extends 'compte/_auth_layout.html.twig' %}

{% block title %}KIINI SAWA — Nouveau mot de passe{% endblock %}

{% block content %}
    {% if not valid %}
        <h1 class="auth-title">Lien expiré</h1>
        <p class="auth-text">Ce lien de réinitialisation n'est plus valable (il expire au bout d'une heure et ne sert qu'une fois).</p>
        <div class="auth-links"><a href="{{ path('app_forgot_password') }}">Demander un nouveau lien</a></div>
    {% else %}
        <h1 class="auth-title">Nouveau mot de passe</h1>
        <form method="post">
            <div class="form-group">
                <label for="password">Nouveau mot de passe</label>
                <input type="password" name="password" id="password" autocomplete="new-password" required minlength="10" maxlength="4096" autofocus>
                {% if error %}<span class="form-error">{{ error }}</span>{% else %}<span class="form-hint">10 caractères minimum.</span>{% endif %}
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
            <button type="submit">Enregistrer</button>
        </form>
    {% endif %}
{% endblock %}
