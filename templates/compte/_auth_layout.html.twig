<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}KIINI SAWA{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0F766E">
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">
    <style>
        :root {
            --bg-color: #022c22;
            --card-bg: rgba(255, 255, 255, 0.07);
            --accent-color: #2dd4bf;
            --accent-gradient: linear-gradient(135deg, #2dd4bf 0%, #0d9488 100%);
            --text-color: #cbd5e1;
            --text-heading: #f8fafc;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
            padding: 2rem 0;
            background: linear-gradient(135deg, #022c22 0%, #0f766e 50%, #014751 100%);
        }

        /* Ambient Glows */
        .glow-1 {
            position: absolute;
            top: -10%; left: -10%;
            width: 50vw; height: 50vh;
            background: radial-gradient(circle, rgba(45, 212, 191, 0.2) 0%, transparent 70%);
            filter: blur(60px);
            pointer-events: none;
        }
        .glow-2 {
            position: absolute;
            bottom: -10%; right: -10%;
            width: 60vw; height: 60vh;
            background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
            filter: blur(80px);
            pointer-events: none;
        }

        /* Dot Grid */
        .dots {
            position: absolute;
            inset: 0;
            opacity: 0.15;
            background-image: radial-gradient(circle, rgba(255, 255, 255, 0.15) 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            pointer-events: none;
        }

        .login-container {
            width: 90%;
            max-width: 440px;
            padding: 3rem 2.5rem;
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 28px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            text-align: center;
            position: relative;
            z-index: 10;
        }

        .logo-mark {
            width: 3.25rem;
            height: 3.25rem;
            border-radius: 1rem;
            background: var(--accent-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35);
            margin: 0 auto 1.5rem;
        }

        .logo {
            font-family: 'Playfair Display', Georgia, serif;
            font-weight: 700;
            font-size: 2.1rem;
            margin-bottom: 0.375rem;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .subtitle {
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: #2dd4bf;
            margin-bottom: 2.25rem;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            text-align: left;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        label {
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            color: #94a3b8;
            text-transform: uppercase;
        }

        input[type="email"],
        input[type="password"],
        input[type="text"] {
            width: 100%;
            padding: 0.9rem 1.1rem;
            background-color: rgba(0, 0, 0, 0.25);
            border: 1.5px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: var(--text-heading);
            font-family: inherit;
            font-size: 0.975rem;
            transition: all 0.25s ease;
        }

        input[type="email"]:focus,
        input[type="password"]:focus,
        input[type="text"]:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 4px rgba(45, 212, 191, 0.15);
            background-color: rgba(0, 0, 0, 0.35);
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            font-size: 0.85rem;
            color: #94a3b8;
            cursor: pointer;
            user-select: none;
            margin: 0.25rem 0;
        }

        .checkbox-container input {
            cursor: pointer;
            accent-color: var(--accent-color);
            width: 1rem;
            height: 1rem;
        }

        button {
            width: 100%;
            padding: 0.95rem;
            background: var(--accent-gradient);
            border: none;
            border-radius: 12px;
            color: #ffffff;
            font-family: inherit;
            font-weight: 700;
            font-size: 0.975rem;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 14px rgba(13, 148, 136, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        button:hover {
            opacity: 0.95;
            box-shadow: 0 6px 20px rgba(13, 148, 136, 0.5);
            transform: translateY(-1px);
        }

        button:active {
            transform: translateY(0);
        }

        .alert {
            padding: 0.85rem 1.1rem;
            background-color: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 10px;
            color: #fca5a5;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            text-align: center;
            line-height: 1.4;
        }

        .alert-success { background-color: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.25); color: #a7f3d0; }
        .alert-info { background-color: rgba(45, 212, 191, 0.10); border-color: rgba(45, 212, 191, 0.25); color: #99f6e4; }
        .auth-title { font-family: 'Playfair Display', Georgia, serif; color: #fff; font-size: 1.5rem; margin-bottom: .5rem; }
        .auth-text { font-size: .925rem; line-height: 1.55; margin-bottom: 1.5rem; }
        .auth-links { margin-top: 1.5rem; font-size: .875rem; display: flex; flex-direction: column; gap: .5rem; }
        .auth-links a, .auth-text a, .checkbox-container a, .form-error a { color: var(--accent-color); text-decoration: none; font-weight: 600; }
        .auth-links a:hover { text-decoration: underline; }
        .form-hint { font-size: .78rem; color: #94a3b8; }
        .form-error { font-size: .8rem; color: #fca5a5; }
        .code-input { text-align: center; font-size: 1.75rem !important; letter-spacing: .6rem; font-weight: 700; }
        .link-button { background: none; box-shadow: none; padding: 0; color: var(--accent-color); text-transform: none; letter-spacing: 0; font-size: .875rem; font-weight: 600; width: auto; }
        .link-button:hover { box-shadow: none; text-decoration: underline; transform: none; }
        .hp-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
        .legal-footer { position: relative; z-index: 10; margin-top: 1.5rem; font-size: .75rem; text-align: center; color: #94a3b8; }
        .legal-footer a { color: #94a3b8; text-decoration: none; margin: 0 .5rem; }
        .legal-footer a:hover { color: #fff; }
        .auth-wrapper { display: flex; flex-direction: column; align-items: center; width: 100%; }
    </style>
</head>
<body>
    <div class="glow-1"></div>
    <div class="glow-2"></div>
    <div class="dots"></div>

    <div class="auth-wrapper">
        <div class="login-container">
            <div class="logo-mark">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                    <path d="M2 17l10 5 10-5"/>
                    <path d="M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div class="logo">KIINI SAWA</div>
            <div class="subtitle">Plan de Vie</div>

            {% for type in ['success', 'info', 'error', 'dev'] %}
                {% for message in app.flashes(type) %}
                    <div class="alert {{ type == 'success' ? 'alert-success' : (type in ['info', 'dev'] ? 'alert-info' : '') }}">{% if type == 'dev' %}<strong>[dev]</strong> {% endif %}{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
        {% include 'legal/_footer_links.html.twig' %}
    </div>
</body>
</html>
