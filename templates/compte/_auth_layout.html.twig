<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}KIINI SAWA{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include 'shared/_pwa_head.html.twig' %}
    <meta name="theme-color" content="#2E6B53">
    <link href="{{ asset('styles/fonts.css') }}" rel="stylesheet">
    {% include 'shared/_design_tokens.html.twig' %}
    {# Fond clair de l'application (contre-audit visuel du 25/11/2026) : l'entrée ressemble à la vitrine et à l'application ;
       le vert sombre est réservé au bandeau du haut. #}
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: var(--font-sans); background: var(--bg); color: var(--fg-light); min-height: 100vh; -webkit-font-smoothing: antialiased; }
        .auth-band { background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary) 100%); height: 9.5rem; }
        .auth-top { max-width: 1100px; margin: 0 auto; padding: 1.1rem 1.25rem; display: flex; justify-content: space-between; align-items: center; }
        .auth-top a { text-decoration: none; }
        .auth-top__back { color: rgba(255,255,255,.88); font-size: .9rem; font-weight: 500; }
        .auth-top__back:hover { color: #fff; text-decoration: underline; }
        .auth-wrapper { display: flex; flex-direction: column; align-items: center; width: 100%; padding: 0 1rem 2.5rem; margin-top: -4.5rem; }
        .login-container { width: 100%; max-width: 440px; padding: 2.25rem 2rem; background: var(--card-bg); border: 1px solid var(--border);
            border-radius: 20px; box-shadow: 0 18px 40px -18px rgba(31, 77, 58, .28); text-align: center; position: relative; }
        .auth-tagline { font-size: .95rem; color: var(--fg-muted); margin: 0 auto 1.5rem; max-width: 32ch; line-height: 1.55; }
        form { display: flex; flex-direction: column; gap: 1.1rem; text-align: left; }
        .form-group { display: flex; flex-direction: column; gap: .4rem; }
        label { font-size: .85rem; font-weight: 600; color: var(--fg); }
        input[type="email"], input[type="password"], input[type="text"], input[type="date"] {
            width: 100%; padding: .8rem 1rem; background: var(--card-bg); border: 1.5px solid var(--border-strong); border-radius: 12px;
            color: var(--fg); font-family: inherit; font-size: 1rem; transition: border-color .2s ease, box-shadow .2s ease; min-height: 3rem; }
        input::placeholder { color: var(--fg-subtle); }
        input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px var(--primary-tint); }
        .checkbox-container { display: flex; align-items: flex-start; gap: .6rem; font-size: .875rem; color: var(--fg-light); cursor: pointer; user-select: none; margin: .25rem 0; line-height: 1.45; }
        .checkbox-container input { cursor: pointer; accent-color: var(--primary); width: 1.1rem; height: 1.1rem; margin-top: .1rem; flex-shrink: 0; }
        button { width: 100%; padding: .9rem; background: var(--primary); border: none; border-radius: 12px; color: #fff; font-family: inherit;
            font-weight: 700; font-size: 1rem; cursor: pointer; transition: background .2s ease, transform .2s ease; box-shadow: 0 4px 14px rgba(46, 107, 83, .25); min-height: 3rem; }
        button:hover { background: var(--primary-dark); transform: translateY(-1px); }
        button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
        button:active { transform: translateY(0); }
        .alert { padding: .8rem 1rem; background: var(--danger-soft, #FBEDEA); border: 1px solid rgba(179, 64, 42, .25); border-radius: 10px; color: var(--danger, #B3402A);
            font-size: .875rem; margin-bottom: 1.25rem; text-align: center; line-height: 1.45; }
        .alert-success { background: var(--success-soft, #EAF3EC); border-color: rgba(58, 125, 82, .25); color: var(--success, #3A7D52); }
        .alert-info { background: var(--primary-soft); border-color: var(--primary-tint); color: var(--primary-dark); }
        .auth-title { font-family: var(--font-serif); color: var(--primary-dark); font-size: 1.6rem; font-weight: 600; margin-bottom: .5rem; line-height: 1.25; }
        .auth-text { font-size: .95rem; line-height: 1.55; margin-bottom: 1.5rem; color: var(--fg-light); }
        .auth-links { margin-top: 1.5rem; font-size: .9rem; display: flex; flex-direction: column; gap: .6rem; color: var(--fg-muted); }
        .auth-links a, .auth-text a, .checkbox-container a, .form-error a { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; font-weight: 600; }
        .form-hint { font-size: .8rem; color: var(--fg-muted); }
        .form-error { font-size: .82rem; color: var(--danger, #B3402A); }
        .code-input { text-align: center; font-size: 1.75rem !important; letter-spacing: .6rem; font-weight: 700; }
        .link-button { background: none; box-shadow: none; padding: 0; color: var(--primary); font-size: .9rem; font-weight: 600; width: auto; min-height: 0; text-decoration: underline; text-underline-offset: 2px; }
        .link-button:hover { background: none; transform: none; }
        .hp-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
        .legal-footer { margin-top: 1.5rem; font-size: .8rem; text-align: center; color: var(--fg-muted); }
        .legal-footer a { color: var(--fg-muted); text-decoration: none; margin: 0 .5rem; }
        .legal-footer a:hover { color: var(--primary); text-decoration: underline; }
        .auth-logo { display: flex; justify-content: center; margin-bottom: .75rem; }
        @media (max-width: 480px) { .login-container { padding: 1.75rem 1.25rem; } .auth-band { height: 8rem; } }
    </style>
</head>
<body>
    <div class="auth-band">
        <div class="auth-top">
            <a href="{{ path('app_home') }}" aria-label="KIINI SAWA, accueil">{% include 'shared/_logo.html.twig' with {tone: 'dark'} only %}</a>
            <a class="auth-top__back" href="{{ path('app_home') }}">Découvrir KIINI SAWA</a>
        </div>
    </div>

    <div class="auth-wrapper">
        <div class="login-container">
            {% for type in ['success', 'info', 'error', 'dev'] %}
                {% for message in app.flashes(type) %}
                    <div class="alert {{ type == 'success' ? 'alert-success' : (type in ['info', 'dev'] ? 'alert-info' : '') }}">{% if type == 'dev' %}<strong>[dev]</strong> {% endif %}{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
        {% include 'legal/_footer_links.html.twig' %}
    </div>
</body>
</html>
