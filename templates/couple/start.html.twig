{% extends 'base.html.twig' %}

{% block title %}Notre couple{% endblock %}

{% block body %}
<div style="max-width: 820px; margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <p class="ks-header__eyebrow" style="color: var(--couple);">Espace couple</p>
    <h1 class="ks-header__title">Bâtir votre couple, ensemble</h1>
    <p class="ks-header__lead" style="margin-bottom: 2rem;">« Deux valent mieux qu'un » (Ecclésiaste 4:9). Un espace commun pour poser votre vision, vos valeurs et vos projets, choisir vos thèmes de croissance et faire le point chaque mois. Vos espaces personnels (plans, journal) restent privés.</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        {% for f in [
            ['🧭', 'Une vision commune', 'Votre « pourquoi » de couple, et la parole qui vous porte.'],
            ['🎯', 'Des projets communs', 'Être, faire, avoir, donner : vos objectifs à deux, avec échéances.'],
            ['🌱', 'Des thèmes de croissance', 'Communication, finances, vie spirituelle, intimité, parentalité…'],
            ['🔍', 'Un rapport croisé', 'Vos profils de personnalité côte à côte, avec des pistes concrètes.'],
        ] %}
            <div style="background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 1.2rem;">
                <div style="font-size: 1.5rem;">{{ f[0] }}</div><div style="font-weight: 700; margin: .3rem 0 .2rem;">{{ f[1] }}</div><div style="color: var(--fg-muted); font-size: .9rem;">{{ f[2] }}</div>
            </div>
        {% endfor %}
    </div>

    <form method="post" action="{{ path('app_couple_create') }}" style="background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 1.5rem; margin-bottom: 1.25rem;">
        <h2 style="font-family: var(--font-serif); font-size: 1.3rem; margin-bottom: .75rem;">Inviter mon conjoint</h2>
        <input type="email" name="email" placeholder="Adresse email de votre conjoint (facultatif)" aria-label="Email du conjoint" style="width: 100%; padding: .75rem .9rem; border: 1.5px solid var(--border); border-radius: var(--r-md); font: inherit; margin-bottom: .6rem;">
        <p style="color: var(--fg-muted); font-size: .85rem; margin-bottom: 1rem;">Sans email, vous obtiendrez un lien à lui envoyer (WhatsApp, SMS…).</p>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('couple') }}">
        <button type="submit" style="padding: .85rem 1.5rem; border: none; border-radius: var(--r-md); background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer;">Créer notre espace couple</button>
    </form>
    <p style="color: var(--fg-muted); font-size: .9rem;">L'espace couple est inclus dans l'abonnement <strong>Duo</strong> : {{ duo.EUR|money('EUR') }} ou {{ duo.XAF|money('XAF') }} par an pour vous deux (au lieu de {{ duo.twoProEur|money('EUR') }} pour deux abonnements PRO). Il est aussi ouvert si vous êtes PRO tous les deux.</p>
</div>
{% endblock %}
