{% extends 'base.html.twig' %}

{% block title %}Le Jardin des défis · Sanctuaire du Couple{% endblock %}

{% block body %}
<style>
    .sc-step { font-size: .78rem; font-weight: 700; color: var(--couple); text-transform: uppercase; letter-spacing: .06em; }
    .sc-bar { height: 6px; border-radius: 999px; background: var(--couple-soft); overflow: hidden; margin: .5rem 0 1rem; }
    .sc-bar span { display: block; height: 100%; background: var(--couple); }
    .sc-prompt { font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.5; margin-bottom: 1rem; }
    .sc-who { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .sc-who span { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; font-weight: 600; padding: .3rem .7rem; border-radius: 999px; background: var(--bg-alt); color: var(--fg-muted); }
    .sc-who span.done { background: var(--primary-soft); color: var(--primary); }
    .sc-note { background: var(--couple-soft); border-radius: var(--r-md); padding: .8rem 1rem; margin-bottom: 1rem; font-size: .92rem; }
    .sc-mini { font-size: .82rem; color: var(--fg-muted); }
    section.ks-card { margin-bottom: 1.25rem; }
    .ks-card > .ks-section-title:first-child { margin-top: 0; display: flex; align-items: center; gap: .5rem; }
</style>
{% set token = csrf_token('couple') %}
{% set active = challenge and challenge.status == 'ACTIVE' %}

<div class="ks-page ks-page--narrow">
    {% include 'shared/_page_header.html.twig' with {
        back: {url: path('app_couple', {'_fragment': 'sanctuaire'}), label: 'Notre couple'},
        eyebrow: 'Sanctuaire du Couple', icon: 'sprout',
        title: 'Le Jardin des défis',
        lead: 'Un petit pas par jour, vécu à deux. Le jour suivant s\'ouvre quand vous avez validé tous les deux.'
    } %}

    <section class="ks-card">
        <h2 class="ks-section-title"><i data-lucide="target" class="ks-ico" aria-hidden="true"></i> Notre défi en cours</h2>
        {% if active %}
            <p class="sc-step">{{ challenge.title }} · jour {{ challenge.currentDay }} sur {{ challenge.totalDays }}</p>
            <div class="sc-bar" aria-hidden="true"><span style="width: {{ ((challenge.currentDay - 1) / challenge.totalDays * 100)|round }}%;"></span></div>
            <p class="sc-prompt">{{ challenge.todayPrompt }}</p>
            <div class="sc-who">
                <span class="{{ challenge.todayDoneByMe ? 'done' }}"><i data-lucide="{{ challenge.todayDoneByMe ? 'check' : 'circle' }}" class="ks-ico" aria-hidden="true"></i> Vous</span>
                <span class="{{ challenge.todayDoneByPartner ? 'done' }}"><i data-lucide="{{ challenge.todayDoneByPartner ? 'check' : 'circle' }}" class="ks-ico" aria-hidden="true"></i> {{ partner ? partner.displayName : 'Votre conjoint' }}</span>
            </div>
            {% if challenge.partnerNote %}
                <div class="sc-note"><strong>Le mot de {{ partner ? partner.displayName : 'votre conjoint' }}</strong><br>{{ challenge.partnerNote }}</div>
            {% endif %}
            {% if challenge.todayDoneByMe %}
                <p class="sc-mini">Vous avez validé ce jour. Il reste à {{ partner ? partner.displayName : 'votre conjoint' }} de le valider pour ouvrir le jour suivant.</p>
            {% else %}
                <form method="post" action="{{ path('app_couple_challenge_check') }}" style="display: grid; gap: .5rem;">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <textarea name="note" class="ks-input" rows="2" maxlength="500" placeholder="Un mot pour votre conjoint sur ce que vous avez vécu (facultatif)" aria-label="Un mot pour votre conjoint"></textarea>
                    <div><button class="ks-btn ks-btn--primary" type="submit">J'ai vécu le jour {{ challenge.currentDay }}</button></div>
                </form>
            {% endif %}
        {% else %}
            <p class="sc-mini">Aucun défi en cours. Choisissez-en un ci-dessous ; {{ partner ? partner.displayName : 'votre conjoint' }} sera prévenu(e).</p>
        {% endif %}
    </section>

    <section class="ks-card">
        <h2 class="ks-section-title"><i data-lucide="list" class="ks-ico" aria-hidden="true"></i> Les défis</h2>
        <div class="ks-grid">
            {% for code, c in catalog %}
                <div class="ks-card ks-card--flat">
                    <p class="sc-mini" style="margin-bottom: .3rem;">{{ themes[c.theme][0] ?? '' }} · {{ c.durationDays }} jours</p>
                    <strong>{{ c.title }}</strong>
                    <p class="sc-mini" style="margin: .3rem 0 .8rem;">{{ c.subtitle }}</p>
                    {% if active and challenge.code == code %}
                        <span class="ks-badge">En cours</span>
                    {% else %}
                        <form method="post" action="{{ path('app_couple_challenge_start') }}"{% if active %} onsubmit="return confirm('Ce défi remplacera celui en cours. Continuer ?')"{% endif %}>
                            <input type="hidden" name="code" value="{{ code }}"><input type="hidden" name="_csrf_token" value="{{ token }}">
                            <button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit">Commencer ce défi</button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
