{% extends 'base.html.twig' %}

{% block title %}L'Autel · Sanctuaire du Couple{% endblock %}

{% block body %}
<style>
    .sc-verse { font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.55; color: var(--fg); }
    .sc-ref { display: block; margin-top: .5rem; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--couple); }
    .sc-step { font-size: .78rem; font-weight: 700; color: var(--couple); text-transform: uppercase; letter-spacing: .06em; }
    .sc-bar { height: 6px; border-radius: 999px; background: var(--couple-soft); overflow: hidden; margin: .5rem 0 1rem; }
    .sc-bar span { display: block; height: 100%; background: var(--couple); }
    .sc-question { background: var(--couple-soft); border-radius: var(--r-md); padding: 1rem; margin: 1rem 0; }
    .sc-mini { font-size: .82rem; color: var(--fg-muted); }
    .sc-item { border-top: 1px solid var(--bg-alt); padding: .75rem 0; display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
    .sc-item:first-of-type { border-top: none; }
    .sc-x { background: none; border: none; color: var(--border-strong); cursor: pointer; font-size: 1.1rem; }
    .sc-x:hover { color: var(--danger); }
    section.ks-card { margin-bottom: 1.25rem; }
    .sc-rhythm { display: flex; gap: .5rem; align-items: flex-start; background: var(--primary-soft); color: var(--primary-dark); border-radius: var(--r-md); padding: .8rem 1rem; margin: .5rem 0 0; font-size: .92rem; }
    .sc-who { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .sc-who span { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; font-weight: 600; padding: .3rem .7rem; border-radius: 999px; background: var(--bg-alt); color: var(--fg-muted); }
    .sc-who span.done { background: var(--primary-soft); color: var(--primary); }
    .ks-card > .ks-section-title:first-child { margin-top: 0; display: flex; align-items: center; gap: .5rem; }
</style>
{% set token = csrf_token('couple') %}

<div class="ks-page ks-page--narrow">
    {% include 'shared/_page_header.html.twig' with {
        back: {url: path('app_couple', {'_fragment': 'sanctuaire'}), label: 'Notre couple'},
        eyebrow: 'Sanctuaire du Couple', icon: 'flame',
        title: 'L\'Autel',
        lead: 'Un temps simple pour méditer la Parole à deux et porter ensemble vos sujets de prière.'
    } %}

    <section class="ks-card">
        <p class="sc-mini" style="margin-bottom: .5rem;">La parole du jour pour votre foyer</p>
        <p class="sc-verse">« {{ dailyVerse.text }} »<span class="sc-ref">{{ dailyVerse.reference }}</span></p>
    </section>

    <section class="ks-card" id="meditation">
        <h2 class="ks-section-title"><i data-lucide="book-open" class="ks-ico" aria-hidden="true"></i> Méditation à deux</h2>
        {% if meditation and meditation.locked %}
            <p class="sc-step">{{ meditation.title }} · étape {{ meditation.currentStep }} sur {{ meditation.totalSteps }}</p>
            <p class="sc-rhythm"><i data-lucide="sunrise" class="ks-ico" aria-hidden="true"></i> Étape {{ meditation.currentStep - 1 }} vécue ensemble. {{ meditation.rhythmMessage }}</p>
        {% elseif meditation and meditation.status != 'FINISHED' and meditation.step %}
            <p class="sc-step">{{ meditation.title }} · étape {{ meditation.currentStep }} sur {{ meditation.totalSteps }}</p>
            <div class="sc-bar" aria-hidden="true"><span style="width: {{ ((meditation.currentStep - 1) / meditation.totalSteps * 100)|round }}%;"></span></div>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; margin-bottom: .5rem;">{{ meditation.step.title }}</h3>
            <p class="sc-verse" style="font-size: 1rem;">{{ meditation.step.verse }}</p>
            <p style="margin-top: .75rem;">{{ meditation.step.reflection }}</p>
            <div class="sc-question">
                <strong>À partager ensemble</strong>
                <p style="margin-top: .3rem;">{{ meditation.step.question }}</p>
            </div>
            {% set partnerName = partner ? partner.displayName : 'votre conjoint' %}
            <div class="sc-who">
                <span class="{{ meditation.stepDoneByMe ? 'done' }}"><i data-lucide="{{ meditation.stepDoneByMe ? 'check' : 'circle' }}" class="ks-ico" aria-hidden="true"></i> Vous</span>
                <span class="{{ meditation.stepDoneByPartner ? 'done' }}"><i data-lucide="{{ meditation.stepDoneByPartner ? 'check' : 'circle' }}" class="ks-ico" aria-hidden="true"></i> {{ partnerName }}</span>
            </div>
            {% if meditation.stepDoneByMe %}
                <p class="sc-mini">Vous avez vécu cette étape. Elle avancera quand {{ partnerName }} l'aura validée à son tour.</p>
            {% else %}
                <form method="post" action="{{ path('app_couple_altar_step') }}">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button class="ks-btn ks-btn--primary" type="submit">J'ai vécu cette étape</button>
                </form>
                <p class="sc-mini" style="margin-top: .6rem;">Prenez environ {{ meditation.durationMinutes }} minutes ensemble. L'étape avance quand vous l'avez validée tous les deux.</p>
            {% endif %}
        {% else %}
            <p class="sc-mini">Aucun parcours en cours. Choisissez-en un ci-dessous : quelques étapes, une parole, une question à partager.</p>
        {% endif %}
    </section>

    <section class="ks-card">
        <h2 class="ks-section-title"><i data-lucide="list" class="ks-ico" aria-hidden="true"></i> Les parcours</h2>
        {% for code, m in catalog %}
            <div class="sc-item">
                <div style="flex: 1;">
                    <strong>{{ m.title }}</strong>
                    <p class="sc-mini" style="margin-top: .2rem;">{{ m.subtitle }} · {{ m.steps|length }} étapes, environ {{ m.durationMinutes }} minutes chacune</p>
                </div>
                {% if meditation and meditation.status != 'FINISHED' and meditation.code == code %}
                    <span class="ks-badge">En cours</span>
                {% else %}
                    <form method="post" action="{{ path('app_couple_altar_start') }}"{% if meditation and meditation.status != 'FINISHED' %} onsubmit="return confirm('Ce parcours remplacera celui en cours. Continuer ?')"{% endif %}>
                        <input type="hidden" name="code" value="{{ code }}"><input type="hidden" name="_csrf_token" value="{{ token }}">
                        <button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit">Commencer</button>
                    </form>
                {% endif %}
            </div>
        {% endfor %}
    </section>

    {% include 'couple/sanctuary/_retreat.html.twig' with {retour: 'autel'} %}

    <section class="ks-card" id="intentions">
        <h2 class="ks-section-title"><i data-lucide="hand-heart" class="ks-ico" aria-hidden="true"></i> Nos intentions de prière</h2>
        <p class="sc-mini" style="margin-bottom: .75rem;">Les sujets que vous confiez à Dieu ensemble. Vous les voyez tous les deux.</p>
        {% for i in intentions %}
            <div class="sc-item">
                <div style="flex: 1;">
                    <strong>{{ i.title }}</strong>
                    {% if i.details %}<p class="sc-mini" style="margin-top: .2rem;">{{ i.details }}</p>{% endif %}
                    <p class="sc-mini">Ajoutée par {{ i.createdBy ? i.createdBy.displayName : 'l\'un de vous' }} le {{ i.createdAt|format_date(pattern: 'd MMMM', locale: 'fr') }}</p>
                </div>
                <form method="post" action="{{ path('app_couple_intention_delete', {id: i.id}) }}" onsubmit="return confirm('Retirer cette intention ?')">
                    <input type="hidden" name="_csrf_token" value="{{ token }}">
                    <button class="sc-x" type="submit" aria-label="Retirer {{ i.title }}">×</button>
                </form>
            </div>
        {% else %}
            <p class="sc-mini">Aucune intention pour l'instant.</p>
        {% endfor %}
        <form method="post" action="{{ path('app_couple_intention_add') }}" style="display: grid; gap: .5rem; margin-top: 1rem;">
            <input type="hidden" name="_csrf_token" value="{{ token }}">
            <input name="title" class="ks-input" required maxlength="255" placeholder="Ex. : La santé de maman, notre décision de déménager" aria-label="Intention">
            <input name="details" class="ks-input" maxlength="1000" placeholder="Précisions (facultatif)" aria-label="Précisions">
            <div><button class="ks-btn ks-btn--primary ks-btn--sm" type="submit">Ajouter l'intention</button></div>
        </form>
    </section>
</div>
{% endblock %}
