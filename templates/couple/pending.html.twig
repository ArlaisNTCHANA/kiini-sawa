{% extends 'base.html.twig' %}

{% block title %}Notre couple{% endblock %}

{% block body %}
<div style="max-width: 640px; margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <h1 style="font-family: var(--font-serif); color: var(--primary); font-size: 2rem;">En attente de votre conjoint</h1>
    <p style="color: var(--fg-light); margin: .4rem 0 1.5rem;">{% if couple.invitedEmail %}Une invitation a été envoyée à <strong>{{ couple.invitedEmail }}</strong>. {% endif %}Partagez ce lien avec votre conjoint : il (elle) créera son compte, puis rejoindra votre espace.</p>
    <div style="display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <input value="{{ inviteUrl }}" readonly onclick="this.select()" aria-label="Lien d'invitation" style="flex: 1; min-width: 240px; padding: .7rem .85rem; border: 1.5px solid #E2E8F0; border-radius: var(--r-md); font: inherit;">
        <button type="button" onclick="navigator.clipboard.writeText('{{ inviteUrl|e('js') }}'); this.textContent = 'Copié ✓'" style="padding: .7rem 1.1rem; border: none; border-radius: var(--r-md); background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer;">Copier</button>
        <a target="_blank" rel="noopener" href="https://wa.me/?text={{ ('Rejoins-moi sur KIINI SAWA pour bâtir notre couple : ' ~ inviteUrl)|url_encode }}" style="padding: .7rem 1.1rem; border-radius: var(--r-md); background: var(--bg-alt); color: var(--fg); font-weight: 600; text-decoration: none;">WhatsApp</a>
    </div>
    <form method="post" action="{{ path('app_couple_settings') }}" onsubmit="return confirm('Annuler l\'invitation ?')">
        <input type="hidden" name="action" value="dissolve"><input type="hidden" name="_csrf_token" value="{{ csrf_token('couple') }}">
        <button type="submit" style="background: none; border: none; color: var(--fg-muted); text-decoration: underline; cursor: pointer; font: inherit;">Annuler l'invitation</button>
    </form>
</div>
{% endblock %}
