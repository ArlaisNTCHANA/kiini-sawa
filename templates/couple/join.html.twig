{% extends 'base.html.twig' %}

{% block title %}Rejoindre l'espace couple{% endblock %}

{% block body %}
<div style="max-width: 560px; margin: 0 auto; padding: 3rem 1.25rem 8rem;">
    <div style="background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 2rem;">
        <p style="font-size: .75rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--couple);">Invitation</p>
        <h1 style="font-family: var(--font-serif); font-size: 1.8rem; margin: .4rem 0 .6rem;">{{ couple.partnerA.displayName }} vous invite à bâtir votre couple</h1>
        <p style="color: var(--fg-light); margin-bottom: 1.25rem;">Un espace commun pour votre vision, vos valeurs, vos projets et vos thèmes de croissance. Votre Plan de Vie et votre journal personnels restent privés.</p>
        <form method="post">
            <label style="display: flex; gap: .6rem; align-items: flex-start; cursor: pointer; background: var(--bg); border-radius: var(--r-md); padding: 1rem;">
                <input type="checkbox" name="shareTests" value="1" checked style="margin-top: .3rem; accent-color: var(--primary);">
                <span><strong>Je partage mes résultats de tests</strong> avec mon conjoint, pour le rapport croisé de notre couple.<br><span style="font-size: .8rem; color: var(--fg-muted);">Modifiable à tout moment.</span></span>
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('couple_join') }}">
            <button type="submit" style="margin-top: 1.25rem; width: 100%; padding: .9rem; border: none; border-radius: var(--r-md); background: var(--primary); color: #fff; font: inherit; font-weight: 700; cursor: pointer;">Rejoindre notre espace couple</button>
        </form>
    </div>
</div>
{% endblock %}
