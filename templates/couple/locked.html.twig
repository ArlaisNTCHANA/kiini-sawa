{% extends 'base.html.twig' %}

{% block title %}Notre couple{% endblock %}

{% block body %}
<div style="max-width: 640px; margin: 0 auto; padding: 2.5rem 1.25rem 8rem;">
    <h1 style="font-family: var(--font-serif); color: var(--primary); font-size: 2rem;">Votre espace couple vous attend</h1>
    <p style="color: var(--fg-light); margin: .5rem 0 1.25rem;">Vous êtes reliés, {{ partner.displayName }} et vous. Pour ouvrir l'espace couple, vous devez être PRO tous les deux : le plus simple est l'abonnement <strong>Duo</strong>.</p>
    <div style="background: var(--card-bg); box-shadow: var(--card-shadow); border-radius: var(--r-lg); padding: 1.5rem; margin-bottom: 1rem;">
        <p style="font-family: var(--font-serif); font-size: 1.6rem;">{{ duo.EUR|money('EUR') }} <small style="font-size: .9rem; color: var(--fg-muted);">ou {{ duo.XAF|money('XAF') }} par an, pour vous deux</small></p>
        <p style="color: var(--fg-muted); font-size: .9rem; margin: .3rem 0 1rem;">Au lieu de {{ duo.twoProEur|money('EUR') }} ou {{ duo.twoProXaf|money('XAF') }} pour deux abonnements PRO. Un seul paiement suffit : vous devenez PRO tous les deux.</p>
        <a href="{{ path('app_subscription') }}#duo" style="display: inline-block; padding: .85rem 1.4rem; border-radius: var(--r-md); background: var(--primary); color: #fff; font-weight: 700; text-decoration: none;">Choisir Duo</a>
    </div>
    <form method="post" action="{{ path('app_couple_settings') }}" onsubmit="return confirm('Fermer l\'espace couple ?')">
        <input type="hidden" name="action" value="dissolve"><input type="hidden" name="_csrf_token" value="{{ csrf_token('couple') }}">
        <button type="submit" style="background: none; border: none; color: var(--fg-muted); text-decoration: underline; cursor: pointer; font: inherit;">Fermer l'espace couple</button>
    </form>
</div>
{% endblock %}
