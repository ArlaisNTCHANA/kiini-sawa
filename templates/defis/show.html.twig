{% extends 'base.html.twig' %}

{% block title %}{{ challenge.title }}{% endblock %}

{% block head_meta %}
    <meta name="description" content="{{ challenge.tagline ?? challenge.description|striptags|slice(0, 150) }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ challenge.title }} — KIINI SAWA">
    <meta property="og:description" content="{{ challenge.tagline ?? 'Un défi collectif pour grandir, un jour à la fois.' }}">
    <meta property="og:url" content="{{ shareUrl }}">
    <meta property="og:image" content="{{ absolute_url('/icons/icon-512.png') }}">
{% endblock %}

{% block body %}
{% if not app.user %}{% include 'shared/_public_header.html.twig' %}{% endif %}
{% set duration = challenge.durationDays %}
{% set trackedShare = shareUrl ~ '?utm_source=whatsapp&utm_medium=partage&utm_campaign=defi-' ~ challenge.slug %}
{% set shareText = (successful ? 'J\'ai relevé le défi « ' ~ challenge.title ~ ' » sur KIINI SAWA ! Le prochain, on le fait ensemble ? ' : 'Je relève le défi « ' ~ challenge.title ~ ' » sur KIINI SAWA. Tu viens avec moi ? ') ~ trackedShare %}
<div class="ks-page ks-page--narrow">
    {% embed 'shared/_page_header.html.twig' with {
        eyebrow: 'Défi collectif · ' ~ duration ~ ' jours', icon: 'trophy',
        title: challenge.title,
        lead: challenge.tagline,
        back: app.user ? {url: path('app_challenges'), label: 'Les défis'} : null,
    } %}{% endembed %}

    {# État du défi #}
    <div class="ks-card" style="margin-bottom: 1rem;">
        <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: center;">
            <div>
                {% if phase == 'upcoming' %}
                    <p class="ks-eyebrow">Commence le</p>
                    <p style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--fg);">{{ challenge.startDate|format_date(pattern: 'EEEE d MMMM', locale: 'fr') }}</p>
                    <p style="color: var(--fg-muted); font-size: .9rem;">dans {{ 1 - day }} jour{{ 1 - day > 1 ? 's' }}</p>
                {% elseif phase == 'running' %}
                    <p class="ks-eyebrow">En cours</p>
                    <p style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--fg);">Jour {{ day }} sur {{ duration }}</p>
                    <p style="color: var(--fg-muted); font-size: .9rem;">jusqu'au {{ challenge.endDate|format_date(pattern: 'd MMMM', locale: 'fr') }}</p>
                {% else %}
                    <p class="ks-eyebrow">Terminé</p>
                    <p style="font-family: var(--font-serif); font-size: 1.4rem; color: var(--fg);">Le {{ challenge.endDate|format_date(pattern: 'd MMMM y', locale: 'fr') }}</p>
                {% endif %}
            </div>
            <div style="display: flex; gap: 1.5rem;">
                <div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.participants }}</p><p class="ks-eyebrow">participant{{ stats.participants > 1 ? 's' }}</p></div>
                {% if phase == 'running' %}<div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.checkedToday }}</p><p class="ks-eyebrow">ont validé aujourd'hui</p></div>{% endif %}
                {% if phase == 'ended' %}<div><p style="font-size: 1.6rem; font-weight: 800; color: var(--primary);">{{ stats.successful }}</p><p class="ks-eyebrow">l'ont relevé</p></div>{% endif %}
            </div>
        </div>
        {% if phase == 'running' %}
            <div style="height: 6px; background: var(--border); border-radius: 99px; margin-top: 1rem; overflow: hidden;"><div style="height: 6px; width: {{ (day / duration * 100)|round }}%; background: var(--primary);"></div></div>
        {% endif %}
    </div>

    {% if participation %}
        {# Espace du participant #}
        <div class="ks-card ks-card--accent" style="margin-bottom: 1rem;">
            {% if phase == 'running' %}
                <p class="ks-eyebrow">Votre action du jour {{ day }}</p>
                <p style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--fg); margin: .4rem 0 1rem;">{{ challenge.actionForDay(day) }}</p>
                {% if checkedToday %}
                    <p class="ks-alert ks-alert--success">✓ Journée validée. Rendez-vous demain !</p>
                {% else %}
                    <form method="post" action="{{ path('app_challenge_checkin', {slug: challenge.slug}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('challenge_checkin') }}">
                        <button type="submit" class="ks-btn ks-btn--primary">J'ai fait ma part aujourd'hui ✓</button>
                    </form>
                {% endif %}
            {% elseif phase == 'upcoming' %}
                <p class="ks-alert ks-alert--info">Vous êtes inscrit. Le jour J, vous recevrez votre première action par e-mail ; revenez ici chaque jour pour la valider.</p>
            {% else %}
                <p class="ks-eyebrow">Défi terminé</p>
            {% endif %}

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 1.25rem; text-align: center;">
                <div><p style="font-size: 1.4rem; font-weight: 800;">{{ participation.progress }}<span style="font-size: .9rem; color: var(--fg-muted);">/{{ duration }}</span></p><p class="ks-eyebrow">jours validés</p></div>
                <div><p style="font-size: 1.4rem; font-weight: 800;">{{ streak }}</p><p class="ks-eyebrow">jours d'affilée</p></div>
                <div><p style="font-size: 1.4rem; font-weight: 800;">{{ threshold }}</p><p class="ks-eyebrow">pour le relever</p></div>
            </div>
            {% if successful %}
                <div style="margin-top: 1.25rem; text-align: center; background: var(--warning-soft); border-radius: var(--r-md); padding: 1rem;">
                    <p style="font-size: 2rem;"><i data-lucide="trophy" class="ks-ico" aria-hidden="true"></i></p>
                    <p style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--fg);">Défi relevé !</p>
                    <p style="color: var(--fg-muted); font-size: .9rem;">Vous avez validé {{ participation.progress }} jours sur {{ duration }}. Partagez-le pour encourager quelqu'un d'autre.</p>
                </div>
            {% endif %}
        </div>
    {% elseif phase != 'ended' %}
        {# Inscription #}
        <div class="ks-card" style="margin-bottom: 1rem; text-align: center;">
            <form method="post" action="{{ path('app_challenge_join', {slug: challenge.slug}) }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('challenge_join') }}">
                <button type="submit" class="ks-btn ks-btn--primary" style="font-size: 1rem; padding: .9rem 1.6rem;">Je relève le défi</button>
                <p style="color: var(--fg-muted); font-size: .85rem; margin-top: .6rem;">Gratuit. {{ app.user ? 'Un clic suffit.' : 'Vous créerez votre compte KIINI SAWA en une minute.' }}</p>
                {% if not app.user %}<button type="submit" name="hasAccount" value="1" class="ks-btn ks-btn--ghost" style="margin-top: .25rem;">J'ai déjà un compte</button>{% endif %}
            </form>
        </div>
    {% endif %}

    {% if challenge.description %}
        <div class="ks-card" style="margin-bottom: 1rem;">
            <h2 class="ks-section-title" style="margin-top: 0;">Le défi</h2>
            <div style="color: var(--fg-light); line-height: 1.7; white-space: pre-line;">{{ challenge.description }}</div>
            {% if challenge.habitTitle %}<p style="margin-top: 1rem;"><strong>Chaque jour :</strong> {{ challenge.habitTitle }}</p>{% endif %}
            <p style="margin-top: .75rem; color: var(--fg-muted); font-size: .9rem;">Le défi est relevé avec au moins {{ threshold }} jours validés sur {{ duration }}.</p>
        </div>
    {% endif %}

    {% if leaderboard|length %}
        <div class="ks-card" style="margin-bottom: 1rem;">
            <h2 class="ks-section-title" style="margin-top: 0;">Ceux qui avancent</h2>
            <ol style="list-style: none; padding: 0; margin: 0;">
                {% for row in leaderboard %}
                    <li style="display: flex; justify-content: space-between; padding: .55rem 0; border-top: {{ loop.first ? 'none' : '1px solid var(--border)' }}; {{ row.me ? 'font-weight: 700; color: var(--primary);' }}">
                        <span>{{ loop.index }}. {{ row.name }}{{ row.me ? ' (vous)' }}</span>
                        <span>{{ row.progress }} jour{{ row.progress > 1 ? 's' }}</span>
                    </li>
                {% endfor %}
            </ol>
        </div>
    {% endif %}

    {# Partage #}
    <div class="ks-card" x-data="{ copied: false }">
        <h2 class="ks-section-title" style="margin-top: 0;">Invitez quelqu'un</h2>
        <p style="color: var(--fg-muted); margin-bottom: 1rem;">« Deux valent mieux qu'un. » Ceux qui relèvent un défi à plusieurs tiennent bien plus longtemps.</p>
        <div style="display: flex; flex-wrap: wrap; gap: .6rem;">
            <a class="ks-btn ks-btn--primary" style="background: #25D366;" target="_blank" rel="noopener" href="https://wa.me/?text={{ shareText|url_encode }}"><i data-lucide="message-circle"></i> WhatsApp</a>
            <a class="ks-btn ks-btn--secondary" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ (shareUrl ~ '?utm_source=facebook&utm_medium=partage&utm_campaign=defi-' ~ challenge.slug)|url_encode }}"><i data-lucide="share-2"></i> Facebook</a>
            <button type="button" class="ks-btn ks-btn--secondary" @click="navigator.clipboard.writeText('{{ (shareUrl ~ '?utm_source=lien&utm_medium=partage&utm_campaign=defi-' ~ challenge.slug)|e('js') }}'); copied = true; setTimeout(() => copied = false, 2000)"><i data-lucide="link"></i> <span x-text="copied ? 'Lien copié ✓' : 'Copier le lien'">Copier le lien</span></button>
        </div>
    </div>
</div>
{% endblock %}
