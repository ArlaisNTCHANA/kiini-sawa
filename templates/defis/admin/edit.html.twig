{% extends 'admin/layout.html.twig' %}
{% block title %}{{ challenge ? challenge.title : 'Nouveau défi' }}{% endblock %}
{% block page_title %}{{ challenge ? challenge.title : 'Nouveau défi' }}{% endblock %}
{% block crumbs %}<span aria-hidden="true">›</span><span aria-current="page">{{ challenge ? challenge.title : 'Nouveau défi' }}</span>{% endblock %}
{% block content %}
<div class="ks-stack" style="max-width: 820px;">
    {% for e in errors %}<div class="ks-alert ks-alert--danger" role="alert">{{ e }}</div>{% endfor %}

    {% if challenge and publicUrl %}
        <section class="ks-card ks-card--accent" x-data="{ copied: '' }">
            <h2 class="ks-card__title"><i data-lucide="globe"></i> Page publique {{ challenge.published ? '(en ligne)' : '(brouillon : visible seulement une fois publié)' }}</h2>
            <p><a href="{{ publicUrl }}" target="_blank" rel="noopener" style="color: var(--primary); overflow-wrap: anywhere;">{{ publicUrl }}</a></p>
            <p class="ks-muted" style="margin: .8rem 0 .5rem;">Liens suivis à publier (les inscriptions apparaîtront dans « D'où viennent les inscrits », campagne defi-{{ challenge.slug }}) :</p>
            <div class="ks-toolbar">
                {% for src in ['tiktok', 'instagram', 'facebook', 'youtube', 'whatsapp', 'newsletter'] %}
                    {% set link = publicUrl ~ '?utm_source=' ~ src ~ '&utm_medium=' ~ (src == 'newsletter' ? 'email' : 'bio') ~ '&utm_campaign=defi-' ~ challenge.slug %}
                    <button type="button" class="ks-btn ks-btn--secondary ks-btn--sm" @click="navigator.clipboard.writeText('{{ link|e('js') }}'); copied = '{{ src }}'; setTimeout(() => copied = '', 2000)"><i data-lucide="link"></i><span x-text="copied === '{{ src }}' ? 'Copié ✓' : '{{ src|capitalize }}'">{{ src|capitalize }}</span></button>
                {% endfor %}
            </div>
            {% if stats %}<p class="ks-muted" style="margin-top: .9rem;">{{ stats.participants }} inscrit(s) · {{ stats.checkedToday }} validation(s) aujourd'hui · {{ stats.successful }} l'ont relevé</p>{% endif %}
        </section>
    {% endif %}

    <form method="post" class="ks-card ks-stack">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_challenge') }}">
        <div class="ks-field"><label class="ks-label" for="title">Titre</label><input class="ks-input" id="title" name="title" value="{{ data.title }}" placeholder="21 jours de discipline" required></div>
        <div class="ks-form-grid">
            <div class="ks-field"><label class="ks-label" for="slug">Adresse (après /defi/)</label><input class="ks-input" id="slug" name="slug" value="{{ data.slug }}" placeholder="21-jours-de-discipline"><p class="ks-help">Laissez vide pour la créer à partir du titre.</p></div>
            <div class="ks-field"><label class="ks-label" for="startDate">Premier jour</label><input class="ks-input" type="date" id="startDate" name="startDate" value="{{ data.startDate }}" required></div>
            <div class="ks-field"><label class="ks-label" for="duration">Durée (jours)</label><input class="ks-input" type="number" min="3" max="100" id="duration" name="duration" value="{{ data.duration }}" required></div>
        </div>
        <div class="ks-field"><label class="ks-label" for="tagline">Accroche</label><input class="ks-input" id="tagline" name="tagline" value="{{ data.tagline }}" maxlength="255" placeholder="Une petite victoire par jour, pour reprendre la main sur ta vie."></div>
        <div class="ks-field"><label class="ks-label" for="description">Présentation</label><textarea class="ks-input" id="description" name="description" rows="5" placeholder="Pourquoi ce défi, ce qu'il va changer, comment ça marche.">{{ data.description }}</textarea></div>
        <div class="ks-field"><label class="ks-label" for="habitTitle">Action de chaque jour</label><input class="ks-input" id="habitTitle" name="habitTitle" value="{{ data.habitTitle }}" placeholder="Me lever à l'heure prévue et prier 10 minutes"><p class="ks-help">Utilisée les jours sans action particulière ci-dessous.</p></div>
        <div class="ks-field"><label class="ks-label" for="dailyActions">Actions jour par jour (facultatif : une ligne = un jour)</label><textarea class="ks-input" id="dailyActions" name="dailyActions" rows="10" placeholder="Jour 1 : écrire pourquoi je veux devenir plus discipliné&#10;Jour 2 : préparer la journée de demain avant de dormir&#10;…">{{ data.dailyActions }}</textarea></div>
        <label style="display: flex; gap: .6rem; align-items: center; font-size: .92rem;"><input type="checkbox" name="published" value="1" {{ data.published ? 'checked' }}> Publié : page visible et inscriptions ouvertes</label>
        <div class="ks-sticky-actions">
            <button type="submit" class="ks-btn ks-btn--primary"><i data-lucide="check"></i> Enregistrer</button>
            <a href="{{ path('admin_challenges') }}" class="ks-btn ks-btn--ghost">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}
