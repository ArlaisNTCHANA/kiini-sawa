{% extends 'admin/layout.html.twig' %}
{% block title %}Défis collectifs{% endblock %}
{% block page_title %}Défis collectifs{% endblock %}
{% block page_lead %}Un défi collectif a une page publique à partager sur les réseaux : chacun s'inscrit en un clic et valide sa journée.{% endblock %}
{% block page_actions %}<a href="{{ path('admin_challenges_new') }}" class="ks-btn ks-btn--primary"><i data-lucide="plus"></i> Nouveau défi</a>{% endblock %}
{% block content %}
{% if rows is empty %}
    <div class="ks-card ks-empty">
        <span class="ks-empty__icon"><i data-lucide="trophy"></i></span>
        <p class="ks-empty__title">Aucun défi pour l'instant</p>
        <p class="ks-empty__text">Créez le premier, par exemple « 21 jours de discipline ».</p>
        <a href="{{ path('admin_challenges_new') }}" class="ks-btn ks-btn--secondary"><i data-lucide="plus"></i> Créer un défi</a>
    </div>
{% else %}
    <section class="ks-card">
        <div class="ks-table-wrap">
            <table class="ks-table ks-table--cards">
                <thead><tr><th>Défi</th><th>Dates</th><th>État</th><th class="is-num">Inscrits</th><th class="is-num">Validé aujourd'hui</th><th class="is-num">Relevé</th><th></th></tr></thead>
                <tbody>
                {% for r in rows %}
                    <tr>
                        <td><strong>{{ r.c.title }}</strong><br><span class="ks-small">/defi/{{ r.c.slug }}</span></td>
                        <td data-label="Dates">{{ r.c.startDate|date('d/m/Y') }} → {{ r.c.endDate|date('d/m/Y') }}<br><span class="ks-small">{{ r.c.durationDays }} jours</span></td>
                        <td data-label="État"><span class="ks-badge {{ r.c.published ? (r.phase == 'ended' ? 'ks-badge--muted' : 'ks-badge--success') : 'ks-badge--warning' }}">{{ r.c.published ? {upcoming: 'Publié · à venir', running: 'Publié · en cours', ended: 'Terminé'}[r.phase] : 'Brouillon' }}</span></td>
                        <td data-label="Inscrits" class="is-num">{{ r.stats.participants }}</td>
                        <td data-label="Validé aujourd'hui" class="is-num">{{ r.phase == 'running' ? r.stats.checkedToday : '—' }}</td>
                        <td data-label="Relevé" class="is-num">{{ r.stats.successful }}</td>
                        <td data-label=""><a href="{{ path('admin_challenges_edit', {id: r.c.id}) }}" class="ks-btn ks-btn--secondary ks-btn--sm"><i data-lucide="pencil"></i> Modifier</a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endif %}
{% endblock %}
