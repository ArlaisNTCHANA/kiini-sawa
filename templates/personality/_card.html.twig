{# Partial: personality/_card.html.twig #}
<div class="test-card">
    {% if done %}
    <div class="test-card-done-badge">
        <svg style="width:10px;height:10px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
        Complété
    </div>
    {% endif %}

    <div class="test-card-header">
        <div class="test-card-icon" style="background:{{ meta.bg }};color:{{ meta.color }};">
            {% if meta.icon == 'brain' %}
            <svg viewBox="0 0 24 24"><path d="M9.5 2a2.5 2.5 0 0 1 5 0v1a2.5 2.5 0 0 1 0 5v2a2.5 2.5 0 0 1 0 5v1a2.5 2.5 0 0 1-5 0v-1a2.5 2.5 0 0 1 0-5V8a2.5 2.5 0 0 1 0-5V2z"/></svg>
            {% elseif meta.icon == 'zap' %}
            <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            {% elseif meta.icon == 'target' %}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            {% elseif meta.icon == 'sparkles' %}
            <svg viewBox="0 0 24 24"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M5 17l1 3 3-1-1-3-3 1z"/><path d="M19 17l-1 3-3-1 1-3 3 1z"/></svg>
            {% elseif meta.icon == 'compass' %}
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            {% elseif meta.icon == 'star' %}
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% elseif meta.icon == 'activity' %}
            <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            {% elseif meta.icon == 'heart' %}
            <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {% endif %}
        </div>
        <div class="test-card-meta">
            <div class="subtitle">{{ meta.subtitle }}</div>
            <h3>{{ meta.name }}</h3>
        </div>
    </div>

    <div class="test-card-body">
        <p>{{ meta.description }}</p>
    </div>

    <div class="questions-count" style="color:{{ meta.color }};">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {{ meta.questions }} questions
    </div>

    <div class="test-card-footer">
        <a href="{{ path('app_personality_take', {type: typeKey|lower}) }}" class="btn-take" style="background:{{ meta.color }};">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            {{ done ? 'Refaire' : 'Faire le test' }}
        </a>
        {% if done %}
        <a href="{{ path('app_personality_result', {type: typeKey|lower}) }}" class="btn-result">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            Résultats
        </a>
        {% endif %}
    </div>
</div>
