{% extends 'base.html.twig' %}

{% block title %}Résultats — {{ testMeta.name }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.result-page {
    min-height: 100vh;
    background: #f8f7f4;
    padding: 2.5rem 1.5rem 5rem;
}
.result-inner {
    max-width: 800px;
    margin: 0 auto;
}
.result-hero {
    background: #fff;
    border-radius: 24px;
    border: 1px solid #e8eaf0;
    overflow: hidden;
    margin-bottom: 1.5rem;
}
.result-hero-gradient {
    height: 8px;
    width: 100%;
}
.result-hero-body {
    padding: 2.5rem 2.5rem 2rem;
}
.result-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 10px;
    border: 1.5px solid #e2e8f0;
    background: transparent;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s;
    margin-bottom: 2rem;
}
.result-back:hover { background: #f1f5f9; }
.result-label {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #94a3b8;
    margin-bottom: 0.5rem;
}
.result-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
}
.result-code {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.25rem;
}
.result-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #1e293b;
    margin-bottom: 0.75rem;
}
.result-insights {
    font-size: 0.95rem;
    color: #475569;
    line-height: 1.7;
    max-width: 580px;
    font-style: italic;
    border-left: 3px solid;
    padding-left: 1rem;
    margin: 1.5rem 0;
}
.result-date {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 600;
}
.result-section {
    background: #fff;
    border-radius: 20px;
    border: 1px solid #e8eaf0;
    padding: 2rem 2.5rem;
    margin-bottom: 1.25rem;
}
.result-section h3 {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
    margin: 0 0 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}
.result-list {
    list-style: none;
    padding: 0;
    margin: 0;
}
.result-list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: #374151;
    line-height: 1.6;
    margin-bottom: 0.75rem;
}
.result-list-item:last-child {
    margin-bottom: 0;
}
.result-list-icon {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 0.2rem;
}
.result-list-icon.strength { color: #16a34a; }
.result-list-icon.weakness { color: #dc2626; }
.result-essence-explanation {
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 0.85rem;
    line-height: 1.5;
}
/* Chart */
.chart-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-start;
}
.radar-wrap {
    flex: 0 0 auto;
}
.bars-wrap {
    flex: 1;
    min-width: 200px;
}
.bar-row {
    margin-bottom: 0.85rem;
}
.bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.35rem;
}
.bar-track {
    height: 10px;
    background: #f1f5f9;
    border-radius: 99px;
    overflow: hidden;
}
.bar-fill {
    height: 100%;
    border-radius: 99px;
    transition: width 1s ease 0.2s;
}
.result-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}
.btn-retake {
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    border: 1.5px solid #e2e8f0;
    background: #fff;
    color: #374151;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: background 0.15s, transform 0.1s;
}
.btn-retake:hover { background: #f8fafc; transform: scale(1.01); }
.btn-catalogue {
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    border: none;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.15s, transform 0.1s;
}
.btn-catalogue:hover { opacity: 0.88; transform: scale(1.01); }
.subtheme-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.02) !important;
}
.subtheme-fill {
    transition: width 1s ease-out;
}
</style>
{% endblock %}

{% block body %}
<div class="result-page">
<div class="result-inner">

    {# ── Hero ── #}
    <div class="result-hero">
        <div class="result-hero-gradient" style="background:linear-gradient(90deg,{{ testMeta.color }},{{ testMeta.color }}88);"></div>
        <div class="result-hero-body">
            <a href="{{ path('app_personality_index') }}" class="result-back">
                <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                Tous mes tests
            </a>

            <div class="result-label">{{ testMeta.subtitle }}</div>
            <div class="result-type-badge" style="background:{{ testMeta.bg }};color:{{ testMeta.color }};">
                {{ testMeta.name }}
            </div>

            {% if not isMulti %}
            <div class="result-code" style="color:{{ testMeta.color }};">
                {% if type == 'ENNEAGRAMME' %}
                    Type {{ formattedResult }}
                {% else %}
                    {{ formattedResult }}
                {% endif %}
            </div>
            {% if profile %}
            <div class="result-title">{{ profile.title }}</div>
            {% endif %}
            {% else %}
            <div class="result-title" style="color:{{ testMeta.color }};">Votre profil {{ testMeta.name }}</div>
            {% if profile %}
            <div style="font-size:1.25rem; font-weight:600; color:#475569; margin-top: 0.5rem; margin-bottom:0.75rem;">Dominant : {{ profile.title }}</div>
            {% endif %}
            {% endif %}

            {% if test.insights %}
            <blockquote class="result-insights" style="border-color:{{ testMeta.color }};">
                {{ test.insights }}
            </blockquote>
            {% endif %}

            <div class="result-date">
                Test passé le {{ test.date|date('d/m/Y') }}
            </div>
        </div>
    </div>

    {# ── Chart (multidimensional tests) ── #}
    {% if isMulti and chartData is not empty %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><polyline points="7 16 11 12 15 14 19 8"/></svg>
            Votre profil détaillé
        </h3>
        <div class="chart-container">
            <div class="radar-wrap">
                {% include 'personality/_radar_chart.html.twig' with {data: chartData, color: testMeta.color} %}
            </div>
            <div class="bars-wrap">
                {% for item in chartData %}
                <div class="bar-row">
                    <div class="bar-label">
                        <span>{{ item.label }}</span>
                        <span style="color:{{ testMeta.color }};font-weight:800;">{{ item.value|round(1) }}</span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:{{ item.value > 10 ? item.value : (item.value * 10) }}%;background:{{ testMeta.color }};"></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Detailed breakdown by sub-theme (Hygiène de vie) ── #}
    {% if type == 'HYGIENE' and detailsData is not empty %}
    <div class="result-section" style="background: transparent; border: none; padding: 0; margin-bottom: 1.5rem;">
        <h3 style="margin-left: 0.5rem; margin-bottom: 1.25rem;">
            <svg style="width:14px;height:14px;color:{{ testMeta.color }};" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            Détails par sous-thèmes
        </h3>
        
        <div class="subthemes-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
            {% for axisKey, subthemes in detailsData %}
                <div class="subtheme-card" style="background: #ffffff; border: 1px solid #e8eaf0; border-radius: 20px; padding: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02), 0 2px 4px -1px rgba(0,0,0,0.01); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; gap: 1rem;">
                    
                    {# Header of Axis card #}
                    <div class="subtheme-card-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #f1f5f9; padding-bottom: 0.75rem;">
                        <span style="font-size: 1.05rem; font-weight: 700; color: #1e293b; text-transform: capitalize;">
                            {% if axisKey == 'physique' %}
                                🏃‍♂️ Physique
                            {% elseif axisKey == 'mental' %}
                                🧠 Mental
                            {% elseif axisKey == 'relationnel' %}
                                🤝 Relationnel
                            {% elseif axisKey == 'spirituel' %}
                                ✨ Spirituel
                            {% elseif axisKey == 'ressources' %}
                                ⚡ Ressources
                            {% elseif axisKey == 'environnement' %}
                                🏡 Environnement
                            {% else %}
                                {{ axisKey|capitalize }}
                            {% endif %}
                        </span>
                        
                        {# Look up axis score in chartData #}
                        {% set axisScore = 5.0 %}
                        {% for item in chartData %}
                            {% if item.key == axisKey %}
                                {% set axisScore = item.value %}
                            {% endif %}
                        {% endfor %}
                        <span style="background: {{ testMeta.bg }}; color: {{ testMeta.color }}; font-weight: 800; font-size: 0.85rem; padding: 0.25rem 0.65rem; border-radius: 8px;">
                            {{ axisScore|round(1) }}/10
                        </span>
                    </div>

                    {# List of sub-themes #}
                    <div class="subtheme-items" style="display: flex; flex-direction: column; gap: 0.85rem;">
                        {% for label, score in subthemes %}
                            <div class="subtheme-row">
                                <div class="subtheme-label" style="display: flex; justify-content: space-between; font-size: 0.82rem; font-weight: 600; color: #475569; margin-bottom: 0.3rem;">
                                    <span>{{ label }}</span>
                                    <span style="color: {{ testMeta.color }}; font-weight: 700;">{{ score|round(1) }}/10</span>
                                </div>
                                <div class="subtheme-track" style="height: 6px; background: #f1f5f9; border-radius: 99px; overflow: hidden;">
                                    <div class="subtheme-fill" style="width: {{ score * 10 }}%; height: 100%; border-radius: 99px; background: {{ testMeta.color }}; opacity: 0.85;"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Profil détaillé (MBTI / ENNEAGRAMME) ── #}
    {% if profile %}
    {% if profile.description %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Description
        </h3>
        <p class="result-description">{{ profile.description }}</p>
    </div>
    {% endif %}

    {% if profile.strengths %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;color:#16a34a;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Forces du Profil
        </h3>
        <ul class="result-list">
            {% for s in profile.strengths|split(',') %}
            <li class="result-list-item">
                <svg class="result-list-icon strength" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{{ s|trim }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% if profile.weaknesses %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;color:#dc2626;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Points d'attention &amp; Défis
        </h3>
        <ul class="result-list">
            {% for w in profile.weaknesses|split(',') %}
            <li class="result-list-item">
                <svg class="result-list-icon weakness" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <span>{{ w|trim }}</span>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    {% if profile.essence %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Moteur Profond &amp; Essence
        </h3>
        <p class="result-essence-explanation">
            <em>L'essence représente le besoin fondamental, la boussole intérieure et la motivation profonde qui guident inconsciemment vos choix de vie.</em>
        </p>
        <div class="result-essence" style="border-color:{{ testMeta.color }};background:{{ testMeta.bg }}; font-size: 1.05rem; font-style: italic; color: #1e293b; font-weight: 500; padding: 1.25rem; border-radius: 14px; border-left: 3px solid;">
            {{ profile.essence }}
        </div>
    </div>
    {% endif %}

    {% if profile.relationships %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Relations &amp; Communication
        </h3>
        <p class="result-description">{{ profile.relationships }}</p>
    </div>
    {% endif %}

    {% if profile.career %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            Carrière &amp; Style professionnel
        </h3>
        <p class="result-description">{{ profile.career }}</p>
    </div>
    {% endif %}

    {% if profile.emotionalDynamics %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
            Dynamiques émotionnelles
        </h3>
        <p class="result-description">{{ profile.emotionalDynamics }}</p>
    </div>
    {% endif %}

    {% if profile.growthAxes %}
    <div class="result-section">
        <h3>
            <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            Axes de développement &amp; croissance
        </h3>
        <p class="result-description">{{ profile.growthAxes }}</p>
    </div>
    {% endif %}
    {% endif %}

    {# ── Actions ── #}
    <div class="result-section" style="background:transparent;border:none;padding:0.5rem 0 0;">
        <div class="result-actions">
            <a href="{{ path('app_personality_take', {type: type|lower}) }}" class="btn-retake">
                <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.25"/></svg>
                Refaire le test
            </a>
            <a href="{{ path('app_personality_index') }}" class="btn-catalogue" style="background:{{ testMeta.color }};">
                <svg style="width:14px;height:14px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Tous mes tests
            </a>
        </div>
    </div>

</div>
</div>
{% endblock %}
