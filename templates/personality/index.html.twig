{% extends 'base.html.twig' %}

{% block title %}Mes Tests de Personnalité{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
:root {
    --page-bg: #f8f7f4;
}
.tests-hero {
    text-align: center;
    padding: 3.5rem 1.5rem 2.5rem;
}
.tests-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2.75rem;
    font-weight: 500;
    color: var(--fg-dark, #1a1a2e);
    margin-bottom: 0.75rem;
    line-height: 1.15;
}
.tests-hero p {
    color: var(--fg-muted, #64748b);
    font-size: 1.05rem;
    font-weight: 300;
    max-width: 520px;
    margin: 0 auto 2rem;
    line-height: 1.7;
}
.progress-bar-wrap {
    max-width: 300px;
    margin: 0 auto 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.progress-bar-track {
    height: 6px;
    background: #e2e8f0;
    border-radius: 99px;
    overflow: hidden;
    max-width: 300px;
    margin: 0 auto 2rem;
}
.progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6);
    border-radius: 99px;
    transition: width 0.8s ease;
}
.tests-disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: #f1f5f9;
    border-radius: 99px;
    font-size: 0.7rem;
    color: #94a3b8;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 3rem;
}
.tests-section-title {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #94a3b8;
    margin: 2.5rem 0 1.25rem;
}
.tests-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
}
.test-card {
    background: #fff;
    border: 1px solid #e8eaf0;
    border-radius: 20px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    display: flex;
    flex-direction: column;
}
.test-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.1);
}
.test-card-header {
    padding: 1.5rem 1.5rem 1rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
}
.test-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.test-card-icon svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
}
.test-card-meta h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 0.2rem;
}
.test-card-meta .subtitle {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
}
.test-card-body {
    padding: 0 1.5rem 0;
    flex: 1;
}
.test-card-body p {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0 0 1rem;
}
.test-card-footer {
    padding: 1rem 1.5rem 1.5rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
}
.test-card-done-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.6rem;
    border-radius: 99px;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #dcfce7;
    color: #16a34a;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}
.btn-take {
    flex: 1;
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: #fff;
    transition: opacity 0.2s, transform 0.1s;
}
.btn-take:hover { opacity: 0.88; transform: scale(1.02); }
.btn-result {
    padding: 0.6rem 0.75rem;
    border-radius: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    border: 1.5px solid #e2e8f0;
    background: transparent;
    color: #475569;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s, border-color 0.2s;
}
.btn-result:hover { background: #f8fafc; border-color: #cbd5e1; }
.questions-count {
    font-size: 0.7rem;
    color: #94a3b8;
    margin-top: auto;
    padding: 0 1.5rem 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}
.icon-svg { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
</style>
{% endblock %}

{% block body %}
<div style="min-height: 100vh; background: var(--page-bg, #f8f7f4);">
<div style="max-width: 960px; margin: 0 auto; padding: 0 1.5rem 4rem;">

    {# ── Hero ── #}
    <div class="tests-hero">
        <div style="display:inline-flex; align-items:center; gap:0.5rem; padding:0.35rem 0.9rem; border:1px solid #e2e8f0; border-radius:99px; font-size:0.65rem; font-weight:800; letter-spacing:0.15em; text-transform:uppercase; color:#94a3b8; margin-bottom:1.5rem;">
            <span style="width:6px;height:6px;border-radius:50%;background:#94a3b8;"></span>
            Architecture Intérieure
        </div>
        <h1>Découverte <em style="color:#94a3b8;font-style:normal;">de Soi</em></h1>
        <p>Cultivez la clarté et la connaissance de vous-même à travers une exploration systématique de votre fonctionnement intérieur.</p>

        {% set completed = latestTests|length %}
        {% set total = tests|length %}
        <div class="progress-bar-wrap">
            <span style="font-size:0.65rem;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:#94a3b8;">Progression</span>
            <span style="font-size:0.65rem;font-weight:800;color:#475569;">{{ completed }}/{{ total }} tests</span>
        </div>
        <div class="progress-bar-track">
            <div class="progress-bar-fill" style="width:{{ total > 0 ? ((completed / total) * 100)|round : 0 }}%;"></div>
        </div>

        <div class="tests-disclaimer">
            <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Ces tests sont <strong style="color:#64748b;margin:0 0.2em;">indicatifs</strong> — un outil de réflexion, non une vérité absolue.
        </div>
    </div>

    {# ── Groupe Personnalité & Cognition ── #}
    <p class="tests-section-title">Personnalité &amp; Cognition</p>
    <div class="tests-grid">
        {% for typeKey, meta in tests %}
            {% if typeKey in ['MBTI', 'DISC', 'ENNEAGRAMME', 'BIG5'] %}
                {% include 'personality/_card.html.twig' with {typeKey: typeKey, meta: meta, done: latestTests[typeKey] is defined} %}
            {% endif %}
        {% endfor %}
    </div>

    {# ── Groupe Potentiel & Aptitudes ── #}
    <p class="tests-section-title" style="margin-top:3rem;">Potentiel &amp; Aptitudes</p>
    <div class="tests-grid">
        {% for typeKey, meta in tests %}
            {% if typeKey in ['INTELLIGENCES', 'TALENT'] %}
                {% include 'personality/_card.html.twig' with {typeKey: typeKey, meta: meta, done: latestTests[typeKey] is defined} %}
            {% endif %}
        {% endfor %}
    </div>

    {# ── Groupe Équilibre & Hygiène ── #}
    <p class="tests-section-title" style="margin-top:3rem;">Équilibre &amp; Hygiène de Vie</p>
    <div class="tests-grid">
        {% for typeKey, meta in tests %}
            {% if typeKey in ['EQUILIBRE', 'HYGIENE'] %}
                {% include 'personality/_card.html.twig' with {typeKey: typeKey, meta: meta, done: latestTests[typeKey] is defined} %}
            {% endif %}
        {% endfor %}
    </div>

</div>
</div>
{% endblock %}
