{% extends 'admin/layout.html.twig' %}
{% block title %}{{ code }}{% endblock %}
{% block page_title %}Modifier un texte{% endblock %}
{% block page_lead %}{{ groupLabel }} · {{ formats[info.format] }}{% endblock %}
{% block crumbs %}<span aria-hidden="true">›</span><span>{{ groupLabel }}</span><span aria-hidden="true">›</span><span aria-current="page" style="overflow-wrap: anywhere;">{{ code }}</span>{% endblock %}
{% block content %}
<div class="ks-stack" style="max-width: 900px;">
    <section class="ks-card">
        <p class="ks-small" style="margin-bottom: .9rem;"><strong>{{ code }}</strong> · défini dans <code>{{ info.source }}</code>
            {% if row and row.draft is not null %}<span class="ks-badge ks-badge--warning">brouillon non publié</span>{% endif %}
            {% if row and row.published is not null %}<span class="ks-badge ks-badge--success">modifié en ligne le {{ row.publishedAt|date('d/m/Y à H:i') }}</span>{% endif %}</p>
        <form method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('site_text') }}">
            <div class="ks-field">
                <label class="ks-label" for="content">{{ row and row.draft is not null ? 'Brouillon' : 'Texte' }}</label>
                <textarea class="ks-input" id="content" name="content" rows="{{ info.format == 'markdown' ? 22 : 5 }}">{{ value }}</textarea>
                {% if info.format != 'text' %}<p class="ks-help">Mise en forme : <code>**gras**</code>, <code>*italique*</code>, <code>[texte du lien](/adresse)</code>{% if info.format == 'markdown' %}, <code>## Titre</code>, listes avec <code>- </code>. Les passages <code>[À COMPLÉTER : …]</code> sont surlignés tant qu'ils restent.{% endif %}</p>{% endif %}
            </div>
            <div class="ks-sticky-actions">
                <button class="ks-btn ks-btn--primary" type="submit" name="action" value="publish" onclick="return confirm('Publier ce texte ? Il sera en ligne immédiatement.');"><i data-lucide="send"></i> Publier</button>
                <button class="ks-btn ks-btn--secondary" type="submit" name="action" value="draft"><i data-lucide="save"></i> Enregistrer le brouillon</button>
                {% if row and row.draft is not null %}<button class="ks-btn ks-btn--ghost" type="submit" name="action" value="discard">Abandonner le brouillon</button>{% endif %}
                {% if row and row.published is not null %}<button class="ks-btn ks-btn--ghost" type="submit" name="action" value="revert" onclick="return confirm('Remettre le texte d\'origine en ligne ?');">Revenir au texte d'origine</button>{% endif %}
            </div>
        </form>
        <details style="margin-top: .9rem;"><summary class="ks-small" style="cursor: pointer;">Texte d'origine (celui du code)</summary><pre class="ks-muted" style="white-space: pre-wrap; margin: .6rem 0 0; font: inherit;">{{ info.default }}</pre></details>
    </section>
    {% if history %}
    <section class="ks-card">
        <h2 class="ks-card__title"><i data-lucide="history"></i> Historique</h2>
        {% for v in history %}
            <form method="post" class="ks-row-link" style="cursor: default;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('site_text') }}"><input type="hidden" name="version" value="{{ v.id }}">
                <span style="min-width: 0;"><strong class="ks-small">{{ v.createdAt|date('d/m/Y H:i') }}</strong> <span class="ks-small">· {{ v.kind == 'origine' ? 'remplacée par le texte d\'origine' : 'publiée' }}{% if v.author %} · {{ v.author.displayName }}{% endif %}</span>
                    <br><span style="font-size: .88rem;">{{ v.content|striptags|slice(0, 160) }}{{ v.content|length > 160 ? '…' }}</span></span>
                <button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit" name="action" value="restore"><i data-lucide="rotate-ccw"></i> Remettre dans le brouillon</button>
            </form>
        {% endfor %}
    </section>
    {% endif %}
</div>
{% endblock %}
