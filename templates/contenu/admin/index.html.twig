{% extends 'admin/layout.html.twig' %}
{% block title %}Textes du site{% endblock %}
{% block page_title %}Textes du site{% endblock %}
{% block page_lead %}La page d'accueil publique, les pages légales et les textes du Sanctuaire du Couple. Rien ne part en ligne tant que vous n'avez pas publié.{% endblock %}
{% block page_actions %}
    {% if drafts %}<form method="post" action="{{ path('admin_site_texts_publish_all') }}" onsubmit="return confirm('Publier les {{ drafts }} brouillon(s) ? Ils seront en ligne immédiatement.');"><input type="hidden" name="_csrf_token" value="{{ csrf_token('site_text') }}"><button class="ks-btn ks-btn--primary" type="submit"><i data-lucide="send"></i> Publier les {{ drafts }} brouillon{{ drafts > 1 ? 's' }}</button></form>{% endif %}
{% endblock %}
{% block content %}
<div class="ks-stack">
    <section class="ks-card ks-card--accent">
        <p class="ks-muted">Vous écrivez un brouillon, vous le relisez en mode aperçu (vous seul le voyez en parcourant le site), puis vous le publiez. Chaque publication est gardée : on peut revenir en arrière ou au texte d'origine.</p>
        <div class="ks-toolbar" style="margin-top: .9rem;">
            <form method="post" action="{{ path('admin_site_texts_preview') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('site_text') }}"><button class="ks-btn ks-btn--secondary ks-btn--sm" type="submit"><i data-lucide="{{ preview ? 'eye-off' : 'eye' }}"></i> {{ preview ? 'Quitter le mode aperçu' : 'Activer le mode aperçu' }}</button></form>
            <a class="ks-btn ks-btn--ghost ks-btn--sm" href="{{ path('app_home', {vitrine: 1}) }}" target="_blank" rel="noopener"><i data-lucide="external-link"></i> Ouvrir le site</a>
            {% if preview %}<span class="ks-badge ks-badge--gold">Mode aperçu actif</span>{% endif %}
        </div>
    </section>

    <form method="get" class="ks-card ks-card--flat ks-toolbar" role="search">
        <input class="ks-input" type="search" name="q" value="{{ q }}" placeholder="Chercher un mot dans les textes…" aria-label="Chercher un mot">
        <select class="ks-input" name="groupe" aria-label="Partie du site"><option value="">Toutes les parties</option>{% for g, n in groups %}<option value="{{ g }}" {{ g == group ? 'selected' }}>{{ groupLabels[g] ?? g }} ({{ n }})</option>{% endfor %}</select>
        <select class="ks-input" name="etat" aria-label="État"><option value="">Tous les états</option><option value="draft" {{ status == 'draft' ? 'selected' }}>Brouillons</option><option value="modified" {{ status == 'modified' ? 'selected' }}>Modifiés (en ligne)</option><option value="original" {{ status == 'original' ? 'selected' }}>Texte d'origine</option></select>
        <button class="ks-btn ks-btn--secondary" type="submit"><i data-lucide="filter"></i> Filtrer</button>
    </form>

    <section class="ks-card">
        <h2 class="ks-card__title">{{ items|length }} texte{{ items|length > 1 ? 's' }} sur {{ total }}</h2>
        {% for it in items %}
            <a class="ks-row-link" href="{{ path('admin_site_text_edit', {code: it.code}) }}">
                <span style="min-width: 0;"><span class="ks-small" style="font-weight: 700;">{{ groupLabels[it.group] ?? it.group }} · {{ it.code }}</span>
                    {% if it.state == 'draft' %}<span class="ks-badge ks-badge--warning">brouillon</span>{% elseif it.state == 'modified' %}<span class="ks-badge ks-badge--success">modifié</span>{% endif %}
                    <br><span style="font-size: .9rem;">{{ it.excerpt }}</span></span>
                <i data-lucide="chevron-right" class="ks-ico"></i>
            </a>
        {% else %}
            <p class="ks-muted">Aucun texte ne correspond. Essayez un autre mot ou retirez un filtre.</p>
        {% endfor %}
    </section>
</div>
{% endblock %}
